{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SyraNSKkYU9gjoPeXfJoLs","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"CS-4 (cepa-espiral-c1): o `/common:wrap-up` grava o próximo passo a partir do handoff.\n3\t\n4\tO passo L7 do wrap-up chama `common/hooks/session-next.py` com o handoff e o\n5\tsession_id. Ele lê a zona NOTE, acha a linha `**Próximo:** repo=… modo=…\n6\tcomando=…` e escreve `<raiz>/.claude/sessions/<id>.next.json` com esses três\n7\tcampos e o brief igual ao parágrafo `## Próximo passo`.\n8\t\n9\tContratos guardados aqui:\n10\t  - com a linha: o arquivo tem repo, modo, comando (com argumentos) e o brief\n11\t    verbatim, sem a linha `**Próximo:**` dentro dele;\n12\t  - sem a linha: nada é escrito, exit 0, e a saída diz que não gravou;\n13\t  - a linha fora da zona NOTE (no AUTO) não conta;\n14\t  - linha inutilizável (repo inexistente, modo desconhecido, reforma, campo\n15\t    faltando, seção vazia): nada é escrito, exit 2, e a saída diz o motivo;\n16\t  - o arquivo escrito é aceito pelo encadeamento do launcher (session-chain.py,\n17\t    CS-3): o cepa é reaberto em repo, com --modo e o brief;\n18\t  - o wrap-up.md manda o L7 chamar o script e levar a saída ao relatório, e o\n19\t    handoff.md documenta a linha.\n20\t\n21\tSem deps de terceiros — rode com `python3 tests/test_wrapup_proximo_passo.py`.\n22\t\"\"\"\n23\t\n24\timport json\n25\timport os\n26\timport subprocess\n27\timport sys\n28\timport tempfile\n29\tfrom pathlib import Path\n30\t\n31\tfor _k in (\"CEPA_ENCADEAR\", \"CEPA_LAUNCH_ID\"):\n32\t    os.environ.pop(_k, None)\n33\t\n34\tREPO = Path(__file__).resolve().parent.parent\n35\tNEXT = REPO / \"common\" / \"hooks\" / \"session-next.py\"\n36\tCHAIN = REPO / \"common\" / \"hooks\" / \"session-chain.py\"\n37\tWRAPUP = REPO / \"common\" / \"commands\" / \"wrap-up.md\"\n38\tHANDOFF_CMD = REPO / \"common\" / \"commands\" / \"handoff.md\"\n39\t\n40\tBRIEF = ('Abrir o `/common:epic contratos-e-regras` no wego-product e grelhar o dono\\n'\n41\t         'até cada ciclo ter roteiro com efeito em tela e em backend.')\n42\t\n43\tfailures = []\n44\t\n45\t\n46\tdef check(name, cond, detail=\"\"):\n47\t    if cond:\n48\t        print(f\"  ok   {name}\")\n49\t    else:\n50\t        print(f\"  FAIL {name} {detail}\")\n51\t        failures.append(name)\n52\t\n53\t\n54\tdef handoff(linha, brief=BRIEF, auto_extra=\"\"):\n55\t    secao = f\"## Próximo passo\\n{brief}\\n\" if brief is not None else \"\"\n56\t    lin = f\"{linha}\\n\\n\" if linha else \"\"\n57\t    return (\"---\\nbranch: session/x\\n---\\n\\n<!-- HANDOFF:AUTO -->\\n## Onde paramos\\n\"\n58\t            f\"{auto_extra}\\n<!-- /HANDOFF:AUTO -->\\n\\n<!-- HANDOFF:NOTE -->\\n\"\n59\t            \"## Onde estamos\\nCS-3 pronto.\\n\\n\"\n60\t            f\"{secao}{lin}\"\n61\t            \"## ⚠ Cuidados / pendências\\n- nada\\n<!-- /HANDOFF:NOTE -->\\n\")\n62\t\n63\t\n64\tclass World:\n65\t    def __enter__(self):\n66\t        self.tmp = tempfile.TemporaryDirectory()\n67\t        t = Path(self.tmp.name).resolve()\n68\t        self.root = t / \"root\"\n69\t        self.root.mkdir()\n70\t        self.alvo = t / \"wego-product\"\n71\t        self.alvo.mkdir()\n72\t        self.hf = t / \"handoff.md\"\n73\t        self.sid = \"sess-abc\"\n74\t        self.nxt = self.root / \".claude\" / \"sessions\" / f\"{self.sid}.next.json\"\n75\t        return self\n76\t\n77\t    def __exit__(self, *a):\n78\t        self.tmp.cleanup()\n79\t\n80\t    def run(self, texto):\n81\t        self.hf.write_text(texto, encoding=\"utf-8\")\n82\t        p = subprocess.run([sys.executable, str(NEXT), \"--handoff\", str(self.hf),\n83\t                            \"--session-id\", self.sid, \"--root\", str(self.root)],\n84\t                           capture_output=True, text=True)\n85\t        return p.returncode, p.stdout + p.stderr\n86\t\n87\t\n88\tdef linha(w, repo=None, modo=\"descoberta\", comando=\"/common:epic contratos-e-regras\"):\n89\t    return f\"**Próximo:** repo={repo or w.alvo} modo={modo} comando={comando}\"\n90\t\n91\t\n92\tprint(\"com a linha: grava os três campos e o brief\")\n93\twith World() as w:\n94\t    rc, out = w.run(handoff(linha(w)))\n95\t    check(\"exit 0\", rc == 0, out)\n96\t    check(\"arquivo existe\", w.nxt.exists(), out)\n97\t    d = json.loads(w.nxt.read_text()) if w.nxt.exists() else {}\n98\t    check(\"repo\", d.get(\"repo\") == str(w.alvo), d)\n99\t    check(\"modo\", d.get(\"modo\") == \"descoberta\", d)\n100\t    check(\"comando com argumento\", d.get(\"comando\") == \"/common:epic contratos-e-regras\", d)\n101\t    check(\"brief = parágrafo Próximo passo\", d.get(\"brief\") == BRIEF, repr(d.get(\"brief\")))\n102\t    check(\"saída diz que gravou\", \"gravado\" in out and \"não gravado\" not in out, out)\n103\t\n104\tprint(\"a linha do critério, verbatim (repo real do dono)\")\n105\tliteral = \"/Users/alegomes/coding/wego/wego-product\"\n106\tif os.path.isdir(literal):\n107\t    with World() as w:\n108\t        rc, out = w.run(handoff(f\"**Próximo:** repo={literal} modo=descoberta \"\n109\t                                \"comando=/common:epic contratos-e-regras\"))\n110\t        d = json.loads(w.nxt.read_text()) if w.nxt.exists() else {}\n111\t        check(\"literal: campos\", (d.get(\"repo\"), d.get(\"modo\"), d.get(\"comando\"))\n112\t              == (literal, \"descoberta\", \"/common:epic contratos-e-regras\"), out)\n113\telse:\n114\t    print(\"  skip (repo do critério não existe nesta máquina)\")\n115\t\n116\tprint(\"linha dentro da seção Próximo passo não vaza para o brief\")\n117\twith World() as w:\n118\t    rc, out = w.run(handoff(None, brief=f\"{BRIEF}\\n\\n{linha(w)}\"))\n119\t    d = json.loads(w.nxt.read_text()) if w.nxt.exists() else {}\n120\t    check(\"brief sem a linha\", d.get(\"brief\") == BRIEF, repr(d.get(\"brief\")))\n121\t    check(\"campos lidos\", d.get(\"modo\") == \"descoberta\", out)\n122\t\n123\tprint(\"ordem das chaves trocada\")\n124\twith World() as w:\n125\t    rc, out = w.run(handoff(f\"**Próximo:** comando=/common:spec x y modo=design repo={w.alvo}\"))\n126\t    d = json.loads(w.nxt.read_text()) if w.nxt.exists() else {}\n127\t    check(\"comando até a próxima chave\", d.get(\"comando\") == \"/common:spec x y\", d)\n128\t    check(\"modo\", d.get(\"modo\") == \"design\", d)\n129\t    check(\"repo\", d.get(\"repo\") == str(w.alvo), d)\n130\t\n131\tprint(\"sem a linha: não escreve e diz\")\n132\twith World() as w:\n133\t    rc, out = w.run(handoff(None))\n134\t    check(\"exit 0\", rc == 0, out)\n135\t    check(\"nada escrito\", not w.nxt.exists())\n136\t    check(\"saída diz que não gravou e por quê\", \"não gravado\" in out and \"Próximo:\" in out, out)\n137\t\n138\tprint(\"linha só no AUTO não conta\")\n139\twith World() as w:\n140\t    rc, out = w.run(handoff(None, auto_extra=linha(w)))\n141\t    check(\"nada escrito\", not w.nxt.exists(), out)\n142\t    check(\"exit 0\", rc == 0, out)\n143\t\n144\tcasos = [\n145\t    (\"repo inexistente\", lambda w: linha(w, repo=str(w.alvo) + \"-nao\"), BRIEF, \"não existe\"),\n146\t    (\"modo desconhecido\", lambda w: linha(w, modo=\"festa\"), BRIEF, \"festa\"),\n147\t    (\"modo reforma\", lambda w: linha(w, modo=\"reforma\"), BRIEF, \"orcamento\"),\n148\t    (\"sem comando\", lambda w: f\"**Próximo:** repo={w.alvo} modo=descoberta\", BRIEF, \"comando\"),\n149\t    (\"sem modo\", lambda w: f\"**Próximo:** repo={w.alvo} comando=/x\", BRIEF, \"modo\"),\n150\t    (\"sem repo\", lambda w: \"**Próximo:** modo=descoberta comando=/x\", BRIEF, \"repo\"),\n151\t    (\"seção vazia\", lambda w: linha(w), \"   \", \"vazia\"),\n152\t    (\"sem seção\", lambda w: linha(w), None, \"vazia\"),\n153\t]\n154\tfor nome, lf, brief, palavra in casos:\n155\t    print(f\"inutilizável: {nome}\")\n156\t    with World() as w:\n157\t        rc, out = w.run(handoff(lf(w), brief=brief))\n158\t        check(f\"{nome}: exit 2\", rc == 2, f\"rc={rc} {out}\")\n159\t        check(f\"{nome}: nada escrito\", not w.nxt.exists())\n160\t        check(f\"{nome}: motivo na saída\", \"não gravado\" in out and palavra in out, out)\n161\t\n162\tprint(\"o arquivo escrito é aceito pelo encadeamento do launcher (CS-3)\")\n163\twith World() as w:\n164\t    subprocess.run([\"git\", \"init\", \"-q\", \".\"], cwd=w.root, check=True)\n165\t    rc, out = w.run(handoff(linha(w)))\n166\t    sdir = w.root / \".claude\" / \"sessions\"\n167\t    (sdir / \"launch-1.launch\").write_text(w.sid + \"\\n\")\n168\t    log = Path(w.tmp.name) / \"cepa.log\"\n169\t    fake = Path(w.tmp.name) / \"fakecepa\"\n170\t    fake.write_text(\"#!/usr/bin/env python3\\nimport json, os, sys\\n\"\n171\t                    f\"open({str(log)!r}, 'w').write(json.dumps({{'args': sys.argv[1:], 'cwd': os.getcwd()}}))\\n\")\n172\t    fake.chmod(0o755)\n173\t    p = subprocess.run([sys.executable, str(CHAIN), \"launch-1\", str(fake), \"0\"],\n174\t                       cwd=w.root, capture_output=True, text=True)\n175\t    got = json.loads(log.read_text()) if log.exists() else {}\n176\t    check(\"cepa reaberto\", bool(got), p.stderr)\n177\t    check(\"cwd = repo\", got.get(\"cwd\") == str(w.alvo), got)\n178\t    check(\"--modo descoberta + brief\", got.get(\"args\") == [\"--modo\", \"descoberta\", BRIEF], got)\n179\t    check(\"arquivo consumido\", not w.nxt.exists())\n180\t\n181\tprint(\"o wrap-up e o handoff conhecem a linha\")\n182\twu = WRAPUP.read_text(encoding=\"utf-8\")\n183\tcheck(\"wrap-up L7 chama session-next.py\", \"session-next.py\" in wu and \"--session-id\" in wu)\n184\tcheck(\"wrap-up leva a saída ao relatório\", \"Próximo passo\" in wu.split(\"### L8\")[1].split(\"##\")[0]\n185\t      if \"### L8\" in wu else False)\n186\tcheck(\"handoff.md documenta a linha\", \"**Próximo:** repo=\" in HANDOFF_CMD.read_text(encoding=\"utf-8\"))\n187\t\n188\tprint()\n189\tif failures:\n190\t    print(f\"{len(failures)} FAIL\")\n191\t    sys.exit(1)\n192\tprint(\"todos ok\")\n193\t"}]},"pa