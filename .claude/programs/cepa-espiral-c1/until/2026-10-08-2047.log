{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfqqtRZC5MqXor2PARmZk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016D3THme1PkKHMkni75Nz3Z","name":"Bash","input":{"command":"sed -n 578,710p common/bin/cepa-plan; echo ----; sed -n 2387,2560p common/bin/cepa-plan; sed -n 2709,2775p common/bin/cepa-plan","description":"Read from-spec and write implementation"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5925,"cache_read_input_tokens":82227,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5925},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"868541c9-49b6-4a70-b747-ccbfce738b0a","uuid":"4e3d3a1c-307a-4aa8-9944-98d82ff227bf","timestamp":"2026-10-09T02:05:05.085Z","request_id":"req_011CfqqtRH5KVSMMytnaeQSi","wire_tool_inputs":{"toolu_016D3THme1PkKHMkni75Nz3Z":{"command":"cd /Users/alegomes/cepa-worktrees/cepa-until-2026-10-08-2047 && sed -n 578,710p common/bin/cepa-plan; echo ----; sed -n 2387,2560p common/bin/cepa-plan; sed -n 2709,2775p common/bin/cepa-plan","description":"Read from-spec and write implementation"}},"wire_ingest_context":{"toolu_016D3THme1PkKHMkni75Nz3Z":{"cwd":"/Users/alegomes/cepa-worktrees/cepa-until-2026-10-08-2047"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016D3THme1PkKHMkni75Nz3Z","type":"tool_result","content":"def carrega_itens(origem):\n    \"\"\"JSON ou YAML, de arquivo ou de stdin ('-'). Devolve (itens, erro).\"\"\"\n    try:\n        bruto = sys.stdin.read() if origem == \"-\" else Path(origem).read_text(encoding=\"utf-8\")\n    except OSError as e:\n        return None, f\"não deu para ler {origem}: {e}\"\n    if not bruto.strip():\n        return None, f\"{origem} veio vazio\"\n    try:\n        dados = json.loads(bruto)\n    except json.JSONDecodeError:\n        try:\n            dados = yaml.safe_load(bruto)\n        except yaml.YAMLError as e:\n            return None, f\"{origem} não é JSON nem YAML válido ({e})\"\n    # aceita tanto a lista crua quanto um documento com `items:`\n    if isinstance(dados, dict) and \"items\" in dados:\n        dados = dados[\"items\"]\n    if not isinstance(dados, list):\n        return None, (f\"{origem} tem que trazer uma LISTA de itens (ou um \"\n                      \"documento com `items:`)\")\n    return dados, None\n\n\n# ── leitura de uma especificação do /common:spec ─────────────────────────────\n\nHERDADO = (\"herdado da ordem do texto da especificação; ninguém priorizou os \"\n           \"critérios entre si\")\n\nRE_CRITERIO = re.compile(r\"^###\\s+(CS-\\d+)\\s*:\\s*(.+?)\\s*$\", re.M)\n# O campo pode ocupar VÁRIAS linhas — um \"Teste vermelho\" real costuma ser uma\n# frase inteira quebrada em três linhas. Capturar só a primeira produzia um\n# `why` cortado no meio de uma oração, que é pior que não ter o campo: parece\n# texto completo. Vai até a próxima linha que abre outro campo, um heading, ou\n# a linha em branco que fecha o parágrafo.\nRE_CAMPO = re.compile(\n    r\"^\\*\\*(Superfície|Teste vermelho)[:]?\\*\\*[:]?[ \\t]*(.*?)\"\n    r\"(?=\\n[ \\t]*\\n|\\n\\*\\*|\\n#{2,}|\\Z)\", re.M | re.S)\n\n# A dependência que a PRÓPRIA spec declara em prosa (\"Depois do CS-1, ...\"). É\n# a única que se lê do texto sem deduzir: dois critérios tocarem o mesmo\n# arquivo não é dependência. Antes a regra era \"o agente acrescenta onde a spec\n# declarar\", e em 2026-09-23 ninguém acrescentou — a fila liberou o CS-2 antes\n# do CS-1 existir.\nRE_DEPOIS_DE = re.compile(\n    r\"\\b(?:depois|ap[óo]s)\\s+(?:(?:d[oa]s?|[oa]s?)\\s+)?\"\n    r\"(CS-\\d+(?:\\s*(?:,|\\be\\b)\\s*CS-\\d+)*)\", re.I)\n\n\ndef itens_de_spec(texto):\n    \"\"\"(itens, avisos). Um item por `### CS-N`, na ordem em que aparecem.\n\n    A ordem é a do texto e o `why` DIZ isso quando a spec não deu motivo de\n    posição — a preferência registrada no desenho. Inventar aqui uma prioridade\n    que ninguém declarou seria fabricar decisão, que é justamente o que este\n    documento existe para não fazer.\n    \"\"\"\n    avisos = []\n    m = re.search(r\"^\\*\\*Status:\\*\\*\\s*(\\S+)\", texto, re.M)\n    status = m.group(1) if m else None\n    if status != \"pronta-para-construir\":\n        avisos.append(f\"a especificação está com `Status: {status}` — só \"\n                      \"`pronta-para-construir` passou pelo crivo do /common:spec \"\n                      \"(toda superfície observável e todo teste vermelho \"\n                      \"declarados)\")\n    abertas = len(re.findall(r\"^-\\s+\\[ \\]\", texto, re.M))\n    if abertas:\n        avisos.append(f\"{abertas} pergunta(s) ainda em aberto na spec — um \"\n                      \"critério cuja pergunta não foi respondida vira item de \"\n                      \"fila que ninguém sabe quando terminou\")\n\n    achados = list(RE_CRITERIO.finditer(texto))\n    ids = {m.group(1) for m in achados}\n    itens = []\n    for i, m in enumerate(achados):\n        corpo = texto[m.end():achados[i + 1].start() if i + 1 < len(achados) else len(texto)]\n        depende = []\n        for d in RE_DEPOIS_DE.finditer(corpo):\n            for alvo in re.findall(r\"CS-\\d+\", d.group(1)):\n                if alvo == m.group(1) or alvo in depende:\n                    continue\n                if alvo not in ids:\n                    avisos.append(f\"{m.group(1)} diz que vem depois do {alvo}, \"\n                                  \"que não existe nesta spec — dependência \"\n                                  \"fora do `blocked_by`\")\n                    continue\n                depende.append(alvo)\n        campos = {k: \" \".join(v.split()) for k, v in RE_CAMPO.findall(corpo)}\n        pedacos = [HERDADO]\n        if campos.get(\"Superfície\"):\n            pedacos.append(f\"superfície onde se observa: {campos['Superfície']}\")\n        if campos.get(\"Teste vermelho\"):\n            pedacos.append(f\"teste vermelho declarado: {campos['Teste vermelho']}\")\n        else:\n            avisos.append(f\"{m.group(1)} não declara **Teste vermelho:** — o \"\n                          \"item nasce sem a frase que diz quando ele terminou\")\n        itens.append({\n            \"id\": m.group(1),\n            \"title\": m.group(2),\n            \"why\": \" · \".join(pedacos),\n            \"status\": \"pending\",\n            \"blocked_by\": depende,\n            \"human_pending\": None,\n        })\n    return itens, avisos\n\n\ndef cmd_from_spec(caminho, como_json=True):\n    p = Path(caminho)\n    if not p.is_file():\n        print(f\"{p} não existe\", file=sys.stderr)\n        return 2\n    itens, avisos = itens_de_spec(p.read_text(encoding=\"utf-8\"))\n    for a in avisos:\n        print(f\"aviso: {a}\", file=sys.stderr)\n    if not itens:\n        print(f\"{p} não tem nenhum critério de sucesso (`### CS-N: ...`) — não \"\n              \"há fila a escrever a partir dela\", file=sys.stderr)\n        return 2\n    print(json.dumps(itens, ensure_ascii=False, indent=2) if como_json else itens)\n    return 0\n\n\n# ── leitura do repasse de uma triagem do /board-flow:triage ──────────────────\n\n# Os cinco destinos que a triagem dá a um card. Os nomes são os do balde no\n# `/board-flow:triage`, em minúsculas — traduzir aqui seria criar um segundo\n# vocabulário para a mesma coisa.\nBALDES = (\"ready\", \"implemented\", \"obsolete\", \"needs-refinement\", \"needs-decision\")\n\n\ndef itens_de_triagem(repasse):\n    \"\"\"(itens, avisos, erros). A classificação é da triagem; a fila é daqui.\n----\ndef cmd_validate(caminho):\n    p = Path(caminho)\n    if not p.is_file():\n        print(f\"{p} não existe\", file=sys.stderr)\n        return 2\n    plan, erro = le_plano(p)\n    if erro:\n        print(erro, file=sys.stderr)\n        return 2\n    faltas = valida_plano(plan)\n    if faltas:\n        print(f\"{p}: {len(faltas)} lacuna(s)\", file=sys.stderr)\n        for f in faltas:\n            print(f\"  - {f}\", file=sys.stderr)\n        return 2\n    print(f\"{p}: fila válida, {len(plan.get('items') or [])} itens\")\n    return 0\n\n\ndef cmd_write(raiz, a):\n    if a.from_triage:\n        repasse, erro = le_repasse(a.from_triage)\n        if erro:\n            print(erro, file=sys.stderr)\n            return 2\n        itens, avisos, erros = itens_de_triagem(repasse)\n        for aviso in avisos:\n            print(f\"aviso: {aviso}\", file=sys.stderr)\n        if erros:\n            for e in erros:\n                print(f\"recusa: {e}\", file=sys.stderr)\n            return 2\n        erro = None\n    elif a.from_spec:\n        sp = Path(a.from_spec)\n        if not sp.is_file():\n            print(f\"{sp} não existe\", file=sys.stderr)\n            return 2\n        itens, avisos = itens_de_spec(sp.read_text(encoding=\"utf-8\"))\n        for aviso in avisos:\n            print(f\"aviso: {aviso}\", file=sys.stderr)\n        if not itens:\n            print(f\"{sp} não tem nenhum critério de sucesso (`### CS-N: ...`)\",\n                  file=sys.stderr)\n            return 2\n        erro = None\n    else:\n        itens, erro = carrega_itens(a.items)\n    if erro:\n        print(erro, file=sys.stderr)\n        return 2\n    faltas = valida_itens(itens)\n    if faltas:\n        print(f\"{len(faltas)} lacuna(s) na fila — nada foi gravado\",\n              file=sys.stderr)\n        for f in faltas:\n            print(f\"  - {f}\", file=sys.stderr)\n        return 2\n\n    alvo = caminho_do_plano(raiz, a.nome)\n    antigos, fonte_antiga, demonstra_antigo = [], None, None\n    if alvo.is_file():\n        plan, err = le_plano(alvo)\n        if err:\n            print(f\"{err} — não dá para dizer o que seria sobrescrito\",\n                  file=sys.stderr)\n            return 3\n        if modo_de(plan) != MODE:\n            print(f\"COLISÃO: {alvo} é um plano '{modo_de(plan)}' — as ondas do \"\n                  f\"/maestro:program-plan. Gravar a fila aqui apaga as ondas e \"\n                  f\"o aceite de cada slice. Escolha outro nome de programa.\",\n                  file=sys.stderr)\n            return 3\n        antigos = plan.get(\"items\") or []\n        fonte_antiga = plan.get(\"source\")\n        # Repriorizar mexe nos itens, não no que a fila demonstra: o campo\n        # vem do disco, senão a primeira reescrita o apaga em silêncio.\n        demonstra_antigo = plan.get(\"demonstra\")\n\n        novos_ids = {str(i.get(\"id\")) for i in itens}\n        sumidos = [str(x.get(\"id\")) for x in antigos\n                   if isinstance(x, dict) and str(x.get(\"id\")) not in novos_ids]\n        if sumidos and a.on_missing == \"refuse\":\n            print(f\"a fila que está no disco tem {len(sumidos)} item(ns) que a \"\n                  f\"lista nova não menciona: {', '.join(sumidos)}.\\n\"\n                  \"Sumir com eles em silêncio apaga posição e `why` que alguém \"\n                  \"decidiu. Inclua-os na lista, ou diga explicitamente o que \"\n                  \"fazer: --on-missing keep (mantém no fim, sem posição \"\n                  \"escolhida; com --from-triage, mantém a fila do disco na \"\n                  \"ordem dela e acrescenta os cards novos depois) ou \"\n                  \"--on-missing drop (marca status: dropped).\",\n                  file=sys.stderr)\n            return 4\n\n    fundidos, reaproveitados = funde(itens, antigos)\n    acrescentados = []\n    if antigos:\n        novos_ids = {str(i[\"id\"]) for i in fundidos}\n        sobras = [x for x in antigos\n                  if isinstance(x, dict) and str(x.get(\"id\")) not in novos_ids]\n        if a.on_missing == \"keep\" and a.from_triage and sobras:\n            # Triagem PARCIAL: o repasse cobre um pedaço da coluna, então a\n            # ordem que ele propõe vale entre os cards que ele leu, não contra\n            # a fila que o dono já priorizou. Achado em quadro real\n            # (2026-09-25): 3 cards novos entravam na frente dos 5 pendentes\n            # priorizados, e esses iam para o fim. A fila do disco fica na\n            # posição dela (item que a triagem também cita é atualizado ali\n            # mesmo) e os cards novos entram DEPOIS, na ordem da triagem.\n            por_id = {str(f[\"id\"]): f for f in fundidos}\n            ja_na_fila = []\n            for s in antigos:\n                if not isinstance(s, dict):\n                    continue\n                ident = str(s.get(\"id\"))\n                ja_na_fila.append(por_id.pop(ident) if ident in por_id else\n                                  normaliza({**s, \"why\": s.get(\"why\") or\n                                             \"sem `why` registrado na fila anterior\"}))\n            acrescentados = [str(f[\"id\"]) for f in fundidos\n                             if str(f[\"id\"]) in por_id]\n            fundidos = ja_na_fila + [f for f in fundidos\n                                     if str(f[\"id\"]) in por_id]\n        elif a.on_missing == \"keep\":\n            fundidos.extend(normaliza({**s, \"why\": s.get(\"why\") or\n                                       \"sem `why` registrado na fila anterior\"}\n                                      ) for s in sobras)\n        elif a.on_missing == \"drop\":\n            for s in sobras:\n                d = normaliza({**s, \"why\": s.get(\"why\") or\n                               \"sem `why` registrado na fila anterior\"})\n                d[\"status\"] = \"dropped\"\n                fundidos.append(d)\n\n    fonte = a.source or (\n        f\"{a.from_spec} ({len(itens)} critérios de sucesso; ordem herdada do texto)\"\n        if a.from_spec else None) or (\n        fonte_da_triagem(repasse) if a.from_triage else None\n        ) or fonte_antiga or \"ditada à mão em /common:plan\"\n    texto = serializa(a.nome, fonte, fundidos, a.quando or \"(data não informada)\",\n                      demonstra_antigo)\n\n    if a.dry_run:\n        print(texto)\n        return 0\n\n    backup = None\n    alvo.parent.mkdir(parents=True, exist_ok=True)\n    if alvo.is_file():\n        backup = alvo.with_suffix(\".yaml.bak\")\n        backup.write_text(alvo.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\n    tmp = alvo.with_suffix(\".yaml.tmp\")\n    tmp.write_text(texto, encoding=\"utf-8\")\n    tmp.replace(alvo)\n\n    print(f\"gravado: {alvo}\")\n    print(f\"  {len(fundidos)} itens · fonte: {fonte}\")\n    if reaproveitados:\n        print(f\"  {len(reaproveitados)} item(ns) já existiam — status e \"\n              f\"human_pending preservados do disco: {', '.join(reaproveitados)}\")\n    if acrescentados:\n        print(f\"  triagem parcial: a ordem da fila do disco foi mantida; \"\n              f\"{len(acrescentados)} card(s) novo(s) entraram depois dela: \"\n              f\"{', '.join(acrescentados)}\")\n    if backup:\n        print(f\"  cópia do anterior em {backup} — comentários escritos à mão \"\n              f\"não sobrevivem à reescrita, estão lá\")\n    return 0\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(\n        description=\"escreve e valida a fila single-track do harness\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    c = sub.add_parser(\"check-name\", help=\"o nome está livre para uma fila?\")\n    w = sub.add_parser(\"write\", help=\"grava a fila\")\n    w.add_argument(\"nome\")\n    w.add_argument(\"--items\",\n                   help=\"arquivo JSON/YAML com a lista de itens, ou '-' para stdin\")\n    w.add_argument(\"--from-spec\", metavar=\"ARQUIVO\",\n                   help=\"lê os itens de uma especificação do /common:spec, um \"\n                        \"por critério de sucesso, na ordem do texto\")\n    w.add_argument(\"--from-triage\", metavar=\"ARQUIVO\",\n                   help=\"lê os itens do repasse de uma triagem do \"\n                        \"/board-flow:triage, na ordem que ela classificou\")\n    w.add_argument(\"--source\", help=\"de onde as demandas vieram\")\n    w.add_argument(\"--quando\", help=\"data a registrar no cabeçalho (YYYY-MM-DD)\")\n    w.add_argument(\"--repo\", default=\".\")\n    w.add_argument(\"--on-missing\", choices=(\"refuse\", \"keep\", \"drop\"),\n                   default=\"refuse\",\n                   help=\"o que fazer com item do disco que a lista nova não cita\")\n    w.add_argument(\"--dry-run\", action=\"store_true\",\n                   help=\"imprime o arquivo que seria gravado, sem gravar\")\n\n    a = ap.parse_args(argv)\n\n    if a.cmd == \"validate\":\n        return cmd_validate(a.plano)\n    if a.cmd == \"from-spec\":\n        return cmd_from_spec(a.spec)\n    if a.cmd == \"from-triage\":\n        return cmd_from_triage(a.repasse)\n    if a.cmd == \"write\" and not (a.items or a.from_spec or a.from_triage):\n        ap.error(\"write precisa de --items, --from-spec ou --from-triage\")\n\n    raiz = raiz_principal(a.repo)\n    if raiz is None:\n        print(f\"{a.repo} não é um repositório git — a fila mora no clone \"\n              \"principal, e sem git não dá para achá-lo\", file=sys.stderr)\n        return 2\n    if a.cmd == \"check-name\":\n        return cmd_check_name(raiz, a.nome)\n    if a.cmd == \"add\":\n        return cmd_add(raiz, a.nome, a.id, a)\n    if a.cmd == \"ordena\":\n        chaves = [k.strip() for k in a.keys.split(\",\") if k.strip()]\n        return cmd_ordena(raiz, a.nome, chaves, a.como_json)\n    if a.cmd == \"divergencia\":\n        return cmd_divergencia(raiz, a.nome, a.board, a.backlog, a.como_json)\n    if a.cmd == \"status\":\n        return cmd_status(raiz, a.nome, a.filtro, a.como_json)\n    if a.cmd == \"show\":\n        return cmd_show(raiz, a.nome, a.como_json)\n    if a.cmd == \"queue\":\n        return cmd_queue(raiz, a.nome, a.teto, a.como_json)\n    if a.cmd == \"promote\":\n        return cmd_promote(raiz, a.nome, a.como_json, a.quando)\n    if a.cmd == \"reconcile\":\n        return cmd_reconcile(raiz, a.nome, a.board, a.config, a.aplicar,\n                             a.como_json)\n    if a.cmd == \"start\":\n        return cmd_start(raiz, a.nome, a.id, a.repo)\n    if a.cmd == \"finish\":\n        return cmd_finish(raiz, a.nome, a.id, a.status, a.evidence,\n                          a.human_pending, a.repo, a.pergunta)\n    if a.cmd == \"responde\":\n        return cmd_responde(raiz, a.nome, a.id, a.resposta, a.mantem)\n    return cmd_write(raiz, a)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","is_error":false}]},"parent_tool_use_id":null,"session_id":"868541c9-49b6-4a70-b747-ccbfce738b0a","uuid":"cb9c6986-0fd3-4e7a-a9bc-626707112bff","timestamp":"2026-10-09T02:05:05.274Z","tool_use_result":{"stdout":"def carrega_itens(origem):\n    \"\"\"JSON ou YAML, de arquivo ou de stdin ('-'). Devolve (itens, erro).\"\"\"\n    try:\n        bruto = sys.stdin.read() if origem == \"-\" else Path(origem).read_text(encoding=\"utf-8\")\n    except OSError as e:\n        return None, f\"não deu para ler {origem}: {e}\"\n    if not bruto.strip():\n        return None, f\"{origem} veio vazio\"\n    try:\n        dados = json.loads(bruto)\n    except json.JSONDecodeError:\n        try:\n            dados = yaml.safe_load(bruto)\n        except yaml.YAMLError as e:\n            return None, f\"{origem} não é JSON nem YAML válido ({e})\"\n    # aceita tanto a lista crua quanto um documento com `items:`\n    if isinstance(dados, dict) and \"items\" in dados:\n        dados = dados[\"items\"]\n    if not isinstance(dados, list):\n        return None, (f\"{origem} tem que trazer uma LISTA de itens (ou um \"\n                      \"documento com `items:`)\")\n    return dados, None\n\n\n# ── leitura de uma especificação do /common:spec ─────────────────────────────\n\nHERDADO = (\"herdado da ordem do texto da especificação; ninguém priorizou os \"\n           \"critérios entre si\")\n\nRE_CRITERIO = re.compile(r\"^###\\s+(CS-\\d+)\\s*:\\s*(.+?)\\s*$\", re.M)\n# O campo pode ocupar VÁRIAS linhas — um \"Teste vermelho\" real costuma ser uma\n# frase inteira quebrada em três linhas. Capturar só a primeira produzia um\n# `why` cortado no meio de uma oração, que é pior que não ter o campo: parece\n# texto completo. Vai até a próxima linha que abre outro campo, um heading, ou\n# a linha em branco que fecha o parágrafo.\nRE_CAMPO = re.compile(\n    r\"^\\*\\*(Superfície|Teste vermelho)[:]?\\*\\*[:]?[ \\t]*(.*?)\"\n    r\"(?=\\n[ \\t]*\\n|\\n\\*\\*|\\n#{2,}|\\Z)\", re.M | re.S)\n\n# A dependência que a PRÓPRIA spec declara em prosa (\"Depois do CS-1, ...\"). É\n# a única que se lê do texto sem deduzir: dois critérios tocarem o mesmo\n# arquivo não é dependência. Antes a regra era \"o agente acrescenta onde a spec\n# declarar\", e em 2026-09-23 ninguém acrescentou — a fila liberou o CS-2 antes\n# do CS-1 existir.\nRE_DEPOIS_DE = re.compile(\n    r\"\\b(?:depois|ap[óo]s)\\s+(?:(?:d[oa]s?|[oa]s?)\\s+)?\"\n    r\"(CS-\\d+(?:\\s*(?:,|\\be\\b)\\s*CS-\\d+)*)\", re.I)\n\n\ndef itens_de_spec(texto):\n    \"\"\"(itens, avisos). Um item por `### CS-N`, na ordem em que aparecem.\n\n    A ordem é a do texto e o `why` DIZ isso quando a spec não deu motivo de\n    posição — a preferência registrada no desenho. Inventar aqui uma prioridade\n    que ninguém declarou seria fabricar decisão, que é justamente o que este\n    documento existe para não fazer.\n    \"\"\"\n    avisos = []\n    m = re.search(r\"^\\*\\*Status:\\*\\*\\s*(\\S+)\", texto, re.M)\n    status = m.group(1) if m else None\n    if status != \"pronta-para-construir\":\n        avisos.append(f\"a especificação está com `Status: {status}` — só \"\n                      \"`pronta-para-construir` passou pelo crivo do /common:spec \"\n                      \"(toda superfície observável e todo teste vermelho \"\n                      \"declarados)\")\n    abertas = len(re.findall(r\"^-\\s+\\[ \\]\", texto, re.M))\n    if abertas:\n        avisos.append(f\"{abertas} pergunta(s) ainda em aberto na spec — um \"\n                      \"critério cuja pergunta não foi respondida vira item de \"\n                      \"fila que ninguém sabe quando terminou\")\n\n    achados = list(RE_CRITERIO.finditer(texto))\n    ids = {m.group(1) for m in achados}\n    itens = []\n    for i, m in enumerate(achados):\n        corpo = texto[m.end():achados[i + 1].start() if i + 1 < len(achados) else len(texto)]\n        depende = []\n        for d in RE_DEPOIS_DE.finditer(corpo):\n            for alvo in re.findall(r\"CS-\\d+\", d.group(1)):\n                if alvo == m.group(1) or alvo in depende:\n                    continue\n                if alvo not in ids:\n                    avisos.append(f\"{m.group(1)} diz que vem depois do {alvo}, \"\n                                  \"que não existe nesta spec — dependência \"\n                                  \"fora do `blocked_by`\")\n                    continue\n                depende.append(alvo)\n        campos = {k: \" \".join(v.split()) for k, v in RE_CAMPO.findall(corpo)}\n        pedacos = [HERDADO]\n        if campos.get(\"Superfície\"):\n            pedacos.append(f\"superfície onde se observa: {campos['Superfície']}\")\n        if campos.get(\"Teste vermelho\"):\n            pedacos.append(f\"teste vermelho declarado: {campos['Teste vermelho']}\")\n        else:\n            avisos.append(f\"{m.group(1)} não declara **Teste vermelho:** — o \"\n                          \"item nasce sem a frase que diz quando ele terminou\")\n        itens.append({\n            \"id\": m.group(1),\n            \"title\": m.group(2),\n            \"why\": \" · \".join(pedacos),\n            \"status\": \"pending\",\n            \"blocked_by\": depende,\n            \"human_pending\": None,\n        })\n    return itens, avisos\n\n\ndef cmd_from_spec(caminho, como_json=True):\n    p = Path(caminho)\n    if not p.is_file():\n        print(f\"{p} não existe\", file=sys.stderr)\n        return 2\n    itens, avisos = itens_de_spec(p.read_text(encoding=\"utf-8\"))\n    for a in avisos:\n        print(f\"aviso: {a}\", file=sys.stderr)\n    if not itens:\n        print(f\"{p} não tem nenhum critério de sucesso (`### CS-N: ...`) — não \"\n              \"há fila a escrever a partir dela\", file=sys.stderr)\n        return 2\n    print(json.dumps(itens, ensure_ascii=False, indent=2) if como_json else itens)\n    return 0\n\n\n# ── leitura do repasse de uma triagem do /board-flow:triage ──────────────────\n\n# Os cinco destinos que a triagem dá a um card. Os nomes são os do balde no\n# `/board-flow:triage`, em minúsculas — traduzir aqui seria criar um segundo\n# vocabulário para a mesma coisa.\nBALDES = (\"ready\", \"implemented\", \"obsolete\", \"needs-refinement\", \"needs-decision\")\n\n\ndef itens_de_triagem(repasse):\n    \"\"\"(itens, avisos, erros). A classificação é da triagem; a fila é daqui.\n----\ndef cmd_validate(caminho):\n    p = Path(caminho)\n    if not p.is_file():\n        print(f\"{p} não existe\", file=sys.stderr)\n        return 2\n    plan, erro = le_plano(p)\n    if erro:\n        print(erro, file=sys.stderr)\n        return 2\n    faltas = valida_plano(plan)\n    if faltas:\n        print(f\"{p}: {len(faltas)} lacuna(s)\", file=sys.stderr)\n        for f in faltas:\n            print(f\"  - {f}\", file=sys.stderr)\n        return 2\n    print(f\"{p}: fila válida, {len(plan.get('items') or [])} itens\")\n    return 0\n\n\ndef cmd_write(raiz, a):\n    if a.from_triage:\n        repasse, erro = le_repasse(a.from_triage)\n        if erro:\n            print(erro, file=sys.stderr)\n            return 2\n        itens, avisos, erros = itens_de_triagem(repasse)\n        for aviso in avisos:\n            print(f\"aviso: {aviso}\", file=sys.stderr)\n        if erros:\n            for e in erros:\n                print(f\"recusa: {e}\", file=sys.stderr)\n            return 2\n        erro = None\n    elif a.from_spec:\n        sp = Path(a.from_spec)\n        if not sp.is_file():\n            print(f\"{sp} não existe\", file=sys.stderr)\n            return 2\n        itens, avisos = itens_de_spec(sp.read_text(encoding=\"utf-8\"))\n        for aviso in avisos:\n            print(f\"aviso: {aviso}\", file=sys.stderr)\n        if not itens:\n            print(f\"{sp} não tem nenhum critério de sucesso (`### CS-N: ...`)\",\n                  file=sys.stderr)\n            return 2\n        erro = None\n    else:\n        itens, erro = carrega_itens(a.items)\n    if erro:\n        print(erro, file=sys.stderr)\n        return 2\n    faltas = valida_itens(itens)\n    if faltas:\n        print(f\"{len(faltas)} lacuna(s) na fila — nada foi gravado\",\n              file=sys.stderr)\n        for f in faltas:\n            print(f\"  - {f}\", file=sys.stderr)\n        return 2\n\n    alvo = caminho_do_plano(raiz, a.nome)\n    antigos, fonte_antiga, demonstra_antigo = [], None, None\n    if alvo.is_file():\n        plan, err = le_plano(alvo)\n        if err:\n            print(f\"{err} — não dá para dizer o que seria sobrescrito\",\n                  file=sys.stderr)\n            return 3\n        if modo_de(plan) != MODE:\n            print(f\"COLISÃO: {alvo} é um plano '{modo_de(plan)}' — as ondas do \"\n                  f\"/maestro:program-plan. Gravar a fila aqui apaga as ondas e \"\n                  f\"o aceite de cada slice. Escolha outro nome de programa.\",\n                  file=sys.stderr)\n            return 3\n        antigos = plan.get(\"items\") or []\n        fonte_antiga = plan.get(\"source\")\n        # Repriorizar mexe nos itens, não no que a fila demonstra: o campo\n        # vem do disco, senão a primeira reescrita o apaga em silêncio.\n        demonstra_antigo = plan.get(\"demonstra\")\n\n        novos_ids = {str(i.get(\"id\")) for i in itens}\n        sumidos = [str(x.get(\"id\")) for x in antigos\n                   if isinstance(x, dict) and str(x.get(\"id\")) not in novos_ids]\n        if sumidos and a.on_missing == \"refuse\":\n            print(f\"a fila que está no disco tem {len(sumidos)} item(ns) que a \"\n                  f\"lista nova não menciona: {', '.join(sumidos)}.\\n\"\n                  \"Sumir com eles em silêncio apaga posição e `why` que alguém \"\n                  \"decidiu. Inclua-os na lista, ou diga explicitamente o que \"\n                  \"fazer: --on-missing keep (mantém no fim, sem posição \"\n                  \"escolhida; com --from-triage, mantém a fila do disco na \"\n                  \"ordem dela e acrescenta os cards novos depois) ou \"\n                  \"--on-missing drop (marca status: dropped).\",\n                  file=sys.stderr)\n            return 4\n\n    fundidos, reaproveitados = funde(itens, antigos)\n    acrescentados = []\n    if antigos:\n        novos_ids = {str(i[\"id\"]) for i in fundidos}\n        sobras = [x for x in antigos\n                  if isinstance(x, dict) and str(x.get(\"id\")) not in novos_ids]\n        if a.on_missing == \"keep\" and a.from_triage and sobras:\n            # Triagem PARCIAL: o repasse cobre um pedaço da coluna, então a\n            # ordem que ele propõe vale entre os cards que ele leu, não contra\n            # a fila que o dono já priorizou. Achado em quadro real\n            # (2026-09-25): 3 cards novos entravam na frente dos 5 pendentes\n            # priorizados, e esses iam para o fim. A fila do disco fica na\n            # posição dela (item que a triagem também cita é atualizado ali\n            # mesmo) e os cards novos entram DEPOIS, na ordem da triagem.\n            por_id = {str(f[\"id\"]): f for f in fundidos}\n            ja_na_fila = []\n            for s in antigos:\n                if not isinstance(s, dict):\n                    continue\n                ident = str(s.get(\"id\"))\n                ja_na_fila.append(por_id.pop(ident) if ident in por_id else\n                                  normaliza({**s, \"why\": s.get(\"why\") or\n                                             \"sem `why` registrado na fila anterior\"}))\n            acrescentados = [str(f[\"id\"]) for f in fundidos\n                             if str(f[\"id\"]) in por_id]\n            fundidos = ja_na_fila + [f for f in fundidos\n                                     if str(f[\"id\"]) in por_id]\n        elif a.on_missing == \"keep\":\n            fundidos.extend(normaliza({**s, \"why\": s.get(\"why\") or\n                                       \"sem `why` registrado na fila anterior\"}\n                                      ) for s in sobras)\n        elif a.on_missing == \"drop\":\n            for s in sobras:\n                d = normaliza({**s, \"why\": s.get(\"why\") or\n                               \"sem `why` registrado na fila anterior\"})\n                d[\"status\"] = \"dropped\"\n                fundidos.append(d)\n\n    fonte = a.source or (\n        f\"{a.from_spec} ({len(itens)} critérios de sucesso; ordem herdada do texto)\"\n        if a.from_spec else None) or (\n        fonte_da_triagem(repasse) if a.from_triage else None\n        ) or fonte_antiga or \"ditada à mão em /common:plan\"\n    texto = serializa(a.nome, fonte, fundidos, a.quando or \"(data não informada)\",\n                      demonstra_antigo)\n\n    if a.dry_run:\n        print(texto)\n        return 0\n\n    backup = None\n    alvo.parent.mkdir(parents=True, exist_ok=True)\n    if alvo.is_file():\n        backup = alvo.with_suffix(\".yaml.bak\")\n        backup.write_text(alvo.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\n    tmp = alvo.with_suffix(\".yaml.tmp\")\n    tmp.write_text(texto, encoding=\"utf-8\")\n    tmp.replace(alvo)\n\n    print(f\"gravado: {alvo}\")\n    print(f\"  {len(fundidos)} itens · fonte: {fonte}\")\n    if reaproveitados:\n        print(f\"  {len(reaproveitados)} item(ns) já existiam — status e \"\n              f\"human_pending preservados do disco: {', '.join(reaproveitados)}\")\n    if acrescentados:\n        print(f\"  triagem parcial: a ordem da fila do disco foi mantida; \"\n              f\"{len(acrescentados)} card(s) novo(s) entraram depois dela: \"\n              f\"{', '.join(acrescentados)}\")\n    if backup:\n        print(f\"  cópia do anterior em {backup} — comentários escritos à mão \"\n              f\"não sobrevivem à reescrita, estão lá\")\n    return 0\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(\n        description=\"escreve e valida a fila single-track do harness\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    c = sub.add_parser(\"check-name\", help=\"o nome está livre para uma fila?\")\n    w = sub.add_parser(\"write\", help=\"grava a fila\")\n    w.add_argument(\"nome\")\n    w.add_argument(\"--items\",\n                   help=\"arquivo JSON/YAML com a lista de itens, ou '-' para stdin\")\n    w.add_argument(\"--from-spec\", metavar=\"ARQUIVO\",\n                   help=\"lê os itens de uma especificação do /common:spec, um \"\n                        \"por critério de sucesso, na ordem do texto\")\n    w.add_argument(\"--from-triage\", metavar=\"ARQUIVO\",\n                   help=\"lê os itens do repasse de uma triagem do \"\n                        \"/board-flow:triage, na ordem que ela classificou\")\n    w.add_argument(\"--source\", help=\"de onde as demandas vieram\")\n    w.add_argument(\"--quando\", help=\"data a registrar no cabeçalho (YYYY-MM-DD)\")\n    w.add_argument(\"--repo\", default=\".\")\n    w.add_argument(\"--on-missing\", choices=(\"refuse\", \"keep\", \"drop\"),\n                   default=\"refuse\",\n                   help=\"o que fazer com item do disco que a lista nova não cita\")\n    w.add_argument(\"--dry-run\", action=\"store_true\",\n                   help=\"imprime o arquivo que seria gravado, sem gravar\")\n\n    a = ap.parse_args(argv)\n\n    if a.cmd == \"validate\":\n        return cmd_validate(a.plano)\n    if a.cmd == \"from-spec\":\n        return cmd_from_spec(a.spec)\n    if a.cmd == \"from-triage\":\n        return cmd_from_triage(a.repasse)\n    if a.cmd == \"write\" and not (a.items or a.from_spec or a.from_triage):\n        ap.error(\"write precisa de --items, --from-spec ou --from-triage\")\n\n    raiz = raiz_principal(a.repo)\n    if raiz is None:\n        print(f\"{a.repo} não é um repositório git — a fila mora no clone \"\n              \"principal, e sem git não dá para achá-lo\", file=sys.stderr)\n        return 2\n    if a.cmd == \"check-name\":\n        return cmd_check_name(raiz, a.nome)\n    if a.cmd == \"add\":\n        return cmd_add(raiz, a.nome, a.id, a)\n    if a.cmd == \"ordena\":\n        chaves = [k.strip() for k in a.keys.split(\",\") if k.strip()]\n        return cmd_ordena(raiz, a.nome, chaves, a.como_json)\n    if a.cmd == \"divergencia\":\n        return cmd_divergencia(raiz, a.nome, a.board, a.backlog, a.como_json)\n    if a.cmd == \"status\":\n        return cmd_status(raiz, a.nome, a.filtro, a.como_json)\n    if a.cmd == \"show\":\n        return cmd_show(raiz, a.nome, a.como_json)\n    if a.cmd == \"queue\":\n        return cmd_queue(raiz, a.nome, a.teto, a.como_json)\n    if a.cmd == \"promote\":\n        return cmd_promote(raiz, a.nome, a.como_json, a.quando)\n    if a.cmd == \"reconcile\":\n        return cmd_reconcile(raiz, a.nome, a.board, a.config, a.aplicar,\n                             a.como_json)\n    if a.cmd == \"start\":\n        return cmd_start(raiz, a.nome, a.id, a.repo)\n    if a.cmd == \"finish\":\n        return cmd_finish(raiz, a.nome, a.id, a.status, a.evidence,\n                          a.human_pending, a.repo, a.pergunta)\n    if a.cmd == \"responde\":\n        return cmd_responde(raiz, a.nome, a.id, a.resposta, a.mantem)\n    return cmd_write(raiz, a)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016D3THme1PkKHMkni75Nz3Z","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
