{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019qYVuMTkAokZ4vtDs727Me","type":"tool_result","content":"    print(f\"gravado: {alvo}\")\n    print(f\"  {len(fundidos)} itens · fonte: {fonte}\")\n    if reaproveitados:\n        print(f\"  {len(reaproveitados)} item(ns) já existiam — status e \"\n              f\"human_pending preservados do disco: {', '.join(reaproveitados)}\")\n    if acrescentados:\n        print(f\"  triagem parcial: a ordem da fila do disco foi mantida; \"\n              f\"{len(acrescentados)} card(s) novo(s) entraram depois dela: \"\n              f\"{', '.join(acrescentados)}\")\n    if backup:\n        print(f\"  cópia do anterior em {backup} — comentários escritos à mão \"\n              f\"não sobrevivem à reescrita, estão lá\")\n    return 0\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(\n        description=\"escreve e valida a fila single-track do harness\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    c = sub.add_parser(\"check-name\", help=\"o nome está livre para uma fila?\")\n    c.add_argument(\"nome\")\n    c.add_argument(\"--repo\", default=\".\")\n\n    v = sub.add_parser(\"validate\", help=\"valida um plan.yaml no disco\")\n    v.add_argument(\"plano\")\n\n    s = sub.add_parser(\"from-spec\",\n                       help=\"lê uma spec do /common:spec e devolve os itens (JSON)\")\n    s.add_argument(\"spec\")\n\n    t = sub.add_parser(\"from-triage\",\n                       help=\"lê o repasse de uma triagem do /board-flow:triage \"\n                            \"e devolve os itens (JSON)\")\n    t.add_argument(\"repasse\", help=\"arquivo JSON/YAML, ou '-' para stdin\")\n\n    q = sub.add_parser(\"queue\",\n                       help=\"quais itens o lote pode executar agora, na ordem \"\n                            \"da fila, e onde ele para\")\n    q.add_argument(\"nome\")\n    q.add_argument(\"--max\", type=int, default=TETO_PADRAO, dest=\"teto\",\n                   help=f\"teto de itens no lote (default {TETO_PADRAO}: cada \"\n                        \"item é um build inteiro com gate de aceite e de prova)\")\n    q.add_argument(\"--repo\", default=\".\")\n    q.add_argument(\"--json\", action=\"store_true\", dest=\"como_json\")\n\n    stt = sub.add_parser(\"status\",\n                         help=\"a fila inteira agrupada por status, na ordem \"\n                              \"gravada; só lê, não reserva nem executa\")\n    stt.add_argument(\"nome\", nargs=\"?\",\n                     help=\"nome da fila; omitido, usa a única que existir\")\n    stt.add_argument(\"--status\", choices=STATUSES, dest=\"filtro\",\n                     help=\"mostra só os itens com este status\")\n    stt.add_argument(\"--repo\", default=\".\")\n    stt.add_argument(\"--json\", action=\"store_true\", dest=\"como_json\")\n\n    pr = sub.add_parser(\"promote\",\n                        help=\"as demandas que a fila entrega ao \"\n                             \"/maestro:program-plan --from-plan\")\n    pr.add_argument(\"nome\")\n    pr.add_argument(\"--repo\", default=\".\")\n    pr.add_argument(\"--json\", action=\"store_true\", dest=\"como_json\")\n    pr.add_argument(\"--quando\", help=\"data a registrar na linha `source` do \"\n                                     \"plano de ondas (AAAA-MM-DD)\")\n\n    st = sub.add_parser(\"start\",\n                        help=\"reserva um item do lote (status: in_progress) e \"\n                             \"assina a reserva com a sessão dona\")\n    st.add_argument(\"nome\")\n    st.add_argument(\"id\")\n    st.add_argument(\"--repo\", default=\".\")\n\n    fi = sub.add_parser(\"finish\",\n                        help=\"registra o desfecho de um item do lote\")\n    fi.add_argument(\"nome\")\n    fi.add_argument(\"id\")\n    fi.add_argument(\"--status\", required=True,\n                    choices=(\"done\", \"blocked\", \"pending\"),\n                    help=\"done = fechou; blocked = travou em condição de fora; \"\n                         \"pending = volta para a fila sem ter fechado\")\n    fi.add_argument(\"--evidence\", required=True,\n                    help=\"o que aconteceu: commits, vereditos, o que travou\")\n    fi.add_argument(\"--human-pending\", dest=\"human_pending\",\n                    help=\"ABRE uma rota que só o humano fecha (validar à mão, \"\n                         \"aprovar PR). Nunca fecha uma: só o humano faz isso\")\n    fi.add_argument(\"--pergunta\",\n                    help=\"a pergunta FECHADA que destrava o item, com a sua \"\n                         \"recomendação (\\\"Fecho o card como 'medir depois do \"\n                         \"go-live'? Recomendo sim: ...\\\"). Use com `blocked` \"\n                         \"e com `--human-pending`: é o que o `cepa-until \"\n                         \"decidir` mostra ao dono em vez da evidência inteira\")\n    fi.add_argument(\"--repo\", default=\".\")\n\n    rs = sub.add_parser(\"responde\",\n                        help=\"o DONO responde a um item adiado: `blocked` volta \"\n                             \"para `pending` com a resposta, e a rota \"\n                             \"`human_pending` fecha. Só num terminal\")\n    rs.add_argument(\"nome\")\n    rs.add_argument(\"id\")\n    rs.add_argument(\"--resposta\", required=True,\n                    help=\"a resposta do dono, verbatim; o próximo run a lê \"\n                         \"na evidência do item\")\n    rs.add_argument(\"--mantem\", action=\"store_true\",\n                    help=\"grava a resposta e deixa o item como está: o \"\n                         \"`blocked` segue travado e a rota segue aberta\")\n    rs.add_argument(\"--repo\", default=\".\")\n\n    rc = sub.add_parser(\"reconcile\",\n                        help=\"compara a fila com o quadro e (com --apply) \"\n                             \"grava a reconciliação\")\n    rc.add_argument(\"nome\")\n    rc.add_argument(\"--board\", required=True, metavar=\"ARQUIVO\",\n                    help=\"JSON/YAML que o atlassian-expert produziu: lista de \"\n                         \"{key, status}, ou {cards: [...], missing: [...]}. \"\n                         \"'-' lê da entrada padrão\")\n    rc.add_argument(\"--config\", help=\"board-flow.yaml a usar (default: o do \"\n                                     \"repo)\")\n    rc.add_argument(\"--apply\", action=\"store_true\", dest=\"aplicar\",\n                    help=\"grava os status reconciliados no plano. Nunca fecha \"\n                         \"`human_pending` e nunca anexa card novo\")\n    rc.add_argument(\"--repo\", default=\".\")\n    rc.add_argument(\"--json\", action=\"store_true\", dest=\"como_json\")\n\n    ad = sub.add_parser(\"add\",\n                        help=\"acrescenta UM item a uma fila existente, sem \"\n                             \"reescrever os outros\")\n    ad.add_argument(\"nome\")\n    ad.add_argument(\"id\")\n    ad.add_argument(\"--title\", required=True)\n    ad.add_argument(\"--why\", help=\"obrigatório com --antes-de; sem \"\n                                  \"--antes-de, vira o `why` do item com a \"\n                                  \"frase 'ainda não priorizado' anexada\")\n    ad.add_argument(\"--antes-de\", dest=\"antes_de\", metavar=\"ID\",\n                    help=\"insere imediatamente antes deste id (exige --why)\")\n    ad.add_argument(\"--blocked-by\", dest=\"blocked_by\", metavar=\"ID,ID\",\n                    help=\"ids desta MESMA fila que bloqueiam o item novo\")\n    ad.add_argument(\"--repo\", default=\".\")\n\n    od = sub.add_parser(\"ordena\",\n                        help=\"ordena uma lista de chaves do Jira pela ordem \"\n                             \"da fila\")\n    od.add_argument(\"nome\")\n    od.add_argument(\"--keys\", required=True, metavar=\"K1,K2,...\",\n                    help=\"chaves na ordem do Jira; as que são item do plano \"\n                         \"voltam na ordem da fila, as outras depois, \