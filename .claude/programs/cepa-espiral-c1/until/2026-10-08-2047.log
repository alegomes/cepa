{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TdHosRnPoz6kFA94mzU9gj","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Grava o próximo passo do encadeamento a partir do handoff (CS-4 do ciclo cepa-espiral-c1).\n3\t\n4\tQuem chama é o passo L7 do `/common:wrap-up`. Lê a zona NOTE do handoff\n5\t(`<!-- HANDOFF:NOTE -->…<!-- /HANDOFF:NOTE -->`) e procura a linha\n6\t\n7\t    **Próximo:** repo=<caminho> modo=<modo> comando=<comando e argumentos>\n8\t\n9\tAchou: escreve `<raiz-principal>/.claude/sessions/<session_id>.next.json` com\n10\t`repo`, `modo`, `comando` e `brief`, onde o brief é o parágrafo da seção\n11\t`## Próximo passo` da mesma zona. É o arquivo que o launcher `cepa` lê quando\n12\ta sessão sai (`session-chain.py`, CS-3) para abrir a seguinte sem o dono digitar.\n13\t\n14\tSem a linha, não escreve nada e diz isso: handoff sem `Próximo:` continua\n15\tválido, a sessão só não encadeia. Linha presente mas inutilizável (repo que não\n16\texiste, modo desconhecido, brief vazio) também não escreve, e diz o motivo: um\n17\tarquivo que o launcher recusaria apagaria o próximo passo em silêncio.\n18\t\n19\tUso: session-next.py --handoff <arquivo> --session-id <id> [--root <raiz>]\n20\tSaída: exit 0 escreveu ou não havia linha; exit 2 a linha existe e não serve.\n21\tA primeira linha do stdout é o que vai no relatório do wrap-up.\n22\t\"\"\"\n23\t\n24\timport argparse\n25\timport json\n26\timport os\n27\timport re\n28\timport sys\n29\t\n30\tsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n31\timport _modos  # noqa: E402\n32\timport _wtlib as L  # noqa: E402\n33\t\n34\tNOTE_RE = re.compile(r\"<!-- HANDOFF:NOTE -->(.*?)<!-- /HANDOFF:NOTE -->\", re.S)\n35\tLINHA_RE = re.compile(r\"^\\s*\\*\\*Próximo:\\*\\*\\s*(.*)$\", re.M)\n36\tCHAVE_RE = re.compile(r\"(?:^|\\s)(repo|modo|comando)=\")\n37\tSECAO_RE = re.compile(r\"^##\\s+Próximo passo\\s*$\", re.M)\n38\t\n39\t\n40\tdef note_zone(texto: str) -> str:\n41\t    m = NOTE_RE.search(texto)\n42\t    return m.group(1) if m else \"\"\n43\t\n44\t\n45\tdef parse_linha(resto: str) -> dict:\n46\t    \"\"\"`repo=… modo=… comando=…` → dict. O comando leva o resto até a próxima\n47\t    chave, porque carrega argumentos com espaço (`/common:epic contratos`).\"\"\"\n48\t    achados = list(CHAVE_RE.finditer(resto))\n49\t    campos = {}\n50\t    for i, m in enumerate(achados):\n51\t        fim = achados[i + 1].start() if i + 1 < len(achados) else len(resto)\n52\t        campos[m.group(1)] = resto[m.end():fim].strip()\n53\t    return campos\n54\t\n55\t\n56\tdef brief_da_secao(note: str) -> str:\n57\t    \"\"\"O parágrafo de `## Próximo passo`, sem a linha `**Próximo:**`.\"\"\"\n58\t    m = SECAO_RE.search(note)\n59\t    if not m:\n60\t        return \"\"\n61\t    corpo = note[m.end():]\n62\t    prox = re.search(r\"^##\\s\", corpo, re.M)\n63\t    if prox:\n64\t        corpo = corpo[:prox.start()]\n65\t    corpo = LINHA_RE.sub(\"\", corpo)\n66\t    return corpo.strip()\n67\t\n68\t\n69\tdef main() -> int:\n70\t    ap = argparse.ArgumentParser()\n71\t    ap.add_argument(\"--handoff\", required=True)\n72\t    ap.add_argument(\"--session-id\", required=True)\n73\t    ap.add_argument(\"--root\")\n74\t    a = ap.parse_args()\n75\t\n76\t    try:\n77\t        texto = open(a.handoff, encoding=\"utf-8\").read()\n78\t    except OSError as e:\n79\t        print(f\"próximo passo não gravado: handoff ilegível ({e})\")\n80\t        return 2\n81\t    note = note_zone(texto)\n82\t    m = LINHA_RE.search(note)\n83\t    if not m:\n84\t        print(\"próximo passo não gravado: o handoff não tem a linha `**Próximo:**` \"\n85\t              \"na zona NOTE, então a sessão seguinte não abre sozinha\")\n86\t        return 0\n87\t\n88\t    campos = parse_linha(m.group(1))\n89\t    repo, modo, comando = campos.get(\"repo\", \"\"), campos.get(\"modo\", \"\"), campos.get(\"comando\", \"\")\n90\t    brief = brief_da_secao(note)\n91\t    faltas = [k for k, v in ((\"repo\", repo), (\"modo\", modo), (\"comando\", comando)) if not v]\n92\t    if faltas:\n93\t        motivo = f\"a linha `**Próximo:**` não traz {', '.join(faltas)}\"\n94\t    elif not os.path.isdir(repo):\n95\t        motivo = f\"repo {repo} não existe\"\n96\t    elif modo not in _modos.MODOS:\n97\t        motivo = f\"modo {modo} não é um dos modos ({' '.join(_modos.MODOS)})\"\n98\t    elif modo == \"reforma\":\n99\t        motivo = \"modo reforma exige --orcamento, que o encadeamento não passa\"\n100\t    elif not brief:\n101\t        motivo = \"a seção `## Próximo passo` está vazia ou não existe\"\n102\t    else:\n103\t        motivo = \"\"\n104\t    if motivo:\n105\t        print(f\"próximo passo não gravado: {motivo}\")\n106\t        return 2\n107\t\n108\t    root = a.root or L.main_root(os.getcwd())\n109\t    if not root:\n110\t        print(\"próximo passo não gravado: raiz do repositório não encontrada\")\n111\t        return 2\n112\t    d = L.sessions_dir(root)\n113\t    d.mkdir(parents=True, exist_ok=True)\n114\t    alvo = d / f\"{a.session_id}.next.json\"\n115\t    alvo.write_text(json.dumps({\"repo\": repo, \"modo\": modo, \"comando\": comando,\n116\t                                \"brief\": brief}, ensure_ascii=False, indent=2) + \"\\n\",\n117\t                    encoding=\"utf-8\")\n118\t    print(f\"próximo passo gravado em {alvo}: ao sair, o cepa abre {repo} \"\n119\t          f\"no modo {modo} ({comando})\")\n120\t    return 0\n121\t\n122\t\n123\tif __name__ == \"__main__\":\n124\t    sys.exit(main())\n125\t"}]},"parent_tool_use_id":"toolu_01EoLbk34ZXu213PxTf3VpP5","agent_id":"a57c72e5f97298fe1","session_id":"0bd79703-5be0-4479-a1c6-2aeb93ae311a","uuid":"54bf182b-fcdf-47e3-b06d-74a9083196cd","timestamp":"2026-10-09T01:12:10.593Z","tool_result_meta":[{"id":"toolu_01TdHosRnPoz6kFA94mzU9gj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"build-hex:proof-reviewer","task_description":"Proof review CS-4"}
