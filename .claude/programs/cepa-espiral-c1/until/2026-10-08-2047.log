{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lpu2JRsvf8s6npGiCeATTA","type":"tool_result","content":"HEAD is now at 2c469ef feat(cepa-plan): campo demonstra: no cabeçalho da fila single-track (CS-1)\n common/bin/cepa-plan              |  66 ++++++++++++++++-\n common/plan-schema.yaml           |   8 ++\n tests/test_cepa_plan_demonstra.py | 152 ++++++++++++++++++++++++++++++++++++++\n 3 files changed, 222 insertions(+), 4 deletions(-)\ndiff --git a/common/bin/cepa-plan b/common/bin/cepa-plan\nindex f294b06..e81c65a 100755\n--- a/common/bin/cepa-plan\n+++ b/common/bin/cepa-plan\n@@ -468,6 +468,12 @@ def valida_plano(plan):\n     if not str(plan.get(\"source\") or \"\").strip():\n         faltas.append(\"sem `source` — de onde as demandas vieram é o que permite \"\n                       \"conferir a fila contra a fonte depois\")\n+    if \"demonstra\" in plan:\n+        d = plan.get(\"demonstra\")\n+        if not isinstance(d, str) or not d.strip():\n+            faltas.append(f\"`demonstra` é {d!r} — o campo é opcional, mas se \"\n+                          \"estiver no cabeçalho tem que ser uma frase dizendo \"\n+                          \"o que a fila demonstra quando acaba\")\n     faltas.extend(valida_itens(plan.get(\"items\")))\n     return faltas\n \n@@ -552,14 +558,18 @@ def funde(novos, antigos):\n     return saida, reaproveitados\n \n \n-def serializa(nome, fonte, itens, quando):\n+def serializa(nome, fonte, itens, quando, demonstra=None):\n     corpo = {\n         \"schema_version\": SCHEMA_VERSION,\n         \"mode\": MODE,\n         \"program\": nome,\n         \"source\": fonte,\n-        \"items\": itens,\n     }\n+    # `demonstra` só existe quando alguém o escreveu: a fila sem ele continua\n+    # válida, e um `demonstra: null` gravado por default seria ruído.\n+    if demonstra:\n+        corpo[\"demonstra\"] = demonstra\n+    corpo[\"items\"] = itens\n     dump = yaml.dump(corpo, allow_unicode=True, sort_keys=False,\n                      default_flow_style=False, width=78)\n     return CABECALHO.format(fonte=fonte, quando=quando) + \"\\n\" + dump\n@@ -1229,6 +1239,41 @@ def cmd_status(raiz, nome, filtro, como_json):\n     return 0\n \n \n+def cmd_show(raiz, nome, como_json):\n+    \"\"\"O cabeçalho da fila: de onde veio e o que ela demonstra quando acaba.\n+\n+    O `status` responde \"em que pé estão os itens\"; este responde \"para que\n+    serve esta fila\", que é a pergunta de quem abre uma fila de ciclo.\n+    \"\"\"\n+    alvo = caminho_do_plano(raiz, nome)\n+    if not alvo.is_file():\n+        print(f\"{alvo} não existe — quem escreve a fila é o /common:plan\",\n+              file=sys.stderr)\n+        return 2\n+    plan, erro = le_plano(alvo)\n+    if erro:\n+        print(erro, file=sys.stderr)\n+        return 2\n+    if modo_de(plan) != MODE:\n+        print(f\"COLISÃO: {alvo} é um plano '{modo_de(plan)}' — ondas do \"\n+              \"/maestro:program-plan, não uma fila\", file=sys.stderr)\n+        return 3\n+    itens = plan.get(\"items\") or []\n+    demonstra = plan.get(\"demonstra\")\n+    if como_json:\n+        print(json.dumps({\"program\": plan.get(\"program\") or nome,\n+                          \"path\": str(alvo), \"source\": plan.get(\"source\"),\n+                          \"demonstra\": demonstra, \"total\": len(itens)},\n+                         ensure_ascii=False, indent=2))\n+        return 0\n+    print(f\"fila {plan.get('program') or nome} · {alvo}\")\n+    print(f\"  fonte: {plan.get('source') or '(sem `source`)'}\")\n+    print(f\"  demonstra: {demonstra}\" if demonstra else\n+          \"  sem `demonstra:` — a fila não diz o que demonstra quando acaba\")\n+    print(f\"  {len(itens)} itens · a situação de cada um: cepa-plan status {nome}\")\n+    return 0\n+\n+\n # ── promoção: as demandas que a fila entrega ao /maestro:program-plan ────────\n \n # Piso D7 do Maestro (common/plan-schema.yaml, \"Piso de uso\"): abaixo de 4\n@@ -2399,7 +2444,7 @@ def cmd_write(raiz, a):\n         return 2\n \n     alvo = caminho_do_plano(raiz, a.nome)\n-    antigos, fonte_antiga = [], None\n+    antigos, fonte_antiga, demonstra_antigo = [], None, None\n     if alvo.is_file():\n         plan, err = le_plano(alvo)\n         if err:\n@@ -2414,6 +2459,9 @@ def cmd_write(raiz, a):\n             return 3\n         antigos = plan.get(\"items\") or []\n         fonte_antiga = plan.get(\"source\")\n+        # Repriorizar mexe nos itens, não no que a fila demonstra: o campo\n+        # vem do disco, senão a primeira reescrita o apaga em silêncio.\n+        demonstra_antigo = plan.get(\"demonstra\")\n \n         novos_ids = {str(i.get(\"id\")) for i in itens}\n         sumidos = [str(x.get(\"id\")) for x in antigos\n@@ -2473,7 +2521,8 @@ def cmd_write(raiz, a):\n         if a.from_spec else None) or (\n         fonte_da_triagem(repasse) if a.from_triage else None\n         ) or fonte_antiga or \"ditada à mão em /common:plan\"\n-    texto = serializa(a.nome, fonte, fundidos, a.quando or \"(data não informada)\")\n+    texto = serializa(a.nome, fonte, fundidos, a.quando or \"(data não informada)\",\n+                      demonstra_antigo)\n \n     if a.dry_run:\n         print(texto)\n@@ -2544,6 +2593,13 @@ def main(argv=None):\n     stt.add_argument(\"--repo\", default=\".\")\n     stt.add_argument(\"--json\", action=\"store_true\", dest=\"como_json\")\n \n+    sh = sub.add_parser(\"show\",\n+                        help=\"o cabeçalho da fila: fonte e o que ela \"\n+                             \"`demonstra:` quando acaba; só lê\")\n+    sh.add_argument(\"nome\")\n+    sh.add_argument(\"--repo\", default=\".\")\n+    sh.add_argument(\"--json\", action=\"store_true\", dest=\"como_json\")\n+\n     pr = sub.add_parser(\"promote\",\n                         help=\"as demandas que a fila entrega ao \"\n                              \"/maestro:program-plan --from-plan\")\n@@ -2696,6 +2752,8 @@ def main(argv=None):\n         return cmd_divergencia(raiz, a.nome, a.board, a.backlog, a.como_json)\n     if a.cmd == \"status\":\n         return cmd_status(raiz, a.nome, a.filtro, a.como_json)\n+    if a.cmd == \"show\":\n+        return cmd_show(raiz, a.nome, a.como_json)\n     if a.cmd == \"queue\":\n         return cmd_queue(raiz, a.nome, a.teto, a.como_json)\n     if a.cmd == \"promote\":","is_error":false}]},"parent_tool_use_id":"toolu_01Qrvd7DeJRrnqLzkgxwvEaA","agent_id":"a0c9ebbd59d575bdb","session_id":"589222f0-7447-4124-8be6-5fe567fca531","uuid":"bde48ee4-928e-47ff-a75d-bca7e8d30206","timestamp":"2026-10-08T23:49:12.848Z","tool_result_meta":[{"id":"toolu_01Lpu2JRsvf8s6npGiCeATTA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"build-hex:proof-reviewer","task_description":"Proof review CS-1"}
