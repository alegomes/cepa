{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L6xB3xeT49U2SdCiU26ceG","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"cepa-metrics — aggregate the harness's own telemetry into a readable report.\n\nReads the JSONL ledgers written by _telemetry.py (and inline emitters) at\n~/.claude/cepa-telemetry/events-YYYY-MM.jsonl and answers the questions the\nharness could not answer about itself: how often gates fire (and where), how\nbuilds trend per repo, which proof verdicts dominate, how many sessions each\nproject consumes.\n\nUsage:\n  cepa-metrics                  # last 30 days\n  cepa-metrics --days 7         # last N days\n  cepa-metrics --month 2026-07  # a specific month\n  cepa-metrics --repo wego-acesso-backend   # filter to one repo\n  cepa-metrics --json           # machine-readable dump of the aggregates\n\nReading the numbers:\n  - gate_block reason=stale/failure with HIGH counts on one repo → the verify\n    loop is too slow there or the baseline scope is wrong.\n  - gate_block reason=no-baseline on a repo that HAS a build → sessions are\n    pushing before ever running verify.\n  - gate_warn reason=no-build-manifest recurring on the same repo → commit the\n    .claude/no-build marker and silence it.\n  - proof_block > 0 → an agent stamped `proven` over a forbidding level; the\n    guard caught it. Recurring == prompt drift in proof-reviewer.\n  - builds failure-rate per repo → where the red-green loop burns the most.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nTELEMETRY_DIR = Path(os.environ.get(\"CEPA_TELEMETRY_DIR\") or (Path.home() / \".claude\" / \"cepa-telemetry\"))\n\n\ndef load_events(since: datetime, until: datetime):\n    events = []\n    if not TELEMETRY_DIR.is_dir():\n        return events\n    for f in sorted(TELEMETRY_DIR.glob(\"events-*.jsonl\")):\n        for line in f.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                e = json.loads(line)\n                ts = datetime.fromisoformat(str(e.get(\"ts\", \"\")).replace(\"Z\", \"+00:00\"))\n            except (json.JSONDecodeError, ValueError):\n                continue\n            if ts.tzinfo is None:\n                ts = ts.replace(tzinfo=timezone.utc)\n            if since <= ts <= until:\n                e[\"_ts\"] = ts\n                events.append(e)\n    return events\n\n\ndef fmt_counter(c: Counter, indent=\"    \", top=None) -> str:\n    items = c.most_common(top)\n    if not items:\n        return f\"{indent}(nenhum)\"\n    width = max(len(str(k)) for k, _ in items)\n    return \"\\n\".join(f\"{indent}{str(k):<{width}}  {v}\" for k, v in items)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Aggregate cepa harness telemetry.\")\n    ap.add_argument(\"--days\", type=int, default=30)\n    ap.add_argument(\"--month\", help=\"YYYY-MM (overrides --days)\")\n    ap.add_argument(\"--repo\", help=\"filter to one repo name\")\n    ap.add_argument(\"--json\", action=\"store_true\", dest=\"as_json\")\n    args = ap.parse_args()\n\n    now = datetime.now(timezone.utc)\n    if args.month:\n        try:\n            start = datetime.strptime(args.month, \"%Y-%m\").replace(tzinfo=timezone.utc)\n        except ValueError:\n            print(f\"--month inválido: {args.month} (use YYYY-MM)\", file=sys.stderr)\n            return 1\n        end = (start.replace(day=28) + timedelta(days=4)).replace(day=1) - timedelta(seconds=1)\n    else:\n        start, end = now - timedelta(days=args.days), now\n\n    events = load_events(start, end)\n    if args.repo:\n        events = [e for e in events if e.get(\"repo\") == args.repo]\n\n    # carimbo que o nudge semanal do session-registry consulta\n    try:\n        TELEMETRY_DIR.mkdir(parents=True, exist_ok=True)\n        (TELEMETRY_DIR / \"last-metrics-review\").write_text(\n            datetime.now(timezone.utc).isoformat(timespec=\"seconds\") + \"\\n\")\n    except OSError:\n        pass\n\n    if not events:\n        print(f\"Nenhum evento entre {start.date()} e {end.date()} em {TELEMETRY_DIR}.\")\n        print(\"A telemetria começa a acumular a partir da instalação desta versão — \"\n              \"rode de novo depois de algumas sessões.\")\n        return 0\n\n    # ── Aggregate ──────────────────────────────────────────────────────\n    by_event = Counter(e.get(\"event\", \"?\") for e in events)\n    sessions = Counter(e.get(\"repo\") or \"?\" for e in events if e.get(\"event\") == \"session_start\")\n\n    builds = defaultdict(Counter)   # repo -> {SUCCESS: n, FAILURE: n}\n    for e in events:\n        if e.get(\"event\") == \"build_result\":\n            builds[e.get(\"repo\") or \"?\"][e.get(\"status\", \"?\")] += 1\n\n    gate_blocks = Counter()         # (repo, tier, reason)\n    gate_warns = Counter()\n    for e in events:\n        key = (e.get(\"repo\") or \"?\", e.get(\"tier\", \"?\"), e.get(\"reason\", \"?\"))\n        if e.get(\"event\") == \"gate_block\":\n            gate_blocks[key] += 1\n        elif e.get(\"event\") == \"gate_warn\":\n            gate_warns[key] += 1\n\n    proof_verdicts = Counter()      # (repo, verdict)\n    proof_blocks = Counter()        # repo\n    for e in events:\n        if e.get(\"event\") == \"proof_verdict\":\n            proof_verdicts[(e.get(\"repo\") or \"?\", e.get(\"verdict\", \"?\"))] += 1\n        elif e.get(\"event\") == \"proof_block\":\n            proof_blocks[e.get(\"repo\") or \"?\"] += 1\n\n    # Formato de relatório. Desde 25/08/2026 o report-style-lint BLOQUEIA a\n    # parada quando o relatório sai do formato, e o turno reescreve. Por isso\n    # uma medição fora do formato não é um relatório ruim que o usuário leu:\n    # pode ser a primeira escrita, que o bloqueio devolveu. O número que\n    # importa é quantos desvios PERSISTIRAM após a reescrita (evento com\n    # `reincidente`), porque só esses chegam ao usuário. Correção de\n    # 06/10/2026: até aqui o agregador somava os dois e sugeria \"passar para\n    # bloqueio\" de um hook que já bloqueava.\n    relatorios = 0\n    relatorios_fora = 0\n    relatorios_bloqueados = 0\n    relatorios_persistiram = 0\n    desvios_tipo = Counter()\n    desvios_persistiram_tipo = Counter()\n    for e in events:\n        if e.get(\"event\") != \"report_style\":\n            continue\n        relatorios += 1\n        fora = (e.get(\"desvios\") or 0) > 0\n        if fora:\n            relatorios_fora += 1\n        if e.get(\"bloqueou\"):\n            relatorios_bloqueados += 1\n        if fora and e.get(\"reincidente\"):\n            relatorios_persistiram += 1\n            for t in (e.get(\"tipos\") or []):\n                desvios_persistiram_tipo[t] += 1\n        for t in (e.get(\"tipos\") or []):\n            desvios_tipo[t] += 1\n\n    # Atrito das pontas: quantos turnos o usuário gasta ANTES de conseguir\n    # disparar a rotina pela qual a sessão existe, e quantos gasta DEPOIS dela\n    # até encerrar. Os dois números existem porque a queixa (\"gasto 15-20% do\n    # contexto só em preparação\") era anedótica e precisava virar evidência.\n    prompts_por_sessao = defaultdict(list)\n    for e in events:\n        if e.get(\"event\") == \"prompt\" and e.get(\"session\"):\n            prompts_por_sessao[e[\"session\"]].append(e)\n\n    antes, depois = [], []\n    for _sid, evs in prompts_por_sessao.items():\n        evs.sort(key=lambda x: x.get(\"ts\", \"\"))\n        idx = [i for i, x in enumerate(evs) if x.get(\"kind\") == \"rotina\"]\n        if not idx:\n            continue  # sessão sem rotina não mede atrito de rotina\n        antes.append(idx[0])                  # turnos digitados antes da 1ª rotina\n        cauda = evs[idx[-1] + 1:]             # o que veio depois da última\n        # o próprio wrap-up/handoff é o encerramento, não atrito: conta o que\n        # veio ANTES dele.\n        fim = next((i for i, x in enumerate(cauda) if x.get(\"kind\") == \"fechamento\"),\n                   len(cauda))\n        depois.append(fim)\n\n    def mediana(xs):\n        if not xs:\n            return None\n        s = sorted(xs)\n        m = len(s) // 2\n        return s[m] if len(s) % 2 else (s[m - 1] + s[m]) / 2\n\n    # Tokens: um evento token_usage por sessão, gravado pelo cepa-tokens no fim\n    # dela. A mesma sessão pode ter sido gravada duas vezes (fim automático +\n    # varredura manual); vale o último evento de cada sessão.\n    ultimo_tokens = {}\n    for e in sorted((e for e in events if e.get(\"event\") == \"token_usage\"),\n                    key=lambda x: x.get(\"ts\", \"\")):\n        ultimo_tokens[e.get(\"sessao\") or id(e)] = e\n    tok_total = Counter()\n    tok_agente = defaultdict(Counter)\n    tok_chars = Counter()\n    tok_repo = Counter()\n    for e in ultimo_tokens.values():\n        novo = (e.get(\"entrada\") or 0) + (e.get(\"cache_w\") or 0)\n        tok_total[\"novo\"] += novo\n        tok_total[\"cache_r\"] += e.get(\"cache_r\") or 0\n        tok_total[\"saida\"] += e.get(\"saida\") or 0\n        tok_repo[e.get(\"repo\") or \"?\"] += novo\n        for tipo, u in (e.get(\"por_agente\") or {}).items():\n            tok_agente[tipo][\"novo\"] += (u.get(\"entrada\") or 0) + (u.get(\"cache_w\") or 0)\n            tok_agente[tipo][\"n\"] += u.get(\"n\") or 0\n        for nome, c in (e.get(\"resultado_chars\") or {}).items():\n            tok_chars[nome] += c or 0\n\n    known = {\"session_start\", \"session_end\", \"build_result\", \"gate_block\", \"gate_warn\",\n             \"proof_verdict\", \"proof_block\", \"report_style\", \"prompt\", \"token_usage\"}\n    custom = Counter(e.get(\"event\") for e in events if e.get(\"event\") not in known)\n\n    if args.as_json:\n        print(json.dumps({\n            \"period\": [start.isoformat(), end.isoformat()],\n            \"total_events\": len(events),\n            \"by_event\": dict(by_event),\n            \"sessions_per_repo\": dict(sessions),\n            \"builds\": {r: dict(c) for r, c in builds.items()},\n            \"gate_blocks\": {\" \".join(k): v for k, v in gate_blocks.items()},\n            \"gate_warns\": {\" \".join(k): v for k, v in gate_warns.items()},\n            \"proof_verdicts\": {\" \".join(k): v for k, v in proof_verdicts.items()},\n            \"proof_blocks\": dict(proof_blocks),\n            \"report_style\": {\"medidos\": relatorios, \"fora\": relatorios_fora,\n                             \"bloqueados\": relatorios_bloqueados,\n                             \"persistiram\": relatorios_persistiram,\n                             \"desvios_por_tipo\": dict(desvios_tipo),\n                             \"desvios_persistiram_por_tipo\":\n                                 dict(desvios_persistiram_tipo)},\n            \"atrito\": {\"sessoes_medidas\": len(antes),\n                       \"turnos_antes_da_rotina\": antes,\n                       \"turnos_depois_da_rotina\": depois,\n                       \"mediana_antes\": mediana(antes),\n                       \"mediana_depois\": mediana(depois)},\n            \"tokens\": {\"sessoes_medidas\": len(ultimo_tokens),\n                       \"total\": dict(tok_total),\n                       \"contexto_novo_por_repo\": dict(tok_repo),\n                       \"por_agente\": {k: dict(v) for k, v in tok_agente.items()},\n                       \"resultado_chars\": dict(tok_chars)},\n            \"custom_events\": dict(custom),\n        }, indent=2, ensure_ascii=False, default=str))\n        return 0\n\n    # ── Report ─────────────────────────────────────────────────────────\n    print(f\"# Telemetria do harness — {start.date()} a {end.date()}\")\n    print(f\"{len(events)} eventos · ledger: {TELEMETRY_DIR}\\n\")\n\n    print(f\"## Sessões por repo ({sum(sessions.values())} no período)\")\n    print(fmt_counter(sessions))\n\n    print(\"\\n## Builds por repo (verde / vermelho)\")\n    if builds:\n        for repo in sorted(builds, key=lambda r: -sum(builds[r].values())):\n            c = builds[repo]\n            ok, fail = c.get(\"SUCCESS\", 0), c.get(\"FAILURE\", 0)\n            total = sum(c.values())\n            rate = f\"{100 * fail / total:.0f}%\" if total else \"-\"\n            # EMPTY: rodada com filtro de teste que executou zero teste (não é verde).\n            empty = c.get(\"EMPTY\", 0)\n            vaz = f\", {empty} vazios (filtro casou zero teste)\" if empty else \"\"\n            print(f\"    {repo}: {ok} verdes, {fail} vermelhos{vaz} (taxa de falha {rate})\")\n    else:\n        print(\"    (nenhum)\")\n\n    print(\"\\n## Gate-advance — bloqueios (repo · tier · motivo)\")\n    print(fmt_counter(Counter({f\"{r} · {t} · {m}\": v for (r, t, m), v in gate_blocks.items()})))\n    print(\"\\n## Gate-advance — avisos sem bloqueio\")\n    print(fmt_counter(Counter({f\"{r} · {t} · {m}\": v for (r, t, m), v in gate_warns.items()})))\n\n    if antes:\n        ma, md = mediana(antes), mediana(depois)\n        print(f\"\\n## Atrito das pontas ({len(antes)} sessão(ões) com rotina)\")\n        print(f\"    turnos ANTES da 1ª rotina:  mediana {ma}  (todas: {sorted(antes)})\")\n        print(f\"    turnos DEPOIS da última:    mediana {md}  (todas: {sorted(depois)})\")\n        print(\"    memória de cálculo: por sessão, conta-se cada prompt do usuário;\")\n        print(\"      ANTES = quantos vieram antes do primeiro comando de rotina\")\n        print(\"      (drain, prove-drain, triage, execute, autonomous, session, ...);\")\n        print(\"      DEPOIS = quantos vieram após o último, até o /wrap-up ou /handoff\")\n        print(\"      (o próprio fechamento não conta). Mediana = valor do meio da lista.\")\n        print(\"    Zero nos dois é o alvo: abrir, rodar, receber o relatório, encerrar.\")\n\n    print(\"\\n## Proof gate — vereditos escritos (repo · veredito)\")\n    print(fmt_counter(Counter({f\"{r} · {v}\": n for (r, v), n in proof_verdicts.items()})))\n    if proof_blocks:\n        print(\"\\n## Proof gate — `proven` sobre-declarado barrado pelo guard ⚠\")\n        print(fmt_counter(proof_blocks))\n\n    if relatorios:\n        pct = 100.0 * relatorios_fora / relatorios\n        pct_p = 100.0 * relatorios_persistiram / relatorios\n        print(f\"\\n## Formato de relatório — {relatorios_persistiram}/{relatorios} \"\n              f\"chegaram ao usuário fora do padrão ({pct_p:.0f}%)\")\n        print(f\"    primeira escrita fora do padrão: {relatorios_fora} \"\n              f\"({pct:.0f}%) · bloqueadas e reescritas pelo report-style-lint: \"\n              f\"{relatorios_bloqueados} · persistiram após a reescrita: \"\n              f\"{relatorios_persistiram}\")\n        print(f\"    memória de cálculo: {relatorios_persistiram} medições com \"\n              f\"desvio E marcadas `reincidente` (a parada já vinha de um \"\n              f\"bloqueio do hook) ÷ {relatorios} medidas × 100 = {pct_p:.0f}%; \"\n              f\"a primeira escrita é {relatorios_fora} com desvio ÷ \"\n              f\"{relatorios} × 100 = {pct:.0f}%\")\n        if desvios_persistiram_tipo:\n            print(\"    desvios que persistiram após a reescrita:\")\n            print(fmt_counter(desvios_persistiram_tipo))\n        if desvios_tipo:\n            print(\"    desvios na primeira escrita (o bloqueio devolve estes):\")\n            print(fmt_counter(desvios_tipo))\n\n    # ── Relógio: espera ativa e onde foi o tempo ───────────────────────\n    espera_blocks = Counter(\n        e.get(\"reason\", \"?\") for e in events if e.get(\"event\") == \"busy_wait_block\")\n    if espera_blocks:\n        print(\"\\n## Espera ativa barrada pelo no-busy-wait (por padrão)\")\n        print(fmt_counter(espera_blocks))\n        print(\"    cada bloqueio é um `until/sleep` ou laço de queima que não rodou —\\n\"\n              \"    a medição de 2026-08-26 pôs esses comandos entre 19% e 52% do relógio.\")\n\n    clocks = [e for e in events if e.get(\"event\") == \"clock_breakdown\"]\n    if clocks:\n        def _s(e, k):\n            try:\n                return float(e.get(k) or 0)\n            except (TypeError, ValueError):\n                return 0.0\n        tw = sum(_s(e, \"relogio_s\") for e in clocks)\n        te = sum(_s(e, \"espera_s\") for e in clocks)\n        tb = sum(_s(e, \"build_s\") for e in clocks)\n        print(f\"\\n## Relógio medido — {len(clocks)} sessão(ões) via cepa-clock\")\n        print(f\"    relógio total : {tw/3600:.1f} h\")\n        if tw:\n            print(f\"    espera ativa  : {te/60:.0f} min ({te/tw*100:.0f}%)\")\n            print(f\"    build         : {tb/60:.0f} min ({tb/tw*100:.0f}%)\")\n            print(f\"    memória de cálculo: soma de espera_s ÷ soma de relogio_s × 100\")\n\n    if ultimo_tokens:\n        base = tok_total[\"novo\"] or 1\n        print(f\"\\n## Tokens — {len(ultimo_tokens)} sessão(ões) medidas\")\n        print(f\"    contexto novo {tok_total['novo']:,} · cache lido {tok_total['cache_r']:,} \"\n              f\"· saída {tok_total['saida']:,}\")\n        # Worktree já removida não resolve para o repo principal e aparece com o\n        # nome do próprio diretório; por isso só os 10 maiores.\n        print(f\"    contexto novo por repo (10 maiores de {len(tok_repo)}):\")\n        for repo, v in tok_repo.most_common(10):\n            print(f\"      {repo:40}{v:>13,}  {v/base*100:5.1f}%\")\n        print(\"    contexto novo por agente (tokens · % do total):\")\n        for tipo, u in sorted(tok_agente.items(), key=lambda kv: -kv[1][\"novo\"])[:10]:\n            n = f\" ×{u['n']}\" if u[\"n\"] else \"\"\n            print(f\"      {tipo + n:40}{u['novo']:>13,}  {u['novo']/base*100:5.1f}%\")\n        if tok_chars:\n            tc = sum(tok_chars.values()) or 1\n            print(\"    o que entrou por resultado de ferramenta (caracteres · %):\")\n            for nome, c in tok_chars.most_common(8):\n                print(f\"      {nome:40}{c:>13,}  {c/tc*100:5.1f}%\")\n        print(\"    memória de cálculo: contexto novo = input_tokens + cache_creation_input_tokens\")\n        print(\"      do transcript, uma vez por resposta do modelo; % = linha ÷ total × 100.\")\n        print(\"      Resultado de ferramenta é medido em caracteres (o transcript não dá tokens\")\n        print(\"      por resultado). Sessão gravada duas vezes conta só o último evento.\")\n\n    if custom:\n        print(\"\\n## Eventos custom (emitidos por comandos/skills)\")\n        print(fmt_counter(custom))\n\n    # ── Leituras sugeridas ─────────────────────────────────────────────\n    hints = []\n    if relatorios >= 20 and relatorios_persistiram / relatorios > 0.05:\n        hints.append(f\"- formato de relatório: {relatorios_persistiram} de \"\n                     f\"{relatorios} chegaram ao usuário fora do padrão \"\n                     f\"({100.0*relatorios_persistiram/relatorios:.0f}%) mesmo \"\n                     f\"após o bloqueio e a reescrita — o motivo do bloqueio não \"\n                     f\"está sendo entendido; veja os tipos que persistem.\")\n    elif relatorios >= 20 and relatorios_fora / relatorios > 0.3:\n        hints.append(f\"- formato de relatório: a primeira escrita sai fora do \"\n                     f\"padrão em {100.0*relatorios_fora/relatorios:.0f}% \"\n                     f\"({relatorios_fora} de {relatorios}), mas o report-style-lint \"\n                     f\"bloqueia e a reescrita corrige — só \"\n                     f\"{relatorios_persistiram} chegaram ao usuário. Custo é o \"\n                     f\"turno extra de reescrita, não relatório ruim.\")\n    for (repo, tier, reason), n in gate_blocks.items():\n        if reason in (\"stale\", \"failure\") and n >= 5:\n            hints.append(f\"- {repo}: {n} bloqueios por build {reason.upper()} — loop de verify lento ou baseline com escopo errado.\")\n        if reason == \"no-baseline\" and n >= 3:\n            hints.append(f\"- {repo}: {n} bloqueios sem baseline — sessões tentam compartilhar antes de rodar verify.\")\n    for (repo, tier, reason), n in gate_warns.items():\n        if reason == \"no-build-manifest\" and n >= 3:\n            hints.append(f\"- {repo}: {n} avisos de repo sem build — commite `.claude/no-build` e silencie.\")\n    if espera_blocks and sum(espera_blocks.values()) >= 5:\n        hints.append(f\"- espera ativa: {sum(espera_blocks.values())} bloqueios — o hook \"\n                     f\"está segurando o vazamento, mas o agente segue tentando esperar; \"\n                     f\"vale ver se algum lead ainda delega e sonda em vez de aguardar o retorno.\")\n    for repo, n in proof_blocks.items():\n        hints.append(f\"- {repo}: {n} artefato(s) `proven` contraditório(s) barrados — prompt drift no proof-reviewer; vale investigar.\")\n    if hints:\n        print(\"\\n## Leituras sugeridas\")\n        print(\"\\n\".join(hints))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\ntests/test_cepa_tokens.py\ntests/test_atrito_pontas.py\ntests/eval/README.md\n(eval):1: no matches found: --include=*.md","is_error":false}]},"parent_tool_use_id":null,"session_id":"40316cca-4ba3-404b-8c97-48b430534268","uuid":"dcd3d0e3-b4bd-4d4e-a4a1-782d502df021","timestamp":"2026-10-09T00:27:52.438Z","tool_use_result":{"stdout":"#!/usr/bin/env python3\n\"\"\"cepa-metrics — aggregate the harness's own telemetry into a readable report.\n\nReads the JSONL ledgers written by _telemetry.py (and inline emitters) at\n~/.claude/cepa-telemetry/events-YYYY-MM.jsonl and answers the questions the\nharness could not answer about itself: how often gates fire (and where), how\nbuilds trend per repo, which proof verdicts dominate, how many sessions each\nproject consumes.\n\nUsage:\n  cepa-metrics                  # last 30 days\n  cepa-metrics --days 7         # last N days\n  cepa-metrics --month 2026-07  # a specific month\n  cepa-metrics --repo wego-acesso-backend   # filter to one repo\n  cepa-metrics --json           # machine-readable dump of the aggregates\n\nReading the numbers:\n  - gate_block reason=stale/failure with HIGH counts on one repo → the verify\n    loop is too slow there or the baseline scope is wrong.\n  - gate_block reason=no-baseline on a repo that HAS a build → sessions are\n    pushing before ever running verify.\n  - gate_warn reason=no-build-manifest recurring on the same repo → commit the\n    .claude/no-build marker and silence it.\n  - proof_block > 0 → an agent stamped `proven` over a forbidding level; the\n    guard caught it. Recurring == prompt drift in proof-reviewer.\n  - builds failure-rate per repo → where the red-green loop burns the most.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nTELEMETRY_DIR = Path(os.environ.get(\"CEPA_TELEMETRY_DIR\") or (Path.home() / \".claude\" / \"cepa-telemetry\"))\n\n\ndef load_events(since: datetime, until: datetime):\n    events = []\n    if not TELEMETRY_DIR.is_dir():\n        return events\n    for f in sorted(TELEMETRY_DIR.glob(\"events-*.jsonl\")):\n        for line in f.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                e = json.loads(line)\n                ts = datetime.fromisoformat(str(e.get(\"ts\", \"\")).replace(\"Z\", \"+00:00\"))\n            except (json.JSONDecodeError, ValueError):\n                continue\n            if ts.tzinfo is None:\n                ts = ts.replace(tzinfo=timezone.utc)\n            if since <= ts <= until:\n                e[\"_ts\"] = ts\n                events.append(e)\n    return events\n\n\ndef fmt_counter(c: Counter, indent=\"    \", top=None) -> str:\n    items = c.most_common(top)\n    if not items:\n        return f\"{indent}(nenhum)\"\n    width = max(len(str(k)) for k, _ in items)\n    return \"\\n\".join(f\"{indent}{str(k):<{width}}  {v}\" for k, v in items)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Aggregate cepa harness telemetry.\")\n    ap.add_argument(\"--days\", type=int, default=30)\n    ap.add_argument(\"--month\", help=\"YYYY-MM (overrides --days)\")\n    ap.add_argument(\"--repo\", help=\"filter to one repo name\")\n    ap.add_argument(\"--json\", action=\"store_true\", dest=\"as_json\")\n    args = ap.parse_args()\n\n    now = datetime.now(timezone.utc)\n    if args.month:\n        try:\n            start = datetime.strptime(args.month, \"%Y-%m\").replace(tzinfo=timezone.utc)\n        except ValueError:\n            print(f\"--month inválido: {args.month} (use YYYY-MM)\", file=sys.stderr)\n            return 1\n        end = (start.replace(day=28) + timedelta(days=4)).replace(day=1) - timedelta(seconds=1)\n    else:\n        start, end = now - timedelta(days=args.days), now\n\n    events = load_events(start, end)\n    if args.repo:\n        events = [e for e in events if e.get(\"repo\") == args.repo]\n\n    # carimbo que o nudge semanal do session-registry consulta\n    try:\n        TELEMETRY_DIR.mkdir(parents=True, exist_ok=True)\n        (TELEMETRY_DIR / \"last-metrics-review\").write_text(\n            datetime.now(timezone.utc).isoformat(timespec=\"seconds\") + \"\\n\")\n    except OSError:\n        pass\n\n    if not events:\n        print(f\"Nenhum evento entre {start.date()} e {end.date()} em {TELEMETRY_DIR}.\")\n        print(\"A telemetria começa a acumular a partir da instalação desta versão — \"\n              \"rode de novo depois de algumas sessões.\")\n        return 0\n\n    # ── Aggregate ──────────────────────────────────────────────────────\n    by_event = Counter(e.get(\"event\", \"?\") for e in events)\n    sessions = Counter(e.get(\"repo\") or \"?\" for e in events if e.get(\"event\") == \"session_start\")\n\n    builds = defaultdict(Counter)   # repo -> {SUCCESS: n, FAILURE: n}\n    for e in events:\n        if e.get(\"event\") == \"build_result\":\n            builds[e.get(\"repo\") or \"?\"][e.get(\"status\", \"?\")] += 1\n\n    gate_blocks = Counter()         # (repo, tier, reason)\n    gate_warns = Counter()\n    for e in events:\n        key = (e.get(\"repo\") or \"?\", e.get(\"tier\", \"?\"), e.get(\"reason\", \"?\"))\n        if e.get(\"event\") == \"gate_block\":\n            gate_blocks[key] += 1\n        elif e.get(\"event\") == \"gate_warn\":\n            gate_warns[key] += 1\n\n    proof_verdicts = Counter()      # (repo, verdict)\n    proof_blocks = Counter()        # repo\n    for e in events:\n        if e.get(\"event\") == \"proof_verdict\":\n            proof_verdicts[(e.get(\"repo\") or \"?\", e.get(\"verdict\", \"?\"))] += 1\n        elif e.get(\"event\") == \"proof_block\":\n            proof_blocks[e.get(\"repo\") or \"?\"] += 1\n\n    # Formato de relatório. Desde 25/08/2026 o report-style-lint BLOQUEIA a\n    # parada quando o relatório sai do formato, e o turno reescreve. Por isso\n    # uma medição fora do formato não é um relatório ruim que o usuário leu:\n    # pode ser a primeira escrita, que o bloqueio devolveu. O número que\n    # importa é quantos desvios PERSISTIRAM após a reescrita (evento com\n    # `reincidente`), porque só esses chegam ao usuário. Correção de\n    # 06/10/2026: até aqui o agregador somava os dois e sugeria \"passar para\n    # bloqueio\" de um hook que já bloqueava.\n    relatorios = 0\n    relatorios_fora = 0\n    relatorios_bloqueados = 0\n    relatorios_persistiram = 0\n    desvios_tipo = Counter()\n    desvios_persistiram_tipo = Counter()\n    for e in events:\n        if e.get(\"event\") != \"report_style\":\n            continue\n        relatorios += 1\n        fora = (e.get(\"desvios\") or 0) > 0\n        if fora:\n            relatorios_fora += 1\n        if e.get(\"bloqueou\"):\n            relatorios_bloqueados += 1\n        if fora and e.get(\"reincidente\"):\n            relatorios_persistiram += 1\n            for t in (e.get(\"tipos\") or []):\n                desvios_persistiram_tipo[t] += 1\n        for t in (e.get(\"tipos\") or []):\n            desvios_tipo[t] += 1\n\n    # Atrito das pontas: quantos turnos o usuário gasta ANTES de conseguir\n    # disparar a rotina pela qual a sessão existe, e quantos gasta DEPOIS dela\n    # até encerrar. Os dois números existem porque a queixa (\"gasto 15-20% do\n    # contexto só em preparação\") era anedótica e precisava virar evidência.\n    prompts_por_sessao = defaultdict(list)\n    for e in events:\n        if e.get(\"event\") == \"prompt\" and e.get(\"session\"):\n            prompts_por_sessao[e[\"session\"]].append(e)\n\n    antes, depois = [], []\n    for _sid, evs in prompts_por_sessao.items():\n        evs.sort(key=lambda x: x.get(\"ts\", \"\"))\n        idx = [i for i, x in enumerate(evs) if x.get(\"kind\") == \"rotina\"]\n        if not idx:\n            continue  # sessão sem rotina não mede atrito de rotina\n        antes.append(idx[0])                  # turnos digitados antes da 1ª rotina\n        cauda = evs[idx[-1] + 1:]             # o que veio depois da última\n        # o próprio wrap-up/handoff é o encerramento, não atrito: conta o que\n        # veio ANTES dele.\n        fim = next((i for i, x in enumerate(cauda) if x.get(\"kind\") == \"fechamento\"),\n                   len(cauda))\n        depois.append(fim)\n\n    def mediana(xs):\n        if not xs:\n            return None\n        s = sorted(xs)\n        m = len(s) // 2\n        return s[m] if len(s) % 2 else (s[m - 1] + s[m]) / 2\n\n    # Tokens: um evento token_usage por sessão, gravado pelo cepa-tokens no fim\n    # dela. A mesma sessão pode ter sido gravada duas vezes (fim automático +\n    # varredura manual); vale o último evento de cada sessão.\n    ultimo_tokens = {}\n    for e in sorted((e for e in events if e.get(\"event\") == \"token_usage\"),\n                    key=lambda x: x.get(\"ts\", \"\")):\n        ultimo_tokens[e.get(\"sessao\") or id(e)] = e\n    tok_total = Counter()\n    tok_agente = defaultdict(Counter)\n    tok_chars = Counter()\n    tok_repo = Counter()\n    for e in ultimo_tokens.values():\n        novo = (e.get(\"entrada\") or 0) + (e.get(\"cache_w\") or 0)\n        tok_total[\"novo\"] += novo\n        tok_total[\"cache_r\"] += e.get(\"cache_r\") or 0\n        tok_total[\"saida\"] += e.get(\"saida\") or 0\n        tok_repo[e.get(\"repo\") or \"?\"] += novo\n        for tipo, u in (e.get(\"por_agente\") or {}).items():\n            tok_agente[tipo][\"novo\"] += (u.get(\"entrada\") or 0) + (u.get(\"cache_w\") or 0)\n            tok_agente[tipo][\"n\"] += u.get(\"n\") or 0\n        for nome, c in (e.get(\"resultado_chars\") or {}).items():\n            tok_chars[nome] += c or 0\n\n    known = {\"session_start\", \"session_end\", \"build_result\", \"gate_block\", \"gate_warn\",\n             \"proof_verdict\", \"proof_block\", \"report_style\", \"prompt\", \"token_usage\"}\n    custom = Counter(e.get(\"event\") for e in events if e.get(\"event\") not in known)\n\n    if args.as_json:\n        print(json.dumps({\n            \"period\": [start.isoformat(), end.isoformat()],\n            \"total_events\": len(events),\n            \"by_event\": dict(by_event),\n            \"sessions_per_repo\": dict(sessions),\n            \"builds\": {r: dict(c) for r, c in builds.items()},\n            \"gate_blocks\": {\" \".join(k): v for k, v in gate_blocks.items()},\n            \"gate_warns\": {\" \".join(k): v for k, v in gate_warns.items()},\n            \"proof_verdicts\": {\" \".join(k): v for k, v in proof_verdicts.items()},\n            \"proof_blocks\": dict(proof_blocks),\n            \"report_style\": {\"medidos\": relatorios, \"fora\": relatorios_fora,\n                             \"bloqueados\": relatorios_bloqueados,\n                             \"persistiram\": relatorios_persistiram,\n                             \"desvios_por_tipo\": dict(desvios_tipo),\n                             \"desvios_persistiram_por_tipo\":\n                                 dict(desvios_persistiram_tipo)},\n            \"atrito\": {\"sessoes_medidas\": len(antes),\n                       \"turnos_antes_da_rotina\": antes,\n                       \"turnos_depois_da_rotina\": depois,\n                       \"mediana_antes\": mediana(antes),\n                       \"mediana_depois\": mediana(depois)},\n            \"tokens\": {\"sessoes_medidas\": len(ultimo_tokens),\n                       \"total\": dict(tok_total),\n                       \"contexto_novo_por_repo\": dict(tok_repo),\n                       \"por_agente\": {k: dict(v) for k, v in tok_agente.items()},\n                       \"resultado_chars\": dict(tok_chars)},\n            \"custom_events\": dict(custom),\n        }, indent=2, ensure_ascii=False, default=str))\n        return 0\n\n    # ── Report ─────────────────────────────────────────────────────────\n    print(f\"# Telemetria do harness — {start.date()} a {end.date()}\")\n    print(f\"{len(events)} eventos · ledger: {TELEMETRY_DIR}\\n\")\n\n    print(f\"## Sessões por repo ({sum(sessions.values())} no período)\")\n    print(fmt_counter(sessions))\n\n    print(\"\\n## Builds por repo (verde / vermelho)\")\n    if builds:\n        for repo in sorted(builds, key=lambda r: -sum(builds[r].values())):\n            c = builds[repo]\n            ok, fail = c.get(\"SUCCESS\", 0), c.get(\"FAILURE\", 0)\n            total = sum(c.values())\n            rate = f\"{100 * fail / total:.0f}%\" if total else \"-\"\n            # EMPTY: rodada com filtro de teste que executou zero teste (não é verde).\n            empty = c.get(\"EMPTY\", 0)\n            vaz = f\", {empty} vazios (filtro casou zero teste)\" if empty else \"\"\n            print(f\"    {repo}: {ok} verdes, {fail} vermelhos{vaz} (taxa de falha {rate})\")\n    else:\n        print(\"    (nenhum)\")\n\n    print(\"\\n## Gate-advance — bloqueios (repo · tier · motivo)\")\n    print(fmt_counter(Counter({f\"{r} · {t} · {m}\": v for (r, t, m), v in gate_blocks.items()})))\n    print(\"\\n## Gate-advance — avisos sem bloqueio\")\n    print(fmt_counter(Counter({f\"{r} · {t} · {m}\": v for (r, t, m), v in gate_warns.items()})))\n\n    if antes:\n        ma, md = mediana(antes), mediana(depois)\n        print(f\"\\n## Atrito das pontas ({len(antes)} sessão(ões) com rotina)\")\n        print(f\"    turnos ANTES da 1ª rotina:  mediana {ma}  (todas: {sorted(antes)})\")\n        print(f\"    turnos DEPOIS da última:    mediana {md}  (todas: {sorted(depois)})\")\n        print(\"    memória de cálculo: por sessão, conta-se cada prompt do usuário;\")\n        print(\"      ANTES = quantos vieram antes do primeiro comando de rotina\")\n        print(\"      (drain, prove-drain, triage, execute, autonomous, session, ...);\")\n        print(\"      DEPOIS = quantos vieram após o último, até o /wrap-up ou /handoff\")\n        print(\"      (o próprio fechamento não conta). Mediana = valor do meio da lista.\")\n        print(\"    Zero nos dois é o alvo: abrir, rodar, receber o relatório, encerrar.\")\n\n    print(\"\\n## Proof gate — vereditos escritos (repo · veredito)\")\n    print(fmt_counter(Counter({f\"{r} · {v}\": n for (r, v), n in proof_verdicts.items()})))\n    if proof_blocks:\n        print(\"\\n## Proof gate — `proven` sobre-declarado barrado pelo guard ⚠\")\n        print(fmt_counter(proof_blocks))\n\n    if relatorios:\n        pct = 100.0 * relatorios_fora / relatorios\n        pct_p = 100.0 * relatorios_persistiram / relatorios\n        print(f\"\\n## Formato de relatório — {relatorios_persistiram}/{relatorios} \"\n              f\"chegaram ao usuário fora do padrão ({pct_p:.0f}%)\")\n        print(f\"    primeira escrita fora do padrão: {relatorios_fora} \"\n              f\"({pct:.0f}%) · bloqueadas e reescritas pelo report-style-lint: \"\n              f\"{relatorios_bloqueados} · persistiram após a reescrita: \"\n              f\"{relatorios_persistiram}\")\n        print(f\"    memória de cálculo: {relatorios_persistiram} medições com \"\n              f\"desvio E marcadas `reincidente` (a parada já vinha de um \"\n              f\"bloqueio do hook) ÷ {relatorios} medidas × 100 = {pct_p:.0f}%; \"\n              f\"a primeira escrita é {relatorios_fora} com desvio ÷ \"\n              f\"{relatorios} × 100 = {pct:.0f}%\")\n        if desvios_persistiram_tipo:\n            print(\"    desvios que persistiram após a reescrita:\")\n            print(fmt_counter(desvios_persistiram_tipo))\n        if desvios_tipo:\n            print(\"    desvios na primeira escrita (o bloqueio devolve estes):\")\n            print(fmt_counter(desvios_tipo))\n\n    # ── Relógio: espera ativa e onde foi o tempo ───────────────────────\n    espera_blocks = Counter(\n        e.get(\"reason\", \"?\") for e in events if e.get(\"event\") == \"busy_wait_block\")\n    if espera_blocks:\n        print(\"\\n## Espera ativa barrada pelo no-busy-wait (por padrão)\")\n        print(fmt_counter(espera_blocks))\n        print(\"    cada bloqueio é um `until/sleep` ou laço de queima que não rodou —\\n\"\n              \"    a medição de 2026-08-26 pôs esses comandos entre 19% e 52% do relógio.\")\n\n    clocks = [e for e in events if e.get(\"event\") == \"clock_breakdown\"]\n    if clocks:\n        def _s(e, k):\n            try:\n                return float(e.get(k) or 0)\n            except (TypeError, ValueError):\n                return 0.0\n        tw = sum(_s(e, \"relogio_s\") for e in clocks)\n        te = sum(_s(e, \"espera_s\") for e in clocks)\n        tb = sum(_s(e, \"build_s\") for e in clocks)\n        print(f\"\\n## Relógio medido — {len(clocks)} sessão(ões) via cepa-clock\")\n        print(f\"    relógio total : {tw/3600:.1f} h\")\n        if tw:\n            print(f\"    espera ativa  : {te/60:.0f} min ({te/tw*100:.0f}%)\")\n            print(f\"    build         : {tb/60:.0f} min ({tb/tw*100:.0f}%)\")\n            print(f\"    memória de cálculo: soma de espera_s ÷ soma de relogio_s × 100\")\n\n    if ultimo_tokens:\n        base = tok_total[\"novo\"] or 1\n        print(f\"\\n## Tokens — {len(ultimo_tokens)} sessão(ões) medidas\")\n        print(f\"    contexto novo {tok_total['novo']:,} · cache lido {tok_total['cache_r']:,} \"\n              f\"· saída {tok_total['saida']:,}\")\n        # Worktree já removida não resolve para o repo principal e aparece com o\n        # nome do próprio diretório; por isso só os 10 maiores.\n        print(f\"    contexto novo por repo (10 maiores de {len(tok_repo)}):\")\n        for repo, v in tok_repo.most_common(10):\n            print(f\"      {repo:40}{v:>13,}  {v/base*100:5.1f}%\")\n        print(\"    contexto novo por agente (tokens · % do total):\")\n        for tipo, u in sorted(tok_agente.items(), key=lambda kv: -kv[1][\"novo\"])[:10]:\n            n = f\" ×{u['n']}\" if u[\"n\"] else \"\"\n            print(f\"      {tipo + n:40}{u['novo']:>13,}  {u['novo']/base*100:5.1f}%\")\n        if tok_chars:\n            tc = sum(tok_chars.values()) or 1\n            print(\"    o que entrou por resultado de ferramenta (caracteres · %):\")\n            for nome, c in tok_chars.most_common(8):\n                print(f\"      {nome:40}{c:>13,}  {c/tc*100:5.1f}%\")\n        print(\"    memória de cálculo: contexto novo = input_tokens + cache_creation_input_tokens\")\n        print(\"      do transcript, uma vez por resposta do modelo; % = linha ÷ total × 100.\")\n        print(\"      Resultado de ferramenta é medido em caracteres (o transcript não dá tokens\")\n        print(\"      por resultado). Sessão gravada duas vezes conta só o último evento.\")\n\n    if custom:\n        print(\"\\n## Eventos custom (emitidos por comandos/skills)\")\n        print(fmt_counter(custom))\n\n    # ── Leituras sugeridas ─────────────────────────────────────────────\n    hints = []\n    if relatorios >= 20 and relatorios_persistiram / relatorios > 0.05:\n        hints.append(f\"- formato de relatório: {relatorios_persistiram} de \"\n                     f\"{relatorios} chegaram ao usuário fora do padrão \"\n                     f\"({100.0*relatorios_persistiram/relatorios:.0f}%) mesmo \"\n                     f\"após o bloqueio e a reescrita — o motivo do bloqueio não \"\n                     f\"está sendo entendido; veja os tipos que persistem.\")\n    elif relatorios >= 20 and relatorios_fora / relatorios > 0.3:\n        hints.append(f\"- formato de relatório: a primeira escrita sai fora do \"\n                     f\"padrão em {100.0*relatorios_fora/relatorios:.0f}% \"\n                     f\"({relatorios_fora} de {relatorios}), mas o report-style-lint \"\n                     f\"bloqueia e a reescrita corrige — só \"\n                     f\"{relatorios_persistiram} chegaram ao usuário. Custo é o \"\n                     f\"turno extra de reescrita, não relatório ruim.\")\n    for (repo, tier, reason), n in gate_blocks.items():\n        if reason in (\"stale\", \"failure\") and n >= 5:\n            hints.append(f\"- {repo}: {n} bloqueios por build {reason.upper()} — loop de verify lento ou baseline com escopo errado.\")\n        if reason == \"no-baseline\" and n >= 3:\n            hints.append(f\"- {repo}: {n} bloqueios sem baseline — sessões tentam compartilhar antes de rodar verify.\")\n    for (repo, tier, reason), n in gate_warns.items():\n        if reason == \"no-build-manifest\" and n >= 3:\n            hints.append(f\"- {repo}: {n} avisos de repo sem build — commite `.claude/no-build` e silencie.\")\n    if espera_blocks and sum(espera_blocks.values()) >= 5:\n        hints.append(f\"- espera ativa: {sum(espera_blocks.values())} bloqueios — o hook \"\n                     f\"está segurando o vazamento, mas o agente segue tentando esperar; \"\n                     f\"vale ver se algum lead ainda delega e sonda em vez de aguardar o retorno.\")\n    for repo, n in proof_blocks.items():\n        hints.append(f\"- {repo}: {n} artefato(s) `proven` contraditório(s) barrados — prompt drift no proof-reviewer; vale investigar.\")\n    if hints:\n        print(\"\\n## Leituras sugeridas\")\n        print(\"\\n\".join(hints))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\ntests/test_cepa_tokens.py\ntests/test_atrito_pontas.py\ntests/eval/README.md\n(eval):1: no matches found: --include=*.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01L6xB3xeT49U2SdCiU26ceG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
