{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0162degwm4PoUgKxuyCjmDK1","type":"tool_result","content":"def cmd_status(raiz, nome, filtro, como_json):\n    if not nome:\n        nomes = filas_single_track(raiz)\n        if not nomes:\n            print(f\"nenhuma fila em {raiz / '.claude' / 'programs'} — quem \"\n                  \"escreve é o /common:plan\", file=sys.stderr)\n            return 2\n        if len(nomes) > 1:\n            print(\"há mais de uma fila; diga qual: \" + \", \".join(nomes),\n                  file=sys.stderr)\n            return 2\n        nome = nomes[0]\n    alvo = caminho_do_plano(raiz, nome)\n    if not alvo.is_file():\n        print(f\"{alvo} não existe — quem escreve a fila é o /common:plan\",\n              file=sys.stderr)\n        return 2\n    plan, erro = le_plano(alvo)\n    if erro:\n        print(erro, file=sys.stderr)\n        return 2\n    if modo_de(plan) != MODE:\n        print(f\"COLISÃO: {alvo} é um plano '{modo_de(plan)}' — ondas do \"\n              \"/maestro:program-plan, não uma fila\", file=sys.stderr)\n        return 3\n\n    items = plan.get(\"items\") or []\n    linhas = []\n    for pos, it in enumerate(items, 1):\n        dono = it.get(\"claimed_by\") or {}\n        linhas.append({\n            \"posicao\": pos, \"id\": it.get(\"id\"), \"title\": it.get(\"title\"),\n            \"status\": status_de(it), \"why\": it.get(\"why\"),\n            \"blocked_by\": it.get(\"blocked_by\") or [],\n            \"human_pending\": it.get(\"human_pending\"),\n            \"evidence\": it.get(\"evidence\"),\n            \"claimed_by\": ({\"session_id\": dono.get(\"session_id\"),\n                            \"branch\": dono.get(\"branch\"),\n                            \"started_at\": dono.get(\"started_at\")}\n                           if dono else None),\n        })\n    contagem = {st: sum(1 for l in linhas if l[\"status\"] == st)\n                for st in STATUSES}\n    visiveis = [l for l in linhas if not filtro or l[\"status\"] == filtro]\n\n    if como_json:\n        print(json.dumps({\"program\": plan.get(\"program\") or nome,\n                          \"path\": str(alvo), \"total\": len(linhas),\n                          \"por_status\": contagem, \"filtro\": filtro,\n                          \"items\": visiveis}, ensure_ascii=False, indent=2))\n        return 0\n\n    print(f\"fila {plan.get('program') or nome} · {alvo}\")\n    print(\"  \" + \" · \".join(f\"{contagem[st]} {rot}\" for st, rot in GRUPOS_STATUS)\n          + f\" · {len(linhas)} no total\")\n    abertas = [l for l in linhas if l[\"human_pending\"] is not None]\n    if abertas:\n        print(f\"  {len(abertas)} com ação humana aberta: \"\n              + \", \".join(l[\"id\"] for l in abertas))\n    for st, rot in GRUPOS_STATUS:\n        grupo = [l for l in visiveis if l[\"status\"] == st]\n        if not grupo:\n            continue\n        print(f\"\\n{rot} ({len(grupo)})\")\n        for l in grupo:\n            print(f\"  {l['posicao']:>3}. {l['id']} — {l['title']}\")\n            if st in (\"done\", \"dropped\"):\n                continue\n            if l[\"claimed_by\"]:\n                c = l[\"claimed_by\"]\n                print(f\"       reservado: sessão {c['session_id'] or '?'}\"\n                      f\" desde {c['started_at'] or '?'}\")\n            if l[\"blocked_by\"]:\n                print(f\"       espera: {', '.join(map(str, l['blocked_by']))}\")\n            if l[\"human_pending\"] is not None:\n                print(f\"       ação humana: {primeira_frase(l['human_pending'])}\")\n            if st == \"blocked\" and l[\"evidence\"]:\n                print(f\"       motivo: {primeira_frase(l['evidence'])}\")\n    return 0\n\n\n# ── promoção: as demandas que a fila entrega ao /maestro:program-plan ────────\n\n# Piso D7 do Maestro (common/plan-schema.yaml, \"Piso de uso\"): abaixo de 4\n# demandas o custo de forkar worktree, subir porteiro e aterrissar merge train\n# perde para executar a mesma fila em série. O piso é checado AQUI, e não na\n# prosa do comando, porque prosa de comando erode sem nenhum teste ficar\n# vermelho — a lição que o auditor de completude deixou nas etapas 1 e 2.\nPISO_DEMANDAS = 4\n\n    linhas = []\n    for linha in texto.splitlines(keepends=True):\n        if linha.startswith(\"#\") or not linha.strip():\n            linhas.append(linha)\n        else:\n            break\n    return \"\".join(linhas)\n\n\ndef grava_corpo(alvo, plan, itens):\n    corpo = dict(plan)\n    corpo[\"items\"] = itens\n    dump = yaml.dump(corpo, allow_unicode=True, sort_keys=False,\n                     default_flow_style=False, width=78)\n    texto = cabecalho_do_arquivo(alvo.read_text(encoding=\"utf-8\"))\n    if texto and not texto.endswith(\"\\n\\n\"):\n        texto += \"\\n\"\n    tmp = alvo.with_suffix(\".yaml.tmp\")\n    tmp.write_text(texto + dump, encoding=\"utf-8\")\n    tmp.replace(alvo)\n\n\ndef abre_plano_para_marcar(raiz, nome):\n    \"\"\"(alvo, plan, item_por_id, erro_exit) — a leitura comum de start/finish.\"\"\"\n    alvo = caminho_do_plano(raiz, nome)\n    if not alvo.is_file():\n        print(f\"{alvo} não existe — não há fila para marcar\", file=sys.stderr)\n        return None, None, None, 2\n    plan, erro = le_plano(alvo)\n    if erro:\n        print(erro, file=sys.stderr)\n        return None, None, None, 2\n    if modo_de(plan) != MODE:\n        print(f\"{alvo} é um plano '{modo_de(plan)}', não uma fila\", file=sys.stderr)\n        return None, None, None, 3\n    return alvo, plan, {str(i.get(\"id\")): i for i in (plan.get(\"items\") or [])\n            # Triagem PARCIAL: o repasse cobre um pedaço da coluna, então a\n            # ordem que ele propõe vale entre os cards que ele leu, não contra\n            # a fila que o dono já priorizou. Achado em quadro real\n            # (2026-09-25): 3 cards novos entravam na frente dos 5 pendentes\n            # priorizados, e esses iam para o fim. A