#!/usr/bin/env python3
"""cepa-plan (board-flow) — shortcut that finds the real `cepa-plan`, from common.

It exists because `common/bin/cepa-plan` is a RELATIVE path, and board-flow is
a plugin installed inside another repo (e.g. WEGO) that never had — and does
not need — a `common/` directory at its root. `/board-flow:capture`, `/drain`
and `/triage` called `python3 common/bin/cepa-plan ...` directly: inside the
cepa repo itself the path exists by accident of layout, but in any other
project the file is simply not there, the command fails silently (or does not
even run) and the card is born outside the queue with no warning — the bug
this shim closes.

This same file serves as a shortcut for other common binaries: the target is
the file's OWN name (`TARGET`), so `board-flow/bin/cepa-autonomy` is a
byte-for-byte copy of this one (tests/test_autonomy_yaml.py pins the equality).

This file reimplements nothing of cepa-plan: it finds the real script in
`common` (repo or plugin cache) and `exec`s into it, passing on the whole
argv and preserving the exit code — whoever reads the output does not notice
it went through here.

Layouts considered, in order (same pattern as
`maestro/bin/maestro-gatekeeper::_carregar_shellscan`, which resolves
`common` from inside `maestro` the same way):

  Repo:   <repo>/board-flow/bin/cepa-plan  → <repo>/common/bin/cepa-plan
  Cache:  <mkt>/board-flow/<ver>/bin/      → <mkt>/common/<ver>/bin/cepa-plan
          (I may find SEVERAL versions of common installed at the same
          time — I take the highest by numeric tuple comparison, not
          lexical: "2.10.0" has to beat "2.9.0", and strings compare wrong)
  PATH:   `cepa-plan` in some directory of the PATH (skipping this very
          file, so it does not loop if it is also named `cepa-plan` and
          sits on the PATH).

No candidate found → message on stderr naming each path tried and how to
resolve it, exit 127 (command not found).
"""
import os
import re
import shutil
import sys
from pathlib import Path


def _numeric_version(name):
    """"2.10.0" -> (2, 10, 0); used to find the highest version of common in
    the plugin cache. Lexical comparison would get "2.10.0" < "2.9.0" wrong."""
    try:
        return tuple(int(x) for x in re.findall(r"\d+", name))
    except Exception:
        return (0,)


TARGET = Path(__file__).name  # cepa-plan, cepa-autonomy... — the shim resolves the same-named binary in common


def _repo_candidate(here):
    """here = <repo>/board-flow/bin/ -> <repo>/common/bin/<TARGET>.

    here.parent = board-flow, here.parent.parent = <repo>.
    """
    return here.parent.parent / "common" / "bin" / TARGET


def _cache_candidate(here):
    """here = <mkt>/board-flow/<ver>/bin/ -> <mkt>/common/<highest-ver>/bin/<TARGET>.

    here.parent = <ver>, here.parent.parent = board-flow, here.parent.parent.parent
    = <mkt> (the marketplace cache at ~/.claude/plugins/cache/<mkt>/).
    """
    mkt = here.parent.parent.parent
    versions = sorted(
        (d for d in (mkt / "common").glob("*") if d.is_dir()),
        key=lambda d: _numeric_version(d.name),
    )
    if versions:
        return versions[-1] / "bin" / TARGET
    return None


def _path_candidate(self_file):
    """`<TARGET>` somewhere on the PATH, skipping this very file."""
    found = shutil.which(TARGET)
    if found and Path(found).resolve() != self_file:
        return Path(found)
    return None


def main():
    self_file = Path(__file__).resolve()
    here = self_file.parent  # the bin/ directory that holds this shim

    tried = []

    repo = _repo_candidate(here)
    tried.append(str(repo))
    if repo.is_file():
        real = repo
    else:
        cache = _cache_candidate(here)
        if cache is not None:
            tried.append(str(cache))
        real = cache if (cache is not None and cache.is_file()) else None

        if real is None:
            via_path = _path_candidate(self_file)
            tried.append(f"{TARGET} no PATH")
            real = via_path

    if real is None:
        sys.stderr.write(
            f"{TARGET} (do common) não encontrado. Caminhos tentados:\n"
            + "\n".join(f"  - {t}" for t in tried)
            + "\n\nComo resolver: instale o plugin `common` do marketplace cepa "
            f"(ele traz o `bin/{TARGET}` real), ou garanta que `{TARGET}` "
            "esteja no PATH.\n"
        )
        sys.exit(127)

    os.execv(sys.executable, [sys.executable, str(real), *sys.argv[1:]])


if __name__ == "__main__":
    main()
