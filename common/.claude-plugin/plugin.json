{
  "name": "common",
  "version": "0.2.0",
  "description": "Shared mindset skills required by the alegomes topology plugins. Ships mental-model, active-listener, zero-micromanagement, conversational-response, till-done, autonomous-mode, green-or-revert, and acceptance-completeness. Agents: completion-auditor (independent last-mile acceptance gate). Commands: /autonomous-start, /autonomous-resume, /debrief, /recap, /branch, /return. Hooks: autonomous-checkpoint (PostToolUse on Task), session-log (UserPromptSubmit), mark-build-stale + capture-build-result + gate-advance (the green-or-revert state machine), lead-no-worktree (PreToolUse on Task — blocks worktree-isolated leads), acceptance-gate (PreToolUse on transitionJiraIssue — blocks In-Review while the acceptance audit is incomplete).",
  "author": {
    "name": "alegomes"
  },
  "keywords": ["agents", "skills", "shared", "autonomous", "green-or-revert"],
  "skills": "./skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-advance.py\""
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lead-no-worktree.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*transitionJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/acceptance-gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/autonomous-checkpoint.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/mark-build-stale.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-build-result.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-log.py\""
          }
        ]
      }
    ]
  }
}
