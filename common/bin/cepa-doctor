#!/usr/bin/env python3
"""cepa-doctor — valida a instalação do harness contra a realidade.

Quase toda falha de infraestrutura do harness é descoberta no meio de uma
tarefa, no pior momento: plugin que não carregou (cards criados sem custom
fields), board-flow.yaml de outro módulo, baseline FAILURE de semanas,
worktrees órfãs, handoffs stale pós-rename. Este comando transforma isso em
manutenção de 30 segundos.

Checks globais (independem do projeto):
  - settings.json parseia; plugins @cepa habilitados
  - versão de cada plugin no repo vs. o cache instalado (edição sem reinstall)
  - todos os hooks .py do cache compilam
  - diretório de telemetria gravável

Checks do projeto (cwd):
  - é git repo (rituais degradam sem git)
  - board-flow.yaml: estrutura mínima do bloco defaults
  - .claude/last-build.json: status e idade do baseline
  - worktrees session/*: stale (>14d sem commit) e diretórios órfãos
  - worktrees de agente esquecidas DENTRO do repo (.claude/worktrees/): elas
    duplicam o código-fonte para toda ferramenta que varre o projeto com find
  - handoffs: arquivos sem update há >30d (fonte de fatos stale)
  - ambiente (.claude/env.yaml, ver docs/env-manifest.md): portas declaradas
    ocupadas por processo de OUTRO diretório (lsof) e containers de `services`
    ausentes no `docker ps` (best-effort; sem docker → skip silencioso).
    O `healthcheck:` do manifest NUNCA roda aqui — doctor é só leitura.

Saída: ✓ / ⚠ / ✗ por check. Exit 0 = tudo ok, 1 = só warnings, 2 = falhas.
O check VIVO do board-flow.yaml contra o Jira não acontece aqui (script sem
MCP) — o comando /common:doctor delega essa parte ao atlassian-expert.
"""

import json
import os
import py_compile
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

CLAUDE_DIR = Path.home() / ".claude"
RESULTS = []  # (level, area, message, fix)  level: "ok" | "warn" | "fail"

# `fix` é None ou um dict {"kind": ..., ...}. Um kind só existe aqui quando a
# correção é MECÂNICA (não há escolha a fazer) e REVERSÍVEL (dá para desfazer
# sem perder trabalho) — esse é o critério para `--fix` poder aplicá-la sem
# perguntar. Tudo que exige decisão (descartar worktree, editar board-flow.yaml,
# apagar handoff) fica de fora de propósito e sai no bloco "precisa de você".

# O comparador repo↔cache é compartilhado com session-registry.py, que faz a
# mesma pergunta no boot da sessão. Fonte única, em hooks/ (ver _pluginver.py).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
try:
    import _pluginver as PV
except Exception:  # noqa: BLE001 — doctor degrada, nunca morre por causa disso
    PV = None


def ok(area, msg, fix=None):
    RESULTS.append(("ok", area, msg, fix))


def warn(area, msg, fix=None):
    RESULTS.append(("warn", area, msg, fix))


def fail(area, msg, fix=None):
    RESULTS.append(("fail", area, msg, fix))


def semver(v: str):
    if PV is not None:
        return PV.semver(v)
    try:
        return tuple(int(x) for x in re.findall(r"\d+", v)[:3])
    except Exception:
        return (0,)


def age_days(iso: str):
    try:
        ts = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
        if ts.tzinfo is None:
            ts = ts.replace(tzinfo=timezone.utc)
        return (datetime.now(timezone.utc) - ts).total_seconds() / 86400
    except Exception:
        return None


def git(args, cwd=None):
    try:
        p = subprocess.run(["git"] + args, capture_output=True, text=True,
                           cwd=cwd, timeout=15)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)


# ── Checks globais ──────────────────────────────────────────────────────

def check_settings():
    path = CLAUDE_DIR / "settings.json"
    if not path.exists():
        warn("settings", "~/.claude/settings.json não existe")
        return {}
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
        ok("settings", "settings.json parseia")
        return settings
    except json.JSONDecodeError as e:
        fail("settings", f"settings.json inválido: {e}")
        return {}


def cepa_repo_root():
    try:
        mk = json.loads((CLAUDE_DIR / "plugins" / "known_marketplaces.json").read_text())
        loc = mk.get("cepa", {}).get("installLocation")
        return Path(loc) if loc else None
    except Exception:
        return None


def last_install():
    """The operational record written by bin/install.sh, or None."""
    try:
        return json.loads((CLAUDE_DIR / "ops" / "last-install.json").read_text())
    except Exception:
        return None


def check_ops(rec):
    """Did the last operational update finish, and is a way back available?

    An install that dies halfway leaves the harness in a state nobody chose,
    and the session that runs next has no way to tell. The record turns that
    into something visible before it costs a task.
    """
    if rec is None:
        warn("ops", "sem registro de install (~/.claude/ops/last-install.json) — "
                    "rode bin/install.sh uma vez para passar a ter rota de recuperação")
        return
    status = rec.get("status")
    started, finished = rec.get("started_at"), rec.get("finished_at")
    if status == "in_progress":
        a = age_days(started)
        atxt = f" (começou há {a:.1f}d)" if a is not None else ""
        fail("ops", f"último install NÃO terminou{atxt} — o harness está num estado "
                    f"que ninguém escolheu; rode bin/install.sh de novo ou "
                    f"bin/install.sh --rollback")
        return
    prev = rec.get("previous_cache_dir")
    has_prev = bool(prev) and Path(prev).is_dir()
    a = age_days(finished or started)
    atxt = f", há {a:.0f}d" if a is not None else ""
    if status == "rolled_back":
        warn("ops", f"último evento foi um --rollback{atxt} — o cache live é o "
                    f"ANTERIOR ao install que você tentou; confirme se é isso mesmo")
        return
    if has_prev:
        ok("ops", f"último install ok{atxt}, com rollback disponível ({prev})")
    else:
        ok("ops", f"último install ok{atxt} (sem ponto de rollback — "
                  f"só --clean cria um)")


def check_plugins(settings, rec=None):
    repo = cepa_repo_root()
    if not repo or not repo.is_dir():
        fail("plugins", "marketplace 'cepa' não encontrado em known_marketplaces.json")
        return
    enabled = settings.get("enabledPlugins", {})
    if PV is None:
        fail("plugins", "comparador de versões (_pluginver.py) não carregou — "
                        "não dá para dizer se o cache é o repo")
        return
    for p in PV.scan(repo, enabled):
        name, repo_v, cache_v = p["name"], p["repo_version"], p["cache_version"]
        if not p["enabled"]:
            warn("plugins", f"{name}@cepa NÃO habilitado em enabledPlugins — cards/hooks desse plugin não funcionam")
        if p["missing"]:
            fail("plugins", f"{name}: nenhuma versão no cache — rode bin/install.sh",
                 fix={"kind": "install", "repo": str(repo)})
        elif p["drift"]:
            # A idade do drift é o que separa "acabei de editar" de "faz duas
            # semanas que trabalho contra um harness que não é o instalado".
            a = age_days((rec or {}).get("finished_at") or (rec or {}).get("started_at"))
            atxt = f"; o último install foi há {a:.0f}d" if a is not None else ""
            warn("plugins", f"{name}: repo está em {repo_v} mas o cache instalado é {cache_v}{atxt} — edições não valem; rode bin/install.sh",
                 fix={"kind": "install", "repo": str(repo)})
        else:
            ok("plugins", f"{name} {cache_v} instalado e habilitado")


def main_worktree_root(cwd: Path):
    """Raiz da worktree PRINCIPAL — é lá que o registry de sessões vive, mesmo
    quando o doctor roda de dentro de uma worktree de sessão."""
    try:
        r = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=str(cwd),
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            return None
        gd = Path(r.stdout.strip())
        if not gd.is_absolute():
            gd = (Path(cwd) / gd).resolve()
        return gd.parent if gd.name == ".git" else None
    except Exception:  # noqa: BLE001
        return None


def parse_worktrees(porcelain: str):
    """`git worktree list --porcelain` em registros — path, branch, detached,
    prunable. O parse linha-a-linha antigo só enxergava quem tinha `branch`, e
    worktree de agente costuma estar em HEAD destacado."""
    out, cur = [], None
    for line in porcelain.splitlines():
        if line.startswith("worktree "):
            if cur:
                out.append(cur)
            cur = {"path": line.split(" ", 1)[1], "branch": None,
                   "detached": False, "prunable": False, "head": None}
        elif cur is None:
            continue
        elif line.startswith("branch "):
            cur["branch"] = line.split(" ", 1)[1].replace("refs/heads/", "")
        elif line.startswith("HEAD "):
            cur["head"] = line.split(" ", 1)[1]
        elif line.startswith("detached"):
            cur["detached"] = True
        elif line.startswith("prunable"):
            cur["prunable"] = True
    if cur:
        out.append(cur)
    return out


def dentro_do_repo(root: Path, path: str) -> bool:
    try:
        Path(path).resolve().relative_to(root.resolve())
        return True
    except (ValueError, OSError):
        return False


def base_branch(root: Path) -> str:
    """A branch onde o trabalho desemboca — mesma heurística do _wtlib."""
    rc, out, _ = git(["symbolic-ref", "--quiet", "refs/remotes/origin/HEAD"], cwd=str(root))
    if rc == 0 and out.strip():
        return out.strip().replace("refs/remotes/origin/", "")
    for cand in ("main", "master"):
        rc, _, _ = git(["rev-parse", "--verify", "--quiet", cand], cwd=str(root))
        if rc == 0:
            return cand
    return "main"


def contido_na_base(root: Path, ref: str, base: str) -> bool:
    """True quando `ref` não tem nada que a base já não tenha."""
    if not ref:
        return False
    rc, _, _ = git(["merge-base", "--is-ancestor", ref, base], cwd=str(root))
    return rc == 0


def sujeira(path: str):
    """Arquivos não rastreados + modificações pendentes na worktree.

    Ignorados ficam de fora de propósito: build output nunca deixaria uma
    worktree removível, e o que se quer proteger é trabalho que só existe ali.
    """
    rc, out, _ = git(["status", "--porcelain", "--untracked-files=all"], cwd=path)
    if rc != 0:
        return None          # não deu para saber → trata como perigoso
    return [l for l in out.splitlines() if l.strip()]


def check_worktree_interna(root: Path, wt):
    """Worktree registrada DENTRO do próprio repositório.

    A ferramenta de subagente do Claude Code cria worktree em
    `.claude/worktrees/agent-<id>` — dentro da árvore, não em ~/cepa-worktrees/.
    Deveria sumir sozinha quando nada muda, mas SOBREVIVE se o agente commitar.
    E, por morar dentro do repo, ela duplica o código-fonte inteiro aos olhos de
    qualquer ferramenta que varra o projeto com `find`.

    O caso que pagou por este check (2026-08-19, wego-acesso-backend): a sobra
    `agent-a3494bc82de7f33a6` fez o `bin/run-dev.sh doctor` contar cada migration
    duas vezes e acusar 14 versões duplicadas inexistentes. Isso barrou o boot do
    backend, derrubou o portão de prova de UI de outro repo e a auditoria de
    aceite de dois cards — e o preflight do cepa-doctor tinha rodado limpo.
    """
    path = wt["path"]
    rel = Path(path).resolve()
    try:
        rel = rel.relative_to(root.resolve())
    except ValueError:
        pass
    ref = wt["branch"] or wt["head"]
    base = base_branch(root)
    idade = ""
    rc, out, _ = git(["log", "-1", "--format=%ct"], cwd=path)
    if rc == 0 and out.strip().isdigit():
        d = (datetime.now(timezone.utc).timestamp() - int(out.strip())) / 86400
        idade = f", último commit há {d:.0f}d"

    dano = "duplica o código-fonte para qualquer ferramenta que varra o repo com find"
    suja = sujeira(path)
    if suja is None:
        warn("worktrees", f"worktree de agente em {rel} — {dano}; "
                          f"não deu para ler o estado dela, remova à mão se for lixo")
        return
    if suja:
        warn("worktrees", f"worktree de agente em {rel} com {len(suja)} arquivo(s) "
                          f"não rastreado(s)/modificado(s){idade} — {dano}; "
                          f"salve o que importa antes de remover (decisão sua, não do doctor)")
        return
    if not contido_na_base(root, ref, base):
        warn("worktrees", f"worktree de agente em {rel} com commit que {base} não tem{idade} "
                          f"— {dano}; mescle ou descarte (decisão sua, não do doctor)")
        return
    alvo = f" e apaga a branch {wt['branch']}" if wt["branch"] else ""
    warn("worktrees", f"worktree de agente esquecida em {rel} (já contida em {base}, "
                      f"sem arquivo pendente){idade} — {dano}",
         fix={"kind": "worktree_interna", "root": str(root), "path": path,
              "branch": wt["branch"] or "", "base": base, "alvo": alvo})


def check_sessoes_desatualizadas():
    """Sessões ABERTAS que carregaram uma versão que o cache já não tem.

    O check de plugins acima compara repo com cache: pega quem editou e não
    instalou. Este pega o oposto — instalou com a sessão aberta. O cache fica
    novo, a sessão segue executando os hooks que leu na abertura, e nada na
    tela distingue os dois. Foi assim que "isso já está valendo" virou a
    afirmação mais cara deste harness.
    """
    if PV is None:
        return
    root = main_worktree_root(Path.cwd())
    if root is None:
        return
    sdir = root / ".claude" / "sessions"
    if not sdir.is_dir():
        return
    achou = False
    sem_foto = 0
    for f in sorted(sdir.glob("*.json")):
        try:
            entry = json.loads(f.read_text(encoding="utf-8"))
        except Exception:  # noqa: BLE001
            continue
        if not entry.get("plugin_versions"):
            sem_foto += 1
            continue
        fora = PV.session_stale(entry)
        if not fora:
            continue
        achou = True
        quais = ", ".join(f"{n} {vb} → cache {va}" for n, vb, va in fora)
        onde = entry.get("branch") or entry.get("cwd") or f.stem
        warn("sessões", f"{onde}: carregou {quais} — os hooks dessa sessão são os "
                        f"antigos; reinicie a sessão para valer")
    if not achou:
        if sem_foto:
            ok("sessões", f"nenhuma sessão desatualizada ({sem_foto} sem foto de "
                          f"versão — abertas antes deste check existir)")
        else:
            ok("sessões", "toda sessão aberta está na versão que o cache tem")


def check_hooks_compile():
    cache_root = CLAUDE_DIR / "plugins" / "cache" / "cepa"
    if not cache_root.is_dir():
        return
    bad = 0
    total = 0
    for plugin_dir in cache_root.iterdir():
        versions = sorted((d for d in plugin_dir.iterdir() if d.is_dir()),
                          key=lambda d: semver(d.name)) if plugin_dir.is_dir() else []
        if not versions:
            continue
        hooks = versions[-1] / "hooks"
        for py in hooks.glob("*.py") if hooks.is_dir() else []:
            total += 1
            try:
                py_compile.compile(str(py), doraise=True)
            except py_compile.PyCompileError as e:
                bad += 1
                fail("hooks", f"{py.relative_to(cache_root)} não compila: {e.msg.splitlines()[-1][:120]}")
    if total and not bad:
        ok("hooks", f"{total} hooks .py do cache compilam")


def check_telemetry():
    tdir = Path(os.environ.get("CEPA_TELEMETRY_DIR") or (CLAUDE_DIR / "cepa-telemetry"))
    try:
        tdir.mkdir(parents=True, exist_ok=True)
        probe = tdir / ".doctor-probe"
        probe.write_text("ok")
        probe.unlink()
        ok("telemetria", f"ledger gravável em {tdir}")
    except OSError as e:
        warn("telemetria", f"ledger não gravável ({e}) — métricas não acumulam")


# ── Checks do projeto (cwd) ─────────────────────────────────────────────

def check_project(cwd: Path):
    rc, out, _ = git(["rev-parse", "--show-toplevel"], cwd=str(cwd))
    if rc != 0:
        warn("projeto", "cwd não é um git repo — handoff/wrap-up/worktrees degradam aqui")
        return
    root = Path(out.strip())
    ok("projeto", f"git repo: {root}")

    # board-flow.yaml — estrutura mínima
    bf = root / "board-flow.yaml"
    if bf.exists():
        text = bf.read_text(encoding="utf-8", errors="replace")
        missing = [k for k in ("site", "project_key", "status_map") if not re.search(rf"^\s*{k}:", text, re.M)]
        for k in ("to_do", "in_progress", "in_review"):
            if not re.search(rf"^\s*{k}:", text, re.M):
                missing.append(f"status_map.{k}")
        if missing:
            warn("board-flow", f"board-flow.yaml sem chave(s): {', '.join(missing)} — rode /board-flow:configure")
        else:
            ok("board-flow", "board-flow.yaml com estrutura mínima (checagem VIVA contra o Jira: /common:doctor --live)")

    # baseline de build
    no_build = (root / ".claude" / "no-build").exists()
    lb = root / ".claude" / "last-build.json"
    if no_build:
        ok("build", "projeto opta por .claude/no-build (sem baseline a cobrar)")
    elif lb.exists():
        try:
            state = json.loads(lb.read_text())
            status = state.get("status", "?")
            a = age_days(state.get("at") or state.get("since"))
            atxt = f", {a:.0f}d atrás" if a is not None else ""
            if status == "SUCCESS":
                ok("build", f"baseline SUCCESS{atxt}")
            else:
                w = f"baseline {status}{atxt} — gate-advance vai bloquear commits/push até um verify verde"
                if a is not None and a > 7:
                    w += " (antigo demais para ser verdade; rode o verify)"
                warn("build", w)
        except (OSError, json.JSONDecodeError) as e:
            warn("build", f"last-build.json ilegível: {e}")
    else:
        warn("build", "sem baseline de build — o primeiro push será bloqueado; rode o verify do projeto (ou crie .claude/no-build)")

    # worktrees session/*
    rc, out, _ = git(["worktree", "list", "--porcelain"], cwd=str(root))
    registered = set()
    if rc == 0:
        # Registro apontando para diretório que não existe mais: o git segue
        # citando a worktree (e recusando recriar a branch) até um prune. É a
        # correção mais mecânica que existe — não apaga trabalho, só limpa
        # ponteiro para o que já sumiu.
        prunable = sum(1 for line in out.splitlines() if line.startswith("prunable"))
        if prunable:
            warn("worktrees", f"{prunable} registro(s) de worktree apontando para diretório "
                              f"inexistente — git worktree prune limpa o ponteiro",
                 fix={"kind": "worktree_prune", "root": str(root)})
        for wt in parse_worktrees(out):
            wt_path, branch = wt["path"], wt["branch"]
            if wt["prunable"] or Path(wt_path).resolve() == root.resolve():
                continue
            if dentro_do_repo(root, wt_path):
                check_worktree_interna(root, wt)
                continue
            if branch and "session/" in branch:
                registered.add(Path(wt_path).name)
                rc2, out2, _ = git(["log", "-1", "--format=%ct"], cwd=wt_path)
                if rc2 == 0 and out2.strip().isdigit():
                    d = (datetime.now(timezone.utc).timestamp() - int(out2.strip())) / 86400
                    if d > 14:
                        warn("worktrees", f"{Path(wt_path).name} ({branch}) sem commit há {d:.0f}d — merge ou /common:worktree-discard")
    wt_home = Path(os.environ.get("CEPA_WORKTREE_HOME")
                   or os.environ.get("CCW_WORKTREE_HOME")
                   or (Path.home() / "cepa-worktrees"))
    if wt_home.is_dir():
        prefix = f"{root.name}-"
        orphans = [d.name for d in wt_home.iterdir()
                   if d.is_dir() and d.name.startswith(prefix) and d.name not in registered]
        for o in orphans:
            warn("worktrees", f"diretório órfão {wt_home / o} (não registrado em git worktree) — lixo de sessão morta")
    if not any(r[1] == "worktrees" for r in RESULTS):
        ok("worktrees", "sem worktrees stale ou órfãs")

    # handoffs stale
    hdir = root / ".claude" / "handoffs"
    stale = 0
    for f in hdir.glob("*.md") if hdir.is_dir() else []:
        m = re.search(r"^updated_at:\s*(\S+)", f.read_text(encoding="utf-8", errors="replace"), re.M)
        a = age_days(m.group(1)) if m else None
        if a is not None and a > 30:
            stale += 1
            warn("handoffs", f"{f.name} sem update há {a:.0f}d — fatos dele são hipótese vencida; arquivar",
                 fix={"kind": "archive_handoff", "path": str(f)})
    if hdir.is_dir() and not stale:
        ok("handoffs", "sem handoffs vencidos")

    check_env_manifest(root)


# ── Ambiente (.claude/env.yaml) ─────────────────────────────────────────

def env_manifest_list(path: Path, key: str):
    """Lê uma chave-lista de topo do env.yaml sem pyyaml (formato raso —
    ver docs/env-manifest.md). Suporta listas em bloco ('- item') e inline
    ('key: [a, b]'). Qualquer problema → lista vazia (fail-silent)."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    items, in_key = [], False
    for raw in lines:
        if raw.lstrip().startswith("#"):
            continue
        line = re.sub(r"\s#.*$", "", raw.rstrip())
        if not line.strip():
            continue
        top = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if top:
            in_key = top.group(1) == key
            val = top.group(2).strip()
            if in_key and val:
                if val.startswith("[") and val.endswith("]"):
                    items.extend(x.strip().strip("'\"")
                                 for x in val[1:-1].split(",") if x.strip())
                else:
                    items.append(val.strip("'\""))
                in_key = False
            continue
        if in_key:
            item = re.match(r"^\s+-\s*(.+)$", line)
            if item:
                items.append(item.group(1).strip().strip("'\""))
    return [i for i in items if i]


def port_holder(port: str):
    """Quem escuta TCP:<port>? Retorna (pid, comando, cwd) ou None se livre.
    Best-effort: lsof ausente/erro → None (porta tratada como livre)."""
    try:
        p = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpc"],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    pid = cmd = None
    for line in p.stdout.splitlines():
        if line.startswith("p") and pid is None:
            pid = line[1:]
        elif line.startswith("c") and cmd is None:
            cmd = line[1:]
    if not pid:
        return None
    cwd = None
    try:
        q = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
                           capture_output=True, text=True, timeout=10)
        for line in q.stdout.splitlines():
            if line.startswith("n"):
                cwd = line[1:]
                break
    except Exception:
        pass
    return pid, cmd or "?", cwd


def check_env_manifest(root: Path):
    """Confere o manifesto de ambiente (.claude/env.yaml) contra a realidade.
    Só leitura: o `healthcheck:` declarado NUNCA é executado aqui."""
    ef = root / ".claude" / "env.yaml"
    if not ef.exists():
        return
    ports = env_manifest_list(ef, "ports")
    services = env_manifest_list(ef, "services")
    if not ports and not services:
        ok("ambiente", "env.yaml presente, sem ports/services declarados")
        return

    root_real = os.path.realpath(str(root))
    for port in ports:
        if not str(port).isdigit():
            warn("ambiente", f"porta inválida no env.yaml: {port!r}")
            continue
        holder = port_holder(str(port))
        if holder is None:
            ok("ambiente", f"porta {port} livre")
            continue
        pid, cmd, cwd = holder
        cwd_real = os.path.realpath(cwd) if cwd else None
        if cwd_real and (cwd_real == root_real
                         or cwd_real.startswith(root_real + os.sep)):
            ok("ambiente", f"porta {port} em uso pelo próprio projeto ({cmd}, pid {pid})")
        else:
            warn("ambiente", f"porta {port} ocupada por {cmd} (pid {pid}, cwd {cwd or '?'}) "
                             f"— processo de OUTRO diretório; suba numa porta livre em vez de matá-lo")

    if services:
        try:
            p = subprocess.run(["docker", "ps", "--format", "{{.Names}}"],
                               capture_output=True, text=True, timeout=15)
        except Exception:
            return  # docker ausente/indisponível → skip silencioso
        if p.returncode != 0:
            return  # daemon fora do ar → skip silencioso (best-effort)
        running = set(p.stdout.split())
        for svc in services:
            if svc in running:
                ok("ambiente", f"container {svc} rodando")
            else:
                warn("ambiente", f"container {svc} declarado no env.yaml não está no docker ps "
                                 f"— suba com o comando `up:` do manifest")


# ── Correções em lote (--fix) ───────────────────────────────────────────
#
# Por que existe: sem isso o ciclo é "acha 1 → propõe → confirma → acha o
# próximo → propõe → confirma...", e a preparação consome mais atenção que a
# tarefa. Aqui as correções mecânicas viram um lote só, aplicado de uma vez,
# com o diagnóstico rodando de novo até parar de mudar.

def fix_install(fx):
    repo = fx.get("repo")
    script = Path(repo) / "bin" / "install.sh" if repo else None
    if not script or not script.is_file():
        return False, f"bin/install.sh não encontrado em {repo}"
    try:
        p = subprocess.run(["bash", str(script)], capture_output=True, text=True,
                           timeout=600, cwd=repo)
    except Exception as e:  # noqa: BLE001
        return False, f"install.sh não rodou: {e}"
    if p.returncode != 0:
        tail = (p.stderr or p.stdout or "").strip().splitlines()
        return False, f"install.sh saiu {p.returncode}: {tail[-1][:160] if tail else 'sem saída'}"
    return True, "plugins reinstalados a partir do repo"


def fix_archive_handoff(fx):
    src = Path(fx["path"])
    dest_dir = src.parent / "archive"
    try:
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest = dest_dir / src.name
        if dest.exists():
            dest = dest_dir / f"{src.stem}-{int(datetime.now(timezone.utc).timestamp())}{src.suffix}"
        src.rename(dest)
    except OSError as e:
        return False, f"não deu para arquivar {src.name}: {e}"
    return True, f"{src.name} movido para {dest_dir}/ (nada apagado)"


def fix_worktree_prune(fx):
    rc, _, err = git(["worktree", "prune"], cwd=fx["root"])
    if rc != 0:
        return False, f"git worktree prune falhou: {err.strip()[:160]}"
    return True, "registros de worktree órfãos limpos"


def fix_worktree_interna(fx):
    """Remove worktree de agente esquecida — só quando ela não guarda trabalho.

    As três travas são deliberadas e redundantes: o diagnóstico já checou, mas
    entre diagnosticar e corrigir cabe uma sessão inteira, e o que se perde aqui
    não volta. No caso real havia um teste de medição do WEGO-2037 que só existia
    dentro da worktree.
    """
    path, root = fx["path"], fx["root"]
    branch, base = fx.get("branch") or "", fx.get("base") or "main"

    suja = sujeira(path)
    if suja is None:
        return False, f"não deu para ler o estado de {path} — nada removido"
    if suja:
        return False, (f"{Path(path).name} ganhou {len(suja)} arquivo(s) pendente(s) "
                       f"desde o diagnóstico — nada removido")
    if not contido_na_base(Path(root), branch or "HEAD", base):
        return False, f"{Path(path).name} tem commit que {base} não tem — nada removido"

    # sem --force de propósito: o próprio git recusa se ainda houver sujeira.
    rc, _, err = git(["worktree", "remove", path], cwd=root)
    if rc != 0:
        return False, f"git worktree remove recusou: {err.strip()[:160]}"
    msg = f"worktree de agente {Path(path).name} removida"
    if branch:
        # -d, nunca -D: se o git achar que a branch não está mesclada, ela fica.
        rc, _, err = git(["branch", "-d", branch], cwd=root)
        msg += f" e branch {branch} apagada" if rc == 0 else f" (branch {branch} mantida: {err.strip()[:80]})"
    return True, msg


FIXERS = {
    "install": fix_install,
    "archive_handoff": fix_archive_handoff,
    "worktree_prune": fix_worktree_prune,
    "worktree_interna": fix_worktree_interna,
}

# Rótulo leigo por tipo de correção — o relatório fala do efeito, não do comando.
FIX_LABEL = {
    "install": "reinstalar os plugins (o que está valendo passa a ser o que está no repo)",
    "archive_handoff": "arquivar handoff vencido (move para archive/, não apaga)",
    "worktree_prune": "limpar registro de worktree cujo diretório já não existe",
    "worktree_interna": "remover worktree de agente esquecida dentro do repo (só a que não guarda trabalho)",
}


def pending_fixes():
    """Correções automáticas dos achados atuais, sem repetir a mesma duas vezes."""
    seen, out = set(), []
    for level, _area, _msg, fx in RESULTS:
        if level == "ok" or not fx:
            continue
        key = (fx["kind"], fx.get("path") or fx.get("repo") or fx.get("root") or "")
        if key in seen:
            continue
        seen.add(key)
        out.append(fx)
    return out


def run_checks():
    RESULTS.clear()
    settings = check_settings()
    rec = last_install()
    check_ops(rec)
    check_plugins(settings, rec)
    check_sessoes_desatualizadas()
    check_hooks_compile()
    check_telemetry()
    check_project(Path.cwd())


def apply_fixes(max_passes=3):
    """Aplica tudo que é automático, re-diagnosticando entre as rodadas.

    Re-rodar é o ponto: uma correção muda o que os outros checks enxergam (o
    install, por exemplo, troca o cache que o check de hooks compila). Sem isso
    o usuário voltaria a ser o loop entre uma correção e a próxima.
    """
    applied, failed = [], []
    for _ in range(max_passes):
        todo = pending_fixes()
        if not todo:
            break
        for fx in todo:
            fixer = FIXERS.get(fx["kind"])
            if not fixer:
                continue
            good, msg = fixer(fx)
            (applied if good else failed).append((fx["kind"], msg))
        run_checks()
    return applied, failed


# ── Main ────────────────────────────────────────────────────────────────

def stamp_path():
    rc, out, _ = git(["rev-parse", "--show-toplevel"], cwd=str(Path.cwd()))
    if rc != 0:
        return None
    return Path(out.strip()) / ".claude" / "doctor-last-run"


def stamp_run():
    """Grava o carimbo que o nudge diário do session-registry consulta."""
    stamp = stamp_path()
    if stamp is None:
        return
    try:
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.write_text(datetime.now(timezone.utc).isoformat(timespec="seconds") + "\n")
    except OSError:
        pass


def fresh_within(hours: float) -> bool:
    """O diagnóstico já rodou neste repo há menos de `hours`?

    É o que permite pendurar o preflight na abertura de CADA sessão (o wrapper
    `cepa`) sem cobrar o diagnóstico toda vez: a primeira sessão do dia paga,
    as seguintes saem na hora.
    """
    stamp = stamp_path()
    if stamp is None or not stamp.exists():
        return False
    try:
        a = age_days(stamp.read_text().strip())
    except OSError:
        return False
    return a is not None and a * 24 < hours


def parse_if_stale(argv):
    """`--if-stale H` (ou `--if-stale=H`): só rode se o último diagnóstico
    neste repo tiver mais de H horas. Retorna as horas, ou None."""
    for i, a in enumerate(argv):
        if a.startswith("--if-stale="):
            val = a.split("=", 1)[1]
        elif a == "--if-stale" and i + 1 < len(argv):
            val = argv[i + 1]
        else:
            continue
        try:
            return float(val)
        except ValueError:
            return None
    return None


def main():
    argv = sys.argv[1:]
    do_fix = "--fix" in argv
    brief = "--brief" in argv

    # Preflight de abertura de sessão: silencioso e barato quando não há nada a
    # dizer. Sem isso o wrapper cobraria o diagnóstico inteiro a cada `cepa`.
    stale_h = parse_if_stale(argv)
    if stale_h is not None and fresh_within(stale_h):
        return 0

    run_checks()

    applied, failed = ([], [])
    if do_fix:
        applied, failed = apply_fixes()
    stamp_run()

    icons = {"ok": "✓", "warn": "⚠", "fail": "✗"}
    order = {"fail": 0, "warn": 1, "ok": 2}
    fails = sum(1 for r in RESULTS if r[0] == "fail")
    warns = sum(1 for r in RESULTS if r[0] == "warn")

    if not brief:
        print("# cepa-doctor\n")
        for level, area, msg, _fx in sorted(RESULTS, key=lambda r: (order[r[0]], r[1])):
            print(f" {icons[level]} [{area}] {msg}")
        print(f"\n{fails} falha(s), {warns} aviso(s), "
              f"{sum(1 for r in RESULTS if r[0] == 'ok')} ok.")
    elif not (applied or failed or fails or warns):
        # Modo resumido e nada a dizer: não imprima nada. Uma linha "está tudo
        # ok" em toda abertura de sessão é ruído que o usuário aprende a pular.
        return 0
    else:
        print(f"cepa-doctor: {fails} falha(s), {warns} aviso(s)"
              + (f", {len(applied)} corrigida(s) automaticamente" if applied else ""))

    if do_fix and brief:
        for kind, msg in applied:
            print(f" ✓ {FIX_LABEL.get(kind, kind)}")
        for kind, msg in failed:
            print(f" ✗ {FIX_LABEL.get(kind, kind)} — {msg}")
    elif do_fix:
        print("\n## Corrigido automaticamente")
        if applied:
            for kind, msg in applied:
                print(f" ✓ {FIX_LABEL.get(kind, kind)} — {msg}")
        else:
            print(" (nada a corrigir automaticamente)")
        if failed:
            print("\n## Tentei corrigir e não deu")
            for kind, msg in failed:
                print(f" ✗ {FIX_LABEL.get(kind, kind)} — {msg}")
    elif not brief:
        auto = pending_fixes()
        if auto:
            print(f"\n{len(auto)} achado(s) têm correção mecânica — "
                  f"`cepa-doctor --fix` aplica todas de uma vez:")
            for fx in auto:
                print(f" · {FIX_LABEL.get(fx['kind'], fx['kind'])}")

    # O que sobra depois do lote é o que realmente custa atenção: cada um destes
    # é uma ESCOLHA (descartar trabalho, editar config, decidir entre reinstalar
    # e voltar), não uma tarefa mecânica — por isso nenhum é aplicado sozinho.
    manual = [(lvl, area, msg) for lvl, area, msg, fx in RESULTS
              if lvl != "ok" and not fx]
    if manual and brief:
        # Na largada da sessão o usuário precisa saber QUE existe algo e o que
        # é, não o parágrafo inteiro de cada achado.
        print(f" ⚠ {len(manual)} pendência(s) que só você decide "
              f"({', '.join(sorted({a for _l, a, _m in manual}))}) — "
              f"veja com: /common:doctor")
    elif manual:
        print("\n## Precisa de você (não mexi — cada um é uma decisão)")
        for _lvl, area, msg in manual:
            print(f" · [{area}] {msg}")

    return 2 if fails else (1 if warns else 0)


if __name__ == "__main__":
    sys.exit(main())
