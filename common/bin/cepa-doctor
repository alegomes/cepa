#!/usr/bin/env python3
"""cepa-doctor — validates the harness installation against reality.

Almost every harness infrastructure failure is discovered in the middle of a
task, at the worst moment: a plugin that did not load (cards created without
custom fields), a board-flow.yaml from another module, a weeks-old FAILURE
baseline, orphan worktrees, stale handoffs after a rename. This command turns
that into 30 seconds of maintenance.

Global checks (independent of the project):
  - settings.json parses; @cepa plugins enabled
  - each plugin's version in the repo vs. the installed cache (edit without reinstall)
  - every cached hook .py compiles
  - telemetry directory is writable

Project checks (cwd):
  - is a git repo (rituals degrade without git)
  - board-flow.yaml: minimal structure of the defaults block
  - .claude/last-build.json: baseline status and age
  - session/* worktrees: stale (>14d without a commit) and orphan directories
  - forgotten agent worktrees INSIDE the repo (.claude/worktrees/): they
    duplicate the source code for every tool that scans the project with find
  - handoffs: files without an update for >30d (source of stale facts)
  - environment (docs/env.yaml, legacy .claude/env.yaml still read; see
    docs/env-manifest.md): declared ports held by a process from ANOTHER
    directory (lsof) and `services` containers
    missing from `docker ps` (best-effort; no docker → silent skip).
    The manifest's `healthcheck:` NEVER runs here — doctor is read-only.
  - `twg` CLI (Atlassian) version: the installed one (`twg --version`) against
    the one declared in `twg_version:` in the environment manifest (docs/env.yaml
    wins over .claude/env.yaml) — it self-updates
    and can change between two cards of the same unattended batch. With no
    `twg_version:` declared, total silence.

Output: ✓ / ⚠ / ✗ per check. Exit 0 = all ok, 1 = warnings only, 2 = failures.
The LIVE check of board-flow.yaml against Jira does not happen here (script
without MCP) — the /common:doctor command delegates that part to atlassian-expert.
"""

import json
import os
import py_compile
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

CLAUDE_DIR = Path.home() / ".claude"
RESULTS = []  # (level, area, message, fix)  level: "ok" | "warn" | "fail"

# `fix` is None or a dict {"kind": ..., ...}. A kind only exists here when the
# fix is MECHANICAL (no choice to make) and REVERSIBLE (can be undone without
# losing work) — that is the criterion for `--fix` to apply it without
# asking. Anything that requires a decision (discard a worktree, edit
# board-flow.yaml, delete a handoff) is left out on purpose and goes in the
# "needs you" block.

# The repo<->cache comparator is shared with session-registry.py, which asks
# the same question at session boot. Single source, in hooks/ (see _pluginver.py).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402
try:
    import _pluginver as PV
except Exception:  # noqa: BLE001 — doctor degrades, never dies because of this
    PV = None

# Where the single-track queue lives (two layouts during the transition): single source.
try:
    import _queuepath as QP
except Exception:  # noqa: BLE001
    QP = None

# `_wtlib.env_manifest_path` is the same path resolution as the worktree
# seeding (docs/env.yaml wins over .claude/env.yaml, the legacy one) — single source.
try:
    import _wtlib as WT
except Exception:  # noqa: BLE001
    WT = None


def ok(area, msg, fix=None):
    RESULTS.append(("ok", area, msg, fix))


def warn(area, msg, fix=None):
    RESULTS.append(("warn", area, msg, fix))


def fail(area, msg, fix=None):
    RESULTS.append(("fail", area, msg, fix))


def semver(v: str):
    if PV is not None:
        return PV.semver(v)
    try:
        return tuple(int(x) for x in re.findall(r"\d+", v)[:3])
    except Exception:
        return (0,)


def age_days(iso: str):
    try:
        ts = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
        if ts.tzinfo is None:
            ts = ts.replace(tzinfo=timezone.utc)
        return (datetime.now(timezone.utc) - ts).total_seconds() / 86400
    except Exception:
        return None


def git(args, cwd=None):
    try:
        p = subprocess.run(["git"] + args, capture_output=True, text=True,
                           cwd=cwd, timeout=15)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)


# ── Global checks ──────────────────────────────────────────────────────

def check_settings():
    path = CLAUDE_DIR / "settings.json"
    if not path.exists():
        warn("settings", "~/.claude/settings.json não existe")
        return {}
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
        ok("settings", "settings.json parseia")
        return settings
    except json.JSONDecodeError as e:
        fail("settings", f"settings.json inválido: {e}")
        return {}


def cepa_repo_root():
    try:
        mk = json.loads((CLAUDE_DIR / "plugins" / "known_marketplaces.json").read_text())
        loc = mk.get("cepa", {}).get("installLocation")
        return Path(loc) if loc else None
    except Exception:
        return None


def last_install():
    """The operational record written by bin/install.sh, or None."""
    try:
        return json.loads((CLAUDE_DIR / "ops" / "last-install.json").read_text())
    except Exception:
        return None


def check_ops(rec):
    """Did the last operational update finish, and is a way back available?

    An install that dies halfway leaves the harness in a state nobody chose,
    and the session that runs next has no way to tell. The record turns that
    into something visible before it costs a task.
    """
    if rec is None:
        warn("ops", "sem registro de install (~/.claude/ops/last-install.json) — "
                    "rode bin/install.sh uma vez para passar a ter rota de recuperação")
        return
    status = rec.get("status")
    started, finished = rec.get("started_at"), rec.get("finished_at")
    if status == "in_progress":
        a = age_days(started)
        atxt = f" (começou há {a:.1f}d)" if a is not None else ""
        fail("ops", f"último install NÃO terminou{atxt} — o harness está num estado "
                    f"que ninguém escolheu; rode bin/install.sh de novo ou "
                    f"bin/install.sh --rollback")
        return
    prev = rec.get("previous_cache_dir")
    has_prev = bool(prev) and Path(prev).is_dir()
    a = age_days(finished or started)
    atxt = f", há {a:.0f}d" if a is not None else ""
    if status == "rolled_back":
        warn("ops", f"último evento foi um --rollback{atxt} — o cache live é o "
                    f"ANTERIOR ao install que você tentou; confirme se é isso mesmo")
        return
    if has_prev:
        ok("ops", f"último install ok{atxt}, com rollback disponível ({prev})")
    else:
        ok("ops", f"último install ok{atxt} (sem ponto de rollback — "
                  f"só --clean cria um)")


def check_plugins(settings, rec=None):
    repo = cepa_repo_root()
    if not repo or not repo.is_dir():
        fail("plugins", "marketplace 'cepa' não encontrado em known_marketplaces.json")
        return
    enabled = settings.get("enabledPlugins", {})
    if PV is None:
        fail("plugins", "comparador de versões (_pluginver.py) não carregou — "
                        "não dá para dizer se o cache é o repo")
        return
    for p in PV.scan(repo, enabled):
        name, repo_v, cache_v = p["name"], p["repo_version"], p["cache_version"]
        if not p["enabled"]:
            warn("plugins", f"{name}@cepa NÃO habilitado em enabledPlugins — cards/hooks desse plugin não funcionam")
        if p["missing"]:
            fail("plugins", f"{name}: nenhuma versão no cache — rode bin/install.sh",
                 fix={"kind": "install", "repo": str(repo)})
        elif p["drift"]:
            # The age of the drift is what separates "I just edited" from "I have
            # been working for two weeks against a harness that is not the installed one".
            a = age_days((rec or {}).get("finished_at") or (rec or {}).get("started_at"))
            atxt = f"; o último install foi há {a:.0f}d" if a is not None else ""
            warn("plugins", f"{name}: repo está em {repo_v} mas o cache instalado é {cache_v}{atxt} — edições não valem; rode bin/install.sh",
                 fix={"kind": "install", "repo": str(repo)})
        else:
            ok("plugins", f"{name} {cache_v} instalado e habilitado")


def main_worktree_root(cwd: Path):
    """Root of the MAIN worktree — that is where the session registry lives, even
    when the doctor runs from inside a session worktree."""
    try:
        r = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=str(cwd),
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            return None
        gd = Path(r.stdout.strip())
        if not gd.is_absolute():
            gd = (Path(cwd) / gd).resolve()
        return gd.parent if gd.name == ".git" else None
    except Exception:  # noqa: BLE001
        return None


def parse_worktrees(porcelain: str):
    """`git worktree list --porcelain` as records — path, branch, detached,
    prunable. The old line-by-line parse only saw entries that had `branch`, and
    agent worktrees are usually on a detached HEAD."""
    out, cur = [], None
    for line in porcelain.splitlines():
        if line.startswith("worktree "):
            if cur:
                out.append(cur)
            cur = {"path": line.split(" ", 1)[1], "branch": None,
                   "detached": False, "prunable": False, "head": None}
        elif cur is None:
            continue
        elif line.startswith("branch "):
            cur["branch"] = line.split(" ", 1)[1].replace("refs/heads/", "")
        elif line.startswith("HEAD "):
            cur["head"] = line.split(" ", 1)[1]
        elif line.startswith("detached"):
            cur["detached"] = True
        elif line.startswith("prunable"):
            cur["prunable"] = True
    if cur:
        out.append(cur)
    return out


def is_inside_repo(root: Path, path: str) -> bool:
    try:
        Path(path).resolve().relative_to(root.resolve())
        return True
    except (ValueError, OSError):
        return False


def base_branch(root: Path) -> str:
    """The branch where work lands — same heuristic as _wtlib."""
    rc, out, _ = git(["symbolic-ref", "--quiet", "refs/remotes/origin/HEAD"], cwd=str(root))
    if rc == 0 and out.strip():
        return out.strip().replace("refs/remotes/origin/", "")
    for cand in ("main", "master"):
        rc, _, _ = git(["rev-parse", "--verify", "--quiet", cand], cwd=str(root))
        if rc == 0:
            return cand
    return "main"


def is_contained_in_base(root: Path, ref: str, base: str) -> bool:
    """True when `ref` has nothing the base does not already have."""
    if not ref:
        return False
    rc, _, _ = git(["merge-base", "--is-ancestor", ref, base], cwd=str(root))
    return rc == 0


def dirty_files(path: str):
    """Untracked files + pending modifications in the worktree.

    Ignored files are left out on purpose: build output would never leave a
    worktree removable, and what we want to protect is work that only exists there.
    """
    rc, out, _ = git(["status", "--porcelain", "--untracked-files=all"], cwd=path)
    if rc != 0:
        return None          # could not tell → treat as dangerous
    return [l for l in out.splitlines() if l.strip()]


def check_internal_worktree(root: Path, wt):
    """Worktree registered INSIDE the repository itself.

    Claude Code's subagent tool creates a worktree at
    `.claude/worktrees/agent-<id>` — inside the tree, not in ~/cepa-worktrees/.
    It should vanish by itself when nothing changes, but it SURVIVES if the agent commits.
    And, since it lives inside the repo, it duplicates the entire source code in the eyes of
    any tool that scans the project with `find`.

    The case that paid for this check (2026-08-19, wego-acesso-backend): the leftover
    `agent-a3494bc82de7f33a6` made `bin/run-dev.sh doctor` count each migration
    twice and report 14 nonexistent duplicate versions. That blocked the backend
    boot, took down another repo's UI-proof gate and the acceptance audit of
    two cards — and the cepa-doctor preflight had run clean.
    """
    path = wt["path"]
    rel = Path(path).resolve()
    try:
        rel = rel.relative_to(root.resolve())
    except ValueError:
        pass
    ref = wt["branch"] or wt["head"]
    base = base_branch(root)
    age_note = ""
    rc, out, _ = git(["log", "-1", "--format=%ct"], cwd=path)
    if rc == 0 and out.strip().isdigit():
        d = (datetime.now(timezone.utc).timestamp() - int(out.strip())) / 86400
        age_note = f", último commit há {d:.0f}d"

    damage = "duplica o código-fonte para qualquer ferramenta que varra o repo com find"
    dirty = dirty_files(path)
    if dirty is None:
        warn("worktrees", f"worktree de agente em {rel} — {damage}; "
                          f"não deu para ler o estado dela, remova à mão se for lixo")
        return
    if dirty:
        warn("worktrees", f"worktree de agente em {rel} com {len(dirty)} arquivo(s) "
                          f"não rastreado(s)/modificado(s){age_note} — {damage}; "
                          f"salve o que importa antes de remover (decisão sua, não do doctor)")
        return
    if not is_contained_in_base(root, ref, base):
        warn("worktrees", f"worktree de agente em {rel} com commit que {base} não tem{age_note} "
                          f"— {damage}; mescle ou descarte (decisão sua, não do doctor)")
        return
    branch_note = f" e apaga a branch {wt['branch']}" if wt["branch"] else ""
    warn("worktrees", f"worktree de agente esquecida em {rel} (já contida em {base}, "
                      f"sem arquivo pendente){age_note} — {damage}",
         fix={"kind": "internal_worktree", "root": str(root), "path": path,
              "branch": wt["branch"] or "", "base": base, "branch_note": branch_note})


def check_stale_sessions():
    """OPEN sessions that loaded a version the cache no longer has.

    The plugins check above compares repo with cache: it catches whoever edited and did not
    install. This one catches the opposite — installed while the session was open. The cache becomes
    new, the session keeps running the hooks it read at startup, and nothing on
    screen tells the two apart. That is how "this is already in effect" became the
    most expensive claim in this harness.
    """
    if PV is None:
        return
    root = main_worktree_root(Path.cwd())
    if root is None:
        return
    sdir = root / ".claude" / "sessions"
    if not sdir.is_dir():
        return
    found = False
    without_snapshot = 0
    for f in sorted(sdir.glob("*.json")):
        try:
            entry = json.loads(f.read_text(encoding="utf-8"))
        except Exception:  # noqa: BLE001
            continue
        if not entry.get("plugin_versions"):
            without_snapshot += 1
            continue
        outdated = PV.session_stale(entry)
        if not outdated:
            continue
        found = True
        which = ", ".join(f"{n} {vb} → cache {va}" for n, vb, va in outdated)
        location = entry.get("branch") or entry.get("cwd") or f.stem
        warn("sessões", f"{location}: carregou {which} — os hooks dessa sessão são os "
                        f"antigos; reinicie a sessão para valer")
    if not found:
        if without_snapshot:
            ok("sessões", f"nenhuma sessão desatualizada ({without_snapshot} sem foto de "
                          f"versão — abertas antes deste check existir)")
        else:
            ok("sessões", "toda sessão aberta está na versão que o cache tem")


def check_hooks_compile():
    cache_root = CLAUDE_DIR / "plugins" / "cache" / "cepa"
    if not cache_root.is_dir():
        return
    bad = 0
    total = 0
    for plugin_dir in cache_root.iterdir():
        versions = sorted((d for d in plugin_dir.iterdir() if d.is_dir()),
                          key=lambda d: semver(d.name)) if plugin_dir.is_dir() else []
        if not versions:
            continue
        hooks = versions[-1] / "hooks"
        for py in hooks.glob("*.py") if hooks.is_dir() else []:
            total += 1
            try:
                py_compile.compile(str(py), doraise=True)
            except py_compile.PyCompileError as e:
                bad += 1
                fail("hooks", f"{py.relative_to(cache_root)} não compila: {e.msg.splitlines()[-1][:120]}")
    if total and not bad:
        ok("hooks", f"{total} hooks .py do cache compilam")


def check_telemetry():
    tdir = Path(os.environ.get("CEPA_TELEMETRY_DIR") or (CLAUDE_DIR / "cepa-telemetry"))
    try:
        tdir.mkdir(parents=True, exist_ok=True)
        probe = tdir / ".doctor-probe"
        probe.write_text("ok")
        probe.unlink()
        ok("telemetria", f"ledger gravável em {tdir}")
    except OSError as e:
        warn("telemetria", f"ledger não gravável ({e}) — métricas não acumulam")


# ── Project checks (cwd) ─────────────────────────────────────────────

def check_project(cwd: Path):
    rc, out, _ = git(["rev-parse", "--show-toplevel"], cwd=str(cwd))
    if rc != 0:
        warn("projeto", "cwd não é um git repo — handoff/wrap-up/worktrees degradam aqui")
        return
    root = Path(out.strip())
    ok("projeto", f"git repo: {root}")

    # board-flow.yaml — minimal structure
    bf = root / "board-flow.yaml"
    if bf.exists():
        text = bf.read_text(encoding="utf-8", errors="replace")
        missing = [k for k in ("site", "project_key", "status_map") if not re.search(rf"^\s*{k}:", text, re.M)]
        for k in ("to_do", "in_progress", "in_review"):
            if not re.search(rf"^\s*{k}:", text, re.M):
                missing.append(f"status_map.{k}")
        if missing:
            warn("board-flow", f"board-flow.yaml sem chave(s): {', '.join(missing)} — rode /board-flow:configure")
        else:
            ok("board-flow", "board-flow.yaml com estrutura mínima (checagem VIVA contra o Jira: /common:doctor --live)")

    # build baseline
    no_build = (root / ".claude" / "no-build").exists()
    lb = root / ".claude" / "last-build.json"
    if no_build:
        ok("build", "projeto opta por .claude/no-build (sem baseline a cobrar)")
    elif lb.exists():
        try:
            state = json.loads(lb.read_text())
            status = state.get("status", "?")
            a = age_days(state.get("at") or state.get("since"))
            atxt = f", {a:.0f}d atrás" if a is not None else ""
            if status == "SUCCESS":
                ok("build", f"baseline SUCCESS{atxt}")
            else:
                w = f"baseline {status}{atxt} — gate-advance vai bloquear commits/push até um verify verde"
                if status == "EMPTY":
                    w += (" (o filtro de teste do último comando casou ZERO teste: corrija o nome "
                          "ou rode com -Dsurefire.failIfNoSpecifiedTests=true)")
                if a is not None and a > 7:
                    w += " (antigo demais para ser verdade; rode o verify)"
                warn("build", w)
        except (OSError, json.JSONDecodeError) as e:
            warn("build", f"last-build.json ilegível: {e}")
    else:
        warn("build", "sem baseline de build — o primeiro push será bloqueado; rode o verify do projeto (ou crie .claude/no-build)")

    # session/* worktrees
    rc, out, _ = git(["worktree", "list", "--porcelain"], cwd=str(root))
    registered = set()
    if rc == 0:
        # Registry entry pointing at a directory that no longer exists: git keeps
        # citing the worktree (and refusing to recreate the branch) until a prune. It is the
        # most mechanical fix there is — it deletes no work, only clears a
        # pointer to what is already gone.
        prunable = sum(1 for line in out.splitlines() if line.startswith("prunable"))
        if prunable:
            warn("worktrees", f"{prunable} registro(s) de worktree apontando para diretório "
                              f"inexistente — git worktree prune limpa o ponteiro",
                 fix={"kind": "worktree_prune", "root": str(root)})
        for wt in parse_worktrees(out):
            wt_path, branch = wt["path"], wt["branch"]
            if wt["prunable"] or Path(wt_path).resolve() == root.resolve():
                continue
            if is_inside_repo(root, wt_path):
                check_internal_worktree(root, wt)
                continue
            if branch and "session/" in branch:
                registered.add(Path(wt_path).name)
                rc2, out2, _ = git(["log", "-1", "--format=%ct"], cwd=wt_path)
                if rc2 == 0 and out2.strip().isdigit():
                    d = (datetime.now(timezone.utc).timestamp() - int(out2.strip())) / 86400
                    if d > 14:
                        warn("worktrees", f"{Path(wt_path).name} ({branch}) sem commit há {d:.0f}d — merge ou /common:worktree-discard")
    wt_home = Path(os.environ.get("CEPA_WORKTREE_HOME")
                   or os.environ.get("CCW_WORKTREE_HOME")
                   or (Path.home() / "cepa-worktrees"))
    if wt_home.is_dir():
        prefix = f"{root.name}-"
        orphans = [d.name for d in wt_home.iterdir()
                   if d.is_dir() and d.name.startswith(prefix) and d.name not in registered]
        for o in orphans:
            warn("worktrees", f"diretório órfão {wt_home / o} (não registrado em git worktree) — lixo de sessão morta")
    if not any(r[1] == "worktrees" for r in RESULTS):
        ok("worktrees", "sem worktrees stale ou órfãs")

    # stale handoffs
    hdir = root / ".claude" / "handoffs"
    stale = 0
    for f in hdir.glob("*.md") if hdir.is_dir() else []:
        m = re.search(r"^updated_at:\s*(\S+)", f.read_text(encoding="utf-8", errors="replace"), re.M)
        a = age_days(m.group(1)) if m else None
        if a is not None and a > 30:
            stale += 1
            warn("handoffs", f"{f.name} sem update há {a:.0f}d — fatos dele são hipótese vencida; arquivar",
                 fix={"kind": "archive_handoff", "path": str(f)})
    if hdir.is_dir() and not stale:
        ok("handoffs", "sem handoffs vencidos")

    check_dirty_tree(root)
    check_env_manifest(root)
    check_twg_version(root)
    check_plan_divergence(root)
    check_awaiting_merge(root)
    check_until_waiting(root)
    check_queue_layout(root)


# ── Environment (docs/env.yaml, legacy .claude/env.yaml) ───────────────────

def env_manifest_list(path: Path, key: str):
    """Reads a top-level list key from env.yaml without pyyaml (shallow format —
    see docs/env-manifest.md). Supports block lists ('- item') and inline
    ('key: [a, b]'). Any problem → empty list (fail-silent)."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    items, in_key = [], False
    for raw in lines:
        if raw.lstrip().startswith("#"):
            continue
        line = re.sub(r"\s#.*$", "", raw.rstrip())
        if not line.strip():
            continue
        top = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if top:
            in_key = top.group(1) == key
            val = top.group(2).strip()
            if in_key and val:
                if val.startswith("[") and val.endswith("]"):
                    items.extend(x.strip().strip("'\"")
                                 for x in val[1:-1].split(",") if x.strip())
                else:
                    items.append(val.strip("'\""))
                in_key = False
            continue
        if in_key:
            item = re.match(r"^\s+-\s*(.+)$", line)
            if item:
                items.append(item.group(1).strip().strip("'\""))
    return [i for i in items if i]


def port_holder(port: str):
    """Who listens on TCP:<port>? Returns (pid, command, cwd) or None if free.
    Best-effort: lsof missing/error → None (port treated as free)."""
    try:
        p = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpc"],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    pid = cmd = None
    for line in p.stdout.splitlines():
        if line.startswith("p") and pid is None:
            pid = line[1:]
        elif line.startswith("c") and cmd is None:
            cmd = line[1:]
    if not pid:
        return None
    cwd = None
    try:
        q = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
                           capture_output=True, text=True, timeout=10)
        for line in q.stdout.splitlines():
            if line.startswith("n"):
                cwd = line[1:]
                break
    except Exception:
        pass
    return pid, cmd or "?", cwd


def queue_with_pending(root: Path):
    """Name of the repo's 1st `single-track` queue that has a `pending` item, or None.

    Shallow read, no pyyaml — same choice as `env_manifest_list`: the doctor
    runs on every session start and cannot depend on an installed
    dependency. What is searched for is literal and anchored at column zero of the item
    block, so regex is enough; any problem becomes None (fail-silent), because
    a diagnostic must not break the session launch.
    """
    for name, plan_file in candidate_queues(root):
        try:
            text = plan_file.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if not re.search(r"^mode:\s*single-track\s*$", text, re.M):
            continue
        if re.search(r"^\s+status:\s*pending\s*$", text, re.M):
            return name
    return None


def candidate_queues(root: Path):
    """[(name, file)] of the candidate queues in both layouts (new wins)."""
    if QP is None:
        return []
    return QP.queue_files(root)


def has_plans_dir(root: Path):
    return (root / ".claude" / "programs").is_dir() or \
        (root / ".claude" / "queues").is_dir()


def check_dirty_tree(root: Path):
    """Dirty tree with a queue waiting for unattended execution.

    The warning is GATED on the queue on purpose. A dirty tree is the normal state of
    someone who is working, and a warning on every session start is exactly the
    noise the user learns to skip — the same reason the brief mode does not
    print "all ok". What is not normal is having a pending queue AND a dirty
    tree, because then `cepa-until` REFUSES to launch, and finding that out at 11pm
    costs the whole window. So the doctor flags it earlier, at session start.
    """
    queue = queue_with_pending(root)
    if not queue:
        return
    dirty = dirty_files(str(root))
    if dirty is None:
        return
    # the record of previous runs does not count: `cepa-until` ignores it too
    dirty = [l for l in dirty
            if not re.match(r"^.. \.claude/(programs|queues)/[^/]+/until/", l)]
    if not dirty:
        ok("execucao", f"fila `{queue}` pendente e árvore limpa — "
                       f"`cepa-until {queue} --for 12h` larga sem recusa")
        return
    warn("execucao",
         f"árvore com {len(dirty)} arquivo(s) pendente(s) e a fila `{queue}` com "
         f"item a executar — o `cepa-until` RECUSA largar assim (é como ele "
         f"separa o que o run fez do que já estava aqui). Commite, limpe, ou "
         f"largue com --dirty-ok. Achar isso na hora de dormir custa a janela")


def check_env_manifest(root: Path):
    """Checks the environment manifest (docs/env.yaml, legacy .claude/env.yaml
    still read) against reality. Read-only: the declared `healthcheck:`
    is NEVER executed here."""
    if WT is None:
        return
    ef = WT.env_manifest_path(str(root))
    if ef is None:
        return
    ports = env_manifest_list(ef, "ports")
    services = env_manifest_list(ef, "services")
    if not ports and not services:
        ok("ambiente", f"{ef.relative_to(root)} presente, sem ports/services declarados")
        return

    root_real = os.path.realpath(str(root))
    for port in ports:
        if not str(port).isdigit():
            warn("ambiente", f"porta inválida no env.yaml: {port!r}")
            continue
        holder = port_holder(str(port))
        if holder is None:
            ok("ambiente", f"porta {port} livre")
            continue
        pid, cmd, cwd = holder
        cwd_real = os.path.realpath(cwd) if cwd else None
        if cwd_real and (cwd_real == root_real
                         or cwd_real.startswith(root_real + os.sep)):
            ok("ambiente", f"porta {port} em uso pelo próprio projeto ({cmd}, pid {pid})")
        else:
            warn("ambiente", f"porta {port} ocupada por {cmd} (pid {pid}, cwd {cwd or '?'}) "
                             f"— processo de OUTRO diretório; suba numa porta livre em vez de matá-lo")

    if services:
        try:
            p = subprocess.run(["docker", "ps", "--format", "{{.Names}}"],
                               capture_output=True, text=True, timeout=15)
        except Exception:
            return  # docker missing/unavailable → silent skip
        if p.returncode != 0:
            return  # daemon down → silent skip (best-effort)
        running = set(p.stdout.split())
        for svc in services:
            if svc in running:
                ok("ambiente", f"container {svc} rodando")
            else:
                warn("ambiente", f"container {svc} declarado no env.yaml não está no docker ps "
                                 f"— suba com o comando `up:` do manifest")


def installed_twg_version():
    """Installed `twg` (Atlassian) CLI version, extracted from the output of
    `twg --version` with regex `\\d+(\\.\\d+)+`. None when the CLI is not on
    PATH, the command fails, or the output has nothing that looks like a version.
    Short timeout and any exception become None — this check must never hang/break
    the doctor because of a third-party CLI."""
    try:
        p = subprocess.run(["twg", "--version"], capture_output=True, text=True, timeout=10)
    except Exception:  # noqa: BLE001
        return None
    m = re.search(r"\d+(?:\.\d+)+", (p.stdout or "") + (p.stderr or ""))
    return m.group(0) if m else None


def check_twg_version(root: Path):
    """Checks the installed `twg` CLI against the `twg_version:` declared in the
    environment manifest (see docs/env-manifest.md).

    `twg` runs a scheduler (`com.atlassian.twg.upkeep`) every 12 minutes
    that checks for updates on its own — the version can change BETWEEN two cards of the
    same unattended batch, with no signal at all. With no `twg_version:` declared,
    total silence: the doctor runs on every session start and an unrequested
    warning is noise.
    """
    if WT is None:
        return
    manifest = WT.env_manifest_path(str(root))
    if manifest is None:
        return
    declared = env_manifest_list(manifest, "twg_version")
    if not declared:
        return
    declared_v = declared[0]
    installed_v = installed_twg_version()
    if installed_v is None:
        warn("ambiente", f"env.yaml declara twg_version {declared_v}, mas a CLI `twg` "
                         f"não está instalada ou não está no PATH")
        return
    if installed_v == declared_v:
        ok("ambiente", f"twg {installed_v}, a versão declarada no env.yaml")
        return
    warn("ambiente", f"twg instalado está em {installed_v}, mas o env.yaml declara "
                     f"{declared_v} — o agendador `com.atlassian.twg.upkeep` atualiza "
                     f"a CLI sozinho, e o que os agentes leem da saída dela mudou de "
                     f"ferramenta desde então; reinstale a versão declarada ou atualize "
                     f"`twg_version:` depois de conferir")


# ── Single-track queue divergence (A3) ──────────────────────────────────
#
# Reports, never fixes: closing an orphan card or inventing a `**Plano:**` in
# BACKLOG.md is the owner's decision, not the doctor's. Delegates the whole
# calculation to `cepa-plan divergence`, which knows how to compare queue × BACKLOG (the
# live Jira read, cards_sem_item/itens_com_card_done, goes in the `--live` step
# of /common:doctor, which passes `--board`).

def resolve_single_track_queue(root: Path):
    """Name of this repo's `single-track` queue, resolved the same way
    /common:next does: `board-flow.yaml` → `defaults.project_key` first;
    otherwise, if there is exactly ONE `mode: single-track` queue in
    `.claude/queues/*/queue.yaml` (or the old layout
    `.claude/programs/*/plan.yaml`), that one. More than one → None (ambiguous — the
    doctor does not guess which queue the owner wants to see)."""
    bf = root / "board-flow.yaml"
    if bf.is_file():
        try:
            text = bf.read_text(encoding="utf-8", errors="replace")
            m = re.search(r"^\s*project_key:\s*['\"]?([\w-]+)", text, re.M)
            if m:
                return m.group(1)
        except OSError:
            pass
    queues = []
    for name, plan_file in candidate_queues(root):
        try:
            text = plan_file.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if re.search(r"^mode:\s*single-track\s*$", text, re.M):
            queues.append(name)
    return queues[0] if len(queues) == 1 else None


def check_plan_divergence(root: Path):
    backlog = root / "BACKLOG.md"
    if not backlog.is_file():
        return
    queue = resolve_single_track_queue(root)
    if queue is None:
        return  # no resolvable queue (none or more than one) — nothing to compare
    cepa_plan = Path(__file__).resolve().parent / "cepa-plan"
    if not cepa_plan.is_file():
        return
    try:
        p = subprocess.run(
            [sys.executable, str(cepa_plan), "divergencia", queue,
             "--backlog", str(backlog), "--repo", str(root), "--json"],
            capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001 — a diagnostic must not break the doctor
        warn("plano", f"divergência da fila `{queue}` não rodou: {e}")
        return
    if p.returncode not in (0,):
        return  # no queue / wave plan / read error — silent, cepa-plan already logs
    try:
        output = json.loads(p.stdout)
    except (ValueError, json.JSONDecodeError):
        return
    without_plan = output.get("secoes_sem_plano") or []
    nonexistent = output.get("plano_inexistente") or []
    if not without_plan and not nonexistent:
        ok("plano", f"fila `{queue}` × BACKLOG.md sem divergência")
        return
    parts = []
    if without_plan:
        parts.append(f"{len(without_plan)} seção(ões) do BACKLOG.md sem `**Plano:**`: "
                      + ", ".join(f"{s['secao']} (linha {s['linha']})" for s in without_plan))
    if nonexistent:
        parts.append(f"{len(nonexistent)} `**Plano:**` citando id fora da fila `{queue}`: "
                      + ", ".join(f"{i['secao']} → {i['plano']}" for i in nonexistent))
    warn("plano", f"fila `{queue}` × BACKLOG.md diverge — " + "; ".join(parts))


def maestro_programs():
    """The maestro plugin's lister: sibling of this file in the cepa repo, or in the
    marketplace clone. Without it (maestro not installed), None."""
    for base in (Path(__file__).resolve().parents[2], cepa_repo_root()):
        if base and (base / "maestro" / "bin" / "maestro-programs").is_file():
            return base / "maestro" / "bin" / "maestro-programs"
    return None


def check_queue_layout(root: Path):
    """The queue moved from `.claude/programs/<n>/plan.yaml` to
    `.claude/queues/<n>/queue.yaml`. A name in both layouts is a warning (the new one
    hides the old); an old queue alone is just a hint to migrate."""
    if QP is None:
        return
    legacy = []
    for name, queue_file in QP.queue_files(root):
        if QP.both_layouts(root, name):
            warn("fila", f"`{name}` existe nos dois layouts "
                         f"(.claude/queues e .claude/programs) — o novo "
                         f"esconde o antigo; apague o que sobrou depois de "
                         f"conferir qual vale")
        if queue_file.parent.parent.name == "programs":
            try:
                text = queue_file.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if re.search(r"^mode:\s*single-track\s*$", text, re.M):
                legacy.append(name)
    if legacy:
        ok("fila", f"{len(legacy)} fila(s) no layout antigo "
                   f"(.claude/programs: {', '.join(legacy)}) — "
                   "`cepa-plan migrate --all` move para .claude/queues")


def check_awaiting_merge(root: Path):
    """A Maestro wave that finished and nobody landed is a human action.

    The merge train only runs while the maestro session is alive. When it dies, the
    DONE slices wait without anything saying they are waiting (wave 1 of WEGO-paralelo,
    2026-08-24: five branches ready, merged by hand hours later). The rule
    belongs to maestro-wave-state; here it is only translated into ⚠.
    """
    mp = maestro_programs()
    if mp is None or not has_plans_dir(root):
        return
    try:
        p = subprocess.run([sys.executable, str(mp), str(root),
                            "--aguardando-merge", "--json"],
                           capture_output=True, text=True, timeout=30)
        if p.returncode != 0:
            return  # outside a git repo — the project check already said so
        programs = json.loads(p.stdout).get("programas") or []
    except Exception as e:  # noqa: BLE001 — a diagnostic must not break the doctor
        warn("maestro", f"checagem de merge pendente não rodou: {e}")
        return
    for program in programs:
        pending = program["aguardando_merge"]
        warn("maestro", f"programa `{program['nome']}`: {len(pending)} slice(s) "
                        f"terminada(s) esperando merge na onda {program['wave']} "
                        f"({', '.join(pending)}) — /maestro:resume {program['nome']} "
                        f"vai direto ao merge train")


def check_until_waiting(root: Path):
    """A `cepa-until` run that finished with the night's branch waiting for the
    owner (C6 of docs/estrategia-fim-do-cepa-until.md). The run does not touch the main
    branch, and without this warning nothing reminds anyone it is waiting: the same failure
    mode as the maestro wave nobody landed."""
    until = Path(__file__).resolve().parent / "cepa-until"
    if not until.is_file() or not has_plans_dir(root):
        return
    try:
        p = subprocess.run([sys.executable, str(until), "pendentes",
                            "--repo", str(root), "--json"],
                           capture_output=True, text=True, timeout=60)
        data = json.loads(p.stdout) if p.returncode == 0 else {}
        runs = data.get("runs") or []
        dead = data.get("mortos") or []
    except Exception as e:  # noqa: BLE001 — a diagnostic must not break the doctor
        warn("until", f"checagem de run esperando o dono não rodou: {e}")
        return
    # A `rodando` run whose supervisor died (WEGO 2026-09-28-2003): the record
    # stopped midway, and the full build of the last `done` never ran. The sentence
    # and the command come ready-made from `pendentes`.
    for m in dead:
        item = ""
        if m.get("item"):
            item = f"; {m['item']} ficou `{m.get('status')}`"
        warn("until", f"fila `{m['fila']}`: o supervisor do run {m['run']} "
                      f"morreu sem fechar o registro ({m['como']}){item} — "
                      + (f"o build completo que faltou: {m['comando']}"
                         if m.get("comando") else
                         "o run não tinha build completo")
                      + (f"; {m['fechar']} mostra o plano, com --yes roda o "
                         "build e deixa o run pronto para aterrissar"
                         if m.get("fechar") else ""))
    for r in runs:
        warn("until", f"fila `{r['fila']}`: o run {r['run']} deixou "
                      f"`{r['branch']}` esperando aterrissagem em "
                      f"`{r['destino']}` — {r['comando']} mostra o plano, "
                      "com --yes executa")


# ── Batch fixes (--fix) ─────────────────────────────────────────────────
#
# Why it exists: without it the cycle is "find 1 → propose → confirm → find the
# next → propose → confirm...", and the preparation consumes more attention than the
# task. Here the mechanical fixes become a single batch, applied at once,
# with the diagnosis rerunning until it stops changing.

def auto_install_allowed():
    """May `--fix` reinstall the plugins? Two closed doors.

    `fix_install` runs the cepa repo's `bin/install.sh` — the machine's REAL
    installation, regardless of the directory the doctor was called from. That is
    what we want in a session preflight, and exactly what we do NOT want
    when the caller was a test: on 2026-08-19 the doctor's own suite,
    running in temporary repositories, saw the repo ahead of the cache and swapped
    the owner's live installation in the middle of `python3 tests/...`. A test that swaps the
    installed harness can cause the very failure the doctor exists to find.

    Door 1: CEPA_DOCTOR_INSTALL=off turns it off explicitly.
    Door 2: doctor called from inside a temporary directory — nobody
    keeps a real project there, and it is where every suite runs. It works as a net for the
    test not yet written that will forget door 1.
    """
    if os.environ.get("CEPA_DOCTOR_INSTALL", "on").lower() == "off":
        return False
    try:
        cwd = Path.cwd().resolve()
    except OSError:
        return False          # without knowing where we are, nothing is reinstalled
    # gettempdir() alone is not enough: on macOS it points to /var/folders/...
    # and a suite running from /tmp would slip through.
    for base in (tempfile.gettempdir(), "/tmp", "/private/tmp", "/var/folders"):
        try:
            cwd.relative_to(Path(base).resolve())
            return False
        except (ValueError, OSError):
            continue
    return True


def fix_install(fx):
    if not auto_install_allowed():
        return False, ("reinstalar plugins é a única correção que sai do projeto e mexe "
                       "na instalação da máquina — desligada aqui; rode bin/install.sh à mão")
    repo = fx.get("repo")
    script = Path(repo) / "bin" / "install.sh" if repo else None
    if not script or not script.is_file():
        return False, f"bin/install.sh não encontrado em {repo}"
    try:
        p = subprocess.run(["bash", str(script)], capture_output=True, text=True,
                           timeout=600, cwd=repo)
    except Exception as e:  # noqa: BLE001
        return False, f"install.sh não rodou: {e}"
    if p.returncode != 0:
        tail = (p.stderr or p.stdout or "").strip().splitlines()
        return False, f"install.sh saiu {p.returncode}: {tail[-1][:160] if tail else 'sem saída'}"
    return True, "plugins reinstalados a partir do repo"


def fix_archive_handoff(fx):
    src = Path(fx["path"])
    dest_dir = src.parent / "archive"
    try:
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest = dest_dir / src.name
        if dest.exists():
            dest = dest_dir / f"{src.stem}-{int(datetime.now(timezone.utc).timestamp())}{src.suffix}"
        src.rename(dest)
    except OSError as e:
        return False, f"não deu para arquivar {src.name}: {e}"
    return True, f"{src.name} movido para {dest_dir}/ (nada apagado)"


def fix_worktree_prune(fx):
    rc, _, err = git(["worktree", "prune"], cwd=fx["root"])
    if rc != 0:
        return False, f"git worktree prune falhou: {err.strip()[:160]}"
    return True, "registros de worktree órfãos limpos"


def fix_internal_worktree(fx):
    """Removes a forgotten agent worktree — only when it holds no work.

    The three locks are deliberate and redundant: the diagnosis already checked, but
    a whole session fits between diagnosing and fixing, and what is lost here
    does not come back. In the real case there was a WEGO-2037 measurement test that only existed
    inside the worktree.
    """
    path, root = fx["path"], fx["root"]
    branch, base = fx.get("branch") or "", fx.get("base") or "main"

    dirty = dirty_files(path)
    if dirty is None:
        return False, f"não deu para ler o estado de {path} — nada removido"
    if dirty:
        return False, (f"{Path(path).name} ganhou {len(dirty)} arquivo(s) pendente(s) "
                       f"desde o diagnóstico — nada removido")
    if not is_contained_in_base(Path(root), branch or "HEAD", base):
        return False, f"{Path(path).name} tem commit que {base} não tem — nada removido"

    # no --force on purpose: git itself refuses if there is still dirt.
    rc, _, err = git(["worktree", "remove", path], cwd=root)
    if rc != 0:
        return False, f"git worktree remove recusou: {err.strip()[:160]}"
    msg = f"worktree de agente {Path(path).name} removida"
    if branch:
        # -d, never -D: if git thinks the branch is not merged, it stays.
        rc, _, err = git(["branch", "-d", branch], cwd=root)
        msg += f" e branch {branch} apagada" if rc == 0 else f" (branch {branch} mantida: {err.strip()[:80]})"
    return True, msg


FIXERS = {
    "install": fix_install,
    "archive_handoff": fix_archive_handoff,
    "worktree_prune": fix_worktree_prune,
    "internal_worktree": fix_internal_worktree,
}

# Plain-language label per fix kind — the report speaks of the effect, not the command.
FIX_LABEL = {
    "install": "reinstalar os plugins (o que está valendo passa a ser o que está no repo)",
    "archive_handoff": "arquivar handoff vencido (move para archive/, não apaga)",
    "worktree_prune": "limpar registro de worktree cujo diretório já não existe",
    "internal_worktree": "remover worktree de agente esquecida dentro do repo (só a que não guarda trabalho)",
}


def fix_key(fx):
    """Identity of a fix — the same key used to avoid repeating it."""
    return (fx["kind"], fx.get("path") or fx.get("repo") or fx.get("root") or "")


def pending_fixes():
    """Automatic fixes for the current findings, without repeating the same one twice."""
    seen, out = set(), []
    for level, _area, _msg, fx in RESULTS:
        if level == "ok" or not fx:
            continue
        # Without this line the blocked install would become "failed to fix" instead
        # of "this is on you" — and the report would lie about what happened.
        if fx["kind"] == "install" and not auto_install_allowed():
            continue
        key = fix_key(fx)
        if key in seen:
            continue
        seen.add(key)
        out.append(fx)
    return out


def run_checks(project_only=False):
    """`--projeto` cuts the global checks (settings, plugins, hooks, telemetry).

    It exists because the doctor's verdict mixed two questions: "is this project
    healthy?" and "is this machine's installation healthy?". For whoever only wants to look at
    the project — and for the test suite, which cannot depend on the state of the
    machine of whoever runs it — the second half is noise that changes the exit code.
    """
    RESULTS.clear()
    if project_only:
        check_project(Path.cwd())
        return
    settings = check_settings()
    rec = last_install()
    check_ops(rec)
    check_plugins(settings, rec)
    check_stale_sessions()
    check_hooks_compile()
    check_telemetry()
    check_project(Path.cwd())


def apply_fixes(max_passes=3, project_only=False):
    """Applies everything that is automatic, re-diagnosing between rounds.

    Rerunning is the point: a fix changes what the other checks see (the
    install, for example, swaps the cache that the hooks check compiles). Without it
    the user would go back to being the loop between one fix and the next.
    """
    applied, failed = [], []
    attempted = set()
    for _ in range(max_passes):
        todo = [fx for fx in pending_fixes() if fix_key(fx) not in attempted]
        if not todo:
            break
        for fx in todo:
            fixer = FIXERS.get(fx["kind"])
            if not fixer:
                continue
            # One attempt per fix, even if the finding survives. Without
            # this, a fix that does not resolve its own finding was redone on
            # every pass: the report listed the same line three times and the
            # doctor ran a whole install three times for nothing.
            attempted.add(fix_key(fx))
            good, msg = fixer(fx)
            (applied if good else failed).append((fx["kind"], msg))
        run_checks(project_only=project_only)
    return applied, failed


# ── Main ────────────────────────────────────────────────────────────────

def stamp_path():
    rc, out, _ = git(["rev-parse", "--show-toplevel"], cwd=str(Path.cwd()))
    if rc != 0:
        return None
    return Path(out.strip()) / ".claude" / "doctor-last-run"


def stamp_run():
    """Writes the stamp that the session-registry daily nudge consults."""
    stamp = stamp_path()
    if stamp is None:
        return
    try:
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.write_text(datetime.now(timezone.utc).isoformat(timespec="seconds") + "\n")
    except OSError:
        pass


def fresh_within(hours: float) -> bool:
    """Has the diagnosis run in this repo less than `hours` ago?

    It is what allows hanging the preflight on the opening of EVERY session (the `cepa`
    wrapper) without charging for the diagnosis every time: the first session of the day pays,
    the following ones exit right away.
    """
    stamp = stamp_path()
    if stamp is None or not stamp.exists():
        return False
    try:
        a = age_days(stamp.read_text().strip())
    except OSError:
        return False
    return a is not None and a * 24 < hours


def parse_if_stale(argv):
    """`--if-stale H` (or `--if-stale=H`): only run if the last diagnosis
    in this repo is more than H hours old. Returns the hours, or None."""
    for i, a in enumerate(argv):
        if a.startswith("--if-stale="):
            val = a.split("=", 1)[1]
        elif a == "--if-stale" and i + 1 < len(argv):
            val = argv[i + 1]
        else:
            continue
        try:
            return float(val)
        except ValueError:
            return None
    return None


HELP = """\
usage: cepa-doctor [--fix] [--brief] [--projeto] [--if-stale H]

Validates the harness installation against reality, in 30 seconds.

Almost every infrastructure failure of the harness shows up in the middle of a
task, at the worst time: a plugin that did not load, a board-flow.yaml from
another module, an expired build baseline, an orphan worktree, a stale handoff
after a rename. This command turns that into half a minute of maintenance.

Global checks (independent of the project):
  - settings.json parses and the @cepa plugins are enabled
  - each plugin's version in the repo against the installed cache (edited
    without reinstalling)
  - open sessions running hooks from a version the cache no longer has
  - every .py hook in the cache compiles
  - telemetry directory is writable

Project checks (current directory):
  - it is a git repo (without git the rituals degrade)
  - board-flow.yaml: minimal structure of the defaults block
  - .claude/last-build.json: status and age of the build baseline
  - session/* worktrees: stale (>14d without a commit) and orphan directories
  - forgotten agent worktree INSIDE the repo (.claude/worktrees/)
  - handoffs not updated for >30d
  - single-track queue diverging from BACKLOG.md
  - cepa-until runs waiting for the owner or with a dead supervisor
  - environment manifest (docs/env.yaml): ports held by a process from
    ANOTHER directory and `services` containers missing from docker ps
  - installed `twg` version against the one declared in the environment manifest

Output: ✓ / ⚠ / ✗ per check; then the list of what has a mechanical fix and
the list of what needs you. The LIVE check of board-flow.yaml against Jira
does not happen here (script without MCP): /common:doctor --live delegates
that part to atlassian-expert.

options:
  --fix          applies all mechanical fixes at once (reinstall plugins,
                 archive expired handoff, clean orphan worktree); what is your
                 decision stays in the "Precisa de você" list
  --brief        only the one-line summary; with nothing to say, prints nothing
                 (the mode `cepa` uses when opening a session)
  --projeto      only the project checks, skips the global ones
  --if-stale H   only runs if the last diagnosis in this repo is older than H
                 hours; otherwise exits silently (the `cepa` preflight)
  -h, --help     this help

examples:
  cepa-doctor                    # the full diagnosis
  cepa-doctor --fix              # diagnosis + mechanical fixes
  cepa-doctor --brief --if-stale 12

exit: 0 = all ok · 1 = warnings only · 2 = some failure
"""


def main():
    argv = sys.argv[1:]
    if any(a in ("-h", "--help", "help", "ajuda") for a in argv):
        print(HELP, end="")
        return 0
    do_fix = "--fix" in argv
    brief = "--brief" in argv
    project_only = "--projeto" in argv

    # Session-start preflight: silent and cheap when there is nothing to
    # say. Without it the wrapper would charge the whole diagnosis on every `cepa`.
    stale_h = parse_if_stale(argv)
    if stale_h is not None and fresh_within(stale_h):
        return 0

    run_checks(project_only=project_only)

    applied, failed = ([], [])
    if do_fix:
        applied, failed = apply_fixes(project_only=project_only)
    stamp_run()

    icons = {"ok": "✓", "warn": "⚠", "fail": "✗"}
    order = {"fail": 0, "warn": 1, "ok": 2}
    fails = sum(1 for r in RESULTS if r[0] == "fail")
    warns = sum(1 for r in RESULTS if r[0] == "warn")

    if not brief:
        print("# cepa-doctor\n")
        for level, area, msg, _fx in sorted(RESULTS, key=lambda r: (order[r[0]], r[1])):
            print(f" {icons[level]} [{area}] {msg}")
        print(f"\n{fails} falha(s), {warns} aviso(s), "
              f"{sum(1 for r in RESULTS if r[0] == 'ok')} ok.")
    elif not (applied or failed or fails or warns):
        # Brief mode and nothing to say: print nothing. An "all ok" line
        # on every session start is noise the user learns to skip.
        return 0
    else:
        print(f"cepa-doctor: {fails} falha(s), {warns} aviso(s)"
              + (f", {len(applied)} corrigida(s) automaticamente" if applied else ""))

    if do_fix and brief:
        for kind, msg in applied:
            print(f" ✓ {FIX_LABEL.get(kind, kind)}")
        for kind, msg in failed:
            print(f" ✗ {FIX_LABEL.get(kind, kind)} — {msg}")
    elif do_fix:
        print("\n## Corrigido automaticamente")
        if applied:
            for kind, msg in applied:
                print(f" ✓ {FIX_LABEL.get(kind, kind)} — {msg}")
        else:
            print(" (nada a corrigir automaticamente)")
        if failed:
            print("\n## Tentei corrigir e não deu")
            for kind, msg in failed:
                print(f" ✗ {FIX_LABEL.get(kind, kind)} — {msg}")
    elif not brief:
        auto = pending_fixes()
        if auto:
            print(f"\n{len(auto)} achado(s) têm correção mecânica — "
                  f"`cepa-doctor --fix` aplica todas de uma vez:")
            for fx in auto:
                print(f" · {FIX_LABEL.get(fx['kind'], fx['kind'])}")

    # What is left after the batch is what really costs attention: each of these
    # is a CHOICE (discard work, edit config, decide between reinstalling
    # and rolling back), not a mechanical task — so none is applied automatically.
    manual = [(lvl, area, msg) for lvl, area, msg, fx in RESULTS
              if lvl != "ok" and not fx]
    if manual and brief:
        # At session launch the user needs to know THAT something exists and what
        # it is, not the whole paragraph of each finding.
        print(f" ⚠ {len(manual)} pendência(s) que só você decide "
              f"({', '.join(sorted({a for _l, a, _m in manual}))}) — "
              f"veja com: /common:doctor")
    elif manual:
        print("\n## Precisa de você (não mexi — cada um é uma decisão)")
        for _lvl, area, msg in manual:
            print(f" · [{area}] {msg}")

    return 2 if fails else (1 if warns else 0)


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
