#!/usr/bin/env python3
"""cepa-modes — shows the table of work modes and their exit conditions.

Every session declares a mode, and the mode is a STATE that lasts until the
exit condition is met. Whoever forgets a mode's purpose mid-work will not open
`docs/modos-de-trabalho.md`, which has 307 lines — they will guess. This
command is the table, and nothing beyond it.

The source is `common/hooks/_modes.py`, the same file `session-mode.py` reads
to inject the exit condition on every turn. One table, two readers.

Usage:
    cepa-modes              # the whole table; marks the current session's mode
    cepa-modes <name>       # a single mode, with entry/produces/exit/gate
    cepa-modes --purposes # one line per mode: what it is for
    cepa-modes --json
    cepa-modes --exit       # the exit verdict of this session's mode, from the disk
    cepa-modes --menu <name> # the mode's menu of common actions, numbered, filtered by this repo

`--exit` is the verdict that exploration lacked: it reads docs/reviews/ and
says which of the three parts of the exit condition are on disk (panel saved,
strategy document it ran over, owner's decision on each named disagreement).
rc 0 = closed, 1 = still open, 2 = the mode has no mechanical verdict here.

`--menu` is the ONLY place that builds the menu text (`actions` of `_modes.py`).
An action whose `needs` the repo does not meet (`file:<path>` at the repo root,
`topology:<name>` = content of `.claude/topology`, `plugin:<name>` installed and
enabled, checked like `cepa-doctor` does via `_pluginver.scan`) is left out; of
variants sharing a label only the first that passes shows; at most 5 lines.
A mode with no actions prints nothing and returns 0. `--menu <mode> --json` is the
same list as data, read by the session-mode hook on the opening turn.
"""

import json
import os
import subprocess
import sys
import textwrap
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402
import _clihelp  # noqa: E402
try:
    import _pluginver as PV
except ImportError:  # same fallback as cepa-doctor: no comparator, no plugin knowledge
    PV = None
try:
    from _modes import MODES, read_session_mode, normalize_mode, exploration_exit
except ImportError:
    print("✗ cepa-modes: não achei common/hooks/_modes.py", file=sys.stderr)
    sys.exit(2)

# `--json` keeps the legacy (pt-BR) keys of the table: compass reads `saida`
# from it, and the output was settled by item `interface-in-english`.
_JSON_KEYS = {"purpose": "proposito", "entry": "entrada", "produces": "produz",
              "exit": "saida", "gate": "gate", "write": "escrita"}

BOLD, DIM, YELLOW, GREEN, RESET = "\033[1m", "\033[2m", "\033[33m", "\033[32m", "\033[0m"


def repo_root():
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=5)
        return out.stdout.strip() if out.returncode == 0 else os.getcwd()
    except (OSError, subprocess.SubprocessError):
        return os.getcwd()


def session_mode():
    """The mode declared in this tree, if any — the same file the hook reads.
    Reads `mode:` (or the old `modo:`) and always returns the new name."""
    return (read_session_mode(repo_root()) or {}).get("mode")


def render_exit(name):
    """`--exit`: the exit verdict of `name` computed from the disk. Only
    exploration has one (the other modes close by their own gates)."""
    if name != "exploration":
        print(f"{YELLOW}{name}{RESET} não tem veredito mecânico de saída aqui. "
              f"Fecha quando: {MODES[name]['exit']}.")
        return 2
    v = exploration_exit(repo_root())
    ok = sum(1 for _, good, _ in v["items"] if good)
    print(f"{BOLD}Saída da exploração{RESET} — {ok}/{len(v['items'])} no disco"
          + (f" (painel: {v['panel']})" if v["panel"] else ""))
    for label, good, detail in v["items"]:
        mark = f"{GREEN}✓{RESET}" if good else f"{YELLOW}✗{RESET}"
        print(f"  {mark} {label}" + (f"\n      {DIM}{detail}{RESET}" if detail else ""))
    if v["closed"]:
        print(f"\n{GREEN}FECHADA.{RESET} Próximo modo: {YELLOW}{v['next_mode']}{RESET} "
              f"— `cepa --mode {v['next_mode']}` em nova sessão.")
        return 0
    print(f"\n{YELLOW}ABERTA.{RESET} O modo só fecha com as três no disco. A decisão do dono "
          f"vai na linha `**Decisão do dono:**` de cada discordância do painel.")
    return 1


MENU_MAX = 5


def installed_plugins():
    """Names of the plugins installed AND enabled, the way `cepa-doctor`
    (check_plugins) decides it: `_pluginver.scan` over the marketplace repo,
    with `enabledPlugins` of ~/.claude/settings.json. Never raises."""
    if PV is None:
        return set()
    try:
        settings = json.loads((Path.home() / ".claude" / "settings.json")
                              .read_text(encoding="utf-8"))
        enabled = settings.get("enabledPlugins", {})
    except (OSError, ValueError, AttributeError):
        return set()
    try:
        return {p["name"] for p in PV.scan(PV.cepa_repo_root(), enabled)
                if p["enabled"] and not p["missing"]}
    except Exception:  # noqa: BLE001
        return set()


def need_met(need, root, plugins):
    kind, _, value = str(need).partition(":")
    if kind == "file":
        return os.path.exists(os.path.join(root, value))
    if kind == "topology":
        try:
            return (Path(root) / ".claude" / "topology").read_text(
                encoding="utf-8").strip() == value
        except OSError:
            return False
    if kind == "plugin":
        return value in plugins
    return False  # unknown requirement type: the action does not show


def menu_actions(name, root):
    """The actions of `name` that pass the filter: the first variant per label, max MENU_MAX."""
    plugins = installed_plugins()
    shown, seen = [], set()
    for a in MODES[name].get("actions", []):
        if a["label"] in seen:
            continue
        if all(need_met(n, root, plugins) for n in a.get("needs", [])):
            seen.add(a["label"])
            shown.append(a)
        if len(shown) == MENU_MAX:
            break
    return shown


def _commands(action):
    cmd = action.get("command")
    return [cmd] if isinstance(cmd, str) else list(cmd or [])


def render_menu(name, as_json=False):
    """`--menu`: numbered lines "N) label: command" (a sequence reads "a, then b").

    With `--json`, the same filtered list as data (`n`, `label`, `commands`, `ask`),
    for the session-mode hook: it writes the reply rules of the opening turn and
    must number the actions exactly as the text the owner sees."""
    shown = menu_actions(name, repo_root())
    if as_json:
        print(json.dumps([{"n": i, "label": a["label"], "commands": _commands(a),
                           "ask": a.get("ask")} for i, a in enumerate(shown, 1)],
                         ensure_ascii=False))
        return 0
    for i, a in enumerate(shown, 1):
        cmds = _commands(a)
        print(f"{i}) {a['label']}" + (f": {', then '.join(cmds)}" if cmds else ""))
    return 0


def render_block(name, info, current, color):
    mark = f"  {GREEN}◀ esta sessão{RESET}" if name == current else ""
    lines = [f"{BOLD}{YELLOW}{name}{RESET}{mark}"]
    for label, key in (("serve para", "purpose"), ("entra com", "entry"), ("produz", "produces"),
                       ("fecha quando", "exit"), ("gate", "gate")):
        body = textwrap.fill(info[key], width=78,
                              initial_indent="", subsequent_indent=" " * 16)
        tag = f"{DIM}{label:>13}{RESET} " if color else f"{label:>13} "
        lines.append(f"  {tag}{body}")
    return "\n".join(lines)


def main():
    ap = _clihelp.Parser(
        prog="cepa modes",
        description=(
            "Every session declares a mode, and the mode is a STATE that lasts until\n"
            "its exit condition is met. Whoever forgets the mode's purpose mid-work\n"
            "will not open docs/modos-de-trabalho.md: they will guess. This command\n"
            "is the table and nothing else. The source is common/hooks/_modes.py,\n"
            "the same one the session hook reads.\n"
            "\n"
            "--menu MODE prints that mode's menu of common actions (numbered, with the\n"
            "command of each), dropping the ones this repo cannot run.\n"
            "\n"
            "--exit is the verdict exploration lacked: it reads docs/reviews/ and says\n"
            "which of the three parts of the exit condition are on disk (panel saved,\n"
            "the strategy document it ran over, the owner's decision on each named\n"
            "disagreement). Only exploration has a mechanical verdict."),
        examples=[
            ("cepa modes", "the whole table; marks this session's mode"),
            ("cepa modes exploration", "one mode: enters with, produces, closes when, gate"),
            ("cepa modes --purposes", "one line per mode: what it is for"),
            ("cepa modes --exit", "the exit verdict of this session's mode"),
            ("cepa modes --menu discovery", "the numbered menu of common actions of a mode"),
            ("cepa modes --json", "the table as JSON (pt-BR keys), for code"),
        ],
        exit_codes=[
            (0, "table printed; with --exit, the mode is closed"),
            (1, "with --exit, the mode is still open"),
            (2, "invalid usage or unknown mode; with --exit, no mode declared in this "
                "tree or the mode has no mechanical verdict here"),
        ],
        see_also=["docs/modos-de-trabalho.md: the full design of the work modes",
                  "cepa --mode help: the same purposes, from the launcher"])
    ap.add_argument("mode", nargs="?", metavar="MODE", help="only this mode (default: all)")
    ap.add_argument("--json", action="store_true", dest="as_json",
                    help="JSON output, for code")
    ap.add_argument("--purposes", "--propositos", action="store_true", dest="purposes",
                    help="one line per mode: what it is for")
    ap.add_argument("--exit", "--saida", action="store_true", dest="exit_",
                    help="exit verdict of this session's mode (or of the given mode), read from disk")
    ap.add_argument("--menu", metavar="MODE", dest="menu",
                    help="the numbered menu of common actions of MODE, filtered by this repo")
    ap.add_argument("--no-color", "--sem-cor", action="store_true", dest="no_color",
                    help="no terminal colors")
    args = ap.parse_args()

    color = not args.no_color and sys.stdout.isatty()
    if not color:
        global BOLD, DIM, YELLOW, GREEN, RESET
        BOLD = DIM = YELLOW = GREEN = RESET = ""

    if args.mode:
        args.mode = normalize_mode(args.mode)  # the old name (`reforma`) still works
    if args.mode and args.mode not in MODES:
        print(f"✗ modo desconhecido: {args.mode}\n  válidos: {', '.join(MODES)}",
              file=sys.stderr)
        return 2

    if args.menu:
        name = normalize_mode(args.menu)
        if name not in MODES:
            print(f"✗ modo desconhecido: {name}\n  válidos: {', '.join(MODES)}",
                  file=sys.stderr)
            return 2
        return render_menu(name, as_json=args.as_json)

    if args.exit_:
        name = args.mode or session_mode()
        if not name:
            print("✗ esta árvore não tem modo declarado; diga qual: cepa-modes --exit exploration",
                  file=sys.stderr)
            return 2
        return render_exit(name)

    target = {args.mode: MODES[args.mode]} if args.mode else MODES
    if args.as_json:
        legacy = {n: {_JSON_KEYS.get(k, k): v for k, v in d.items()} for n, d in target.items()}
        print(json.dumps(legacy, indent=2, ensure_ascii=False))
        return 0

    if args.purposes:
        print(f"{BOLD}Work modes{RESET} — what each one is for:")
        width = max(len(n) for n in target)
        for name, info in target.items():
            body = textwrap.fill(info["purpose"], width=78,
                                 initial_indent="", subsequent_indent=" " * (width + 4))
            print(f"  {YELLOW}{name:<{width}}{RESET}  {body}")
        print(f"\n{DIM}The whole table (enters with / produces / closes when / gate): "
              f"cepa-modes{RESET}")
        return 0

    current = session_mode()
    print(f"{BOLD}Modos de trabalho{RESET} — um estado que dura até a condição de "
          f"saída ser satisfeita.")
    print(f"{DIM}Nenhuma sessão sobe sem modo. Desenho completo: "
          f"docs/modos-de-trabalho.md{RESET}\n")
    for name, info in target.items():
        print(render_block(name, info, current, color))
        print()
    if not args.mode:
        if current:
            print(f"{DIM}Modo desta sessão: {RESET}{YELLOW}{current}{RESET}"
                  f"{DIM} — trocar exige nova sessão (`cepa --mode <x>`).{RESET}")
        else:
            print(f"{DIM}Esta árvore não tem modo declarado.{RESET}")
        print(f"{DIM}Falta o 8º, `deploy`: fora da rodada por decisão do dono — "
              f"é o único que depende de infra externa.{RESET}")
    return 0


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
