#!/usr/bin/env python3
"""cepa-clock — para onde foi o tempo de relógio de uma sessão.

## Why it exists

Until 2026-08-26 nobody in this harness knew where the time of a long routine
was spent; the going guess was "build". The first real measurement, over five
recorded runs, said otherwise:

| run                     | clock   | active wait  | build |
|-------------------------|---------|--------------|-------|
| session/drain-plan-0840 |  299min |  155min (52%)|   16% |
| session/exec-17081128   |  636min |  146min (23%)|    9% |
| session/todo-21081818   |  924min |  194min (21%)|    6% |
| session/todo-1413       | 1098min |  241min (22%)|   11% |
| session/todo-22081827   |  913min |  176min (19%)|    9% |

"Active wait" is a Bash command that stays blocked without working: `until ...;
do sleep; done` (the lead polling the disk for a worker's file) and burn loops
(`for i in $(seq 1 6000); do git log; done`) used as an improvised `sleep`.
`no-busy-wait.py` now blocks both; this script is how to check that the
barrier paid off, and how to measure the next suspect.

## How it reads

The source is the transcript Claude Code writes to `~/.claude/projects/<slug>/`,
plus one file per subagent in `<session>/subagents/`. The duration of a tool
call is the interval between the agent message that fired it and the result
record. Agents run in parallel, so overlapping intervals are MERGED before
summing — without that the same minute would be counted once per agent and the
sum would exceed the clock.

Honest caveat: the clock runs from the first to the last event of the session.
In an interactive session that includes the time it sat waiting for YOU, and
then the percentages come out diluted. The ABSOLUTE MINUTES are the reliable
number; the percentage is only comparable between non-interactive runs.

(JSON keys and telemetry fields keep their pt-BR names: relogio_s, espera_s,
build_s, outro_s.)

Usage:
    cepa-clock                      # the most recent session of this repo
    cepa-clock --slug <slug>        # a named session
    cepa-clock --all --days 7       # every session of the last week
    cepa-clock --emit               # writes to the telemetry ledger
    cepa-clock --json
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402

PROJECTS = Path.home() / ".claude" / "projects"
WAIT_RE = re.compile(r"\buntil\b|\bsleep\b|\bwhile\b|\bfor\b.*\bseq\b")
BUILD_RE = re.compile(r"\bmvn|\bgradle|npm (run )?(test|build)|\bpytest\b|\bcargo (test|build)")


def _parse_ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def _lines(path):
    try:
        for line in open(path, errors="replace"):
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except ValueError:
                continue
    except OSError:
        return


def _calls(path):
    """(name, command, t0, t1) of each tool call that got a result."""
    uses, stamps = {}, []
    for line in _lines(path):
        if line.get("timestamp"):
            stamps.append(_parse_ts(line["timestamp"]))
        msg = line.get("message")
        if not isinstance(msg, dict) or not isinstance(msg.get("content"), list):
            continue
        for c in msg["content"]:
            if not isinstance(c, dict):
                continue
            if line.get("type") == "assistant" and c.get("type") == "tool_use":
                uses[c["id"]] = {"name": c.get("name", "?"),
                                 "command": (c.get("input") or {}).get("command", "") or "",
                                 "t0": _parse_ts(line["timestamp"])}
            elif line.get("type") == "user" and c.get("type") == "tool_result":
                u = uses.get(c.get("tool_use_id"))
                if u:
                    u["t1"] = _parse_ts(line["timestamp"])
    return [u for u in uses.values() if "t1" in u], stamps


def _union(intervals):
    if not intervals:
        return 0.0
    ordered = sorted(intervals)
    merged = [list(ordered[0])]
    for a, b in ordered[1:]:
        if a <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], b)
        else:
            merged.append([a, b])
    return sum((b - a).total_seconds() for a, b in merged)


def measure(session: Path):
    """session = the main session .jsonl; subagents live in the sibling dir."""
    files = [str(session)] + sorted(glob.glob(str(session.with_suffix("")) + "/subagents/agent-*.jsonl"))
    wait, build, other, all_stamps = [], [], [], []
    wait_by_agent, n = Counter(), Counter()
    for f in files:
        meta = f.replace(".jsonl", ".meta.json")
        kind = "main"
        if os.path.exists(meta):
            try:
                kind = json.load(open(meta)).get("agentType") or "?"
            except (OSError, ValueError):
                kind = "?"
        calls, stamps = _calls(f)
        all_stamps += stamps
        for u in calls:
            iv = (u["t0"], u["t1"])
            if u["name"] != "Bash":
                if u["name"] != "Task":       # Task wraps the others; it would double-count
                    other.append(iv)
                continue
            if BUILD_RE.search(u["command"]):
                build.append(iv)
                n["build"] += 1
            elif WAIT_RE.search(u["command"]):
                wait.append(iv)
                n["espera"] += 1
                wait_by_agent[kind] += (u["t1"] - u["t0"]).total_seconds()
            else:
                other.append(iv)
                n["outro"] += 1
    if not all_stamps:
        return None
    clock = (max(all_stamps) - min(all_stamps)).total_seconds()
    return {"slug": session.parent.name, "sessao": session.stem,
            "inicio": min(all_stamps).isoformat(timespec="seconds"),
            "relogio_s": clock, "espera_s": _union(wait), "build_s": _union(build),
            "outro_s": _union(other), "agentes": len(files) - 1,
            "n": dict(n), "por_agente": dict(wait_by_agent.most_common(4))}


def _cwd_slug():
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        root = ""
    return (root or os.getcwd()).replace("/", "-").replace(".", "-")


def sessions(slug=None, all_sessions=False, days=30):
    cutoff = datetime.now(timezone.utc) - timedelta(days=days)
    dirs = [PROJECTS / slug] if slug else sorted(PROJECTS.glob("*"))
    if not slug and not all_sessions:
        target = _cwd_slug()
        dirs = [d for d in dirs if d.name == target] or dirs
    found = []
    for d in dirs:
        if not d.is_dir():
            continue
        for f in d.glob("*.jsonl"):
            if datetime.fromtimestamp(f.stat().st_mtime, timezone.utc) >= cutoff:
                found.append(f)
    found.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    return found if all_sessions else found[:1]


def report(r):
    w = r["relogio_s"] or 1
    def row(label, s, extra=""):
        return f"  {label:24}{s/60:7.1f} min  {s/w*100:5.1f}%  {extra}"
    out = [f"{r['sessao'][:8]} · {r['slug'][:52]}",
           f"  início {r['inicio']} · {r['agentes']} subagentes · "
           f"relógio {r['relogio_s']/60:.0f} min",
           row("espera ativa", r["espera_s"], f"({r['n'].get('espera', 0)} chamadas)"),
           row("build", r["build_s"], f"({r['n'].get('build', 0)} chamadas)"),
           row("bash normal", r["outro_s"], f"({r['n'].get('outro', 0)} chamadas)"),
           row("fora de ferramenta", max(0.0, w - r["espera_s"] - r["build_s"] - r["outro_s"]),
               "(geração dos agentes)")]
    if r["por_agente"]:
        top = ", ".join(f"{k}={v/60:.0f}min" for k, v in r["por_agente"].items())
        out.append(f"  espera por agente: {top}")
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(
        prog="cepa-clock",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Onde foi parar o relógio de uma sessão.\n"
            "\n"
            "Lê a transcrição que o Claude Code grava em ~/.claude/projects/<slug>/\n"
            "(mais um arquivo por subagente) e separa o tempo da sessão em espera\n"
            "ativa (um comando Bash parado sem trabalhar: `until ...; do sleep; done`,\n"
            "loops de queima usados como sleep), build e outro. Intervalos de agentes\n"
            "em paralelo são fundidos antes de somar; sem isso o mesmo minuto\n"
            "contaria uma vez por agente.\n"
            "\n"
            "Os MINUTOS ABSOLUTOS são o número confiável. Numa sessão interativa o\n"
            "relógio inclui o tempo em que ela esperou por você, e os percentuais\n"
            "saem diluídos: só compare percentuais entre runs desatendidos."),
        epilog=(
            "exemplos:\n"
            "  cepa-clock                     # a sessão mais recente deste repo\n"
            "  cepa-clock --slug <slug>       # as sessões de outro diretório de projeto\n"
            "  cepa-clock --all --days 7      # todas as sessões da última semana\n"
            "  cepa-clock --emit              # também grava no ledger de telemetria\n"
            "  cepa-clock --json              # para código (relogio_s, espera_s, build_s, outro_s)"))
    ap.add_argument("--slug", metavar="SLUG",
                    help="diretório em ~/.claude/projects a ler (default: o deste repo)")
    ap.add_argument("--all", "--todas", dest="all_sessions", action="store_true",
                    help="todas as sessões do período, não só a última")
    ap.add_argument("--days", type=int, default=30, metavar="N",
                    help="janela, em dias, que --all considera (default: 30)")
    ap.add_argument("--emit", action="store_true",
                    help="além de imprimir, grava o resultado no ledger de telemetria")
    ap.add_argument("--json", action="store_true", dest="as_json",
                    help="saída em JSON, para código")
    args = ap.parse_args()

    files = sessions(args.slug, args.all_sessions, args.days)
    if not files:
        print("No transcript found. Pass --slug, or --all to scan everything.",
              file=sys.stderr)
        return 2

    results = [r for r in (measure(f) for f in files) if r and r["relogio_s"] >= 300]
    if not results:
        print("No session with 5+ minutes of clock in the period.", file=sys.stderr)
        return 0

    if args.as_json:
        print(json.dumps(results, indent=2, ensure_ascii=False))
    else:
        for r in results:
            print(report(r))
            print()
        if len(results) > 1:
            total_clock = sum(r["relogio_s"] for r in results)
            total_wait = sum(r["espera_s"] for r in results)
            print(f"TOTAL: {len(results)} sessões, {total_clock/60:.0f} min de relógio, "
                  f"{total_wait/60:.0f} min de espera ativa ({total_wait/total_clock*100:.0f}%)")

    if args.emit:
        sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
        try:
            import _telemetry as T
        except ImportError:
            print("telemetry unavailable; nothing written", file=sys.stderr)
            return 0
        for r in results:
            T.emit("clock_breakdown", relogio_s=int(r["relogio_s"]),
                   espera_s=int(r["espera_s"]), build_s=int(r["build_s"]),
                   outro_s=int(r["outro_s"]), agentes=r["agentes"], sessao=r["sessao"][:8])
        print(f"written to the ledger: {len(results)} session(s)")
    return 0


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
