#!/usr/bin/env python3
"""cepa-metrics — aggregate the harness's own telemetry into a readable report.

Reads the JSONL ledgers written by _telemetry.py (and inline emitters) at
~/.claude/cepa-telemetry/events-YYYY-MM.jsonl and answers the questions the
harness could not answer about itself: how often gates fire (and where), how
builds trend per repo, which proof verdicts dominate, how many sessions each
project consumes.

Usage:
  cepa-metrics                  # last 30 days
  cepa-metrics --days 7         # last N days
  cepa-metrics --month 2026-07  # a specific month
  cepa-metrics --repo wego-acesso-backend   # filter to one repo
  cepa-metrics --json           # machine-readable dump of the aggregates
  cepa-metrics scorecard        # the three scorecard numbers, with the arithmetic

Reading the numbers:
  - gate_block reason=stale/failure with HIGH counts on one repo → the verify
    loop is too slow there or the baseline scope is wrong.
  - gate_block reason=no-baseline on a repo that HAS a build → sessions are
    pushing before ever running verify.
  - gate_warn reason=no-build-manifest recurring on the same repo → commit the
    .claude/no-build marker and silence it.
  - proof_block > 0 → an agent stamped `proven` over a forbidding level; the
    guard caught it. Recurring == prompt drift in proof-reviewer.
  - builds failure-rate per repo → where the red-green loop burns the most.
"""

import argparse
import json
import os
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402

TELEMETRY_DIR = Path(os.environ.get("CEPA_TELEMETRY_DIR") or (Path.home() / ".claude" / "cepa-telemetry"))


def load_events(since: datetime, until: datetime):
    events = []
    if not TELEMETRY_DIR.is_dir():
        return events
    for f in sorted(TELEMETRY_DIR.glob("events-*.jsonl")):
        for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
                ts = datetime.fromisoformat(str(e.get("ts", "")).replace("Z", "+00:00"))
            except (json.JSONDecodeError, ValueError):
                continue
            if ts.tzinfo is None:
                ts = ts.replace(tzinfo=timezone.utc)
            if since <= ts <= until:
                e["_ts"] = ts
                events.append(e)
    return events


def fmt_counter(c: Counter, indent="    ", top=None) -> str:
    items = c.most_common(top)
    if not items:
        return f"{indent}(nenhum)"
    width = max(len(str(k)) for k, _ in items)
    return "\n".join(f"{indent}{str(k):<{width}}  {v}" for k, v in items)


# ── Scorecard ──────────────────────────────────────────────────────────
# The three numbers the strategy (docs/estrategia-cepa-proximo-nivel.md,
# decision 8, findings F3, F8 and F10) set as the comparison baseline for the
# spiral Cepa Epic: a harness change that moves none of them does not ship. The
# formulas are the same as the document's, so the number here matches the one there.
SCORECARD_REPO = "cepa"


def _turns_after_routine(events):
    """F3: prompts after the LAST routine, summed, ÷ sessions with a routine."""
    by_session = defaultdict(list)
    for e in events:
        if e.get("event") == "prompt" and e.get("session"):
            by_session[e["session"]].append(e)
    sessions_count, after = 0, 0
    for evs in by_session.values():
        evs.sort(key=lambda x: x.get("ts", ""))
        idx = [i for i, x in enumerate(evs) if x.get("kind") == "rotina"]
        if not idx:
            continue
        sessions_count += 1
        after += len(evs) - idx[-1] - 1
    return after, sessions_count


def _red_builds(events):
    """F8: FAILURE builds ÷ all build_result events (EMPTY counts in the denominator)."""
    statuses = [e.get("status") for e in events if e.get("event") == "build_result"]
    return sum(1 for s in statuses if s == "FAILURE"), len(statuses)


def _sessions_in_cepa(events):
    """F10: session_start in the cepa repo ÷ session_start across all repos."""
    repos = [e.get("repo") for e in events if e.get("event") == "session_start"]
    return sum(1 for r in repos if r == SCORECARD_REPO), len(repos)


def intent_lines(events):
    """Lines of the "Intenção da sessão" block, with the calculation (cycle 1 of
    docs/estrategia-intencao-da-sessao.md). Session = `session` field (8
    characters); an event without it forms no session and stays out of the
    per-session counts. Returns [] if there is no intent.* event."""
    by_event_name = defaultdict(set)
    asked, no_session = 0, 0
    for e in events:
        ev = e.get("event", "")
        if not ev.startswith("intent."):
            continue
        if ev == "intent.asked":
            asked += 1
        if e.get("session"):
            by_event_name[ev].add(e["session"])
        else:
            no_session += 1
    if not (by_event_name or asked or no_session):
        return []
    written = by_event_name["intent.written"]
    advanced = written & by_event_name["intent.cursor_advanced"]
    never_advanced = written - advanced
    at_last_step = written & by_event_name["intent.finished_at_last_step"]
    n = len(written)

    def pct(x):
        return f"{100 * x / n:.1f}%" if n else "sem dados"

    L = [f"    sessões com intenção gravada: {n}",
         f"    com cursor avançado ao menos uma vez: {len(advanced)} de {n} "
         f"({len(advanced)} ÷ {n} × 100 = {pct(len(advanced))})",
         f"    com cursor NUNCA avançado: {len(never_advanced)} de {n} "
         f"({len(never_advanced)} ÷ {n} × 100 = {pct(len(never_advanced))})",
         f"    terminaram no último passo (wrap-up com cursor em M ou M+1): "
         f"{len(at_last_step)} de {n} ({len(at_last_step)} ÷ {n} × 100 = {pct(len(at_last_step))})",
         f"    perguntas \"onde estamos / próximo passo\" (intent.asked): {asked}"]
    if n >= 10 and len(never_advanced) * 2 > n:
        L.append("    ⚠ critério do ciclo 2: com 10+ sessões, mais da metade nunca "
                 "avançou o cursor — C2 entra.")
    elif n < 10:
        L.append(f"    critério do ciclo 2: faltam {10 - n} sessão(ões) com intenção "
                 "gravada para avaliar (mínimo 10).")
    L += ["    memória de cálculo: conta-se SESSÕES distintas (campo session), não eventos;",
          "      gravada = ao menos um intent.written; avançou = a mesma sessão tem",
          "      intent.cursor_advanced; nunca avançou = gravada − avançou;",
          "      último passo = intent.finished_at_last_step (emitido pelo wrap-up);",
          "      perguntas = total de intent.asked (eventos, não sessões).",
          "      C2 entra se, com 10+ sessões gravadas, nunca-avançou > metade, ou se os",
          "      turnos DEPOIS da rotina (seção Atrito das pontas) não caírem."]
    if no_session:
        L.append(f"    ({no_session} evento(s) intent.* sem session, fora das contagens por sessão)")
    return L


def _line(name, numerator, denominator, pct, units):
    if not denominator:
        return f"    {name}: sem dados ({units[1]} = 0)"
    result = f"{100 * numerator / denominator:.1f}%" if pct else f"{numerator / denominator:.1f}"
    operation = f"{numerator} ÷ {denominator} × 100" if pct else f"{numerator} ÷ {denominator}"
    return f"    {name}: {result}  ({numerator} {units[0]} ÷ {denominator} {units[1]}; {operation} = {result})"


def scorecard(argv):
    ap = argparse.ArgumentParser(prog="cepa-metrics scorecard",
                                 description="The three scorecard numbers (turns after "
                                             "routine, red builds, sessions in the cepa "
                                             "repo), over three windows, with the "
                                             "arithmetic behind each one.")
    ap.add_argument("--json", action="store_true", dest="as_json",
                    help="JSON output, for code")
    args = ap.parse_args(argv)

    now = datetime.now(timezone.utc)
    windows = [("últimos 7 dias", now - timedelta(days=7)),
               ("desde o início", datetime.min.replace(tzinfo=timezone.utc))]
    out = {}
    for label, since in windows:
        evs = load_events(since, now)
        out[label] = {
            "turnos após rotina por sessão": _turns_after_routine(evs),
            "builds vermelhos": _red_builds(evs),
            "sessões no repo cepa": _sessions_in_cepa(evs),
        }

    if args.as_json:
        print(json.dumps({r: {k: {"numerador": n, "denominador": d,
                                  "resultado": (n / d if d else None)}
                              for k, (n, d) in m.items()}
                          for r, m in out.items()}, indent=2, ensure_ascii=False))
        return 0

    print(f"# Scorecard do harness · ledger: {TELEMETRY_DIR}")
    for label, m in out.items():
        print(f"\n## {label}")
        print(_line("turnos após rotina por sessão", *m["turnos após rotina por sessão"],
                     False, ("prompts depois da última rotina", "sessões com rotina")))
        print(_line("builds vermelhos", *m["builds vermelhos"],
                     True, ("builds FAILURE", "builds")))
        print(_line("sessões no repo cepa", *m["sessões no repo cepa"],
                     True, ("sessões no cepa", "sessões")))
    print("\nmemória de cálculo (docs/estrategia-cepa-proximo-nivel.md, F3, F8, F10):")
    print("  turnos após rotina = soma, nas sessões com algum comando de rotina, dos")
    print("    prompts do usuário depois da última rotina ÷ número dessas sessões;")
    print("  builds vermelhos = eventos build_result FAILURE ÷ todos os build_result × 100;")
    print("  sessões no repo cepa = session_start com repo=cepa ÷ todos os session_start × 100.")
    return 0


def main():
    ap = argparse.ArgumentParser(
        prog="cepa-metrics",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Aggregates the harness's own telemetry into a readable report.\n"
            "\n"
            "Reads the JSONL ledgers in ~/.claude/cepa-telemetry/events-YYYY-MM.jsonl,\n"
            "which the hooks feed automatically, and answers what the harness did not\n"
            "know about itself: how many sessions each repo uses, how often the gates\n"
            "block (and why), how builds go per repo, which proof verdicts dominate,\n"
            "and how many turns you spend before and after a routine.\n"
            "\n"
            "subcommand:\n"
            "  cepa-metrics scorecard [--json]   the three scorecard numbers, with the arithmetic"),
        epilog=(
            "examples:\n"
            "  cepa-metrics                      # last 30 days\n"
            "  cepa-metrics --days 7\n"
            "  cepa-metrics --month 2026-10\n"
            "  cepa-metrics --repo wego-acessos-backend\n"
            "  cepa-metrics --json               # the aggregates, for code\n"
            "\n"
            "how to read: high gate_block stale/failure in a repo = slow verify or wrong\n"
            "baseline scope; no-baseline in a repo WITH a build = sessions pushing\n"
            "without ever running verify; proof_block > 0 = an agent stamped `proven`\n"
            "above the allowed level and the guard caught it."))
    ap.add_argument("--days", type=int, default=30, metavar="N",
                    help="window: the last N days (default: 30)")
    ap.add_argument("--month", metavar="YYYY-MM",
                    help="window: one closed month (overrides --days)")
    ap.add_argument("--repo", metavar="NAME", help="only the events of this repo (by name)")
    ap.add_argument("--json", action="store_true", dest="as_json",
                    help="JSON output, for code")
    args = ap.parse_args()

    now = datetime.now(timezone.utc)
    if args.month:
        try:
            start = datetime.strptime(args.month, "%Y-%m").replace(tzinfo=timezone.utc)
        except ValueError:
            print(f"--month inválido: {args.month} (use YYYY-MM)", file=sys.stderr)
            return 1
        end = (start.replace(day=28) + timedelta(days=4)).replace(day=1) - timedelta(seconds=1)
    else:
        start, end = now - timedelta(days=args.days), now

    events = load_events(start, end)
    if args.repo:
        events = [e for e in events if e.get("repo") == args.repo]

    # stamp that the session-registry weekly nudge reads
    try:
        TELEMETRY_DIR.mkdir(parents=True, exist_ok=True)
        (TELEMETRY_DIR / "last-metrics-review").write_text(
            datetime.now(timezone.utc).isoformat(timespec="seconds") + "\n")
    except OSError:
        pass

    if not events:
        print(f"Nenhum evento entre {start.date()} e {end.date()} em {TELEMETRY_DIR}.")
        print("A telemetria começa a acumular a partir da instalação desta versão — "
              "rode de novo depois de algumas sessões.")
        return 0

    # ── Aggregate ──────────────────────────────────────────────────────
    by_event = Counter(e.get("event", "?") for e in events)
    sessions = Counter(e.get("repo") or "?" for e in events if e.get("event") == "session_start")

    builds = defaultdict(Counter)   # repo -> {SUCCESS: n, FAILURE: n}
    for e in events:
        if e.get("event") == "build_result":
            builds[e.get("repo") or "?"][e.get("status", "?")] += 1

    gate_blocks = Counter()         # (repo, tier, reason)
    gate_warns = Counter()
    for e in events:
        key = (e.get("repo") or "?", e.get("tier", "?"), e.get("reason", "?"))
        if e.get("event") == "gate_block":
            gate_blocks[key] += 1
        elif e.get("event") == "gate_warn":
            gate_warns[key] += 1

    proof_verdicts = Counter()      # (repo, verdict)
    proof_blocks = Counter()        # repo
    for e in events:
        if e.get("event") == "proof_verdict":
            proof_verdicts[(e.get("repo") or "?", e.get("verdict", "?"))] += 1
        elif e.get("event") == "proof_block":
            proof_blocks[e.get("repo") or "?"] += 1

    # Report format. Since 2026-08-25 the report-style-lint BLOCKS the stop
    # when the report leaves the format, and the turn rewrites. So an
    # off-format measurement is not a bad report the user read: it may be the
    # first draft, which the block sent back. The number that matters is how
    # many deviations PERSISTED after the rewrite (event with `reincidente`),
    # because only those reach the user. Fix of 2026-10-06: until then the
    # aggregator summed both and suggested "switch to blocking" for a hook
    # that already blocked.
    reports = 0
    reports_off_format = 0
    reports_blocked = 0
    reports_persisted = 0
    deviations_by_type = Counter()
    persisted_deviations_by_type = Counter()
    for e in events:
        if e.get("event") != "report_style":
            continue
        reports += 1
        off_format = (e.get("desvios") or 0) > 0
        if off_format:
            reports_off_format += 1
        if e.get("bloqueou"):
            reports_blocked += 1
        if off_format and e.get("reincidente"):
            reports_persisted += 1
            for t in (e.get("tipos") or []):
                persisted_deviations_by_type[t] += 1
        for t in (e.get("tipos") or []):
            deviations_by_type[t] += 1

    # Edge friction: how many turns the user spends BEFORE being able to fire
    # the routine the session exists for, and how many AFTER it until closing.
    # Both numbers exist because the complaint ("I spend 15-20% of the context
    # on preparation alone") was anecdotal and had to become evidence.
    prompts_by_session = defaultdict(list)
    for e in events:
        if e.get("event") == "prompt" and e.get("session"):
            prompts_by_session[e["session"]].append(e)

    before, after = [], []
    for _sid, evs in prompts_by_session.items():
        evs.sort(key=lambda x: x.get("ts", ""))
        idx = [i for i, x in enumerate(evs) if x.get("kind") == "rotina"]
        if not idx:
            continue  # a session without a routine has no routine friction to measure
        before.append(idx[0])                  # turns typed before the 1st routine
        tail = evs[idx[-1] + 1:]             # what came after the last one
        # the wrap-up/handoff itself is the closing, not friction: count what
        # came BEFORE it.
        end_idx = next((i for i, x in enumerate(tail) if x.get("kind") == "fechamento"),
                       len(tail))
        after.append(end_idx)

    def median(xs):
        if not xs:
            return None
        s = sorted(xs)
        m = len(s) // 2
        return s[m] if len(s) % 2 else (s[m - 1] + s[m]) / 2

    # Tokens: one token_usage event per session, written by cepa-tokens at its
    # end. The same session may have been written twice (automatic end +
    # manual sweep); the last event of each session wins.
    last_tokens = {}
    for e in sorted((e for e in events if e.get("event") == "token_usage"),
                    key=lambda x: x.get("ts", "")):
        last_tokens[e.get("sessao") or id(e)] = e
    tok_total = Counter()
    tok_agent = defaultdict(Counter)
    tok_chars = Counter()
    tok_repo = Counter()
    for e in last_tokens.values():
        new_ctx = (e.get("entrada") or 0) + (e.get("cache_w") or 0)
        tok_total["novo"] += new_ctx
        tok_total["cache_r"] += e.get("cache_r") or 0
        tok_total["saida"] += e.get("saida") or 0
        tok_repo[e.get("repo") or "?"] += new_ctx
        for kind_name, u in (e.get("por_agente") or {}).items():
            tok_agent[kind_name]["novo"] += (u.get("entrada") or 0) + (u.get("cache_w") or 0)
            tok_agent[kind_name]["n"] += u.get("n") or 0
        for name, c in (e.get("resultado_chars") or {}).items():
            tok_chars[name] += c or 0

    known = {"session_start", "session_end", "build_result", "gate_block", "gate_warn",
             "proof_verdict", "proof_block", "report_style", "prompt", "token_usage",
             "intent.written", "intent.cursor_advanced", "intent.asked",
             "intent.finished_at_last_step"}
    custom = Counter(e.get("event") for e in events if e.get("event") not in known)

    if args.as_json:
        print(json.dumps({
            "period": [start.isoformat(), end.isoformat()],
            "total_events": len(events),
            "by_event": dict(by_event),
            "sessions_per_repo": dict(sessions),
            "builds": {r: dict(c) for r, c in builds.items()},
            "gate_blocks": {" ".join(k): v for k, v in gate_blocks.items()},
            "gate_warns": {" ".join(k): v for k, v in gate_warns.items()},
            "proof_verdicts": {" ".join(k): v for k, v in proof_verdicts.items()},
            "proof_blocks": dict(proof_blocks),
            "report_style": {"medidos": reports, "fora": reports_off_format,
                             "bloqueados": reports_blocked,
                             "persistiram": reports_persisted,
                             "desvios_por_tipo": dict(deviations_by_type),
                             "desvios_persistiram_por_tipo":
                                 dict(persisted_deviations_by_type)},
            "atrito": {"sessoes_medidas": len(before),
                       "turnos_antes_da_rotina": before,
                       "turnos_depois_da_rotina": after,
                       "mediana_antes": median(before),
                       "mediana_depois": median(after)},
            "tokens": {"sessoes_medidas": len(last_tokens),
                       "total": dict(tok_total),
                       "contexto_novo_por_repo": dict(tok_repo),
                       "por_agente": {k: dict(v) for k, v in tok_agent.items()},
                       "resultado_chars": dict(tok_chars)},
            "custom_events": dict(custom),
        }, indent=2, ensure_ascii=False, default=str))
        return 0

    # ── Report ─────────────────────────────────────────────────────────
    print(f"# Telemetria do harness — {start.date()} a {end.date()}")
    print(f"{len(events)} eventos · ledger: {TELEMETRY_DIR}\n")

    print(f"## Sessões por repo ({sum(sessions.values())} no período)")
    print(fmt_counter(sessions))

    print("\n## Builds por repo (verde / vermelho)")
    if builds:
        for repo in sorted(builds, key=lambda r: -sum(builds[r].values())):
            c = builds[repo]
            ok, fail = c.get("SUCCESS", 0), c.get("FAILURE", 0)
            total = sum(c.values())
            rate = f"{100 * fail / total:.0f}%" if total else "-"
            # EMPTY: run with a test filter that executed zero tests (not green).
            empty = c.get("EMPTY", 0)
            empty_note = f", {empty} vazios (filtro casou zero teste)" if empty else ""
            print(f"    {repo}: {ok} verdes, {fail} vermelhos{empty_note} (taxa de falha {rate})")
    else:
        print("    (nenhum)")

    print("\n## Gate-advance — bloqueios (repo · tier · motivo)")
    print(fmt_counter(Counter({f"{r} · {t} · {m}": v for (r, t, m), v in gate_blocks.items()})))
    print("\n## Gate-advance — avisos sem bloqueio")
    print(fmt_counter(Counter({f"{r} · {t} · {m}": v for (r, t, m), v in gate_warns.items()})))

    if before:
        median_before, median_after = median(before), median(after)
        print(f"\n## Atrito das pontas ({len(before)} sessão(ões) com rotina)")
        print(f"    turnos ANTES da 1ª rotina:  mediana {median_before}  (todas: {sorted(before)})")
        print(f"    turnos DEPOIS da última:    mediana {median_after}  (todas: {sorted(after)})")
        print("    memória de cálculo: por sessão, conta-se cada prompt do usuário;")
        print("      ANTES = quantos vieram antes do primeiro comando de rotina")
        print("      (drain, prove-drain, triage, execute, autonomous, session, ...);")
        print("      DEPOIS = quantos vieram após o último, até o /wrap-up ou /handoff")
        print("      (o próprio fechamento não conta). Mediana = valor do meio da lista.")
        print("    Zero nos dois é o alvo: abrir, rodar, receber o relatório, encerrar.")

    intent_block = intent_lines(events)
    if intent_block:
        print("\n## Intenção da sessão")
        print("\n".join(intent_block))

    print("\n## Proof gate — vereditos escritos (repo · veredito)")
    print(fmt_counter(Counter({f"{r} · {v}": n for (r, v), n in proof_verdicts.items()})))
    if proof_blocks:
        print("\n## Proof gate — `proven` sobre-declarado barrado pelo guard ⚠")
        print(fmt_counter(proof_blocks))

    if reports:
        pct = 100.0 * reports_off_format / reports
        pct_p = 100.0 * reports_persisted / reports
        print(f"\n## Formato de relatório — {reports_persisted}/{reports} "
              f"chegaram ao usuário fora do padrão ({pct_p:.0f}%)")
        print(f"    primeira escrita fora do padrão: {reports_off_format} "
              f"({pct:.0f}%) · bloqueadas e reescritas pelo report-style-lint: "
              f"{reports_blocked} · persistiram após a reescrita: "
              f"{reports_persisted}")
        print(f"    memória de cálculo: {reports_persisted} medições com "
              f"desvio E marcadas `reincidente` (a parada já vinha de um "
              f"bloqueio do hook) ÷ {reports} medidas × 100 = {pct_p:.0f}%; "
              f"a primeira escrita é {reports_off_format} com desvio ÷ "
              f"{reports} × 100 = {pct:.0f}%")
        if persisted_deviations_by_type:
            print("    desvios que persistiram após a reescrita:")
            print(fmt_counter(persisted_deviations_by_type))
        if deviations_by_type:
            print("    desvios na primeira escrita (o bloqueio devolve estes):")
            print(fmt_counter(deviations_by_type))

    # ── Clock: busy-wait and where the time went ───────────────────────
    wait_blocks = Counter(
        e.get("reason", "?") for e in events if e.get("event") == "busy_wait_block")
    if wait_blocks:
        print("\n## Espera ativa barrada pelo no-busy-wait (por padrão)")
        print(fmt_counter(wait_blocks))
        print("    cada bloqueio é um `until/sleep` ou laço de queima que não rodou —\n"
              "    a medição de 2026-08-26 pôs esses comandos entre 19% e 52% do relógio.")

    clocks = [e for e in events if e.get("event") == "clock_breakdown"]
    if clocks:
        def _secs(e, k):
            try:
                return float(e.get(k) or 0)
            except (TypeError, ValueError):
                return 0.0
        total_wall = sum(_secs(e, "relogio_s") for e in clocks)
        total_wait = sum(_secs(e, "espera_s") for e in clocks)
        total_build = sum(_secs(e, "build_s") for e in clocks)
        print(f"\n## Relógio medido — {len(clocks)} sessão(ões) via cepa-clock")
        print(f"    relógio total : {total_wall/3600:.1f} h")
        if total_wall:
            print(f"    espera ativa  : {total_wait/60:.0f} min ({total_wait/total_wall*100:.0f}%)")
            print(f"    build         : {total_build/60:.0f} min ({total_build/total_wall*100:.0f}%)")
            print(f"    memória de cálculo: soma de espera_s ÷ soma de relogio_s × 100")

    if last_tokens:
        base = tok_total["novo"] or 1
        print(f"\n## Tokens — {len(last_tokens)} sessão(ões) medidas")
        print(f"    contexto novo {tok_total['novo']:,} · cache lido {tok_total['cache_r']:,} "
              f"· saída {tok_total['saida']:,}")
        # A worktree already removed does not resolve to the main repo and shows
        # up under its own directory name; hence only the 10 largest.
        print(f"    contexto novo por repo (10 maiores de {len(tok_repo)}):")
        for repo, v in tok_repo.most_common(10):
            print(f"      {repo:40}{v:>13,}  {v/base*100:5.1f}%")
        print("    contexto novo por agente (tokens · % do total):")
        for kind_name, u in sorted(tok_agent.items(), key=lambda kv: -kv[1]["novo"])[:10]:
            n = f" ×{u['n']}" if u["n"] else ""
            print(f"      {kind_name + n:40}{u['novo']:>13,}  {u['novo']/base*100:5.1f}%")
        if tok_chars:
            tc = sum(tok_chars.values()) or 1
            print("    o que entrou por resultado de ferramenta (caracteres · %):")
            for name, c in tok_chars.most_common(8):
                print(f"      {name:40}{c:>13,}  {c/tc*100:5.1f}%")
        print("    memória de cálculo: contexto novo = input_tokens + cache_creation_input_tokens")
        print("      do transcript, uma vez por resposta do modelo; % = linha ÷ total × 100.")
        print("      Resultado de ferramenta é medido em caracteres (o transcript não dá tokens")
        print("      por resultado). Sessão gravada duas vezes conta só o último evento.")

    if custom:
        print("\n## Eventos custom (emitidos por comandos/skills)")
        print(fmt_counter(custom))

    # ── Suggested readings ─────────────────────────────────────────────
    hints = []
    if reports >= 20 and reports_persisted / reports > 0.05:
        hints.append(f"- formato de relatório: {reports_persisted} de "
                     f"{reports} chegaram ao usuário fora do padrão "
                     f"({100.0*reports_persisted/reports:.0f}%) mesmo "
                     f"após o bloqueio e a reescrita — o motivo do bloqueio não "
                     f"está sendo entendido; veja os tipos que persistem.")
    elif reports >= 20 and reports_off_format / reports > 0.3:
        hints.append(f"- formato de relatório: a primeira escrita sai fora do "
                     f"padrão em {100.0*reports_off_format/reports:.0f}% "
                     f"({reports_off_format} de {reports}), mas o report-style-lint "
                     f"bloqueia e a reescrita corrige — só "
                     f"{reports_persisted} chegaram ao usuário. Custo é o "
                     f"turno extra de reescrita, não relatório ruim.")
    for (repo, tier, reason), n in gate_blocks.items():
        if reason in ("stale", "failure") and n >= 5:
            hints.append(f"- {repo}: {n} bloqueios por build {reason.upper()} — loop de verify lento ou baseline com escopo errado.")
        if reason == "no-baseline" and n >= 3:
            hints.append(f"- {repo}: {n} bloqueios sem baseline — sessões tentam compartilhar antes de rodar verify.")
    for (repo, tier, reason), n in gate_warns.items():
        if reason == "no-build-manifest" and n >= 3:
            hints.append(f"- {repo}: {n} avisos de repo sem build — commite `.claude/no-build` e silencie.")
    if wait_blocks and sum(wait_blocks.values()) >= 5:
        hints.append(f"- espera ativa: {sum(wait_blocks.values())} bloqueios — o hook "
                     f"está segurando o vazamento, mas o agente segue tentando esperar; "
                     f"vale ver se algum lead ainda delega e sonda em vez de aguardar o retorno.")
    for repo, n in proof_blocks.items():
        hints.append(f"- {repo}: {n} artefato(s) `proven` contraditório(s) barrados — prompt drift no proof-reviewer; vale investigar.")
    if hints:
        print("\n## Leituras sugeridas")
        print("\n".join(hints))
    return 0


if __name__ == "__main__":
    _tui.install()
    if sys.argv[1:2] == ["scorecard"]:
        sys.exit(scorecard(sys.argv[2:]))
    sys.exit(main())
