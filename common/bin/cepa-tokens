#!/usr/bin/env python3
"""cepa-tokens — shows how many tokens a session spent, and on which agents.

## Why it exists

On 2026-09-12 Spotify's Portal was evaluated: it diverts the reading of large
files to a cheap model and promises ~90% savings on those reads. The question
that decided whether to copy the idea was "does reading weigh on Cepa's
spend?", and the ledger could not answer it: it had 0 events with tokens. The
cost the BACKLOG recorded was agent fan-out (~600k per /common:advisors), not
large files. This script turns the guess into a number.

## How it reads

The source is the same as `cepa-clock`: the transcript in
`~/.claude/projects/<slug>/` and one file per subagent in
`<session>/subagents/`, with the agent type in the adjacent `.meta.json`.

Each model response carries `usage`. The SAME response shows up on several
lines (one per content block) and, in subagents, the first lines carry a
partial count. So each `message.id` is counted once, with the `usage` of the
LAST line of that id. Summing all lines inflates the total.

Four numbers per response (the keys stay in pt-BR: they are the JSON and
telemetry field names):
  - entrada     = input_tokens (new text, uncached)
  - cache_w     = cache_creation_input_tokens (new text written to the cache)
  - cache_r     = cache_read_input_tokens (reused context, ~10% of the price)
  - saida       = output_tokens

"New context" = entrada + cache_w. It is what grows when a large file enters
the conversation.

To know WHAT came in, the size in characters of each tool result (Read, Bash,
Agent...) is counted. Characters, not tokens: the transcript does not say how
many tokens each result cost.

Usage:
    cepa-tokens                       # the most recent session of this repo
    cepa-tokens --file <x.jsonl>      # a named session
    cepa-tokens --all --days 30       # every session in the period
    cepa-tokens --emit                # writes to the ledger (token_usage event)
    cepa-tokens --json
"""

import glob
import json
import os
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402
import _clihelp  # noqa: E402

PROJECTS = Path.home() / ".claude" / "projects"
FIELDS = ("entrada", "cache_w", "cache_r", "saida")


def _lines(path):
    try:
        for line in open(path, errors="replace"):
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except ValueError:
                continue
    except OSError:
        return


def _chars(content):
    if isinstance(content, str):
        return len(content)
    if isinstance(content, list):
        return sum(len(c.get("text") or "") for c in content if isinstance(c, dict))
    return 0


def _read_file(path):
    """Usage per model, characters per tool, cwd and last timestamp of a .jsonl."""
    usages = {}                     # message.id -> (model, usage) — the last line wins
    tool_names = {}                 # tool_use_id -> tool name
    chars = Counter()
    cwd, last_ts = "", ""
    for line in _lines(path):
        cwd = line.get("cwd") or cwd
        last_ts = line.get("timestamp") or last_ts
        msg = line.get("message")
        if not isinstance(msg, dict):
            continue
        if isinstance(msg.get("usage"), dict):
            usages[msg.get("id") or id(line)] = (msg.get("model") or "?", msg["usage"])
        if not isinstance(msg.get("content"), list):
            continue
        for c in msg["content"]:
            if not isinstance(c, dict):
                continue
            if c.get("type") == "tool_use":
                tool_names[c.get("id")] = c.get("name") or "?"
            elif c.get("type") == "tool_result":
                chars[tool_names.get(c.get("tool_use_id"), "?")] += _chars(c.get("content"))
    by_model = defaultdict(Counter)
    for model, u in usages.values():
        by_model[model]["entrada"] += u.get("input_tokens") or 0
        by_model[model]["cache_w"] += u.get("cache_creation_input_tokens") or 0
        by_model[model]["cache_r"] += u.get("cache_read_input_tokens") or 0
        by_model[model]["saida"] += u.get("output_tokens") or 0
    return by_model, chars, cwd, last_ts


def measure(session: Path):
    """session = the main session .jsonl; subagents live in the sibling dir."""
    files = [str(session)] + sorted(glob.glob(str(session.with_suffix("")) + "/subagents/agent-*.jsonl"))
    total, by_agent, by_model, chars = Counter(), defaultdict(Counter), defaultdict(Counter), Counter()
    cwd, last_ts = "", ""
    for f in files:
        kind = "main"
        meta = f[: -len(".jsonl")] + ".meta.json"
        if f != str(session):
            kind = "?"
            try:
                kind = json.load(open(meta)).get("agentType") or "?"
            except (OSError, ValueError):
                pass
        file_by_model, file_chars, file_cwd, file_last_ts = _read_file(f)
        if f == str(session):
            cwd = file_cwd
        last_ts = max(last_ts, file_last_ts)
        chars.update(file_chars)
        for model, u in file_by_model.items():
            by_model[model].update(u)
            by_agent[kind].update(u)
            total.update(u)
        if f != str(session):
            by_agent[kind]["n"] += 1
    if not sum(total.values()):
        return None
    return {"sessao": session.stem, "slug": session.parent.name, "cwd": cwd, "fim": last_ts,
            "agentes": len(files) - 1,
            "total": {k: total[k] for k in FIELDS},
            "por_agente": {k: dict(v) for k, v in by_agent.items()},
            "por_modelo": {k: dict(v) for k, v in by_model.items()},
            "resultado_chars": dict(chars.most_common())}


def _cwd_slug():
    try:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        root = ""
    return (root or os.getcwd()).replace("/", "-").replace(".", "-")


def sessions(all_sessions=False, days=30):
    cutoff = datetime.now(timezone.utc) - timedelta(days=days)
    dirs = sorted(PROJECTS.glob("*"))
    if not all_sessions:
        target = _cwd_slug()
        dirs = [d for d in dirs if d.name == target] or dirs
    found = [f for d in dirs if d.is_dir() for f in d.glob("*.jsonl")
             if datetime.fromtimestamp(f.stat().st_mtime, timezone.utc) >= cutoff]
    found.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    return found if all_sessions else found[:1]


def new_context(u):
    return (u.get("entrada") or 0) + (u.get("cache_w") or 0)


def report(r):
    t = r["total"]
    base = new_context(t) or 1
    out = [f"{r['sessao'][:8]} · {r['slug'][:52]} · {r['agentes']} subagentes",
           f"  contexto novo {new_context(t):,} · cache lido {t['cache_r']:,} · saída {t['saida']:,}",
           "  por agente (contexto novo · % do total · saída):"]
    for kind, u in sorted(r["por_agente"].items(), key=lambda kv: -new_context(kv[1])):
        n = f" ×{u['n']}" if u.get("n") else ""
        out.append(f"    {kind + n:40}{new_context(u):>12,}  {new_context(u)/base*100:5.1f}%  {u.get('saida', 0):>9,}")
    if r["resultado_chars"]:
        total_chars = sum(r["resultado_chars"].values()) or 1
        out.append("  o que entrou por resultado de ferramenta (caracteres · %):")
        for name, c in list(r["resultado_chars"].items())[:8]:
            out.append(f"    {name:40}{c:>12,}  {c/total_chars*100:5.1f}%")
    out.append("  memória de cálculo: contexto novo = input_tokens + cache_creation_input_tokens,")
    out.append("    somados uma vez por message.id (última linha do id); % = agente ÷ total × 100")
    return "\n".join(out)


def emit(r):
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
    import _telemetry as T
    # `ts` overrides the current-time stamp with the end of the session: in a
    # sweep of old sessions, the event must land in the period when the spend happened.
    fields = {"sessao": r["sessao"][:8], "agentes": r["agentes"], **r["total"],
              "por_agente": r["por_agente"], "resultado_chars": dict(list(r["resultado_chars"].items())[:10])}
    if r["fim"]:
        fields["ts"] = r["fim"].replace("Z", "+00:00")
    T.emit("token_usage", cwd=r["cwd"] or None, **fields)


def main():
    ap = _clihelp.Parser(
        prog="cepa tokens",
        description=(
            "Reads the same source as cepa clock: the transcript in\n"
            "~/.claude/projects/<slug>/ plus one file per subagent, with the agent\n"
            "type in the .meta.json next to it. Each message.id is counted once, from\n"
            "the `usage` of its last line (the same response appears on several lines;\n"
            "summing all of them inflates the total).\n"
            "\n"
            "Four numbers per response (the keys stay in pt-BR in JSON and telemetry):\n"
            "  entrada   input_tokens (new text, not cached)\n"
            "  cache_w   cache_creation_input_tokens (new text written to the cache)\n"
            "  cache_r   cache_read_input_tokens (reused context, ~10% of the price)\n"
            "  saida     output_tokens\n"
            "\n"
            "\"New context\" = entrada + cache_w: it is what grows when a large file\n"
            "enters the conversation. To know WHAT entered, it counts the characters\n"
            "of each tool result (Read, Bash, Agent...)."),
        examples=[
            ("cepa tokens", "the most recent session of this repo"),
            ("cepa tokens --file <x.jsonl>", "one specific session"),
            ("cepa tokens --all --days 30", "every session in the period"),
            ("cepa tokens --emit", "writes to the ledger (token_usage event)"),
            ("cepa tokens --json", "JSON output, for code"),
        ],
        exit_codes=[
            (0, "report printed or written; also with --emit when no transcript was found"),
            (2, "invalid usage, or no transcript with token usage found (without --emit)"),
        ],
        see_also=["cepa clock: where the same session's wall-clock time went"])
    ap.add_argument("--file", "--arquivo", dest="file", metavar="FILE",
                    help="the main .jsonl of a session (default: the most recent of this repo)")
    ap.add_argument("--all", "--todas", dest="all_sessions", action="store_true",
                    help="every session in the period, not just the last one")
    ap.add_argument("--days", type=int, default=30, metavar="N",
                    help="window, in days, that --all considers (default: 30)")
    ap.add_argument("--emit", action="store_true",
                    help="writes the result to the telemetry ledger instead of printing the report")
    ap.add_argument("--json", action="store_true", dest="as_json",
                    help="JSON output, for code")
    args = ap.parse_args()

    files = [Path(args.file)] if args.file else sessions(args.all_sessions, args.days)
    results = [r for r in (measure(f) for f in files) if r]
    if not results:
        print("No transcript with token usage found.", file=sys.stderr)
        return 0 if args.emit else 2

    if args.emit:
        for r in results:
            emit(r)
        if not args.as_json:
            print(f"written to the ledger: {len(results)} session(s)")
    if args.as_json:
        print(json.dumps(results, indent=2, ensure_ascii=False))
    elif not args.emit:
        for r in results:
            print(report(r))
            print()
    return 0


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
