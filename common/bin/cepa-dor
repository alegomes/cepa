#!/usr/bin/env python3
"""cepa-dor — invocable Definition of Ready for the slices of a plan.yaml.

Deliberately decoupled primitive (Maestro v1 design, Component 4): the maestro
is the first client, but /board-flow:triage and /board-flow:drain can reuse the
checks that are not wave-specific. 100% read-only.

Verdict per slice: READY / NOT-READY with named gaps, in pt-BR.

Checks (each exists because the matching failure already cost a wave):
  - schema_version in {1, 2} (refuses an unknown version). v1 = legacy, waves
    only; v2 = explicit, mandatory `mode`
  - mode == parallel-waves (in v1, absent = parallel-waves); a single-track
    plan is refused, pointing to /board-flow:triage and /common:next, see
    common/plan-schema.yaml
  - program with >= 4 demands (D7)
  - declared surface that is DISJOINT from the other slices of the wave on the
    plan's registry files (globs expanded against the file tree at the fork
    point; glob x glob intersection in the abstract is not computable). An
    intersection on a registry file makes BOTH NOT-READY; an intersection on
    any other file is a WARNING, not a veto (measurement in
    docs/spec/planejador-de-lotes-paralelos.md: requiring total disjointness
    would forbid 40% of the pairs in wego-assinatura-backend, 72% of which
    would merge cleanly). "Registry file" (arquivo-cartório) = optional
    `cartorios:` field at the top of plan.yaml, measured by
    `common/bin/cepa-hotspots`; a plan without the field vetoes no
    intersection, it only warns.
  - surface does not intersect the enforcement zone (unconditional deny)
  - registry file that no slice declares -> WARNING (not a veto)
  - acceptance criterion declared; in a .claude/no-build repo the slice MUST
    carry an executable acceptance_cmd (the merge train does not land N slices
    with zero verification)
  - acceptance form: either the acceptance carries an observable
    Given/When/Then on some surface (US), or the slice declares
    `acceptance_form: substrate` (TS). A plan that only names private
    implementation steps is not a verifiable demand, it is a guess with a
    slice name
  - zero open strategic decision (human_gate: none or a recorded decision)
  - minimum context pointed to (non-empty context)
  - green baseline at the fork point (.claude/last-build.json, the same signal
    as green-or-revert; in a no-build repo the check is waived with a note)

Usage:
  cepa-dor <plan.yaml> [--wave N] [--fork-point REF] [--repo DIR] [--json]
           [--enforcement-zone GLOB ...]

Exit: 0 = all READY · 1 = READY with warnings · 2 = some NOT-READY (or invalid plan)
"""
import argparse
import fnmatch
import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402

try:
    import yaml
except ImportError:
    print("✗ cepa-dor precisa de PyYAML (pip install pyyaml)", file=sys.stderr)
    sys.exit(2)

# plan.yaml versions this binary can read. v1 = legacy (waves only, no
# `mode`); v2 = explicit `mode`. Accepting both avoids migrating plans that
# are on disk and working. See common/plan-schema.yaml.
KNOWN_SCHEMA_VERSIONS = {1, 2}

DEFAULT_ENFORCEMENT_ZONE = [
    ".claude/settings*",
    ".claude-plugin/*",
    "*/.claude-plugin/*",
    "*/hooks/*",
    "*/plugins/*",
]

# Recognised acceptance forms. 'bdd' = behaviour observable on a surface (US);
# 'substrate' = substrate work declared as such (TS), whose legitimate
# acceptance is technical. Having neither is the case this check exists to
# catch: a plan that only names private implementation steps.
ACCEPTANCE_FORMS = ("bdd", "substrate")

# Accepted BDD triples: English (canonical) and pt-BR (the harness prose).
# All THREE words are required: "Given" alone is context, not a criterion.
BDD_TRIPLES = [
    (r"\bgiven\b", r"\bwhen\b", r"\bthen\b"),
    (r"\bdado\b", r"\bquando\b", r"\bent[ãa]o\b"),
]


def has_bdd(text: str) -> bool:
    return any(all(re.search(w, text, re.IGNORECASE) for w in triple)
               for triple in BDD_TRIPLES)




def git_tree(repo: Path, ref: str) -> list[str]:
    out = subprocess.run(
        ["git", "-C", str(repo), "ls-tree", "-r", "--name-only", ref],
        capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"git ls-tree {ref} falhou: {out.stderr.strip()}")
    return out.stdout.splitlines()


def expand(globs: list[str], tree: list[str]) -> set[str]:
    hits: set[str] = set()
    for g in globs:
        hits.update(f for f in tree
                    if fnmatch.fnmatch(f, g) or fnmatch.fnmatch(f, g.rstrip("/") + "/*"))
    return hits


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="cepa-dor",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Definition of Ready for the slices of a wave plan (plan.yaml).\n"
            "\n"
            "Verdict per slice: READY or NOT-READY, with the gaps named. 100%\n"
            "read-only. First client: /maestro:program-plan, which iterates the plan\n"
            "with you until every slice comes out READY.\n"
            "\n"
            "What it checks (each check exists because the failure already cost a wave):\n"
            "  - schema_version 1 or 2 and mode parallel-waves (a single-track queue\n"
            "    is refused, pointing to /common:queue and /common:next)\n"
            "  - program with 4+ demands (floor D7)\n"
            "  - declared surface DISJOINT from the wave's other slices on the\n"
            "    registry files (`cartorios:` at the top of the plan, measured by\n"
            "    cepa-hotspots); overlap on any other file is a warning, not a veto\n"
            "  - surface outside the enforcement zone (unconditional denial)\n"
            "  - acceptance criterion declared; in a .claude/no-build repo, an\n"
            "    executable acceptance_cmd\n"
            "  - acceptance shape: observable Given/When/Then, or\n"
            "    `acceptance_form: substrate` declared\n"
            "  - zero open strategic decisions (human_gate)\n"
            "  - minimal context pointed to and a green baseline at the fork point"),
        epilog=(
            "examples:\n"
            "  cepa-dor .claude/programs/wego/plan.yaml\n"
            "  cepa-dor .claude/programs/wego/plan.yaml --wave 2 --json\n"
            "  cepa-dor plan.yaml --fork-point origin/main --enforcement-zone 'infra/**'\n"
            "\n"
            "exit: 0 = all READY · 1 = READY with warnings · 2 = some NOT-READY or invalid plan"))
    ap.add_argument("plan", metavar="plan", help="path to the wave plan.yaml")
    ap.add_argument("--wave", type=int, default=None, metavar="N",
                    help="id of the wave to check (default: the first pending one)")
    ap.add_argument("--fork-point", default="HEAD", metavar="REF",
                    help="ref the slices start from; surface globs are expanded "
                         "against the tree at that point (default: HEAD)")
    ap.add_argument("--repo", default=".", metavar="DIR",
                    help="repository root (default: the current directory)")
    ap.add_argument("--json", action="store_true", help="JSON output, for code")
    ap.add_argument("--enforcement-zone", nargs="*", metavar="GLOB",
                    default=DEFAULT_ENFORCEMENT_ZONE,
                    help="globs no slice may touch (default: "
                         + ", ".join(DEFAULT_ENFORCEMENT_ZONE) + ")")
    if len(sys.argv) == 1:
        ap.print_help(sys.stderr)
        return 2
    args = ap.parse_args()

    repo = Path(args.repo).resolve()
    problems_global: list[str] = []
    warnings_global: list[str] = []

    try:
        plan = yaml.safe_load(Path(args.plan).read_text())
    except Exception as e:
        print(f"✗ plan.yaml ilegível: {e}")
        return 2

    version = plan.get("schema_version") if isinstance(plan, dict) else None
    if version not in KNOWN_SCHEMA_VERSIONS:
        print(f"✗ schema_version ausente ou desconhecida ({version}) — "
              f"cepa-dor conhece as versões {sorted(KNOWN_SCHEMA_VERSIONS)}")
        return 2

    # v1 had no `mode`: every plan from that era is wave-based. v2 requires the
    # field, which lets us refuse a document we cannot read instead of treating
    # a missing `waves` as an empty plan.
    mode = plan.get("mode")
    if version == 1:
        if mode is None:
            mode = "parallel-waves"
        elif mode == "single-track":
            print("✗ `mode: single-track` não existe no schema v1 — "
                  "suba o plano para `schema_version: 2` "
                  "(ver common/plan-schema.yaml)")
            return 2
    elif mode is None:
        print("✗ schema v2 exige `mode` explícito "
              "(single-track | parallel-waves) — ver common/plan-schema.yaml")
        return 2

    # A single-track plan has no waves or surfaces to make disjoint. Refuse,
    # pointing to the right path, instead of failing further on with "no
    # pending wave", which does not say what to do.
    if mode == "single-track":
        print("✗ este é um plano single-track (um item por vez, sem fork) — "
              "cepa-dor só avalia slices de onda.\n"
              "  O gate de prontidão do single-track é por item, no momento em "
              "que o item entra na fila: /board-flow:triage onde há tracker; "
              "sem tracker, a revisão do dono ao aprovar a ordem.\n"
              "  Para saber o próximo passo deste plano: /common:next")
        return 2
    if mode != "parallel-waves":
        print(f"✗ mode desconhecido ({mode!r}) — "
              "esperado 'parallel-waves' ou 'single-track' "
              "(ver common/plan-schema.yaml)")
        return 2

    slices_all: dict = plan.get("slices") or {}
    waves = plan.get("waves") or []

    # registry files (optional field at the top of the plan, measured by
    # common/bin/cepa-hotspots); without the field no intersection is vetoed,
    # only warned (relaxed behaviour, see the module docstring)
    registry_raw = plan.get("cartorios")
    if registry_raw is None:
        registry_raw = []
    elif not isinstance(registry_raw, list):
        problems_global.append(
            f"`cartorios` precisa ser uma lista de caminhos (veio {type(registry_raw).__name__})")
        registry_raw = []

    # D7 — floor of 4 demands in the PROGRAM (calculation memo in decision D7)
    demands = {s.get("demanda", k) for k, s in slices_all.items()}
    if len(demands) < 4:
        problems_global.append(
            f"programa com {len(demands)} demanda(s) — piso é 4 (D7): abaixo "
            "disso /board-flow:drain ou sessão única ganham do overhead do maestro")

    # target wave
    wave = None
    if args.wave is not None:
        wave = next((w for w in waves if w.get("id") == args.wave), None)
        if wave is None:
            print(f"✗ onda {args.wave} não existe no plano")
            return 2
    else:
        wave = next((w for w in waves if w.get("status", "pending") == "pending"), None)
        if wave is None:
            print("✗ nenhuma onda pending no plano (use --wave para forçar)")
            return 2

    wave_slices = wave.get("slices") or []
    missing = [s for s in wave_slices if s not in slices_all]
    if missing:
        print(f"✗ onda {wave.get('id')}: slices sem definição: {', '.join(missing)}")
        return 2

    try:
        tree = git_tree(repo, args.fork_point)
    except RuntimeError as e:
        print(f"✗ {e}")
        return 2

    registry_files = expand([str(c) for c in registry_raw], tree)

    no_build = (repo / ".claude" / "no-build").exists()

    # baseline at the fork point, same signal as green-or-revert
    if no_build:
        warnings_global.append(
            "repo .claude/no-build: baseline dispensada; a verificação recai "
            "no acceptance_cmd de cada slice")
    else:
        lb = repo / ".claude" / "last-build.json"
        status = None
        if lb.exists():
            try:
                status = json.loads(lb.read_text()).get("status")
            except Exception:
                pass
        if status != "SUCCESS":
            problems_global.append(
                f"baseline no fork point não está verde (last-build.json: "
                f"{status or 'ausente'}) — rode o build/verify antes de forkar a onda")

    # surface expansion
    expanded: dict[str, set[str]] = {}
    per_slice: dict[str, dict] = {}
    for name in wave_slices:
        sl = slices_all[name]
        gaps: list[str] = []
        warns: list[str] = []
        surface = sl.get("surface") or []
        if not surface:
            gaps.append("superfície não declarada (surface: [])")
        files = expand(surface, tree)
        expanded[name] = files
        if surface and not files:
            warns.append("nenhum arquivo EXISTENTE casa com a superfície no fork "
                         "point — ok se o slice só cria arquivos novos; confira os globs")

        # enforcement zone: unconditional deny
        zone_hits = expand(args.enforcement_zone, tree) & files
        # globs can also cover future files: check literal glob x glob
        if zone_hits:
            gaps.append("superfície intersecta a zona de enforcement "
                        f"({len(zone_hits)} arquivo(s), ex.: {sorted(zone_hits)[0]}) — "
                        "nenhum glob de slice pode incluí-la")

        # acceptance
        acc = (sl.get("acceptance") or "").strip()
        acc_cmd = (sl.get("acceptance_cmd") or "").strip()
        if not acc:
            gaps.append("critério de aceite testável não declarado (acceptance:)")
        if no_build and not acc_cmd:
            gaps.append("repo .claude/no-build exige acceptance_cmd executável "
                        "(comando de verificação próprio do slice)")

        # acceptance form: observable BDD OR declared substrate
        form = str(sl.get("acceptance_form") or "").strip().lower()
        if form and form not in ACCEPTANCE_FORMS:
            gaps.append(f"acceptance_form inválido ({form!r}) — use "
                        f"'bdd' (comportamento observável) ou 'substrate' "
                        f"(trabalho de substrato assumido)")
        elif form == "bdd" and not has_bdd(acc):
            gaps.append("acceptance_form: bdd mas o acceptance não traz um "
                        "Given/When/Then (ou Dado/Quando/Então) observável — "
                        "escreva o critério na forma que você declarou")
        elif not form and not has_bdd(acc):
            gaps.append("aceite sem Given/When/Then observável e sem "
                        "`acceptance_form: substrate` — o plano só nomeia passos "
                        "privados de implementação: ou declare o comportamento "
                        "observável numa superfície, ou assuma que é substrato")

        # open strategic decision: the #1 predictor of mediation
        hg = sl.get("human_gate", None)
        if hg is None or (isinstance(hg, str) and not hg.strip()):
            gaps.append("human_gate ausente — declare 'none' ou registre a decisão já tomada")
        elif isinstance(hg, str) and hg.strip().lower().startswith(("open", "aberta", "pendente", "tbd", "?")):
            gaps.append(f"decisão estratégica em aberto (human_gate: {hg!r}) — "
                        "resolva e registre antes do fork")

        # minimum context
        if not sl.get("context"):
            gaps.append("contexto mínimo não apontado (context: links de specs/cards/docs)")

        per_slice[name] = {"gaps": gaps, "warns": warns}

    # pairwise disjointness: an intersection on a registry file knocks out BOTH
    # slices; an intersection on any other file becomes a warning, not a veto
    # (CS-4: requiring total disjointness would forbid 40% of the pairs in
    # wego-assinatura-backend, 72% of which would merge cleanly)
    names = list(wave_slices)
    for i in range(len(names)):
        for j in range(i + 1, len(names)):
            inter = expanded[names[i]] & expanded[names[j]]
            if not inter:
                continue
            registry_hits = inter & registry_files
            other_hits = inter - registry_files
            if registry_hits:
                msg = (f"superfície intersecta a de {{other}} num arquivo-cartório "
                       f"({len(registry_hits)} arquivo(s), ex.: {sorted(registry_hits)[0]})")
                per_slice[names[i]]["gaps"].append(msg.format(other=names[j]))
                per_slice[names[j]]["gaps"].append(msg.format(other=names[i]))
            if other_hits:
                warnings_global.append(
                    f"[{names[i]}, {names[j]}] cruzam fora de arquivo-cartório "
                    f"({len(other_hits)} arquivo(s), ex.: {sorted(other_hits)[0]}) — "
                    "conflito incidental fica para o verify pós-merge do merge train")

    # registry file that nobody declares -> wave warning, not a veto (without
    # `cartorios` in the plan there is no data, so the warning simply does not
    # fire, CS-3)
    if registry_files:
        declared = set().union(*expanded.values()) if expanded else set()
        friction = registry_files - declared
        if friction:
            warnings_global.append(
                f"{len(friction)} arquivo(s)-cartório fora de toda superfície "
                f"(ex.: {sorted(friction)[0]}) — nenhum slice declarou escrevê-los; "
                "confira se algum precisa")

    # ── report ──────────────────────────────────────────────────────────
    verdicts = {n: ("NOT-READY" if per_slice[n]["gaps"] or problems_global
                    else "READY") for n in names}

    if args.json:
        print(json.dumps({
            "wave": wave.get("id"),
            "fork_point": args.fork_point,
            "global_problems": problems_global,
            "global_warnings": warnings_global,
            "slices": {n: {"verdict": verdicts[n], **per_slice[n]} for n in names},
        }, ensure_ascii=False, indent=2))
    else:
        print(f"# cepa-dor — onda {wave.get('id')} @ {args.fork_point}\n")
        for p in problems_global:
            print(f" ✗ [programa] {p}")
        for w in warnings_global:
            print(f" ⚠ [onda] {w}")
        for n in names:
            v = verdicts[n]
            mark = "✓" if v == "READY" else "✗"
            print(f" {mark} [{n}] {v}")
            for g in per_slice[n]["gaps"]:
                print(f"     ✗ {g}")
            for w in per_slice[n]["warns"]:
                print(f"     ⚠ {w}")
        ready = sum(1 for v in verdicts.values() if v == "READY")
        print(f"\n{ready}/{len(names)} slice(s) READY.")

    if any(v == "NOT-READY" for v in verdicts.values()):
        return 2
    if warnings_global or any(per_slice[n]["warns"] for n in names):
        return 1
    return 0


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
