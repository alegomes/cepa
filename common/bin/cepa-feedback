#!/usr/bin/env python3
"""cepa-feedback — o caderno de reclamações do próprio harness.

The problem it solves: annoyance with the harness ALWAYS shows up in the middle
of something else. The gate blocks what it shouldn't, the command asks too much,
the report comes out unreadable — and at that moment there are two exits: drop
the task to open the Cepa repo's BACKLOG.md (which is almost never the repo you
are in), or move on and forget. Moving on and forgetting always wins. This file
is the third exit.

Design, and the reason for each choice:

  - **Global, not per repo.** The target of the feedback is Cepa, and the
    annoyance happens in the client's repo. A `.claude/feedback.md` per repo
    would scatter the same complaint across five places nobody rereads.
    Everything lands in ~/.claude/cepa-feedback/feedback-YYYY-MM.jsonl
    (CEPA_FEEDBACK_DIR overrides it).
  - **Append-only.** A record is never rewritten; triage is ANOTHER line that
    cites the id. The state ("aberto" / "triado") is a replay of the ledger, as
    in telemetry.
  - **Context captured automatically** — repo, branch, session mode. If the
    record depends on you remembering where you were, it is born useless: an
    August complaint read in October without the command that caused it never
    becomes a card.
  - **The text belongs to the owner, not the agent.** The command neither
    summarizes nor rewrites what you said; it records it verbatim.

Usage:
    cepa-feedback add "o gate X barrou o commit legítimo" --target write-mode-gate
    cepa-feedback list                     # the open ones
    cepa-feedback list --status todos --json
    cepa-feedback triage fb-20260826-1 --destination "BACKLOG.md § Gate de escrita"
    cepa-feedback triage fb-20260826-1 --destination "queue WEGO" --queue WEGO --why "..."

Exits: 0 ok · 2 invalid usage · 3 unknown id · 4 already triaged.
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

MIN_TEXT = 12  # a one-word complaint cannot be reconstructed months later
ORIGINS = ("comando", "skill", "hook", "manual")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402
try:
    import _telemetry as T
except Exception:  # noqa: BLE001 — telemetry never decides whether the record happens
    T = None

BOLD, DIM, YELLOW, GREEN, RESET = "\033[1m", "\033[2m", "\033[33m", "\033[32m", "\033[0m"


def ledger_dir():
    d = os.environ.get("CEPA_FEEDBACK_DIR")
    return Path(d) if d else Path.home() / ".claude" / "cepa-feedback"


def _git(args, cwd):
    try:
        out = subprocess.run(["git", "-C", str(cwd)] + args,
                             capture_output=True, text=True, timeout=5)
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def context(cwd):
    """Repo, branch and mode — what makes the complaint reconstructable later."""
    root = _git(["rev-parse", "--show-toplevel"], cwd) or str(cwd)
    git_common = _git(["rev-parse", "--path-format=absolute", "--git-common-dir"], cwd)
    if git_common.endswith("/.git"):
        repo = Path(git_common).parent.name
    elif git_common:
        repo = Path(git_common).name
    else:
        repo = Path(root).name
    branch = _git(["rev-parse", "--abbrev-ref", "HEAD"], cwd) or None
    mode = None
    path = Path(root) / ".claude" / "session-mode"
    if path.is_file():
        try:
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                k, _, v = line.partition(":")
                if k.strip() in ("mode", "modo"):  # `modo` = file from an old cepa
                    v = v.strip().strip('"')
                    mode = v if v and v != "null" else None
        except OSError:
            pass
    return {"repo": repo or None, "branch": branch, "modo": mode}


def ledger_files():
    d = ledger_dir()
    return sorted(d.glob("feedback-*.jsonl")) if d.is_dir() else []


def events():
    """Every ledger line, in file order. A corrupted line is skipped: a ledger
    that dies on one bad line loses the rest of what was right."""
    for path in ledger_files():
        try:
            content = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in content.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if isinstance(ev, dict) and ev.get("id"):
                yield ev


def records():
    """Ledger replay: id → record with `status` and the triage, when there was one."""
    out = {}
    for ev in events():
        kind = ev.get("tipo")
        if kind == "feedback":
            r = dict(ev)
            r["status"] = "aberto"
            r["triagem"] = None
            out.setdefault(ev["id"], r)
        elif kind == "triagem" and ev["id"] in out:
            out[ev["id"]]["status"] = "triado"
            out[ev["id"]]["triagem"] = {
                "destino": ev.get("destino"), "nota": ev.get("nota"), "ts": ev.get("ts"),
            }
    return out


def new_id(now):
    day = now.strftime("%Y%m%d")
    n = sum(1 for ev in events() if ev.get("tipo") == "feedback"
            and str(ev.get("id", "")).startswith(f"fb-{day}-"))
    return f"fb-{day}-{n + 1}"


def write_event(ev):
    d = ledger_dir()
    d.mkdir(parents=True, exist_ok=True)
    path = d / f"feedback-{datetime.now(timezone.utc):%Y-%m}.jsonl"
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(ev, ensure_ascii=False) + "\n")
    return path


def cmd_add(args):
    text = " ".join(args.text).strip()
    if not text:
        print("✗ feedback vazio: diga o que incomodou.", file=sys.stderr)
        return 2
    if len(text) < MIN_TEXT:
        print(f"✗ feedback curto demais ({len(text)} caracteres, mínimo {MIN_TEXT}).\n"
              "  Uma palavra não se reconstrói meses depois — diga o que o harness "
              "fez e o que você esperava.", file=sys.stderr)
        return 2
    if args.origin not in ORIGINS:
        print(f"✗ origem inválida: {args.origin} (válidas: {', '.join(ORIGINS)})",
              file=sys.stderr)
        return 2

    now = datetime.now(timezone.utc)
    ev = {
        "ts": now.isoformat(),
        "tipo": "feedback",
        "id": new_id(now),
        "texto": text,
        "alvo": args.target or None,
        "origem": args.origin,
    }
    ev.update(context(args.repo or os.getcwd()))
    path = write_event(ev)
    if T:
        try:
            T.emit("feedback_capturado", origem=args.origin, alvo=args.target or "none")
        except Exception:  # noqa: BLE001
            pass

    if args.as_json:
        print(json.dumps({"id": ev["id"], "arquivo": str(path)}, ensure_ascii=False))
    else:
        print(f"✔ feedback {ev['id']} registrado ({path}).")
    return 0


def _format_record(r, color):
    mark = GREEN + "aberto" + RESET if r["status"] == "aberto" else DIM + "triado" + RESET
    if not color:
        mark = r["status"]
    header = f"{BOLD}{r['id']}{RESET}  {mark}  {DIM}{r['ts'][:16]}{RESET}"
    ctx = " · ".join(x for x in (r.get("repo"), r.get("branch"), r.get("modo"),
                                 r.get("alvo")) if x)
    body = [header, f"  {r['texto']}"]
    if ctx:
        body.append(f"  {DIM}{ctx}{RESET}")
    if r["status"] == "triado" and r.get("triagem"):
        body.append(f"  {DIM}→ {r['triagem'].get('destino')}{RESET}")
    return "\n".join(body)


def cmd_list(args):
    everything = list(records().values())
    everything.sort(key=lambda r: r.get("ts", ""))
    selected = [r for r in everything
                if (args.status == "todos" or r["status"] == args.status)
                and (not args.repo_name or r.get("repo") == args.repo_name)]
    if args.max:
        selected = selected[-args.max:]

    if args.as_json:
        print(json.dumps(selected, ensure_ascii=False, indent=2))
        return 0

    color = sys.stdout.isatty() and not args.no_color
    if not color:
        global BOLD, DIM, YELLOW, GREEN, RESET
        BOLD = DIM = YELLOW = GREEN = RESET = ""
    if not selected:
        d = ledger_dir()
        print(f"Nenhum feedback {args.status} em {d}."
              if d.is_dir() else f"Nenhum feedback registrado ainda ({d} não existe).")
        return 0
    for r in selected:
        print(_format_record(r, color))
        print()
    open_count = sum(1 for r in everything if r["status"] == "aberto")
    print(f"{DIM}{len(selected)} exibido(s) · {open_count} aberto(s) no total.{RESET}")
    return 0


def cmd_triage(args):
    destination = (args.destination or "").strip()
    if not destination:
        print("✗ triagem sem destino: diga onde o item foi parar "
              "(card, seção do BACKLOG.md, commit).", file=sys.stderr)
        return 2
    recs = records()
    r = recs.get(args.id)
    if not r:
        print(f"✗ id inexistente: {args.id}", file=sys.stderr)
        return 3
    if r["status"] == "triado":
        previous = (r.get("triagem") or {}).get("destino")
        print(f"✗ {args.id} já foi triado → {previous}", file=sys.stderr)
        return 4
    ev = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "tipo": "triagem",
        "id": args.id,
        "destino": destination,
        "nota": (args.note or None),
    }
    write_event(ev)
    if T:
        try:
            T.emit("feedback_triado")
        except Exception:  # noqa: BLE001
            pass
    print(f"✔ {args.id} → {destination}")

    # A1: --queue appends the item to the single-track queue in the SAME step
    # in which the triage closes, so the feedback does not vanish into a
    # prose destination nobody revisits. The triage is already written above —
    # a failure from here on means "did not enter the queue", never "the
    # triage did not happen".
    if args.queue:
        title = r["texto"][:100]
        cepa_plan = Path(__file__).resolve().parent / "cepa-plan"
        cmd = [sys.executable, str(cepa_plan), "add", args.queue, args.id,
               "--title", title, "--repo", args.repo]
        if args.why:
            cmd += ["--why", args.why]
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError) as e:
            print(f"⚠ {args.id} não entrou na fila '{args.queue}': "
                  f"cepa-plan não rodou ({e})", file=sys.stderr)
            return 0
        if p.returncode == 0:
            print(f"✔ {args.id} também entrou na fila '{args.queue}'.")
        elif p.returncode == 4:
            print(f"· {args.id} já estava na fila '{args.queue}' — nada mudou lá.")
        else:
            detail = (p.stderr or p.stdout).strip().splitlines()
            print(f"⚠ triagem registrada, mas {args.id} NÃO entrou na fila "
                  f"'{args.queue}': "
                  f"{detail[-1] if detail else 'erro desconhecido'}",
                  file=sys.stderr)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="cepa-feedback",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Registra e acompanha o feedback sobre o próprio harness.\n"
            "\n"
            "O incômodo com o harness sempre aparece no meio de outra coisa: o gate\n"
            "que barrou o que não devia, o comando que perguntou demais, o relatório\n"
            "ilegível. Em vez de largar a tarefa para abrir o BACKLOG.md do Cepa, ou\n"
            "seguir e esquecer, registre aqui.\n"
            "\n"
            "O ledger é GLOBAL e append-only: ~/.claude/cepa-feedback/feedback-AAAA-MM.jsonl\n"
            "(CEPA_FEEDBACK_DIR sobrescreve). Repo, branch e modo da sessão são\n"
            "capturados sozinhos; o texto é gravado verbatim, nunca resumido."),
        epilog=(
            "exemplos:\n"
            "  cepa-feedback add \"o gate X barrou o commit legítimo\" --target write-mode-gate\n"
            "  cepa-feedback list                      # os abertos\n"
            "  cepa-feedback list --status todos --json\n"
            "  cepa-feedback triage fb-20260826-1 --destination \"BACKLOG.md § Gate de escrita\"\n"
            "  cepa-feedback triage fb-20260826-1 --destination \"fila WEGO\" --queue WEGO --why \"...\"\n"
            "\n"
            "saída: 0 ok · 2 uso inválido · 3 id desconhecido · 4 já triado\n"
            "cada subcomando tem o próprio --help."))
    sub = ap.add_subparsers(dest="cmd", metavar="<subcomando>")

    a = sub.add_parser("add", help="registra um feedback (texto verbatim)",
                       description="Registra um feedback. O texto vai verbatim para o "
                                   "ledger, com repo, branch e modo da sessão capturados "
                                   "sozinhos. Recusa texto vazio ou de uma palavra só.")
    a.add_argument("text", nargs="+", metavar="texto",
                   help="o feedback, nas suas palavras (aspas opcionais)")
    a.add_argument("--target", "--alvo", dest="target", metavar="ALVO",
                   help="comando, hook ou agente que causou o incômodo")
    a.add_argument("--origin", "--origem", dest="origin", default="manual", choices=ORIGINS,
                   help="quem está registrando (default: manual)")
    a.add_argument("--repo", metavar="DIR",
                   help="diretório de onde tirar repo, branch e modo (default: o atual)")
    a.add_argument("--json", action="store_true", dest="as_json",
                   help="saída em JSON, para código")
    a.set_defaults(func=cmd_add)

    l = sub.add_parser("list", help="lista os feedbacks registrados",
                       description="Lista os feedbacks do ledger, os abertos por default.")
    l.add_argument("--status", default="aberto", choices=("aberto", "triado", "todos"),
                   help="quais listar (default: aberto)")
    l.add_argument("--repo", dest="repo_name", metavar="NOME",
                   help="só os registrados neste repo (pelo nome)")
    l.add_argument("--max", type=int, metavar="N", help="só os N mais recentes")
    l.add_argument("--json", action="store_true", dest="as_json",
                   help="saída em JSON, para código")
    l.add_argument("--no-color", "--sem-cor", dest="no_color", action="store_true",
                   help="sem cores no terminal")
    l.set_defaults(func=cmd_list)

    t = sub.add_parser("triage", aliases=["triar"],
                       help="marca um feedback como triado, com destino",
                       description="Marca um feedback como triado, dizendo onde ele foi "
                                   "parar. A triagem é outra linha do ledger citando o id; "
                                   "um id já triado é recusado (saída 4).")
    t.add_argument("id", help="o id do feedback, como o `list` imprime (ex.: fb-20260826-1)")
    t.add_argument("--destination", "--destino", dest="destination", required=True,
                   metavar="DESTINO", help="onde o item foi parar (seção do BACKLOG, fila, card)")
    t.add_argument("--note", "--nota", dest="note", metavar="NOTA",
                   help="observação livre sobre a triagem")
    t.add_argument("--queue", "--plano", dest="queue", metavar="FILA",
                   help="acrescenta o feedback à fila single-track FILA via "
                        "`cepa-plan add` (título = os ~100 primeiros "
                        "caracteres do texto do feedback). Exit 4 do add "
                        "(id já na fila) não é erro; qualquer outra falha do "
                        "add não desfaz a triagem, só avisa que o item ficou "
                        "de fora da fila")
    t.add_argument("--why", help="`--why` repassado ao `cepa-plan add`, "
                                 "quando --queue é usado")
    t.add_argument("--repo", default=".",
                   help="repo onde mora a fila de --queue (default: cwd)")
    t.set_defaults(func=cmd_triage)

    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help(sys.stderr)
        return 2
    return args.func(args)


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
