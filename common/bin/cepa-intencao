#!/usr/bin/env python3
# Deprecated alias: renamed to cepa-intent. Python (not sh) so both `cepa-intencao ...` and `python3 cepa-intencao ...` keep working.
import os, sys; d = os.path.dirname(os.path.realpath(__file__))
os.execv(sys.executable, [sys.executable, os.path.join(d, "cepa-intent"), *sys.argv[1:]])
