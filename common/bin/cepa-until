#!/usr/bin/env python3
"""cepa-until — executa a fila do repo por uma JANELA DE TEMPO, sem ninguém acordado.

## Por que existe

Os três executores em lote do harness (`/board-flow:drain`, `/common:drain-plan`,
`/board-flow:prove-drain`) são limitados por CONTAGEM: `--max N`. Contagem é a
forma errada para aproveitar ociosidade — você não sabe quantos itens cabem numa
noite, sabe quantas horas tem. O que falta é um teto de relógio.

Mas relógio sozinho não resolve, porque o que mata uma sessão longa não é o
tempo: é o CONTEXTO. Uma sessão de 12h estoura muito antes das 12h, e quem
retoma hoje é uma pessoa digitando `/common:autonomous-resume` — às 3h da manhã,
ninguém digita.

Daí o desenho: **um item por subprocesso**. Este supervisor dispara

    claude -p "/common:drain-plan <fila> --max 1"

uma vez por item, num processo novo a cada vez. Estouro de contexto deixa de ser
uma falha e vira o fim normal de um subprocesso — o supervisor dispara o
próximo, com a janela de contexto limpa. É isso, e só isso, que torna 12h
possíveis.

## O que ele NÃO faz, de propósito

Ele não reserva item, não registra desfecho, não conhece a topologia e não sabe
o que é um card. Quem faz tudo isso é o `/common:drain-plan` + o `cepa-plan`,
que já têm a máquina de estado necessária, construída e testada:

  - `cepa-plan start` reserva o item ASSINANDO a reserva (sessão, pid, host);
  - `cepa-plan queue` devolve como executável a reserva cujo pid morreu — a
    "reserva órfã". É o que impede um subprocesso morto de travar a fila para
    sempre, e é exatamente a garantia de que um supervisor precisa;
  - `cepa-plan finish` grava o desfecho, inclusive a rota que só o humano fecha.

Este arquivo é a fiação em volta disso: relógio, disjuntor e registro.

## As quatro decisões do dono (2026-08-30)

1. **A fonte é a fila em disco** (`/common:drain-plan`), não a coluna do quadro.
   A fila guarda a ORDEM e o PORQUÊ, e não depende do Jira estar de pé às 3h.
2. **Disjuntor em 3 falhas seguidas.** Abaixo disso é azar; acima é queimar a
   janela inteira num problema sistêmico.
3. **Commit por item, numa branch só.** Sem trem de merge e sem N branches
   penduradas esperando alguém reparar — que é o defeito medido do Maestro na
   onda 1 do WEGO-paralelo (5 branches verdes paradas, 2 delas por meio dia).
   Isso é GUARDA, não intenção: a branch da largada é gravada e conferida entre
   itens, e o run encerra se ela mudou. O supervisor não commita nem cria
   branch — quem faz isso é o fluxo dentro do subprocesso —, então sem a
   conferência a noite podia se espalhar em branches caladas e o banner
   continuaria imprimindo a branch certa. (Lacuna achada pelo gate de aceite,
   2026-08-30.)
4. **`--dangerously-skip-permissions` ligado.** Sem isso o subprocesso trava no
   primeiro pedido de permissão e a noite morre em silêncio. Fica explícito no
   banner e desligável por `--com-permissoes`.

## Onde o corte acontece

Entre itens, NUNCA no meio de um. Matar um item pela metade deixa árvore suja e
reserva pendurada. Duas folgas controlam isso:

  - `--reserva-minima` (default 25min): não COMEÇA um item se sobra menos que
    isso. Um item que não cabe na janela é trabalho jogado fora.
  - `--folga` (default 60min): quanto um item JÁ RODANDO pode passar do prazo
    antes de ser morto. Passou disso, é morte por timeout — registrada, e a
    reserva órfã volta para a fila no próximo run.

## Quando ele para

Para no primeiro de: prazo atingido, fila sem item executável (a razão vem do
`cepa-plan queue` — `fim-da-fila`, `bloqueado`, `bloqueado-antes`), ou disjuntor.
Um item que sai `blocked` PARA o lote — regra do `cepa-plan`, herdada do
`/board-flow:drain`: re-executar mede o mesmo travamento.

Uso:
    cepa-until minha-fila --for 12h
    cepa-until minha-fila --until 07:00
    cepa-until minha-fila --for 3h --dry-run     # o plano do run, sem executar
"""

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

try:
    import yaml
except ImportError:
    print("cepa-until precisa de PyYAML (pip install pyyaml)", file=sys.stderr)
    sys.exit(2)

AQUI = Path(__file__).resolve().parent
CEPA_PLAN = AQUI / "cepa-plan"

RESERVA_MINIMA_PADRAO = "25m"
FOLGA_PADRAO = "60m"
MAX_FALHAS_PADRAO = 3

# Quanto esperar entre o SIGTERM e o SIGKILL ao matar um item que estourou a
# folga. O SIGTERM educado é o primeiro pedido; o SIGKILL existe porque um
# processo pode IGNORAR o primeiro (build com trap, wrapper de shell), e sem a
# escalada ele seguiria rodando a noite inteira enquanto o supervisor achava
# que tinha matado. Ajustável só para o teste conseguir exercer a escalada sem
# esperar meio minuto por caso.
GRACA_SIGTERM = float(os.environ.get("CEPA_UNTIL_GRACA_SIGTERM", "30"))

# Status que contam como PROGRESSO no item. `dropped` entra porque o item saiu
# da fila por decisão registrada, não por falha do run.
TERMINAIS = {"done", "blocked", "dropped"}

# Quantos subprocessos a MESMA janela gasta no MESMO item antes de tirá-lo da
# frente. O `queue` sempre entrega o primeiro item executável, e um subprocesso
# morto devolve a reserva como órfã — então um item que não sai do lugar é
# reoferecido para sempre. Em 2026-08-30 o WEGO-1941 consumiu 3 das 5
# tentativas do run com 15 pendentes atrás dele. Duas é o teto porque a segunda
# tentativa tem valor medido: o WEGO-2206 falhou parado num build em segundo
# plano e fechou na repetição, quando o build já tinha acabado.
TENTATIVAS_POR_ITEM_PADRAO = 2

# O que o `claude` imprime quando a CONTA bateu o teto de uso — não o item, não
# a fila, não a topologia. Sem reconhecer isto o supervisor lê só "saiu 1 e o
# item não andou" e culpa o card: em 2026-08-30 duas tentativas de 92s e 4s
# entraram no disjuntor como se o WEGO-1941 fosse sistematicamente ruim, e o
# relatório da manhã mandava investigar o item errado. Repetir também não
# levanta o teto — quem levanta é o relógio —, então o run PARA aqui, com
# motivo próprio, em vez de gastar a janela batendo na mesma porta.
LIMITE_DE_USO = re.compile(
    r"(?:you'?ve|you have)\s+(?:hit|reached)\s+your\s+[\w\s-]{0,24}\blimit\b"
    r"|\busage limit reached\b"
    r"|\blimit reached\b\s*[\u00b7\u2022\u2219|-]\s*resets\b",
    re.I)

# O horário do reset, quando a mensagem traz — é o dado que decide se remarcar a
# janela ou desistir da noite, e some se o supervisor só registrar "bateu limite".
RESET_DO_LIMITE = re.compile(r"resets?(?:\s+at)?\s+([^\n(]{1,40})", re.I)

# A marca de "você está dentro de uma janela desatendida", exportada para cada
# subprocesso. O hook `no-background-build` só existe quando ela está no
# ambiente: numa sessão interativa mandar o build para o segundo plano é a
# coisa certa (a notificação reinvoca a sessão), e sob `claude -p` é perder o
# item, porque não há turno seguinte para colher o resultado.
ENV_JANELA = "CEPA_UNTIL_RUN"

# Quanto da saída do subprocesso o reconhecedor de limite olha. Ler o pedaço
# final DESTA tentativa (e não o log inteiro, que é append) é o que impede
# reagir à mensagem de uma tentativa anterior; ler só o fim é o que impede
# reagir ao relatório de um agente que MENCIONA limite de uso em prosa.
CAUDA_DA_SAIDA = 2000


# ── relógio ─────────────────────────────────────────────────────────────────

_DUR = re.compile(r"^(\d+(?:\.\d+)?)\s*([hm])$", re.I)


def parse_duracao(texto, flag="--for"):
    """'12h' / '90m' → timedelta. Sem unidade não passa: '12' é ambíguo e a
    ambiguidade aqui custa uma noite inteira na unidade errada.

    `flag` existe porque três opções passam por aqui (--for, --reserva-minima,
    --folga) e uma recusa que nomeia a flag errada manda você conferir o
    argumento certo — foi o que uma perturbação flagrou em 2026-08-30.
    """
    m = _DUR.match(texto.strip())
    if not m:
        raise ValueError(
            f"{flag} {texto!r} não é uma duração: use '12h' ou '90m' (a unidade "
            "é obrigatória)")
    valor, unidade = float(m.group(1)), m.group(2).lower()
    if valor <= 0:
        raise ValueError(f"{flag} {texto!r} não é positivo")
    return timedelta(hours=valor) if unidade == "h" else timedelta(minutes=valor)


def parse_ate(texto, agora):
    """'07:00' → o próximo 07:00 no futuro. Se já passou hoje, é amanhã."""
    try:
        hh, mm = texto.strip().split(":")
        alvo = agora.replace(hour=int(hh), minute=int(mm), second=0, microsecond=0)
    except Exception:
        raise ValueError(f"--until {texto!r} não é um horário: use 'HH:MM'")
    if alvo <= agora:
        alvo += timedelta(days=1)
    return alvo


def humano(td):
    total = int(max(td.total_seconds(), 0))
    h, m = total // 3600, (total % 3600) // 60
    return f"{h}h{m:02d}" if h else f"{m}min"


# ── leitura da fila ─────────────────────────────────────────────────────────

def consulta_fila(nome, repo):
    """`cepa-plan queue --max 1 --json`. Devolve (dados, erro)."""
    try:
        p = subprocess.run(
            [sys.executable, str(CEPA_PLAN), "queue", nome,
             "--max", "1", "--repo", str(repo), "--json"],
            capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return None, "o `cepa-plan queue` não respondeu em 60s"
    if p.returncode != 0:
        return None, (p.stderr or p.stdout or "").strip() or \
            f"`cepa-plan queue` saiu {p.returncode}"
    try:
        return json.loads(p.stdout), None
    except json.JSONDecodeError as e:
        return None, f"o `cepa-plan queue` não devolveu JSON ({e})"


def le_item(caminho_plano, ident):
    """Status atual do item no disco. A verdade do desfecho é o PLANO, não o
    código de saída do subprocesso — sincronize pelo efeito verificável."""
    try:
        plan = yaml.safe_load(Path(caminho_plano).read_text(encoding="utf-8"))
    except Exception as e:
        return None, f"não consegui reler {caminho_plano}: {e}"
    for it in (plan or {}).get("items") or []:
        if isinstance(it, dict) and str(it.get("id")) == str(ident):
            return it, None
    return None, f"o item {ident} sumiu do plano durante o run"


# ── execução de um item ─────────────────────────────────────────────────────

def monta_comando(nome, repo, permissoes):
    cmd = ["claude", "-p", f"/common:drain-plan {nome} --max 1"]
    if not permissoes:
        cmd.append("--dangerously-skip-permissions")
    return cmd


def cauda_do_log(log, desde, limite=CAUDA_DA_SAIDA):
    """O fim do que UMA tentativa escreveu no log. `desde` é o tamanho do
    arquivo antes de ela começar."""
    try:
        with open(log, "rb") as f:
            f.seek(desde)
            bruto = f.read()
    except OSError:
        return ""
    return bruto[-limite:].decode("utf-8", "replace")


def limite_de_uso(texto):
    """(True, reset) se a saída é a conta batendo o teto de uso; (False, None)
    se não. `reset` é o horário verbatim que a mensagem deu, ou None."""
    if not texto or not LIMITE_DE_USO.search(texto):
        return False, None
    m = RESET_DO_LIMITE.search(texto)
    return True, (m.group(1).strip().rstrip(".") if m else None)


def executa_item(nome, repo, permissoes, limite_seg, log):
    """Dispara UM subprocesso.
    Devolve (codigo, matou_por_timeout, segundos, saida_desta_tentativa)."""
    cmd = monta_comando(nome, repo, permissoes)
    inicio = time.monotonic()
    try:
        marca = os.path.getsize(log)
    except OSError:
        marca = 0
    with open(log, "ab", buffering=0) as saida:
        saida.write(f"\n===== {datetime.now().isoformat(timespec='seconds')} "
                    f"· {' '.join(cmd)}\n".encode("utf-8"))
        saida.flush()
        try:
            proc = subprocess.Popen(cmd, cwd=str(repo), stdout=saida,
                                    stderr=subprocess.STDOUT,
                                    stdin=subprocess.DEVNULL,
                                    env=dict(os.environ, **{ENV_JANELA: "1"}),
                                    start_new_session=True)
        except OSError as e:
            # O `claude` sumiu do PATH, ficou sem permissão ou o binário está
            # corrompido DEPOIS da largada. Estourar aqui mataria o supervisor
            # e a janela junto, deixando o registro pela metade — o oposto do
            # que ele existe para fazer. Vira item sem progresso: o disjuntor
            # encerra em 3, com o motivo escrito.
            saida.write(f"MAESTRO-SPAWN-FALHOU: {e}\n".encode("utf-8"))
            return -2, False, time.monotonic() - inicio, ""
        try:
            codigo = proc.wait(timeout=max(limite_seg, 1))
            matou = False
        except subprocess.TimeoutExpired:
            # Mata o GRUPO: o claude spawna filhos (builds, mvn), e matar só o
            # pai deixa build órfão segurando a árvore.
            matou = True
            try:
                os.killpg(proc.pid, signal.SIGTERM)
                proc.wait(timeout=GRACA_SIGTERM)
            except Exception:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except Exception:
                    pass
            codigo = proc.returncode if proc.returncode is not None else -1
    return codigo, matou, time.monotonic() - inicio, cauda_do_log(log, marca)


def bloqueia_item(nome, repo, ident, tentativas):
    """Tira da frente da fila o item que gastou o teto de tentativas.
    Devolve None se conseguiu, ou o erro em texto.

    Este é o ÚNICO ponto em que o supervisor ESCREVE no plano, e a exceção é
    deliberada. O que ele grava aqui — "este item já consumiu N subprocessos
    DESTA janela" — é um fato que só existe neste nível: cada subprocesso nasce
    sem memória do anterior, que é justamente o que torna 12h possíveis, então
    nem o `/common:drain-plan` nem o `cepa-plan` têm como enxergar a repetição.
    Sem a marca, o `queue` reoferece o mesmo item para sempre.

    `blocked` é o estado certo e não é um estado novo: o `monta_lote` ADIA
    `blocked` e segue para o próximo item, que é exatamente a semântica pedida,
    e o `finish` já limpa o `claimed_by` — a reserva órfã não fica pendurada.
    """
    evidencia = (
        f"{tentativas} tentativas seguidas do `cepa-until` na mesma janela sem "
        "tirar o item do lugar. Isto NÃO é veredito sobre o trabalho nem "
        "condição de fora: é o supervisor tirando o item da frente para a fila "
        "andar. A saída do `claude` de cada tentativa está no `.log` do run; "
        "devolva o item para `pending` quando souber o que travou.")
    try:
        p = subprocess.run(
            [sys.executable, str(CEPA_PLAN), "finish", nome, str(ident),
             "--status", "blocked", "--evidence", evidencia,
             "--repo", str(repo)],
            capture_output=True, text=True, timeout=60)
    except (subprocess.TimeoutExpired, OSError) as e:
        return f"o `cepa-plan finish` não respondeu: {e}"
    if p.returncode != 0:
        return (p.stderr or p.stdout or "").strip() or \
            f"`cepa-plan finish` saiu {p.returncode}"
    return None


# ── guardas de largada ──────────────────────────────────────────────────────

def arvore_suja(repo):
    try:
        p = subprocess.run(["git", "status", "--porcelain"], cwd=str(repo),
                           capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    if p.returncode != 0:
        return None
    return [l for l in p.stdout.splitlines() if l.strip()]


def branch_atual(repo):
    try:
        p = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                           cwd=str(repo), capture_output=True, text=True, timeout=30)
        return p.stdout.strip() if p.returncode == 0 else "?"
    except Exception:
        return "?"


# ── o laço ──────────────────────────────────────────────────────────────────

def main(argv=None):
    ap = argparse.ArgumentParser(
        description="executa a fila single-track do repo por uma janela de tempo")
    ap.add_argument("fila", help="nome da fila em .claude/programs/<nome>/plan.yaml")
    janela = ap.add_mutually_exclusive_group(required=True)
    janela.add_argument("--for", dest="duracao", metavar="12h",
                        help="quanto tempo rodar (ex.: 12h, 90m)")
    janela.add_argument("--until", dest="ate", metavar="07:00",
                        help="até que horas rodar (próximo HH:MM)")
    ap.add_argument("--repo", default=".")
    ap.add_argument("--max-falhas", type=int, default=MAX_FALHAS_PADRAO,
                    dest="max_falhas",
                    help=f"disjuntor: falhas SEGUIDAS que encerram o run "
                         f"(default {MAX_FALHAS_PADRAO})")
    ap.add_argument("--tentativas-por-item", type=int,
                    default=TENTATIVAS_POR_ITEM_PADRAO, dest="tentativas_item",
                    help=f"quantos subprocessos a mesma janela gasta no mesmo "
                         f"item antes de marcá-lo `blocked` e seguir para o "
                         f"próximo (default {TENTATIVAS_POR_ITEM_PADRAO})")
    ap.add_argument("--reserva-minima", default=RESERVA_MINIMA_PADRAO,
                    dest="reserva",
                    help=f"não começa item se sobra menos que isso "
                         f"(default {RESERVA_MINIMA_PADRAO})")
    ap.add_argument("--folga", default=FOLGA_PADRAO,
                    help=f"quanto um item já rodando pode passar do prazo antes "
                         f"de ser morto (default {FOLGA_PADRAO})")
    ap.add_argument("--com-permissoes", action="store_true", dest="permissoes",
                    help="NÃO passa --dangerously-skip-permissions. O "
                         "subprocesso vai travar no primeiro pedido de "
                         "permissão — só use com alguém olhando")
    ap.add_argument("--sujo-ok", action="store_true", dest="sujo_ok",
                    help="começa mesmo com a árvore suja (por default recusa: "
                         "sem isso não dá para separar o que o run fez do que "
                         "já estava lá)")
    ap.add_argument("--dry-run", action="store_true", dest="dry",
                    help="mostra o plano do run e sai sem executar nada")
    a = ap.parse_args(argv)

    repo = Path(a.repo).resolve()
    agora = datetime.now()

    try:
        prazo = (agora + parse_duracao(a.duracao)) if a.duracao \
            else parse_ate(a.ate, agora)
        reserva = parse_duracao(a.reserva, "--reserva-minima")
        folga = parse_duracao(a.folga, "--folga")
    except ValueError as e:
        print(f"cepa-until: {e}", file=sys.stderr)
        return 2

    if a.max_falhas < 1:
        print("cepa-until: --max-falhas precisa ser >= 1", file=sys.stderr)
        return 2
    if a.tentativas_item < 1:
        print("cepa-until: --tentativas-por-item precisa ser >= 1 — com 0 o run "
              "marcaria `blocked` todo item antes de tentar", file=sys.stderr)
        return 2
    if not shutil.which("claude"):
        print("cepa-until: `claude` não está no PATH — sem ele não há o que "
              "supervisionar", file=sys.stderr)
        return 2

    dados, erro = consulta_fila(a.fila, repo)
    if erro:
        print(f"cepa-until: a fila {a.fila!r} não está executável — {erro}",
              file=sys.stderr)
        return 2

    sujeira = arvore_suja(repo)
    if sujeira and not a.sujo_ok:
        print(f"cepa-until: a árvore tem {len(sujeira)} arquivo(s) modificado(s). "
              "Commite ou limpe antes — de manhã não dá para separar o que o run "
              "fez do que já estava aqui. (--sujo-ok ignora este guarda.)",
              file=sys.stderr)
        for l in sujeira[:10]:
            print(f"    {l}", file=sys.stderr)
        return 2

    ledger_dir = repo / ".claude" / "programs" / a.fila / "until"
    ledger_dir.mkdir(parents=True, exist_ok=True)
    run_id = agora.strftime("%Y-%m-%d-%H%M")
    ledger = ledger_dir / f"{run_id}.jsonl"
    log = ledger_dir / f"{run_id}.log"

    print(f"cepa-until · fila {dados.get('program')} · {repo}")
    print(f"  branch      : {branch_atual(repo)}")
    print(f"  janela      : agora → {prazo.strftime('%d/%m %H:%M')} "
          f"({humano(prazo - agora)})")
    print(f"  disjuntor   : {a.max_falhas} falhas seguidas")
    print(f"  por item    : até {a.tentativas_item} tentativa(s); depois disso "
          "vira `blocked` e a fila anda")
    print(f"  reserva     : não começa item com menos de {humano(reserva)}")
    print(f"  folga       : mata item que passar {humano(folga)} do prazo")
    print(f"  permissões  : "
          + ("PEDE (vai travar sem alguém olhando)" if a.permissoes
             else "--dangerously-skip-permissions LIGADO"))
    print(f"  registro    : {ledger}")
    prox = (dados.get("batch") or [{}])[0]
    print(f"  1º item     : {prox.get('id', '(nenhum — fila sem item executável)')}"
          + (f" — {prox.get('title')}" if prox.get("id") else ""))
    t = dados.get("totals") or {}
    print(f"  fila        : {t.get('por_status', {}).get('pending', 0)} pendente(s), "
          f"{t.get('por_status', {}).get('done', 0)} done")

    if a.dry:
        print("\n(--dry-run: nada foi executado)")
        return 0
    if not dados.get("batch"):
        parada = dados.get("stop") or {}
        print(f"\nnada a fazer: {parada.get('reason')} — {parada.get('detail')}")
        return 0

    def registra(evento):
        evento["quando"] = datetime.now().isoformat(timespec="seconds")
        with ledger.open("a", encoding="utf-8") as f:
            f.write(json.dumps(evento, ensure_ascii=False) + "\n")

    branch_largada = branch_atual(repo)
    registra({"evento": "run_start", "fila": a.fila, "prazo": prazo.isoformat(),
              "max_falhas": a.max_falhas, "branch": branch_largada})

    falhas_seguidas = 0
    feitos, falhados, itens = [], [], 0
    # Quantas vezes ESTA janela já disparou um subprocesso para cada item, e o
    # que ela tirou da frente por esgotamento ou pelo teto de uso da conta.
    tentativas, esgotados, limitados = {}, [], []
    motivo_fim, detalhe_fim = None, None

    print()
    while True:
        restante = prazo - datetime.now()
        if restante < reserva:
            motivo_fim = "prazo"
            detalhe_fim = (f"sobram {humano(restante)}, menos que a reserva "
                           f"mínima de {humano(reserva)} — começar um item "
                           "agora seria trabalho jogado fora")
            break

        agora_branch = branch_atual(repo)
        if agora_branch != branch_largada:
            motivo_fim = "branch-mudou"
            detalhe_fim = (
                f"a largada foi em `{branch_largada}` e agora estamos em "
                f"`{agora_branch}` — alguém trocou de branch no meio do run. "
                "Seguir espalharia os commits da noite por branches que "
                "ninguém vai buscar de manhã, que é exatamente o que a decisão "
                "de commitar por item numa branch só existe para impedir")
            break

        dados, erro = consulta_fila(a.fila, repo)
        if erro:
            motivo_fim, detalhe_fim = "fila-ilegivel", erro
            break
        for aviso in dados.get("warnings") or []:
            print(f"  aviso: {aviso}")
            registra({"evento": "aviso", "texto": aviso})
        if not dados.get("batch"):
            parada = dados.get("stop") or {}
            motivo_fim = parada.get("reason") or "fim-da-fila"
            detalhe_fim = parada.get("detail") or "a fila não tem item executável"
            break

        item = dados["batch"][0]
        ident = item["id"]
        caminho_plano = dados.get("path")
        itens += 1
        tentativas[ident] = tentativas.get(ident, 0) + 1
        vez = tentativas[ident]

        print(f"[{datetime.now().strftime('%H:%M')}] {ident} — {item.get('title')} "
              f"({humano(restante)} restantes"
              + (f", tentativa {vez}/{a.tentativas_item}" if vez > 1 else "") + ")")
        registra({"evento": "item_start", "id": ident, "title": item.get("title"),
                  "restante_seg": int(restante.total_seconds()),
                  "tentativa": vez})

        limite = (restante + folga).total_seconds()
        codigo, matou, gasto, saida = executa_item(
            a.fila, repo, a.permissoes, limite, log)

        depois, erro_item = le_item(caminho_plano, ident)
        if erro_item:
            estado, progresso = "?", False
            pendencia = None
        else:
            estado = str(depois.get("status") or "pending").strip().lower()
            pendencia = depois.get("human_pending")
            progresso = estado in TERMINAIS or pendencia is not None

        registra({"evento": "item_end", "id": ident, "status": estado,
                  "human_pending": pendencia, "exit_code": codigo,
                  "timeout": matou, "segundos": int(gasto),
                  "tentativa": vez, "progresso": progresso})

        # O teto de uso da CONTA, antes do disjuntor. Sem esta separação a
        # mensagem "You've hit your session limit" vira "o item não saiu do
        # lugar" e o relatório da manhã acusa o card errado. Só é consultado
        # quando o item não andou — uma tentativa que FECHOU o item não vira
        # parada, aconteça o que acontecer depois na saída.
        if not progresso:
            bateu, reset = limite_de_uso(saida)
            if bateu:
                limitados.append((ident, reset))
                registra({"evento": "limite_de_uso", "id": ident, "reset": reset})
                motivo_fim = "limite-de-uso"
                detalhe_fim = (
                    f"a conta bateu o teto de uso da Claude durante o {ident} — "
                    "isso não é o item, não é a fila e repetir não levanta o "
                    "teto: quem levanta é o relógio"
                    + (f" (o `claude` disse que reseta {reset})" if reset else "")
                    + ". Parei aqui em vez de gastar a janela batendo na mesma "
                      "porta; o item continua onde estava, sem culpa registrada")
                print(f"          → LIMITE DE USO DA CONTA"
                      + (f" · reseta {reset}" if reset else "")
                      + " — não é falha do item")
                break

        if progresso:
            falhas_seguidas = 0
            feitos.append((ident, estado, pendencia))
            marca = estado
            if pendencia:
                marca += " · rota humana em aberto"
            print(f"          → {marca} ({humano(timedelta(seconds=gasto))})")
        else:
            falhas_seguidas += 1
            falhados.append((ident, estado, codigo, matou))
            razao = ("morto por timeout" if matou else
                     "não consegui nem lançar o `claude`" if codigo == -2 else
                     f"claude saiu {codigo}" if codigo else
                     "o item não saiu do lugar")
            print(f"          → SEM PROGRESSO: {razao} "
                  f"(status ainda `{estado}`) · {falhas_seguidas}/{a.max_falhas}")

            if vez >= a.tentativas_item:
                erro_bloqueio = bloqueia_item(a.fila, repo, ident, vez)
                if erro_bloqueio:
                    motivo_fim = "item-preso"
                    detalhe_fim = (
                        f"{ident} gastou as {vez} tentativas e eu não consegui "
                        f"tirá-lo da frente da fila ({erro_bloqueio}). O próximo "
                        "`queue` devolveria o mesmo item, e o run viraria um "
                        "laço nele — parar aqui é o menor dos dois estragos")
                    registra({"evento": "esgotado", "id": ident, "tentativas": vez,
                              "bloqueado": False, "erro": erro_bloqueio})
                    break
                esgotados.append((ident, vez))
                registra({"evento": "esgotado", "id": ident, "tentativas": vez,
                          "bloqueado": True, "erro": None})
                print(f"          → {vez} tentativa(s) sem progresso: marquei "
                      "`blocked` e a fila segue no próximo item")

            if falhas_seguidas >= a.max_falhas:
                motivo_fim = "disjuntor"
                detalhe_fim = (f"{falhas_seguidas} itens seguidos sem progresso — "
                               "isso é sistêmico, não azar; seguir queimaria a "
                               "janela no mesmo problema")
                break

    registra({"evento": "run_end", "motivo": motivo_fim, "detalhe": detalhe_fim,
              "itens": itens, "com_progresso": len(feitos),
              "sem_progresso": len(falhados), "esgotados": len(esgotados),
              "limite_de_uso": len(limitados)})

    print(f"\n── fim às {datetime.now().strftime('%H:%M')} · {motivo_fim}")
    print(f"   {detalhe_fim}")
    print(f"   {itens} tentativa(s) · {len(feitos)} com progresso · "
          f"{len(falhados)} sem"
          + (f" · {len(limitados)} interrompida(s) pelo teto de uso da conta"
             if limitados else ""))
    abertas = [(i, p) for i, _, p in feitos if p]
    if abertas:
        print(f"\n   Espera por você ({len(abertas)}):")
        for ident, rota in abertas:
            print(f"     - {ident}: {rota}")
    if falhados:
        print(f"\n   Sem progresso ({len(falhados)}):")
        for ident, estado, codigo, matou in falhados:
            print(f"     - {ident}: status `{estado}`"
                  + (" · morto por timeout" if matou else f" · exit {codigo}"))
    if esgotados:
        print(f"\n   Tirados da frente da fila ({len(esgotados)}) — estão "
              "`blocked`, devolva para `pending` quando souber o que travou:")
        for ident, vez in esgotados:
            print(f"     - {ident}: {vez} tentativa(s) sem sair do lugar")
    if limitados:
        print(f"\n   Teto de uso da conta ({len(limitados)}) — não é falha "
              "do item:")
        for ident, reset in limitados:
            print(f"     - {ident}: bateu o limite"
                  + (f", reseta {reset}" if reset else
                     " (o `claude` não disse quando reseta)"))
    print(f"\n   registro: {ledger}")
    print(f"   saída do claude: {log}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\ncepa-until: interrompido. O item em voo pode ter ficado "
              "reservado — o próximo `queue` o devolve como reserva órfã.",
              file=sys.stderr)
        sys.exit(130)
