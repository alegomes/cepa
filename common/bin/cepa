#!/bin/sh
# cepa — the worktree-aware `claude` launcher. (Was `ccw`, renamed 2026-07-30
# with the rest of the product; the old name is gone, not aliased.)
#
# Use this instead of `claude` and stop thinking about worktrees. It starts a
# normal session in the current directory UNLESS another live session already
# occupies this working tree — in which case it auto-isolates this one into its
# own git worktree so the two can't collide. You decide nothing; isolation
# appears only when it would actually save you from a clash.
#
#   cepa                 # auto: isolate only if needed
#   cepa -s billing-api  # force a named worktree (session/billing-api), reuse to resume
#   cepa -s              # no name → pick a recent worktree to resume (fzf, or a
#                        #   numbered menu) — terminal-agnostic, unlike Tab
#                        #   completion which Warp's own engine ignores
#   cepa --resume        # any other args pass straight through to claude
#
#   cepa --mode help     # the purpose of each mode, then exits (opens no session);
#                        #   in the interactive menu, `?` does the same and shows the menu again
#
#   cepa --prompt smartass            # appends a custom system prompt
#   cepa --prompt ~/prompts/x.md      # ...by path, or by name (see below)
#   cepa --prompt-substitui base.md   # replaces the WHOLE system prompt (dangerous)
#
# Custom system prompt: `--prompt <name|path>` reads a text file and hands it
# to claude via --append-system-prompt, i.e. it ADDS to Claude Code's default
# system prompt (the one that teaches the tools, the hooks and CLAUDE.md).
# `--prompt-substitui` uses --system-prompt and ERASES that default, so only use
# it with a prompt that stands on its own. A <name> without a slash is looked up,
# with and without the .md suffix, in $CEPA_PROMPTS_HOME (default
# ~/.claude/cepa-prompts) and in <repo>/.claude/prompts. Persistent default:
# CEPA_PROMPT=<name|path> (and CEPA_PROMPT_MODO=substitui for the destructive mode).
#
# Every launch goes through a preflight: the harness diagnostic runs (at most
# once every 12h per repo) and fixes what is mechanical, so the session is born
# ready instead of you finding out mid-task that the installed plugin is not the
# repo's. It is silent when there is nothing to say, never keeps the session
# from opening, and gets out of the way with CEPA_PREFLIGHT=off
# (interval: CEPA_PREFLIGHT_TTL, in hours).
#
# Chaining: when claude exits, if the session left the next step in
# <main-root>/.claude/sessions/<session_id>.next.json ({"repo", "mode",
# "brief"}), cepa deletes the file and opens the next session in `repo`, with
# `--mode <mode>` and the brief as the initial prompt. Without the file, it exits
# as before. Turn it off with CEPA_ENCADEAR=off. Details in common/hooks/session-chain.py.
#
#   cepa --purpose "<text>"     # records the text as the session purpose
#   cepa --purpose "<p>" --by-when "<goal>" --plan "<step 1>
#   <step 2>"                   # records the whole intent (one step per line)
#
# Chaining passes all three when the previous session's handoff wrote the next
# session's intent (`**Intenção:**`, `**Meta:**` and `**Plano:**` lines), and
# none when it did not: the brief talks about the session that exited and does
# not become a purpose. The recording happens before the first turn, via
# cepa-intent, the only writer of .claude/session-intent. Only `--purpose`
# records a generic stopping point and plan. The values do not go to claude. A
# recording failure warns and the session opens anyway.
#
# Every session is born in bypassPermissions, because Claude Code's `auto` mode
# interrupts a long routine: it consults a classifier on every command and,
# after 3 blocks in a row, starts asking about everything. The harness hooks
# still apply, since they do not depend on the permission mode. Go back to
# Claude Code's default mode with CEPA_PERMISSOES=classificador.
#
# Install: alias claude='/path/to/common/bin/cepa'   (or put this on PATH)
# Override the real binary with CLAUDE_WT_CLAUDE_BIN if you aliased `claude`.
#
# Worktrees are created under ~/cepa-worktrees (override: CEPA_WORKTREE_HOME,
# or the legacy CCW_WORKTREE_HOME, still read), deliberately OUTSIDE the repo
# tree — keeping them out of a cloud-sync folder (Insync/Dropbox/iCloud), whose
# move/replace races otherwise delete live ones.

set -e

CLAUDE_BIN="${CLAUDE_WT_CLAUDE_BIN:-claude}"

# Resolve our own location (following symlinks) → find session-launch.py.
SELF="$0"
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(dirname "$SELF")/$link" ;;
  esac
done
SCRIPT_DIR=$(cd "$(dirname "$SELF")" && pwd)
LAUNCH_PY="$SCRIPT_DIR/../hooks/session-launch.py"
CHAIN_PY="$SCRIPT_DIR/../hooks/session-chain.py"
CEPA_SELF="$SCRIPT_DIR/$(basename "$SELF")"
DOCTOR="$SCRIPT_DIR/cepa-doctor"
MODES_BIN="$SCRIPT_DIR/cepa-modes"
INTENT_BIN="$SCRIPT_DIR/cepa-intent"

# Preflight: gets the harness ready BEFORE the session starts, instead of the
# user finding out mid-task that the installed plugin is not the repo's.
# Runs at most once every CEPA_PREFLIGHT_TTL hours per repo (the stamp lives in
# .claude/doctor-last-run), fixes only what is mechanical and reversible, and is
# silent when there is nothing to say.
#
# A preflight failure NEVER keeps the session from opening: if the doctor is
# gone, broken or stuck, we go straight to claude. Turn it off with CEPA_PREFLIGHT=off.
preflight() {
  [ "${CEPA_PREFLIGHT:-on}" = "off" ] && return 0
  [ -f "$DOCTOR" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 "$DOCTOR" --fix --brief --if-stale "${CEPA_PREFLIGHT_TTL:-12}" >&2 || true
  return 0
}

# --- Working mode ------------------------------------------------------------
# Every session declares which of the modes it operates in; the mode is a STATE
# that lasts the whole session (a routine is a task that ends). Written to
# .claude/session-mode for the hooks to read. Design: docs/modos-de-trabalho.md.
#
# Without a mode cepa does NOT start: a silent default rebuilds exactly the leak
# between activities that the mode exists to close. Escape:
# CEPA_MODO=off (does not write, does not ask, cepa behaves as before).
MODES="exploration discovery design construction refactor reflection documentation"

# The old (pt-BR) names are still accepted in --mode/--modo and become the new one.
normalize_mode() {
  case "$1" in
    exploracao) echo exploration ;;
    descoberta) echo discovery ;;
    construcao) echo construction ;;
    reforma) echo refactor ;;
    reflexao) echo reflection ;;
    documentacao) echo documentation ;;
    *) echo "$1" ;;
  esac
}

is_valid_mode() {
  for _m in $MODES; do [ "$_m" = "$1" ] && return 0; done
  return 1
}

# Asks for the mode on /dev/tty. Without a tty there is no way to ask, so it
# fails with the instruction instead of assuming a mode for you.
# The purpose of each mode, one line per mode, read from the single source
# (common/hooks/_modes.py) by cepa-modes. The menu used to list only the seven
# names, and whoever does not remember what "reforma" demands chose by name, so
# the mode, which is a boundary, became a label. Without python3 or without the
# script, the help degrades to the names and the document path; it never goes
# away silently.
show_purposes() {
  if command -v python3 >/dev/null 2>&1 && [ -f "$MODES_BIN" ]; then
    python3 "$MODES_BIN" --purposes --no-color >&2 2>/dev/null && return 0
  fi
  printf 'modos: %s\n' "$MODES" >&2
  printf 'o propósito de cada um está em docs/modos-de-trabalho.md\n' >&2
  return 0
}

ask_mode() {
  if [ ! -t 0 ] || [ ! -r /dev/tty ]; then
    printf '✗ cepa: nenhuma sessão sobe sem modo declarado.\n' >&2
    printf '  Use: cepa --mode <%s>\n' "$(printf '%s' "$MODES" | tr ' ' '|')" >&2
    printf '  Veja o propósito de cada um: cepa --mode help\n' >&2
    printf '  Ou desligue a exigência com CEPA_MODO=off\n' >&2
    return 1
  fi
  while :; do
    printf 'Em qual modo esta sessão opera?\n' >&2
    _i=0
    for _m in $MODES; do _i=$((_i+1)); printf '  %d) %s\n' "$_i" "$_m" >&2; done
    printf '  ?) ajuda — o propósito de cada modo\n' >&2
    printf 'modo? [número, nome ou ?] > ' >&2
    _ans=""
    read -r _ans < /dev/tty || return 1
    # An empty Enter still means giving up; `?` shows the purposes and the menu
    # comes back, because whoever asked for help has not chosen yet.
    [ -n "$_ans" ] || return 1
    case "$_ans" in
      "?"|h|help|ajuda) show_purposes; printf '\n' >&2; continue ;;
      *[!0-9]*) printf '%s\n' "$_ans"; return 0 ;;
      *) printf '%s\n' "$MODES" | tr ' ' '\n' | sed -n "${_ans}p"; return 0 ;;
    esac
  done
}

# A refactor without a budget never ends, there is always one more tweak. The
# budget is the closed list of what will be refactored; it IS the mode's exit condition.
ask_budget() {
  if [ ! -t 0 ] || [ ! -r /dev/tty ]; then
    printf '✗ cepa: modo refactor exige --budget "<escopo fechado>"\n' >&2
    return 1
  fi
  printf 'Orçamento da reforma (o que exatamente será reformado): ' >&2
  _o=""
  read -r _o < /dev/tty || return 1
  [ -n "$_o" ] || return 1
  printf '%s\n' "$_o"
}

# --- Custom system prompt ---------------------------------------------------
# One library directory, with and without the .md suffix. Separate from
# resolve_prompt only so a path with a space in the name does not break the lookup.
_try() {
  [ -d "$1" ] || return 1
  [ -f "$1/$2" ] && { printf '%s\n' "$1/$2"; return 0; }
  [ -f "$1/$2.md" ] && { printf '%s\n' "$1/$2.md"; return 0; }
  return 1
}

# Resolves <name|path> to a readable file and prints the path. An argument with
# a slash (or ~) is a path and only that is tried: getting a path wrong is the
# typist's error, not an invitation to look for a namesake in the library. A
# bare name is looked up, with and without the .md suffix, in the user's library
# ($CEPA_PROMPTS_HOME, default ~/.claude/cepa-prompts) and in the repo's
# (<repo>/.claude/prompts), in that order.
resolve_prompt() {
  _ref="$1"
  case "$_ref" in
    "~/"*) _ref="$HOME/${_ref#\~/}" ;;
  esac
  case "$_ref" in
    */*)
      [ -f "$_ref" ] && { printf '%s\n' "$_ref"; return 0; }
      [ -f "$_ref.md" ] && { printf '%s\n' "$_ref.md"; return 0; }
      return 1
      ;;
  esac
  _repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
  _try "${CEPA_PROMPTS_HOME:-$HOME/.claude/cepa-prompts}" "$_ref" && return 0
  [ -n "$_repo" ] && _try "$_repo/.claude/prompts" "$_ref" && return 0
  return 1
}

# A prompt error is a typo: refuse to start and say where it looked, instead of
# silently opening the session without the prompt you asked for.
prompt_error() {
  printf '✗ cepa: system prompt não encontrado: %s\n' "$1" >&2
  printf '  procurei em: %s\n' \
    "${CEPA_PROMPTS_HOME:-$HOME/.claude/cepa-prompts}, <repo>/.claude/prompts (e como caminho)" >&2
  exit 2
}

# Every path that launches claude goes through here, so the mode is written in
# the directory where the session will actually run (root OR isolated worktree).
launch_here() {
  write_mode "$PWD"
  write_intent "$PWD"
  run_claude "$@"
}

# Chaining: claude is no longer `exec`'d. When it exits, session-chain.py looks
# for the next step the session left in
# <main-root>/.claude/sessions/<session_id>.next.json and, if it finds one,
# deletes the file and reopens this launcher in its repo and mode, with the
# brief as the prompt. CEPA_LAUNCH_ID is what ties this launch to the
# session_id: the session-registry hook records it at SessionStart. Without the
# file, it exits with claude's code, as before. Turn it off with CEPA_ENCADEAR=off.
run_claude() {
  CEPA_LAUNCH_ID=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
  export CEPA_LAUNCH_ID
  set +e
  "$CLAUDE_BIN" "$@"
  _rc=$?
  set -e
  if [ "${CEPA_ENCADEAR:-on}" != "off" ] && [ -n "$CEPA_LAUNCH_ID" ] \
      && [ -f "$CHAIN_PY" ] && command -v python3 >/dev/null 2>&1; then
    # The session may have removed its own worktree (wrap-up merges and deletes).
    # A process born in a deleted directory fails before running (the pyenv shim
    # is bash: "shell-init: error retrieving current directory") and
    # session-chain.py finds the main root from the cwd. Go back to the root.
    cd "${ROOT:-$PWD}" 2>/dev/null || cd "$HOME" 2>/dev/null || cd /
    exec python3 "$CHAIN_PY" "$CEPA_LAUNCH_ID" "$CEPA_SELF" "$_rc"
  fi
  exit "$_rc"
}

write_mode() {
  [ "${CEPA_MODO:-on}" = "off" ] && return 0
  [ -n "$MODE" ] || return 0
  mkdir -p "$1/.claude" 2>/dev/null || return 0
  {
    printf 'mode: %s\n' "$MODE"
    printf 'routine: null\n'
    if [ -n "$BUDGET" ]; then
      printf 'budget: "%s"\n' "$(printf '%s' "$BUDGET" | sed 's/"/\\"/g')"
    else
      printf 'budget: null\n'
    fi
    printf 'opened_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$1/.claude/session-mode" 2>/dev/null || return 0
  printf '◆ modo: %s\n' "$MODE" >&2
  return 0
}

# Records the session purpose (--purpose) in the directory where it actually
# runs, via cepa-intent, the only writer of .claude/session-intent. Independent
# of CEPA_MODO: intent is not mode. --reason makes it overwrite an intent left by
# a previous session in this tree (it goes to the history; with no previous
# intent --reason is ignored). A failure NEVER keeps the session from opening.
write_intent() {
  [ -n "$PURPOSE" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  [ -f "$INTENT_BIN" ] || return 0
  _idir=$1
  # One plan step per line becomes one --plan argument; no glob.
  set -f
  _ifs=$IFS; IFS='
'
  set -- ${PLAN:-cumprir o próximo passo deixado pela sessão anterior}
  IFS=$_ifs; set +f
  _ierr=$(mktemp 2>/dev/null) || _ierr=/dev/null
  if _ires=$(cd "$_idir" && python3 "$INTENT_BIN" write \
      --purpose "$PURPOSE" \
      --by-when "${BY_WHEN:-o próximo passo deixado pela sessão anterior cumprido}" \
      --reason "sessão aberta pelo cepa com a intenção na linha de comando" \
      --plan "$@" \
      2>"$_ierr"); then
    printf '◆ intenção: %s\n' "$_ires" >&2
  else
    printf '⚠ cepa: não gravei a intenção da sessão (%s)\n' \
      "$(tr '\n' ' ' < "$_ierr" 2>/dev/null)" >&2
  fi
  [ "$_ierr" = /dev/null ] || rm -f "$_ierr"
  return 0
}

# Interactive picker for `cepa -s` with no name: choose an existing session/*
# worktree to resume, newest commit first, each captioned with its label (the
# branch's git description). Uses fzf when present, else a numbered /dev/tty
# menu. Prints the chosen slice on stdout; returns non-zero when there's nothing
# to pick or the user cancels. Every fallible command is guarded so `set -e`
# (inherited by this command substitution's subshell) can't truncate the list.
pick_slice() {
  _root="$1"
  _refs=$(git -C "$_root" for-each-ref --sort=-committerdate \
            --format='%(refname:short)' refs/heads/session/ 2>/dev/null || true)
  if [ -z "$_refs" ]; then
    printf '✗ No session worktrees to resume. Create one with: cepa -s <name>\n' >&2
    return 1
  fi

  _tab=$(printf '\t')
  _rows=$(printf '%s\n' "$_refs" | while IFS= read -r _ref; do
    [ -n "$_ref" ] || continue
    _slice=${_ref#session/}
    _desc=$(git -C "$_root" config "branch.$_ref.description" 2>/dev/null | head -n1 || true)
    printf '%s%s%s\n' "$_slice" "$_tab" "$_desc"
  done)

  if command -v fzf >/dev/null 2>&1; then
    _pick=$(printf '%s\n' "$_rows" | fzf \
      --delimiter="$_tab" --with-nth=1,2 --nth=1 \
      --height=40% --reverse --prompt='resume worktree > ' \
      --header='session/* worktrees — newest first (Esc to cancel)' || true)
  else
    printf '%s\n' "$_rows" | awk -F"$_tab" \
      '{printf "  %d) %s%s\n", NR, $1, ($2==""?"":"  - "$2)}' >&2
    printf 'resume which? [number, or Enter to cancel] > ' >&2
    _ans=""
    read -r _ans < /dev/tty || true
    case "$_ans" in
      ""|*[!0-9]*) return 1 ;;
    esac
    _pick=$(printf '%s\n' "$_rows" | sed -n "${_ans}p")
  fi

  [ -n "$_pick" ] || return 1
  printf '%s\n' "${_pick%%"$_tab"*}"
}

# Parse our own flags; everything else goes to claude.
SLICE=""
PICK=0
MODE="${CEPA_MODO_DEFAULT:-}"
BUDGET=""
PURPOSE=""
BY_WHEN=""
PLAN=""
PROMPT_REF="${CEPA_PROMPT:-}"
PROMPT_MODE="${CEPA_PROMPT_MODO:-append}"
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--mode|--modo)
      [ $# -ge 2 ] || { printf '✗ cepa: %s exige um valor\n' "$1" >&2; exit 2; }
      MODE="$2"; shift 2 ;;
    --mode=*)  MODE="${1#--mode=}"; shift ;;
    --modo=*)  MODE="${1#--modo=}"; shift ;;
    --budget|--orcamento)
      [ $# -ge 2 ] || { printf '✗ cepa: %s exige um valor\n' "$1" >&2; exit 2; }
      BUDGET="$2"; shift 2 ;;
    --budget=*) BUDGET="${1#--budget=}"; shift ;;
    --orcamento=*) BUDGET="${1#--orcamento=}"; shift ;;
    --purpose|--proposito)
      [ $# -ge 2 ] || { printf '✗ cepa: %s exige um valor\n' "$1" >&2; exit 2; }
      PURPOSE="$2"; shift 2 ;;
    --purpose=*) PURPOSE="${1#--purpose=}"; shift ;;
    --proposito=*) PURPOSE="${1#--proposito=}"; shift ;;
    --by-when|--para-quando)
      [ $# -ge 2 ] || { printf '✗ cepa: %s exige um valor\n' "$1" >&2; exit 2; }
      BY_WHEN="$2"; shift 2 ;;
    --by-when=*) BY_WHEN="${1#--by-when=}"; shift ;;
    --para-quando=*) BY_WHEN="${1#--para-quando=}"; shift ;;
    --plan|--plano)
      [ $# -ge 2 ] || { printf '✗ cepa: %s exige um valor\n' "$1" >&2; exit 2; }
      PLAN="$2"; shift 2 ;;
    --plan=*) PLAN="${1#--plan=}"; shift ;;
    --plano=*) PLAN="${1#--plano=}"; shift ;;
    --prompt)
      [ $# -ge 2 ] || { printf '✗ cepa: --prompt exige um valor\n' >&2; exit 2; }
      PROMPT_REF="$2"; PROMPT_MODE="append"; shift 2 ;;
    --prompt=*)    PROMPT_REF="${1#--prompt=}"; PROMPT_MODE="append"; shift ;;
    --prompt-substitui)
      [ $# -ge 2 ] || { printf '✗ cepa: --prompt-substitui exige um valor\n' >&2; exit 2; }
      PROMPT_REF="$2"; PROMPT_MODE="substitui"; shift 2 ;;
    --prompt-substitui=*)
      PROMPT_REF="${1#--prompt-substitui=}"; PROMPT_MODE="substitui"; shift ;;
    -s|--slice)
      # A real slice name follows only if the next arg exists, is non-empty,
      # and isn't itself a flag. Otherwise `-s` means "let me pick one".
      if [ $# -ge 2 ] && [ -n "$2" ] && [ "${2#-}" = "$2" ]; then
        SLICE="$2"; shift 2
      else
        PICK=1; shift
      fi
      ;;
    *) break ;;
  esac
done

MODE=$(normalize_mode "$MODE")

# `cepa --mode help` is a query, not a session launch: it prints the purpose of
# each mode and exits, without touching worktree, preflight or claude.
case "$MODE" in
  ajuda|help|"?") show_purposes; exit 0 ;;
esac

# Custom system prompt: becomes a claude flag BEFORE any launch path, so it also
# applies when cepa behaves as plain claude (outside a repo) or when it isolates
# the session in a worktree.
if [ -n "$PROMPT_REF" ]; then
  case "$PROMPT_MODE" in
    append)    PROMPT_FLAG="--append-system-prompt" ;;
    substitui) PROMPT_FLAG="--system-prompt" ;;
    *) printf '✗ cepa: CEPA_PROMPT_MODO inválido: %s (append|substitui)\n' \
         "$PROMPT_MODE" >&2; exit 2 ;;
  esac
  PROMPT_FILE=$(resolve_prompt "$PROMPT_REF") || prompt_error "$PROMPT_REF"
  [ -s "$PROMPT_FILE" ] || {
    printf '✗ cepa: system prompt vazio: %s\n' "$PROMPT_FILE" >&2
    exit 2
  }
  set -- "$PROMPT_FLAG" "$(cat "$PROMPT_FILE")" "$@"
  printf '◆ system prompt (%s): %s\n' "$PROMPT_MODE" "$PROMPT_FILE" >&2
fi

# --- Permissions ------------------------------------------------------------
# Claude Code's `auto` mode sends each command to a classifier (a model call that
# judges whether it can be approved alone) and, after 3 blocks in a row, stops
# deciding and starts asking about EVERYTHING; the maxConsecutive:3 constant is
# written in the binary and no environment variable loosens it. In the middle of
# a long routine this becomes a wall of prompts.
#
# That is why every cepa session is born in bypassPermissions. This does NOT turn
# off the harness enforcement: the hooks (path-lock, bash-path-lock,
# gate-advance, reactor guard, enforcement-guard) run in any permission mode;
# back when sessions opened in bypass, the telemetry ledger recorded 486 hook
# blocks in August/2026 alone. What gets out of the way is Claude Code's
# classifier, not your guard.
#
# Escape: CEPA_PERMISSOES=classificador gives back Claude Code's default mode.
# A permission flag typed by you on the command line always wins.
if [ "${CEPA_PERMISSOES:-bypass}" = "bypass" ]; then
  _perm_set=0
  for _a in "$@"; do
    case "$_a" in
      --permission-mode|--permission-mode=*|--dangerously-skip-permissions)
        _perm_set=1 ;;
    esac
  done
  if [ "$_perm_set" = "0" ]; then
    set -- --dangerously-skip-permissions "$@"
    printf '◆ permissões: bypass (os hooks do harness continuam valendo)\n' >&2
  fi
fi

# Not a git repo, or can't find the helper → just be claude.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exec "$CLAUDE_BIN" "$@"

# Mode: required before anything happens. An invalid mode is an error (it does
# not become a question): the error is the typist's, and guessing would be the
# silent default this design refuses.
if [ "${CEPA_MODO:-on}" != "off" ]; then
  if [ -n "$MODE" ] && ! is_valid_mode "$MODE"; then
    printf '✗ cepa: modo desconhecido: %s\n  válidos: %s\n' "$MODE" "$MODES" >&2
    exit 2
  fi
  if [ -z "$MODE" ]; then
    MODE=$(ask_mode) || exit 2
    MODE=$(normalize_mode "$MODE")
    is_valid_mode "$MODE" || {
      printf '✗ cepa: modo desconhecido: %s\n  válidos: %s\n' "$MODE" "$MODES" >&2
      exit 2
    }
  fi
  if [ "$MODE" = "refactor" ] && [ -z "$BUDGET" ]; then
    BUDGET=$(ask_budget) || exit 2
  fi
fi

preflight

[ -f "$LAUNCH_PY" ] || launch_here "$@"

# Already inside a session worktree → nothing to isolate.
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
case "$BRANCH" in
  session/*) launch_here "$@" ;;
esac

# `cepa -s` with no name → pick a recent worktree to resume. Cancel or an empty
# list aborts cleanly (launch nothing) rather than starting a surprise session.
if [ "$PICK" = "1" ]; then
  SLICE=$(pick_slice "$ROOT") || exit 0
  [ -n "$SLICE" ] || exit 0
  printf '↻ resuming session/%s\n' "$SLICE" >&2
fi

# Decide (atomic, under lock). On any failure, fall back to launching in place.
RESULT=$(CLAUDE_WT_ROOT="$ROOT" CLAUDE_WT_SLICE="$SLICE" python3 "$LAUNCH_PY") \
  || launch_here "$@"

DIR=$(printf '%s' "$RESULT" | cut -f1)
CLAIM=$(printf '%s' "$RESULT" | cut -f2)
[ -n "$DIR" ] || launch_here "$@"

cd "$DIR" || launch_here "$@"
if [ "$DIR" != "$ROOT" ]; then
  printf '⊕ Another session is live in %s\n  → isolated this one to %s\n' "$ROOT" "$DIR" >&2
fi

write_mode "$PWD"
write_intent "$PWD"
CLAUDE_WT_CLAIM="$CLAIM"
export CLAUDE_WT_CLAIM
run_claude "$@"
