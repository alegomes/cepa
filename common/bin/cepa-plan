    st = sub.add_parser(
        "start", help="reserves a queue item and signs the reservation with the owning session",
        description=(
            "`pending` → `in_progress`, signed with `claimed_by` (session_id, pid,\n"
            "hostname, cwd, time). The reservation keeps two sessions from building\n"
            "the same item. With a live owner the refusal NAMES who is on the item;\n"
            "with a dead owner the reservation is orphaned and claiming it is right,\n"
            "otherwise the queue jams forever because of a run that ended. Liveness\n"
            "is _wtlib's (pid alive on the same host, 24h horizon), the same rule the\n"
            "worktree system uses."),
        examples=[("cepa plan start wego WEGO-123", "reserve the item"),
                  ("cepa plan start wego WEGO-123 --commit", "reserve and commit the queue")],
        exit_codes=[(0, "reserved (or an orphaned reservation reclaimed)"),
                    (2, f"invalid usage, {not_git}, {no_queue}, unknown item id"),
                    (3, waves),
                    (5, "refused: reserved by a live session, not `pending`, or an "
