    st.add_argument("id", help="item id in the queue")
    st.add_argument("--commit", action="store_true", help=commit_help)
    st.add_argument("--repo", default=".", metavar="DIR", help=repo_help)

    fi = sub.add_parser(
        "finish", help="records the outcome of a queue item",
        description=(
            "--evidence is mandatory: `done` without what happened is just a word.\n"
            "--human-pending OPENS a route only the human closes; closing it (empty)\n"
            "is refused, because only whoever ran the route knows whether it passed.\n"
            "`--status done` is refused when:\n"
            "  - the .claude/last-build.json of the --repo session is EMPTY (a test\n"
            "    filter that matched zero tests): green without a test closes nothing\n"
            "  - the session topology has validation-lead (build-hex, build-team)\n"
            "    and there is no docs/validation/<id>.yaml with verdict\n"
            "    READY-TO-SHIP or READY-WITH-CAVEATS\n"
            "  - the --repo tree has changes not committed (only the queue file and\n"
            "    its .yaml.bak are tolerated): commit first; disabling a test is no fix\n"
            "  - the tree is not a git repo (the HEAD sha cannot be recorded)\n"
            "`--status done` records `head_commit`: the HEAD of the --repo tree.\n"
            "Any status is refused when the item is already done/blocked/dropped\n"
            "(a second finish would erase the first one's evidence), or when the item\n"
            "is reserved (`claimed_by`) by another session. Each refusal is kept on\n"
            "the item in `finish_recusado` (last 5)."),
        examples=[('cepa plan finish wego WEGO-123 --status done --evidence "commit abc, build green"',
                   "close the item"),
                  ('cepa plan finish wego WEGO-124 --status blocked --evidence "staging 502" '
                   '--blocker "the test server is down"',
                   "stuck, with the reason in plain words"),
                  ('cepa plan finish wego WEGO-125 --status pending --evidence "split in two" --commit',
                   "back to the queue, committed")],
        exit_codes=[(0, "recorded"),
                    (2, f"invalid usage, {not_git}, {no_queue}, unknown item id, "
                        "empty --evidence or --human-pending, missing human section, "
                        "`done` refused (empty build, missing validation, dirty tree, "
                        "no git), item already terminal, item held by another "
                        "session"),
                    (3, waves)])
    fi.add_argument("name", metavar="name", help="queue name")
    fi.add_argument("id", help="item id in the queue")
    fi.add_argument("--status", required=True,
                    choices=("done", "blocked", "pending"),
                    help="done = closed; blocked = stuck on an outside condition; "
                         "pending = back to the queue without closing")
    fi.add_argument("--supervisor", action="store_true",
                    help="the run supervisor re-opening or re-marking an item it "
                         "does not own, after the agent's own finish (skips the "
                         "terminal-status and owner refusals only)")
    fi.add_argument("--evidence", required=True, metavar="TEXT",
                    help="what happened: commits, verdicts, what got stuck")
    fi.add_argument("--human-pending", dest="human_pending", metavar="ROUTE",
                    help="OPENS a route only a human closes (validate by hand, "
                         "approve a PR). Never closes one: only the human does")
    fi.add_argument("--question", "--pergunta", dest="question", metavar="TEXT",
                    help="the CLOSED question that unblocks the item, up to 25 "
                         "words, no branch, class or file name, "
                         "with your recommendation (\"Close the card as 'measure "
                         "after go-live' and return it to the queue? I recommend yes: "
                         "...\"). `cepa-until decide` shows it in a fixed "
                         "menu: yes = the item returns to the queue with this "
                         "answer, no = it stays as is. Use with `blocked` "
                         "and with `--human-pending`")
    # The HUMAN section (see _ownertext). `--evidence` is the agents' section.
    owner_help = {
        "pedido": "human section: what the item asked for, in plain words",
        "pronto": "human section: what already works, in plain words",
        "impede": "human section: what keeps the item from moving, in one plain "
                  "sentence. Required with `blocked`",
        "se_sim": "human section: what happens to the work if the owner "
                  "answers yes to the question",
        "se_nao": "human section: what happens to the work if the owner "
                  "answers no",
    }
    for key, flag, _ in _ownertext.FIELDS:
        fi.add_argument(flag, _ownertext.OLD_FLAGS[flag], dest=f"owner_{key}",
                        metavar="TEXT",
                        help=owner_help[key] + ". Up to 30 words, no card, "
                             "commit, file or verdict")
    fi.add_argument("--commit", action="store_true", help=commit_help)
    fi.add_argument("--repo", default=".", metavar="DIR", help=repo_help)

    rs = sub.add_parser(
        "answer", aliases=["responde"],
        help="records the owner's answer to a deferred item (terminal only)",
        description=(
            "`blocked` goes back to `pending` with the answer, and the\n"
            "`human_pending` route closes. The answer is kept verbatim in the item's\n"
            "evidence, where the next run reads it. Refuses a text that does not\n"
            "look like an answer (a request for clarification, a question) unless\n"
            "--force. Runs only on a terminal: an agent cannot answer for the owner.\n"
            "By default commits only the queue in the same step."),
        examples=[('cepa plan answer wego WEGO-124 --answer "yes, close it"',
                   "unblock with the answer"),
                  ('cepa plan answer wego WEGO-124 --answer "wait for go-live" --keep',
                   "record it, leave the item stuck"),
                  ('cepa plan answer wego WEGO-124 --answer "no longer needed" --drop',
                   "drop the item")],
        exit_codes=[(0, "recorded"),
                    (2, f"invalid usage, not a terminal, empty answer, --keep with "
                        f"--drop, {not_git}, {no_queue}, unknown item id, item not "
                        "deferred"),
                    (3, waves),
                    (6, "the text does not look like an answer (repeat with --force)")])
    rs.add_argument("name", metavar="name", help="queue name")
    rs.add_argument("id", help="id of the deferred item")
    rs.add_argument("--answer", "--resposta", dest="answer", metavar="TEXT", required=True,
                    help="the owner's answer, verbatim; the next run reads it "
                         "in the item's evidence")
    rs.add_argument("--keep", "--mantem", dest="keep", action="store_true",
                    help="records the answer and leaves the item as is: "
                         "`blocked` stays stuck and the route stays open")
    rs.add_argument("--drop", "--descarta", dest="drop", action="store_true",
                    help="drops the item (`dropped`) and closes the route; on a "
                         "`done` item, only closes the leftover task")
    rs.add_argument("--force", "--forca", dest="force", action="store_true",
                    help="records even a text that does not seem to answer the "
                         "route (a request for clarification, a question)")
    rs.add_argument("--author", "--autor", dest="author", metavar="NAME", default=None,
                    help="who signs the waiver that a \"yes\" answer accepts "
                         "(default: `git config user.name`, then $USER)")
    rs.add_argument("--no-commit", action="store_true", dest="no_commit",
                    help="writes the queue without committing (by default `answer` "
                         "commits only the queue in the same step)")
    rs.add_argument("--repo", default=".", metavar="DIR", help=repo_help)

    rc = sub.add_parser(
        "reconcile", help="compares the queue with the board and, with --apply, records it",
        description=(
            "Who closed outside the plan, who vanished, and which cards exist on the\n"
            "board with no position in the queue. Does not talk to Jira: the board\n"
            "is read by atlassian-expert and arrives through --board. Without\n"
            "--apply it only reports. It NEVER closes a `human_pending` (only the\n"
            "human does), NEVER appends a card the queue does not have (placing it\n"
            "is /common:queue --from-jira) and NEVER demotes a `done` item: a card\n"
            "that went backwards on the board becomes a warning."),
        examples=[("cepa plan reconcile wego --board /tmp/board.json", "report only"),
                  ("cepa plan reconcile wego --board /tmp/board.json --apply",
                   "record the reconciled statuses"),
                  ("cat /tmp/board.json | cepa plan reconcile wego --board - --json",
                   "board from stdin, JSON out")],
        exit_codes=[(0, "reconciled (or reported)"),
                    (2, f"invalid usage, {not_git}, {no_queue}, unreadable board or "
                        "board-flow.yaml, no status map"),
                    (3, waves)])
    rc.add_argument("name", metavar="name", help="queue name")
    rc.add_argument("--board", required=True, metavar="FILE",
                    help="JSON/YAML produced by atlassian-expert: a list of "
                         "{key, status}, or {cards: [...], missing: [...]}. "
                         "'-' reads from standard input")
    rc.add_argument("--config", metavar="FILE",
                    help="board-flow.yaml to use (default: the repo's)")
    rc.add_argument("--apply", action="store_true", dest="apply_changes",
                    help="writes the reconciled statuses to the plan. Never closes "
                         "`human_pending` and never appends a new card")
    rc.add_argument("--repo", default=".", metavar="DIR", help=repo_help)
    rc.add_argument("--json", action="store_true", dest="as_json", help=json_help)

    ld = sub.add_parser(
        "landed", aliases=["aterrissados"],
        help="lists the cards in review that already landed on the integration branch",
        description=(
            "A card in review lands when its proof is PROVEN, its acceptance is\n"
            "complete and its code is already on the integration branch. The others\n"
            "come out with the reason they are held. Reads the board from --board,\n"
            "never from Jira."),
        examples=[("cepa plan landed --board /tmp/board.json", "what can leave review"),
                  ("cepa plan landed --board /tmp/board.json --into origin/develop --json",
                   "another integration ref, for code")],
        exit_codes=[(0, "listed"),
                    (2, f"invalid usage, {not_git}, unreadable board or "
                        "board-flow.yaml, no integration ref found")])
    ld.add_argument("--board", required=True, metavar="FILE",
                    help="JSON/YAML from atlassian-expert: a list of {key, status}")
    ld.add_argument("--config", metavar="FILE",
                    help="board-flow.yaml to use (default: the repo's)")
    ld.add_argument("--into", metavar="REF",
                    help="integration ref (default: origin/HEAD, origin/main or main)")
    ld.add_argument("--repo", default=".", metavar="DIR", help=repo_help)
    ld.add_argument("--json", action="store_true", dest="as_json", help=json_help)

    ad = sub.add_parser(
        "add", help="adds ONE item to an existing queue, without rewriting the others",
        description=(
            "Unlike `write`, which replaces the whole list. It is what\n"
            "/board-flow:capture, cepa feedback triage and the owner's own hand call\n"
            "so a new card does not stay only in Jira or only in BACKLOG.md.\n"
            "Without --before the item enters at the END and its `why` carries\n"
            "\"ainda não priorizado\" (every entry door creates the item, even\n"
            "without knowing the position). With --before, --why is MANDATORY: a\n"
            "position chosen without its reason is what the queue exists to prevent.\n"
            "By default commits only the queue in the same step."),
        examples=[('cepa plan add wego WEGO-130 --title "Export the signed PDF"',
                   "at the end, not prioritized yet"),
                  ('cepa plan add wego WEGO-130 --title "Export the signed PDF" '
                   '--before WEGO-125 --why "the client demo needs it first"',
                   "at a chosen position"),
                  ('cepa plan add wego WEGO-131 --title "Audit log" --blocked-by WEGO-130 --no-commit',
                   "blocked by another item, no commit")],
        exit_codes=[(0, "added"),
                    (2, f"invalid usage, {not_git}, {no_queue}, --before or "
                        "--blocked-by naming an id not in the queue, --before without "
                        "--why, the result does not validate"),
                    (3, waves),
                    (4, "the id already exists (the message states its status)")])
    ad.add_argument("name", metavar="name", help="queue name")
    ad.add_argument("id", help="id of the new item (Jira key or free id)")
    ad.add_argument("--title", required=True, metavar="TITLE", help="item title")
    ad.add_argument("--why", metavar="TEXT",
                    help="required with --before; without --before, becomes the "
                         "item's `why` with 'not prioritized yet' appended")
    ad.add_argument("--before", "--antes-de", dest="before", metavar="ID",
                    help="inserts right before this id (requires --why)")
    ad.add_argument("--blocked-by", dest="blocked_by", metavar="ID,ID",
                    help="ids in this SAME queue that block the new item")
    ad.add_argument("--no-commit", action="store_true", dest="no_commit",
                    help="writes the queue without committing (by default `add` "
                         "commits only the queue in the same step)")
    ad.add_argument("--repo", default=".", metavar="DIR", help=repo_help)

    od = sub.add_parser(
        "order", aliases=["ordena"],
        help="sorts a list of Jira keys by queue order",
        description=(
            "Gives /board-flow:drain the queue order for a list of Jira keys. Keys\n"
            "that are plan items come first, in queue order; the others come after,\n"
            "in the order they arrived, marked `fora_do_plano`. Does not decide what\n"
            "to do with a `done`/`dropped` item: it only orders and states each\n"
            "key's status."),
        examples=[("cepa plan order wego --keys WEGO-125,WEGO-123,WEGO-140",
                   "queue order for these keys"),
                  ("cepa plan order wego --keys WEGO-125,WEGO-123 --json", "for code")],
        exit_codes=[(0, "ordered"),
                    (2, f"invalid usage, {not_git}, {no_queue} (the caller falls "
                        "back to the Jira order)"),
                    (3, waves)])
    od.add_argument("name", metavar="name", help="queue name")
    od.add_argument("--keys", required=True, metavar="K1,K2,...",
                    help="keys in Jira order; those that are plan items "
                         "come back in queue order, the rest after them, "
                         "marked `fora_do_plano`")
    od.add_argument("--repo", default=".", metavar="DIR", help=repo_help)
    od.add_argument("--json", action="store_true", dest="as_json", help=json_help)

    dv = sub.add_parser(
        "divergence", aliases=["divergencia"],
        help="lists, without fixing, where the queue, the board and BACKLOG.md disagree",
        description=(
            "What /common:doctor lists. Read only on purpose: closing an orphan card\n"
            "or inventing a `**Plano:**` line on its own would rewrite the queue or\n"
            "the document without the owner seeing. Three lists:\n"
            "  - cards_sem_item: card open in Jira with no item in the queue\n"
            "  - itens_com_card_done: open item whose card the board says is done\n"
            "  - secoes_sem_plano / plano_inexistente: BACKLOG.md section without\n"
            "    the `**Plano:**` line, or citing an id not in this queue\n"
            "Without --board the first two are left out (warned, not silenced);\n"
            "without --backlog, the third."),
        examples=[("cepa plan divergence wego --board /tmp/board.json --backlog BACKLOG.md",
                   "all three lists"),
                  ("cepa plan divergence wego --backlog BACKLOG.md --json",
                   "only the BACKLOG.md check, for code")],
        exit_codes=[(0, "report printed, even with divergence"),
                    (2, f"invalid usage, {not_git}, an input file is unreadable"),
                    (3, waves)])
    dv.add_argument("name", metavar="name", help="queue name")
    dv.add_argument("--board", metavar="FILE",
                    help="same format as `reconcile`. Without it, "
                         "cards_sem_item and itens_com_card_done come out empty")
    dv.add_argument("--backlog", metavar="FILE",
                    help="the BACKLOG.md to scan. Without it, secoes_sem_plano and "
                         "plano_inexistente come out empty")
    dv.add_argument("--repo", default=".", metavar="DIR", help=repo_help)
    dv.add_argument("--json", action="store_true", dest="as_json", help=json_help)

    w = sub.add_parser(
        "write", help="writes the queue from a list of items, a spec, an Epic cycle or a triage",
        description=(
            "Refuses an empty `why`, a duplicate id, a dangling `blocked_by` and a\n"
            "cycle. On a rewrite the new list rules order, `title` and `why`; the\n"
            "disk keeps what came from execution: its `status` always wins, and its\n"
            "`human_pending` wins while open. The previous file is copied to\n"
            "<file>.bak first (hand-written comments are not preserved).\n"
            "--on-missing decides the on-disk items the new list does not mention;\n"
            "`keep` puts them at the end. With --from-triage there is no refusal:\n"
            "absent `done`/`dropped` are kept at the start, the triage enters in its\n"
            "order and absent open items go after (`drop` marks only those)."),
        examples=[("cepa plan write wego --from-spec docs/spec/assinatura.md",
                   "one item per success criterion"),
                  ("cepa plan write wego --from-epic docs/epics/wego.md --cycle 2",
                   "the queue of one Epic cycle"),
                  ("cepa plan write wego --items /tmp/items.json --on-missing keep --dry-run",
                   "preview a hand-made list"),
                  ("cepa plan write wego --from-triage /tmp/triage.json --source \"triage 2026-11-05\"",
                   "the order of a triage")],
        exit_codes=[(0, "written (or printed, with --dry-run)"),
                    (2, f"invalid usage (no item source, --from-epic without --cycle), "
                        f"{not_git}, invalid items"),
                    (3, "name collision: a waves plan, or an unreadable file on disk"),
                    (4, "the file on disk has items the new list does not mention "
                        "(see --on-missing)")])
    w.add_argument("name", metavar="name", help="queue name")
    w.add_argument("--items", metavar="FILE",
                   help="JSON/YAML file with the item list, or '-' for stdin")
    w.add_argument("--from-spec", metavar="FILE",
                   help="reads the items from a /common:spec specification, one "
                        "per success criterion, in text order")
    w.add_argument("--from-triage", metavar="FILE",
                   help="reads the items from the handoff of a "
                        "/board-flow:triage run, in the order it classified")
    w.add_argument("--from-epic", metavar="FILE",
                   help="reads the items of one cycle of a /common:epic Epic, "
                        "one per sentence of \"What it crosses\"; needs --cycle")
    w.add_argument("--cycle", "--ciclo", dest="cycle", type=int, metavar="N",
                   help="the value-ladder cycle that becomes the queue (with --from-epic)")
    w.add_argument("--source", metavar="TEXT",
                   help="where the demands came from, recorded in the header")
    w.add_argument("--when", "--quando", dest="when", metavar="DATE",
                   help="date to record in the header (YYYY-MM-DD)")
    w.add_argument("--repo", default=".", metavar="DIR", help=repo_help)
    w.add_argument("--on-missing", choices=("refuse", "keep", "drop"),
                   default="refuse",
                   help="what to do with an on-disk item the new list does not mention")
    w.add_argument("--dry-run", action="store_true",
                   help="prints the file that would be written, without writing")

    a = ap.parse_args(argv)
    if not a.cmd:
        ap.print_help(sys.stderr)
        return 2
    a.cmd = {"responde": "answer", "ordena": "order",
             "divergencia": "divergence"}.get(a.cmd, a.cmd)

    if a.cmd == "validate":
        return cmd_validate(a.plan_file, a.repo)
    if a.cmd == "decisions":
        return cmd_decisions(a.repo, a.files, a.as_json)
    if a.cmd == "verdict":
        return cmd_verdict(a.repo, a.file, a.ordinal, a.verdict, a.reason, a.text)
    if a.cmd == "from-spec":
        return cmd_from_spec(a.spec)
    if a.cmd == "from-triage":
        return cmd_from_triage(a.handoff)
    if a.cmd == "from-epic":
        return cmd_from_epic(a.epic, a.cycle)
    if a.cmd == "write" and not (a.items or a.from_spec or a.from_triage
                                 or a.from_epic):
        ap.error("write precisa de --items, --from-spec, --from-triage ou "
                 "--from-epic")
    if a.cmd == "write" and bool(a.from_epic) != (a.cycle is not None):
        ap.error("--from-epic e --cycle andam juntos: o Epic tem vários ciclos "
                 "e a fila é de um só")

    root = main_root(a.repo)
    if root is None:
        print(f"{a.repo} não é um repositório git — a fila mora no clone "
              "principal, e sem git não dá para achá-lo", file=sys.stderr)
        return 2
    if a.cmd == "migrate":
        return cmd_migrate(root, a.name, a.all_queues, a.dry_run)
    if a.cmd == "check-name":
        return cmd_check_name(root, a.name)
    if a.cmd == "add":
        return cmd_add(root, a.name, a.id, a)
    if a.cmd == "order":
        keys = [k.strip() for k in a.keys.split(",") if k.strip()]
        return cmd_order(root, a.name, keys, a.as_json)
    if a.cmd == "divergence":
        return cmd_divergence(root, a.name, a.board, a.backlog, a.as_json)
    if a.cmd == "status":
        return cmd_status(root, a.name, a.status_filter, a.as_json, a.item)
    if a.cmd == "show":
        return cmd_show(root, a.name, a.as_json, a.item)
    if a.cmd == "ready":
        return cmd_ready(root, a.as_json)
    if a.cmd == "epics":
        return cmd_epics(root, a.as_json, a.brief)
    if a.cmd == "queue":
        return cmd_queue(root, a.name, a.max_items, a.as_json)
    if a.cmd == "promote":
        return cmd_promote(root, a.name, a.as_json, a.when)
    if a.cmd in ("landed", "aterrissados"):
        return cmd_landed(root, a.board, a.config, a.into, a.as_json)
    if a.cmd == "reconcile":
        return cmd_reconcile(root, a.name, a.board, a.config, a.apply_changes,
                             a.as_json)
    if a.cmd == "start":
        return cmd_start(root, a.name, a.id, a.repo, a.commit)
    if a.cmd == "finish":
        return cmd_finish(root, a.name, a.id, a.status, a.evidence,
                          a.human_pending, a.repo, a.question, a.commit,
                          {key: getattr(a, f"owner_{key}")
                           for key, _, _ in _ownertext.FIELDS},
                          a.supervisor)
    if a.cmd == "answer":
        return cmd_answer(root, a.name, a.id, a.answer, a.keep,
                            a.force, not a.no_commit, a.repo, a.author, a.drop)
    return cmd_write(root, a)


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
