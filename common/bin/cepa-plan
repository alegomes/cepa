#!/usr/bin/env python3
"""cepa-plan — TRANSITION SHIM, not a command (it is not listed in `cepa help`).

It exists only for the runs in flight during the rename `plan` -> `queue`
(docs/spec/reforma-de-nomes-dos-comandos.md, CS-1): the slash commands such a
run loaded before the rename still say `python3 common/bin/cepa-plan ...`.
It is removed at the end of the reform (CS-11/CS-12). `cepa plan` is refused
by the launcher; this file is reachable only by its path.
"""
import os
import sys

_real = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cepa-queue")
os.execv(sys.executable, [sys.executable, _real, *sys.argv[1:]])
