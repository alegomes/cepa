#!/usr/bin/env python3
"""cepa-autonomy — queries the autonomy bands (`common/autonomy.yaml`).

    cepa-autonomy listar [--repo .] [--json]
    cepa-autonomy classificar (--bash CMD | --mcp TOOL | --path P [--op OP] | --slash S | --id ID) [--repo .] [--json]

The file decides "ask or do", not the agent of the turn. This CLI is how a
command (today /board-flow:decide, step 5b) asks the file which band an action
falls into before turning it into a question for the owner:

  executa_e_reporta  → do it, and report it as an information line
  sempre_pergunta    → goes into the owner's question batch
  not listed         → ask (default), and the question ends by proposing the id

Human output in pt-BR; `--json` for code consumers. Exit 0 whenever the query
ran; 2 on invalid argument.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402


def _load_lib():
    here = Path(__file__).resolve().parent.parent / "hooks"
    if str(here) not in sys.path:
        sys.path.insert(0, str(here))
    import _autonomy

    return _autonomy


def cmd_list(args, lib):
    cfg = lib.load(args.repo)
    if args.json:
        print(json.dumps(cfg, ensure_ascii=False, indent=2))
        return 0
    print(f"autonomy.yaml (versao {cfg['versao']}) — fontes: {', '.join(cfg['fontes']) or 'nenhuma'}")
    for band, label in ((lib.BAND_AUTOMATIC, "executa e reporta (reversível)"),
                          (lib.BAND_ASK, "sempre pergunta (irreversível ou de fora)")):
        print(f"\n{label}:")
        for item in cfg[band]:
            detect = ", ".join(f"{k}={v!r}" for k, v in item["detect"].items())
            extra = f"  [precondição: {item['precondicao']}]" if item.get("precondicao") else ""
            moved = f"  [movido por {item['movido_por']}]" if item.get("movido_por") else ""
            print(f"  - {item['id']}: {detect}{extra}{moved}")
    print(f"\nnão listado → {cfg['default_nao_listado']}")
    for warning in cfg["avisos"]:
        print(f"aviso: {warning}", file=sys.stderr)
    return 0


def cmd_classify(args, lib):
    cfg = lib.load(args.repo)
    if args.id:
        band = lib.band_of(cfg, args.id)
        res = {"faixa": band or lib.BAND_ASK, "id": args.id if band else None,
               "listado": band is not None, "precondicao": None, "condicoes": {}}
        if band:
            item = next(i for i in cfg[band] if i["id"] == args.id)
            res["precondicao"] = item.get("precondicao")
    else:
        conds = {}
        for c in args.cond:
            if "=" not in c:
                print(f"--cond espera CHAVE=VALOR, veio {c!r}", file=sys.stderr)
                return 2
            k, v = c.split("=", 1)
            conds[k.strip()] = v.strip()
        res = lib.match(cfg, bash=args.bash, mcp=args.mcp, path=args.path, op=args.op,
                        slash=args.slash, cond=conds)
    res["avisos"] = cfg["avisos"]
    if args.json:
        print(json.dumps(res, ensure_ascii=False))
        return 0
    if not res["listado"]:
        print(f"não listado → {cfg['default_nao_listado']}: pergunte, e termine a pergunta "
              f"propondo o id a acrescentar em common/autonomy.yaml")
    elif res["faixa"] == lib.BAND_AUTOMATIC:
        print(f"executa e reporta ({res['id']}): faça e reporte como linha de informação, não como pergunta")
        if res.get("precondicao"):
            print(f"  SÓ depois de conferir a precondição: {res['precondicao']} — "
                  f"falhou, a ação é descartar-trabalho e vira pergunta")
    else:
        print(f"sempre pergunta ({res['id']}): entra no lote de perguntas do dono")
    if res.get("condicoes"):
        print(f"  condições que o hook resolve (Fase 2): {res['condicoes']}")
    for warning in res["avisos"]:
        print(f"aviso: {warning}", file=sys.stderr)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="cepa-autonomy", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("listar", "classificar"):
        p = sub.add_parser(name)
        p.add_argument("--repo", default=".")
        p.add_argument("--json", action="store_true")
        if name == "classificar":
            g = p.add_mutually_exclusive_group(required=True)
            g.add_argument("--bash")
            g.add_argument("--mcp")
            g.add_argument("--path")
            g.add_argument("--slash")
            g.add_argument("--id")
            p.add_argument("--op", help="com --path: delete|edit|any")
            p.add_argument("--cond", action="append", default=[], metavar="CHAVE=VALOR",
                           help="condição do detect já conferida por você (ex.: label=infra, "
                                "branch_atual=main, destino_terminal=true); repetível")
    args = ap.parse_args(argv)
    lib = _load_lib()
    return cmd_list(args, lib) if args.cmd == "listar" else cmd_classify(args, lib)


if __name__ == "__main__":
    _tui.instalar()
    sys.exit(main())
