#!/usr/bin/env python3
"""cepa-autonomy — says which autonomy band an action falls into (common/autonomy.yaml).

    cepa-autonomy list [--repo .] [--json]
    cepa-autonomy classify (--bash CMD | --mcp TOOL | --path P [--op OP] | --slash S | --id ID) [--repo .] [--json]

The file decides "ask or do", not the agent of the turn. This CLI is how a
command (today /board-flow:decide, step 5b) asks the file which band an action
falls into before turning it into a question for the owner:

  executa_e_reporta  → do it, and report it as an information line
  sempre_pergunta    → goes into the owner's question batch
  not listed         → ask (default), and the question ends by proposing the id

Human output in pt-BR; `--json` for code consumers. Exit 0 whenever the query
ran; 2 on invalid argument.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402
import _clihelp  # noqa: E402


def _load_lib():
    here = Path(__file__).resolve().parent.parent / "hooks"
    if str(here) not in sys.path:
        sys.path.insert(0, str(here))
    import _autonomy

    return _autonomy


def cmd_list(args, lib):
    cfg = lib.load(args.repo)
    if args.json:
        print(json.dumps(cfg, ensure_ascii=False, indent=2))
        return 0
    print(f"autonomy.yaml (versao {cfg['versao']}) — fontes: {', '.join(cfg['fontes']) or 'nenhuma'}")
    for band, label in ((lib.BAND_AUTOMATIC, "executa e reporta (reversível)"),
                          (lib.BAND_ASK, "sempre pergunta (irreversível ou de fora)")):
        print(f"\n{label}:")
        for item in cfg[band]:
            detect = ", ".join(f"{k}={v!r}" for k, v in item["detect"].items())
            extra = f"  [precondição: {item['precondicao']}]" if item.get("precondicao") else ""
            moved = f"  [movido por {item['movido_por']}]" if item.get("movido_por") else ""
            print(f"  - {item['id']}: {detect}{extra}{moved}")
    print(f"\nnão listado → {cfg['default_nao_listado']}")
    for warning in cfg["avisos"]:
        print(f"aviso: {warning}", file=sys.stderr)
    return 0


def cmd_classify(args, lib):
    cfg = lib.load(args.repo)
    if args.id:
        band = lib.band_of(cfg, args.id)
        res = {"faixa": band or lib.BAND_ASK, "id": args.id if band else None,
               "listado": band is not None, "precondicao": None, "condicoes": {}}
        if band:
            item = next(i for i in cfg[band] if i["id"] == args.id)
            res["precondicao"] = item.get("precondicao")
    else:
        conds = {}
        for c in args.cond:
            if "=" not in c:
                print(f"--cond espera CHAVE=VALOR, veio {c!r}", file=sys.stderr)
                return 2
            k, v = c.split("=", 1)
            conds[k.strip()] = v.strip()
        res = lib.match(cfg, bash=args.bash, mcp=args.mcp, path=args.path, op=args.op,
                        slash=args.slash, cond=conds)
    res["avisos"] = cfg["avisos"]
    if args.json:
        print(json.dumps(res, ensure_ascii=False))
        return 0
    if not res["listado"]:
        print(f"não listado → {cfg['default_nao_listado']}: pergunte, e termine a pergunta "
              f"propondo o id a acrescentar em common/autonomy.yaml")
    elif res["faixa"] == lib.BAND_AUTOMATIC:
        print(f"executa e reporta ({res['id']}): faça e reporte como linha de informação, não como pergunta")
        if res.get("precondicao"):
            print(f"  SÓ depois de conferir a precondição: {res['precondicao']} — "
                  f"falhou, a ação é descartar-trabalho e vira pergunta")
    else:
        print(f"sempre pergunta ({res['id']}): entra no lote de perguntas do dono")
    if res.get("condicoes"):
        print(f"  condições que o hook resolve (Fase 2): {res['condicoes']}")
    for warning in res["avisos"]:
        print(f"aviso: {warning}", file=sys.stderr)
    return 0


def main(argv=None):
    ap = _clihelp.Parser(
        prog="cepa autonomy",
        description=(
            "The file decides \"ask or do\", not the agent of the turn. This is how a\n"
            "command (today /board-flow:decide, step 5b) asks which band an action\n"
            "falls into before turning it into a question for the owner:\n"
            "\n"
            "  executa_e_reporta   does it, and reports it in one info line\n"
            "  sempre_pergunta     goes into the owner's batch of questions\n"
            "  not listed          asks (default), and the question ends proposing the id\n"
            "\n"
            "Human output in pt-BR; --json for code."),
        examples=[
            ("cepa autonomy list", "every band and its ids"),
            ("cepa autonomy classify --bash 'git push --force'", "band of a shell command"),
            ("cepa autonomy classify --path src/Main.java --op delete",
             "band of deleting a file"),
        ],
        exit_codes=[
            (0, "the query ran, whatever the band"),
            (2, "invalid usage (no subcommand, unknown flag, bad --cond)"),
        ],
        see_also=["common/autonomy.yaml: the bands themselves",
                  "/board-flow:decide: the command that asks the file before asking the owner"])
    sub = ap.add_subparsers(dest="cmd")
    OLD_NAMES = {"list": "listar", "classify": "classificar"}  # still accepted
    summary = {
        "list": "lists the bands and the ids declared in autonomy.yaml",
        "classify": "says which band one action falls into",
    }
    description = {
        "list": (
            "Prints each band (executa_e_reporta, sempre_pergunta) with the ids it\n"
            "declares, their detect fields, preconditions and who moved them, then the\n"
            "default for actions not listed. Warnings from loading the file go to stderr."),
        "classify": (
            "Takes ONE action, described by exactly one of --bash, --mcp, --path,\n"
            "--slash or --id, and says its band: do it and report, always ask, or not\n"
            "listed (ask, and propose the id to add to common/autonomy.yaml)."),
    }
    examples = {
        "list": [
            ("cepa autonomy list", "the bands, human-readable"),
            ("cepa autonomy list --json", "the loaded file as JSON, for code"),
        ],
        "classify": [
            ("cepa autonomy classify --bash 'git push --force'", "a shell command"),
            ("cepa autonomy classify --path src/Main.java --op delete", "deleting a path"),
            ("cepa autonomy classify --slash /board-flow:advance --cond label=infra",
             "a slash command, condition checked"),
            ("cepa autonomy classify --id commit-local --json", "a declared id, as JSON"),
        ],
    }
    exit_codes = {
        "list": [(0, "the bands were listed"), (2, "invalid usage")],
        "classify": [(0, "the query ran, whatever the band"),
                        (2, "invalid usage (no action flag, two action flags, "
                            "--cond without KEY=VALUE)")],
    }
    for name in ("list", "classify"):
        p = sub.add_parser(name, help=summary[name], description=description[name],
                           examples=examples[name], exit_codes=exit_codes[name],
                           aliases=[OLD_NAMES[name]])
        p.add_argument("--repo", default=".", metavar="DIR",
                       help="repository whose common/autonomy.yaml is read "
                            "(default: the current directory)")
        p.add_argument("--json", action="store_true", help="JSON output, for code")
        if name == "classify":
            g = p.add_mutually_exclusive_group(required=True)
            g.add_argument("--bash", metavar="CMD",
                           help="a shell command, as it would be run")
            g.add_argument("--mcp", metavar="TOOL",
                           help="the name of an MCP tool (e.g. jira_transition_issue)")
            g.add_argument("--path", metavar="PATH",
                           help="a file or directory the action would touch (see --op)")
            g.add_argument("--slash", metavar="/CMD",
                           help="a slash command (e.g. /board-flow:advance)")
            g.add_argument("--id", metavar="ID",
                           help="the id of an action already declared in autonomy.yaml")
            p.add_argument("--op", metavar="OP",
                           help="with --path: the operation on the path, delete, edit or any")
            p.add_argument("--cond", action="append", default=[], metavar="KEY=VALUE",
                           help="a detect condition already checked (e.g. label=infra, "
                                "branch_atual=main, destino_terminal=true); repeatable")
    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help(sys.stderr)
        return 2
    lib = _load_lib()
    cmd = {"listar": "list", "classificar": "classify"}.get(args.cmd, args.cmd)
    return cmd_list(args, lib) if cmd == "list" else cmd_classify(args, lib)


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
