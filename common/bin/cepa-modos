#!/usr/bin/env python3
# Deprecated alias: renamed to cepa-modes. Python (not sh) so both `cepa-modos ...` and `python3 cepa-modos ...` keep working.
import os, sys; d = os.path.dirname(os.path.realpath(__file__))
os.execv(sys.executable, [sys.executable, os.path.join(d, "cepa-modes"), *sys.argv[1:]])
