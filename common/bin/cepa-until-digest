#!/usr/bin/env python3
"""cepa-until-digest — o resumo de um run do `cepa-until` que cabe numa sessão.

## Por que existe

O `cepa-until` deixa dois arquivos por run: o registro (`<run>.jsonl`, poucos
KB) e a saída bruta de cada subprocesso `claude` (`<run>.log`, stream-json).
O `.log` do run de 2026-09-23 no WEGO tem 10,6 MB, cerca de 2,6 milhões de
tokens (10.617.662 bytes ÷ ~4 bytes por token): não cabe em sessão nenhuma. Uma
análise que lê o `.log` por grep lê o que o grep achou, e o que ele não achou
some calado.

Este script escolhe o que ler de forma MECÂNICA, e diz o que escolheu:

  - o registro inteiro (largada, fim, cada item, cada build);
  - de cada rodada, o relatório final do `claude` (o `result` do stream-json),
    as chamadas de agente por tipo, os erros de ferramenta e o custo;
  - de cada rodada, os SINAIS DE PROCESSO: worktree aberta por quem não é o
    proof-reviewer, e relato de gate de build contornado com o verde de outro
    módulo (ver `SINAIS`, abaixo);
  - de cada build completo do supervisor, a cauda da saída;
  - o `status` e a `evidence` ATUAIS de cada item tocado, lidos do plano.

Quem interpreta é o `/common:until-review`. Este script não opina.

Uso:
    cepa-until-digest .claude/programs/WEGO/until/2026-09-23-1826.jsonl
    cepa-until-digest <run>.jsonl --result-max 4000
"""

import argparse
import json
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

try:
    import yaml
except ImportError:
    yaml = None

RESULT_MAX_PADRAO = 3000
ERROS_POR_RODADA = 5
CAUDA_DO_VERIFY = 15
SINAIS_POR_RODADA = 8
TRECHO_DO_SINAL = 160

# ## SINAIS de processo
#
# No run 2026-09-27-1632 do WEGO o `qa-engineer` abriu worktree descartável
# (proibida nas regras da noite) no WEGO-2327 e no WEGO-2329, e no 2329
# contornou o hook que barra commit com build vermelho apresentando o build
# verde de OUTRO módulo. Nada disso apareceu neste resumo: o `qa-engineer` é
# neto do orquestrador (engineering-lead → qa-engineer), e o stream-json do
# `claude -p` só traz as chamadas de ferramenta dos filhos diretos. O que o
# log TEM é o relatório que cada agente devolve a quem o chamou (o
# `tool_result` da chamada `Agent`), e os arquivos que o filho escreve (o
# RESULT.md do engineering-lead citou os dois desvios). É nesses textos que os
# sinais abaixo são procurados, além das chamadas de ferramenta visíveis.
#
# Os sinais de TEXTO só são procurados no relatório devolvido por um agente e
# no conteúdo que um agente escreve (Write/Edit): o resultado de qualquer
# outra ferramenta traz a dica que o hook de path-lock imprime ("provar RED
# revertendo código: worktree descartável FORA da raiz"), e a leitura de um
# RESULT.md repete o que ele já disse — cada um deles virava um sinal falso.
#
# Cada sinal sai com QUEM (o agente cuja chamada ou relatório o trouxe) e um
# trecho literal. Este script não julga: worktree `--detach` do proof-reviewer
# para perturbação é permitida (e vem anotada assim), e quem decide é o
# /common:until-review.
SINAIS_DE_TEXTO = [
    ("worktree descartável relatada",
     re.compile(r"worktree\s+descart[aá]vel|c[oó]pia\s+descart[aá]vel"
                r"|worktree\s+tempor[aá]ri[ao]", re.I)),
    ("build verde de outro módulo / gate de build contornado",
     re.compile(r"build\s+verde\s+de\s+outro\s+m[oó]dulo"
                r"|outro\s+m[oó]dulo[^.\n]{0,60}(?:verde|BUILD SUCCESS)"
                r"|contorn(?:ei|ou|amos|ad[oa]|ando)\b[^.\n]{0,80}(?:gate|hook)"
                r"|re-?estabelec\w*[^.\n]{0,40}baseline\s+verde"
                r"|re-establishing\s+green\s+build", re.I)),
]
WORKTREE_ADD = re.compile(r"git\s+(?:-C\s+\S+\s+)?worktree\s+add\b")


def _texto_do_conteudo(c):
    t = c.get("content")
    if isinstance(t, list):
        t = " ".join(str(x.get("text", "")) for x in t if isinstance(x, dict))
    return str(t or "")


def _trecho(texto, m):
    ini = max(0, m.start() - TRECHO_DO_SINAL // 2)
    fim = min(len(texto), m.end() + TRECHO_DO_SINAL)
    return " ".join(texto[ini:fim].split())


def sinais_no_texto(texto, quem, origem):
    achados = []
    for nome, rx in SINAIS_DE_TEXTO:
        m = rx.search(texto)
        if m:
            achados.append({"sinal": nome, "quem": quem, "origem": origem,
                            "trecho": _trecho(texto, m)})
    return achados


def le_jsonl(caminho):
    eventos = []
    for linha in Path(caminho).read_text(encoding="utf-8",
                                         errors="replace").splitlines():
        try:
            eventos.append(json.loads(linha))
        except json.JSONDecodeError:
            continue
    return eventos


def segmentos_do_log(caminho):
    """[(cabeçalho, [linhas])], um por `===== <quando> · <comando>` que o
    supervisor escreve antes de cada subprocesso e de cada build."""
    segs, atual = [], None
    try:
        f = open(caminho, encoding="utf-8", errors="replace")
    except OSError:
        return segs
    with f:
        for linha in f:
            if linha.startswith("===== "):
                atual = (linha[6:].strip(), [])
                segs.append(atual)
            elif atual is not None:
                atual[1].append(linha)
    return segs


def resume_rodada(linhas, result_max):
    """O que importa de UM subprocesso `claude` em stream-json."""
    agentes, erros, resultado, sinais = Counter(), [], None, []
    # id da chamada `Agent` → tipo do agente chamado: é o que diz DE QUEM é
    # o relatório devolvido (tool_result) e de quem é cada chamada de
    # ferramenta (parent_tool_use_id).
    agente_por_chamada = {}

    def autor(e):
        pai = e.get("parent_tool_use_id")
        return agente_por_chamada.get(pai, "orquestrador" if not pai
                                      else f"agente {pai[:12]}")

    for linha in linhas:
        try:
            e = json.loads(linha)
        except (json.JSONDecodeError, ValueError):
            continue
        tipo = e.get("type")
        if tipo == "assistant":
            for c in (e.get("message") or {}).get("content") or []:
                if not isinstance(c, dict) or c.get("type") != "tool_use":
                    continue
                nome, inp = c.get("name"), c.get("input") or {}
                if nome in ("Agent", "Task"):
                    alvo = inp.get("subagent_type") or "?"
                    agentes[alvo] += 1
                    if c.get("id"):
                        agente_por_chamada[c["id"]] = alvo
                    if inp.get("isolation") == "worktree":
                        sinais.append({"sinal": "worktree aberta (Agent com "
                                                "isolation=worktree)",
                                       "quem": autor(e),
                                       "origem": f"chamada a {alvo}",
                                       "trecho": ""})
                elif nome == "EnterWorktree":
                    sinais.append({"sinal": "worktree aberta (EnterWorktree)",
                                   "quem": autor(e), "origem": "ferramenta",
                                   "trecho": json.dumps(inp,
                                                        ensure_ascii=False)[:TRECHO_DO_SINAL]})
                elif nome == "Bash":
                    cmd = str(inp.get("command") or "")
                    m = WORKTREE_ADD.search(cmd)
                    if m:
                        flag = ("--detach" if "--detach" in cmd
                                else "-b" if re.search(r"\s-b\s", cmd)
                                else "sem --detach")
                        sinais.append({"sinal": f"worktree aberta ({flag})",
                                       "quem": autor(e), "origem": "Bash",
                                       "trecho": _trecho(cmd, m)})
                elif nome in ("Write", "Edit", "MultiEdit"):
                    texto = str(inp.get("content") or inp.get("new_string")
                                or "")
                    alvo = str(inp.get("file_path") or "")
                    sinais.extend(sinais_no_texto(
                        texto, autor(e), f"{nome} em {Path(alvo).name}"))
        elif tipo == "user":
            for c in (e.get("message") or {}).get("content") or []:
                if not isinstance(c, dict) or c.get("type") != "tool_result":
                    continue
                texto = _texto_do_conteudo(c)
                if c.get("is_error"):
                    erros.append(" ".join(texto.split())[:240])
                devolvido_por = agente_por_chamada.get(c.get("tool_use_id"))
                if devolvido_por:
                    sinais.extend(sinais_no_texto(texto, devolvido_por,
                                                  "relatório devolvido"))
        elif tipo == "result":
            resultado = e
    vistos, unicos = set(), []
    for sn in sinais:
        chave = (sn["sinal"], sn["quem"], sn["trecho"][:80])
        if chave not in vistos:
            vistos.add(chave)
            unicos.append(sn)
    # a worktree do proof-reviewer é a permitida: vai por último, para o teto
    # de SINAIS_POR_RODADA não esconder a que não é
    sinais = sorted(unicos, key=lambda sn: sn["sinal"].startswith("worktree")
                    and "proof-reviewer" in sn["quem"])
    r = resultado or {}
    texto = r.get("result") if isinstance(r.get("result"), str) else ""
    cortado = len(texto) > result_max
    return {
        "agentes": dict(agentes),
        "erros": erros,
        "custo": r.get("total_cost_usd"),
        "turnos": r.get("num_turns"),
        "is_error": r.get("is_error"),
        "terminal": r.get("terminal_reason") or r.get("subtype"),
        "relatorio": texto[:result_max] + ("\n[… cortado]" if cortado else ""),
        "tem_result": resultado is not None,
        "sinais": sinais,
    }


def itens_do_plano(caminho_plano):
    if yaml is None or not caminho_plano.is_file():
        return {}
    try:
        plano = yaml.safe_load(caminho_plano.read_text(encoding="utf-8")) or {}
    except Exception:
        return {}
    return {str(it.get("id")): it for it in plano.get("items") or []
            if isinstance(it, dict)}


def plano_da_fila(ledger, fila):
    """O plan.yaml de verdade: o do clone PRINCIPAL, não o da árvore de onde o
    `cepa-until` largou.

    O registro mora em `<árvore>/.claude/programs/<fila>/until/`. Quando essa
    árvore é uma worktree ligada, o plan.yaml ao lado dele é uma cópia que
    ninguém atualiza: quem grava a fila é o `cepa-plan`, sempre no clone
    principal (o pai de `git rev-parse --git-common-dir`, a mesma regra do
    `raiz_principal` dele). Em 2026-09-26 este resumo leu a cópia e mostrou 21
    itens `pending` que já estavam fechados. Fora de um repo git, sobra a
    vizinha do registro.
    """
    vizinho = ledger.parent.parent / "plan.yaml"
    r = subprocess.run(["git", "-C", str(ledger.parent), "rev-parse",
                        "--git-common-dir"], capture_output=True, text=True)
    if r.returncode != 0:
        return vizinho
    comum = Path(r.stdout.strip())
    if not comum.is_absolute():
        comum = (ledger.parent / comum).resolve()
    raiz = comum.parent if comum.name == ".git" else comum
    return raiz / ".claude" / "programs" / (fila or ledger.parent.parent.name) \
        / "plan.yaml"


def monta(ledger, result_max):
    ledger = Path(ledger).resolve()
    log = ledger.with_suffix(".log")
    eventos = le_jsonl(ledger)
    inicio = next((e for e in eventos if e.get("evento") == "run_start"), {})
    fim = next((e for e in eventos if e.get("evento") == "run_end"), {})
    caminho_plano = plano_da_fila(ledger, inicio.get("fila"))
    plano = itens_do_plano(caminho_plano)

    rodadas = [s for s in segmentos_do_log(log) if " · verify · " not in s[0]
               and "/common:until-review" not in s[0]]
    builds = [s for s in segmentos_do_log(log) if " · verify · " in s[0]]
    starts = [e for e in eventos if e.get("evento") == "item_start"]
    ends = [e for e in eventos if e.get("evento") == "item_end"]

    out = [f"# Resumo do run {ledger.stem}", ""]
    out.append(f"- registro: `{ledger}`")
    out.append(f"- saída bruta: `{log}` "
               f"({log.stat().st_size if log.exists() else 0} bytes; este "
               "resumo lê dela só o que está listado abaixo)")
    out.append(f"- fila: `{inicio.get('fila')}` · branch: `{inicio.get('branch')}`"
               f" · base: `{(inicio.get('base') or '')[:10]}`"
               f" · build: `{inicio.get('verify')}`")
    out.append(f"- largada: {inicio.get('quando')} · prazo: {inicio.get('prazo')}"
               f" · fim: {fim.get('quando')} · motivo: `{fim.get('motivo')}`")
    out.append(f"- detalhe do fim: {fim.get('detalhe')}")
    contagens = {k: v for k, v in fim.items()
                 if isinstance(v, int) and k not in ("max_falhas",)}
    out.append(f"- contagens: {json.dumps(contagens, ensure_ascii=False)}")
    if len(rodadas) != len(starts):
        out.append(f"- ATENÇÃO: {len(starts)} item_start no registro e "
                   f"{len(rodadas)} rodadas no `.log` — o pareamento abaixo "
                   "pode estar deslocado")
    out.append("")

    out.append("## Eventos do registro fora das rodadas")
    for e in eventos:
        if e.get("evento") not in ("run_start", "run_end", "item_start",
                                   "item_end"):
            out.append(f"- {json.dumps(e, ensure_ascii=False)}")
    out.append("")

    custo_total = 0.0
    out.append("## Rodadas")
    for i, st in enumerate(starts):
        ident = st.get("id")
        en = ends[i] if i < len(ends) else {}
        r = resume_rodada(rodadas[i][1], result_max) if i < len(rodadas) else None
        custo = (r or {}).get("custo")
        if isinstance(custo, (int, float)):
            custo_total += custo
        out.append(f"### {i + 1}. {ident} — {st.get('title')}")
        out.append(f"- desfecho no registro: status `{en.get('status')}`, "
                   f"{en.get('segundos')} s, exit {en.get('exit_code')}, "
                   f"commits na branch da noite: {en.get('commits')}, "
                   f"tentativa {en.get('tentativa')}")
        if r:
            out.append(f"- custo US$ {custo} · {r['turnos']} turnos · "
                       f"fim `{r['terminal']}`"
                       + (" · is_error" if r["is_error"] else ""))
            if r["agentes"]:
                out.append("- agentes chamados: "
                           + ", ".join(f"{k} ×{v}" for k, v in
                                       sorted(r["agentes"].items())))
            else:
                out.append("- agentes chamados: nenhum")
            if r["erros"]:
                out.append(f"- erros de ferramenta: {len(r['erros'])}; os "
                           f"primeiros {min(len(r['erros']), ERROS_POR_RODADA)}:")
                for erro in r["erros"][:ERROS_POR_RODADA]:
                    out.append(f"  - {erro}")
            if r["sinais"]:
                out.append(f"- sinais de processo: {len(r['sinais'])}"
                           + (f"; os primeiros {SINAIS_POR_RODADA}:"
                              if len(r["sinais"]) > SINAIS_POR_RODADA else ":"))
                for sn in r["sinais"][:SINAIS_POR_RODADA]:
                    prova = (sn["sinal"].startswith("worktree")
                             and "proof-reviewer" in sn["quem"])
                    out.append(f"  - {sn['sinal']} · quem: {sn['quem']}"
                               + (" (prova por perturbação: permitida na noite)"
                                  if prova else "")
                               + f" · onde: {sn['origem']}"
                               + (f" · «{sn['trecho']}»" if sn["trecho"] else ""))
            else:
                out.append("- sinais de processo: nenhum (nenhuma worktree "
                           "aberta, nenhum relato de gate contornado)")
            if not r["tem_result"]:
                out.append("- SEM `result` final: o subprocesso morreu antes de "
                           "relatar")
            out.append("")
            out.append("Relatório final da rodada:")
            out.append("")
            out.append("> " + (r["relatorio"] or "(vazio)").replace("\n", "\n> "))
        out.append("")

    if builds:
        out.append("## Builds completos do supervisor")
        for cab, linhas in builds:
            out.append(f"### {cab}")
            out.append("```")
            out.extend(l.rstrip() for l in linhas[-CAUDA_DO_VERIFY:])
            out.append("```")
        out.append("")

    tocados = []
    for st in starts:
        if st.get("id") not in tocados:
            tocados.append(st.get("id"))
    out.append("## Estado ATUAL na fila dos itens tocados")
    out.append(f"(lido agora de `{caminho_plano}`, não do momento do run)")
    for ident in tocados:
        it = plano.get(str(ident))
        if not it:
            out.append(f"- {ident}: não está mais na fila")
            continue
        out.append(f"- {ident}: `{it.get('status')}`"
                   + (f" · blocked_by {it.get('blocked_by')}"
                      if it.get("blocked_by") else " · blocked_by vazio")
                   + (f" · rota humana: {it.get('human_pending')}"
                      if it.get("human_pending") else ""))
        if it.get("evidence"):
            out.append(f"  - evidence: {' '.join(str(it['evidence']).split())}")
    out.append("")
    out.append(f"Custo somado das rodadas: US$ {custo_total:.2f} (soma do "
               "`total_cost_usd` de cada `result`).")
    return "\n".join(out) + "\n"


def main(argv=None):
    ap = argparse.ArgumentParser(description="resumo de um run do cepa-until")
    ap.add_argument("ledger", help="o <run>.jsonl do cepa-until")
    ap.add_argument("--result-max", type=int, default=RESULT_MAX_PADRAO,
                    help=f"caracteres do relatório final de cada rodada "
                         f"(default {RESULT_MAX_PADRAO})")
    a = ap.parse_args(argv)
    if not Path(a.ledger).is_file():
        print(f"cepa-until-digest: {a.ledger} não existe", file=sys.stderr)
        return 2
    sys.stdout.write(monta(a.ledger, a.result_max))
    return 0


if __name__ == "__main__":
    sys.exit(main())
