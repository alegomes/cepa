#!/usr/bin/env python3
"""cepa-until-digest — TRANSITION SHIM, not a command (it is not listed in `cepa help`).

It exists only for the runs in flight during the rename `until-digest` ->
`run digest` (docs/spec/reforma-de-nomes-dos-comandos.md, CS-2): the slash
commands such a run loaded before the rename still say
`python3 common/bin/cepa-until-digest ...`. It is removed at the end of the
reform (CS-11/CS-12). `cepa until-digest` is refused by the launcher; this file
is reachable only by its path.
"""
import os
import sys

_real = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cepa-run")
os.execv(sys.executable, [sys.executable, _real, "digest", *sys.argv[1:]])
