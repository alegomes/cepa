#!/usr/bin/env python3
"""cepa-promptcov — measures checkpoint coverage of a conversational command.

Born from the P1-sweep-mode card (docs/spec/planejador-de-lotes-paralelos.md):
a command with `interaction: conversational` (e.g.
`maestro/commands/program-plan.md`) is PROSE that a Claude agent follows in a
session, not code an interpreter executes. There is no function to call and no
line to instrument with coverage in the usual sense. The proof-reviewer pinned
that card's PROVEN verdict to `l2_coverage: assumed` for exactly this reason:
no tool measured "how much of the prose was actually exercised".

This script measures something narrower and more honest: given a command whose
behaviour blocks are tagged with `**[tag:id]**` (a new convention, see
`maestro/commands/program-plan.md`), and a regression test whose checks embed
the same `tag:id` in their name, it crosses the two sets and flags every
command `id` that NO test check references.

What this does NOT prove: that the existing check is semantically correct, or
that an agent followed the prose the right way in a real session (that is the
proof-reviewer's job, by perturbing the test, or an independent run, see
docs/proof/P1-sweep-mode.yaml). What this PROVES: that every documented
behaviour block has AT LEAST ONE mechanical check watching it, the same
question line coverage answers for code, applied at the granularity a
conversational command has: the annotated paragraph, not the line.

Convention:
  - in the command: `**[sweep:full-source]** Read the ENTIRE source...`
  - in the test:    `check("[sweep:full-source] sweeps the whole source", ...)`

No `[tag:id]` in the command means nothing to measure; the script says so
explicitly (it never declares 100% coverage by vacuity).

Usage:
  cepa-promptcov <command.md> <test.py> [--tag TAG] [--json]

Exit: 0 = every checkpoint is covered · 1 = some checkpoint is uncovered
      2 = error (missing file, or no checkpoint for the requested TAG)
"""
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _tui  # noqa: E402
import _clihelp  # noqa: E402

# `**[tag:id]**` in the command file; captures tag and id separately so
# --tag can filter (a command may one day carry more than one annotation
# family).
_CMD_TAG_RE = re.compile(r"\*\*\[(?P<tag>[\w-]+):(?P<id>[\w-]+)\]\*\*")

# A bare `tag:id` anywhere in the test text (comment, docstring, or, by the
# convention adopted here, inside the first argument of check()). It does not
# have to be inside check() specifically: a comment
# `# covers: sweep:full-source` counts too. Deliberately loose: format
# rigidity is the kind of thing that drives away whoever maintains this.
_TEST_TAG_RE = re.compile(r"\b(?P<tag>[\w-]+):(?P<id>[\w-]+)\b")


def find_checkpoints(cmd_text: str, tag: str | None) -> list[str]:
    ids = []
    for m in _CMD_TAG_RE.finditer(cmd_text):
        if tag and m.group("tag") != tag:
            continue
        ids.append(f"{m.group('tag')}:{m.group('id')}")
    return ids


def find_covered(test_text: str, tag: str | None) -> set[str]:
    covered = set()
    for m in _TEST_TAG_RE.finditer(test_text):
        if tag and m.group("tag") != tag:
            continue
        covered.add(f"{m.group('tag')}:{m.group('id')}")
    return covered


def main() -> int:
    ap = _clihelp.Parser(
        prog="cepa promptcov",
        description=(
            "A conversational command (a .md an agent follows) is prose, not code:\n"
            "there is no line to instrument. This script measures something narrower\n"
            "and honest: given a command whose behavior blocks are marked with\n"
            "`**[tag:id]**` and a test whose checks carry the same `tag:id` in their\n"
            "name, it crosses the two and points out every `id` that NO check references.\n"
            "\n"
            "The convention:\n"
            "  in the command:  **[sweep:full-source]** Read the WHOLE source...\n"
            "  in the test:     check(\"[sweep:full-source] scans the whole source\", ...)\n"
            "\n"
            "With no [tag:id] in the command there is nothing to measure, and it says\n"
            "so (it never declares 100% vacuously)."),
        examples=[
            ("cepa promptcov maestro/commands/program-plan.md "
             "tests/test_program_plan_sweep.py", "coverage of every tag"),
            ("cepa promptcov cmd.md test.py --tag sweep --json",
             "only the sweep family, JSON for code"),
        ],
        exit_codes=[
            (0, "every checkpoint covered"),
            (1, "some checkpoint uncovered"),
            (2, "invalid usage, no arguments, missing file, or no checkpoint "
                "(for the requested TAG) in the command"),
        ])
    ap.add_argument("command", metavar="COMMAND", help=".md file of the conversational command")
    ap.add_argument("test", metavar="TEST", help="test file that should cover the checkpoints")
    ap.add_argument("--tag", default=None, metavar="TAG",
                    help="restricts to one annotation family (e.g. sweep); "
                         "default: every [tag:id] found")
    ap.add_argument("--json", action="store_true", help="JSON output, for code")
    if len(sys.argv) == 1:
        ap.print_help(sys.stderr)
        return 2
    args = ap.parse_args()

    cmd_path = Path(args.command)
    test_path = Path(args.test)
    for p in (cmd_path, test_path):
        if not p.is_file():
            print(f"✗ cepa-promptcov: arquivo não encontrado: {p}", file=sys.stderr)
            return 2

    cmd_text = cmd_path.read_text(encoding="utf-8")
    test_text = test_path.read_text(encoding="utf-8")

    checkpoints = find_checkpoints(cmd_text, args.tag)
    if not checkpoints:
        msg = (f"nenhum checkpoint **[{args.tag}:id]** encontrado em {cmd_path}"
               if args.tag else
               f"nenhum checkpoint **[tag:id]** encontrado em {cmd_path}")
        if args.json:
            print(json.dumps({"measured": False, "message": msg,
                              "checkpoints": [], "covered": [], "uncovered": []},
                             ensure_ascii=False, indent=2))
        else:
            print(f"# cepa-promptcov @ {cmd_path}\n\n ⚠ {msg}")
        return 2

    covered_ids = find_covered(test_text, args.tag)
    seen: set[str] = set()
    ordered_checkpoints = [c for c in checkpoints if not (c in seen or seen.add(c))]
    covered = [c for c in ordered_checkpoints if c in covered_ids]
    uncovered = [c for c in ordered_checkpoints if c not in covered_ids]

    if args.json:
        print(json.dumps({
            "measured": True,
            "checkpoints": ordered_checkpoints,
            "covered": covered,
            "uncovered": uncovered,
        }, ensure_ascii=False, indent=2))
    else:
        print(f"# cepa-promptcov @ {cmd_path} × {test_path}\n")
        for c in ordered_checkpoints:
            mark = "✓" if c in covered_ids else "✗"
            print(f" {mark} {c}")
        print(f"\n{len(covered)}/{len(ordered_checkpoints)} checkpoint(s) coberto(s).")
        if uncovered:
            print(f"sem cobertura: {', '.join(uncovered)}")

    return 1 if uncovered else 0


if __name__ == "__main__":
    _tui.install()
    sys.exit(main())
