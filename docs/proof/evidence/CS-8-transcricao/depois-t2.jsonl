unto de onde vem o e-mail do paciente, já que a `Receita` só guarda `paciente_id`."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":669,"cache_read_input_tokens":56288,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":669},"output_tokens":807,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e6f3e624-63cc-4309-bfb7-01bce913fb05","uuid":"8667ac88-68b0-4b3f-b130-acda28d69f7e","timestamp":"2026-11-07T00:16:16.989Z","request_id":"req_011Cgnc3bc16P5XCgithNgMs"}
