#!/usr/bin/env python3
"""maestro-programs — answers "what can I run here?" before running.

It exists because discovering the options of /maestro:run cost two shell
commands and the knowledge of two fields that `ls` does not show: `mode` (a
single-track plan does NOT run here) and the `status` of the waves (which is the
next pending one). Without this the user guesses the program name and finds out
about the refusal afterwards.

Reads `<main-root>/.claude/programs/*/plan.yaml` — the SAME root that
/maestro:run uses (the parent of `git rev-parse --git-common-dir` without the
trailing `/.git`), so that the listing and the execution never disagree about
where the plan lives.

It only reads. Never writes, never brings up a gatekeeper, never forks.

Usage:
  maestro-programs [REPO] [--json]
  maestro-programs [REPO] --check-name NOME
  maestro-programs [REPO] --aguardando-merge [--json]
Output (human): one line per program with mode, next wave and the verdict
`roda` / `não roda: <reason>`. Exit 0 whenever it managed to list (even with
zero programs); 2 if the directory is not a git repo.

`--check-name` answers ANOTHER question, before writing: is this program name
free? The harness's two planners write to the SAME directory — /board-flow:triage
writes the board queue to `.claude/programs/<project_key>/plan.yaml`
(mode: single-track) and /maestro:program-plan writes the waves to
`.claude/programs/<name>/plan.yaml` (mode: parallel-waves) — and the program
name is a free choice of the caller. Without this check,
`/maestro:program-plan WEGO` on a `WEGO` board overwrites the prioritized queue
and the `why` of each item without a word. Exit 3 = collision.

`--aguardando-merge` answers the question of /common:next and of the doctor: does
any program have a slice that finished (DONE) and nobody landed? Prints one line
per program in that situation and nothing when there is none; exit 0 in both
cases. It exists because the merge train only runs with the maestro session
alive, and when it dies the disk needs to say "wave waiting for you", not "wave
running".
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("maestro-programs precisa de PyYAML", file=sys.stderr)
    sys.exit(2)

def _wave_state_mod():
    """The maestro-wave-state, imported: the "awaiting merge" rule lives there."""
    path = Path(__file__).resolve().parent / "maestro-wave-state"
    loader = importlib.machinery.SourceFileLoader("maestro_wave_state", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


WS = _wave_state_mod()

# Plan modes that THIS command knows how to execute. The complement is not a
# user error — it is another document, with another consumer (single-track →
# /common:next).
RUNNABLE_MODE = "parallel-waves"


def main_root(repo):
    """The main clone, even when called from inside a linked worktree.

    `--git-common-dir` points to the main clone's .git; its parent is the
    root. In a plain repo it gives the same as `--show-toplevel`.
    """
    common = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--git-common-dir"],
        capture_output=True, text=True)
    if common.returncode != 0:
        return None
    p = Path(common.stdout.strip())
    if not p.is_absolute():
        p = (Path(repo) / p).resolve()
    return p.parent


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except (OSError, ValueError):
        return False
    return True


def _run_in_progress(progdir):
    """What the disk says about a previous execution of this program."""
    info = {"wave_state": None, "gatekeeper_pid": None, "gatekeeper_vivo": False}
    ws = progdir / "wave-state.yaml"
    if ws.is_file():
        try:
            data = yaml.safe_load(ws.read_text()) or {}
        except yaml.YAMLError:
            data = {}
        slices = data.get("slices") or {}
        if isinstance(slices, dict):
            states = {}
            for name, s in slices.items():
                st = (s or {}).get("status") if isinstance(s, dict) else None
                states[name] = st or "?"
        else:
            states = {}
        info["wave_state"] = {"wave": data.get("wave"), "slices": states,
                              "aguardando_merge": WS.awaiting_merge(data)}
    pidfile = progdir / "gatekeeper" / "gatekeeper.pid"
    if pidfile.is_file():
        pid = pidfile.read_text().strip()
        info["gatekeeper_pid"] = pid
        info["gatekeeper_vivo"] = _pid_alive(pid)
    return info


def _evaluate(plan):
    """(eligible, reason, next_wave, waves_summary) for a loaded plan."""
    sv = plan.get("schema_version")
    if sv not in (1, 2):
        missing = "sem `schema_version`" if sv is None else f"schema_version {sv!r} desconhecida"
        return False, f"{missing} — /maestro:run recusa igual (declare 1 ou 2)", None, None
    mode = plan.get("mode") or (RUNNABLE_MODE if sv == 1 else None)
    if mode is None:
        return False, "v2 sem `mode` — campo obrigatório no schema 2", None, None
    if mode == "single-track":
        items = plan.get("items") or []
        pending = [i for i in items if (i or {}).get("status") in (None, "pending", "in_progress")]
        next_id = pending[0].get("id") if pending else None
        reason = "plano de um item por vez — quem responde o próximo é /common:next"
        if next_id:
            reason += f" (próximo: {next_id})"
        return False, reason, None, None
    if mode != RUNNABLE_MODE:
        return False, f"mode {mode!r} não é válido (ver common/plan-schema.yaml)", None, None

    waves = plan.get("waves") or []
    if not waves:
        return False, "sem `waves` — nada a forkar", None, None
    summary = [{"id": w.get("id"), "status": w.get("status") or "pending",
                "slices": w.get("slices") or []} for w in waves]
    pending_waves = [w for w in summary if w["status"] not in ("done",)]
    if not pending_waves:
        return False, f"todas as {len(summary)} ondas já estão done", None, summary
    return True, None, pending_waves[0], summary


def _new_queues(root):
    """The single-track queues of the new layout, `.claude/queues/<n>/queue.yaml`.

    The official resolver is `common/hooks/_queuepath.py`, but maestro is another
    plugin and does not import from `common`; here we only list, so duplicating
    the path is cheaper than coupling the two."""
    base = root / ".claude" / "queues"
    if not base.is_dir():
        return []
    return [{"nome": d.name, "dir": str(d), "elegivel": False,
             "motivo": "fila single-track (.claude/queues) — quem executa é o "
                       "/common:next ou o cepa-until, não o /maestro:run",
             "mode": "single-track", "schema_version": 2,
             "proxima_onda": None, "ondas": None}
            for d in sorted(base.iterdir()) if (d / "queue.yaml").is_file()]


def collect(root):
    progs = []
    base = root / ".claude" / "programs"
    if not base.is_dir():
        return _new_queues(root)
    for d in sorted(p for p in base.iterdir() if p.is_dir()):
        item = {"nome": d.name, "dir": str(d), "elegivel": False,
                "motivo": None, "mode": None, "schema_version": None,
                "proxima_onda": None, "ondas": None}
        item.update(_run_in_progress(d))
        pf = d / "plan.yaml"
        if not pf.is_file():
            item["motivo"] = "sem plan.yaml"
            progs.append(item)
            continue
        try:
            plan = yaml.safe_load(pf.read_text()) or {}
        except yaml.YAMLError as e:
            item["motivo"] = f"plan.yaml ilegível: {e.__class__.__name__}"
            progs.append(item)
            continue
        item["schema_version"] = plan.get("schema_version")
        item["mode"] = plan.get("mode") or (
            RUNNABLE_MODE if plan.get("schema_version") == 1 else None)
        ok, reason, next_wave, summary = _evaluate(plan)
        item["elegivel"], item["motivo"] = ok, reason
        item["proxima_onda"], item["ondas"] = next_wave, summary
        progs.append(item)
    new = {q["nome"] for q in _new_queues(root)}
    progs = [p for p in progs if p["nome"] not in new] + _new_queues(root)
    return sorted(progs, key=lambda p: p["nome"])


def render(root, progs):
    print(f"Programas em {root}/.claude/programs\n")
    if not progs:
        print("  (nenhum) — crie um com /maestro:program-plan <nome>")
        return
    for p in progs:
        label = f"  {p['nome']}"
        mode = p["mode"] or "?"
        sv = p["schema_version"]
        print(f"{label}  [mode: {mode}{f', schema v{sv}' if sv else ''}]")
        if p["elegivel"]:
            w = p["proxima_onda"]
            slices = ", ".join(str(s) for s in w["slices"]) or "(sem slices)"
            done_count = sum(1 for x in p["ondas"] if x["status"] == "done")
            print(f"      RODA  →  /maestro:run {p['nome']} --wave {w['id']}"
                  f"   ({len(p['ondas'])} ondas, {done_count} done; onda {w['id']}"
                  f" = {slices})")
        else:
            print(f"      não roda: {p['motivo']}")
        ws = p.get("wave_state")
        if ws:
            states = ", ".join(f"{k}={v}" for k, v in (ws["slices"] or {}).items())
            print(f"      execução anterior: onda {ws['wave']}"
                  + (f" · {states}" if states else ""))
            if ws.get("aguardando_merge"):
                print("      " + _awaiting_line(p["nome"], ws))
        if p.get("gatekeeper_pid"):
            alive = "VIVO" if p["gatekeeper_vivo"] else "morto (órfão — o gc do run limpa)"
            print(f"      porteiro pid {p['gatekeeper_pid']}: {alive}")
    runnable = [p["nome"] for p in progs if p["elegivel"]]
    print()
    if runnable:
        print("Rodáveis agora: " + ", ".join(runnable))
    else:
        print("Nenhum programa rodável — /maestro:program-plan <nome> cria um.")


def _awaiting_line(name, ws):
    pending = ws["aguardando_merge"]
    return (f"{name}: {len(pending)} slice(s) terminada(s) esperando merge na "
            f"onda {ws['wave']} ({', '.join(pending)}) → /maestro:resume {name}")


def cmd_awaiting(root, as_json):
    progs = [p for p in collect(root)
             if (p.get("wave_state") or {}).get("aguardando_merge")]
    if as_json:
        print(json.dumps({"raiz": str(root), "programas": [
            {"nome": p["nome"], "wave": p["wave_state"]["wave"],
             "aguardando_merge": p["wave_state"]["aguardando_merge"]}
            for p in progs]}, ensure_ascii=False, indent=2))
    else:
        for p in progs:
            print(_awaiting_line(p["nome"], p["wave_state"]))
    return 0


def cmd_check_name(root, name):
    """Exit 0 = name free (or it is its own wave plan). 3 = collision."""
    queue_file = root / ".claude" / "queues" / name / "queue.yaml"
    if queue_file.is_file():
        print(f"COLISÃO: {queue_file} já é a fila '{name}' (layout novo, escrita por "
              f"/common:queue). Escrever ondas com este nome esconderia a fila "
              f"de quem a lê. Escolha outro nome de programa.", file=sys.stderr)
        return 3
    target = root / ".claude" / "programs" / name / "plan.yaml"
    if not target.is_file():
        print(f"nome livre: {target} não existe")
        return 0
    try:
        plan = yaml.safe_load(target.read_text()) or {}
    except yaml.YAMLError as e:
        print(f"{target} existe e está ilegível ({e.__class__.__name__}) — "
              "não dá para dizer o que sobrescreveria", file=sys.stderr)
        return 3
    mode = plan.get("mode") or (
        RUNNABLE_MODE if plan.get("schema_version") == 1 else None)
    if mode == "single-track":
        items = plan.get("items") or []
        print(f"COLISÃO: {target} já é a fila single-track do board "
              f"'{plan.get('queue') or plan.get('program') or name}' ({len(items)} itens, escrita por "
              f"/board-flow:triage). Escrever ondas aqui apaga a ordem e o `why` "
              f"de cada item. Escolha outro nome de programa.", file=sys.stderr)
        return 3
    print(f"nome ocupado por um plano '{mode}' — reescrever é o fluxo normal "
          f"de replanejar as ondas de '{name}'")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description="lista os programas do Maestro neste repo")
    ap.add_argument("repo", nargs="?", default=".")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--check-name", metavar="NOME",
                    help="o nome de programa está livre? exit 3 se colide com "
                         "uma fila single-track")
    ap.add_argument("--aguardando-merge", action="store_true",
                    help="só os programas com slice DONE ainda não aterrissada")
    a = ap.parse_args(argv)

    root = main_root(a.repo)
    if root is None:
        print(f"{a.repo} não é um repositório git", file=sys.stderr)
        return 2
    if a.check_name:
        return cmd_check_name(root, a.check_name)
    if a.aguardando_merge:
        return cmd_awaiting(root, a.json)
    progs = collect(root)
    if a.json:
        print(json.dumps({"raiz": str(root), "programas": progs},
                         ensure_ascii=False, indent=2))
    else:
        render(root, progs)
    return 0


if __name__ == "__main__":
    sys.exit(main())
