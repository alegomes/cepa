#!/usr/bin/env python3
"""maestro-poll — one iteration of the wave event loop (design rev2.1, Comp. 2a).

Deterministic, testable core: the primary synchronization is by FILE
(each child's resultado.txt + wave-state), NEVER by the herdr pane (the pane is
cosmetic). This script does NOT talk to herdr nor kill processes — it INSPECTS
the state on disk and reports the transitions the maestro session must carry out.

Why an inspector iteration instead of an internal loop: with an event loop there
is deadlock (a session stuck in a blocking wait does not drain the escalation
queue). /maestro:run calls this in rotation, acts on the output and repeats.

For each `running` slice, decides the terminal state by reading the marker in
resultado.txt (the normative wrapper guarantees it shows up):
  MAESTRO-EXIT:0                 → DONE
  MAESTRO-EXIT:<n≠0>             → FAIL
  MAESTRO-EXIT:ESCALATED:<id>    → ESCALATED (protocol 3a; not a failure)
  (no marker, stale mtime)       → heartbeat suspicion / TIMEOUT by T_slice

Usage:
  maestro-poll <program-dir> [--now EPOCH] [--heartbeat-s 300]
Reads <program-dir>/wave-state.yaml and <program-dir>/slices/<S>/resultado.txt.
Emits JSON: {transitions:[...], escalations:[...], alive:[...]}.
--now allows deterministic testing (Date.now does not exist in the workflow
runtime, but here it is a normal CLI; we still accept --now for the tests).
"""
import argparse
import json
import re
import sys
import time
from pathlib import Path

try:
    import yaml
except ImportError:
    print("maestro-poll precisa de PyYAML", file=sys.stderr)
    sys.exit(2)

EXIT_RE = re.compile(r"MAESTRO-EXIT:(ESCALATED:(\S+)|(\d+))")


def read_marker(result_file: Path):
    """Returns (terminal_state, detail) or (None, None) if still running."""
    if not result_file.is_file():
        return None, None
    txt = result_file.read_text(errors="replace")
    # the LAST marker counts (the child may log before exiting)
    last = None
    for m in EXIT_RE.finditer(txt):
        last = m
    if not last:
        return None, None
    if last.group(2) is not None:            # ESCALATED:<id>
        return "ESCALATED", last.group(2)
    code = int(last.group(3))
    return ("DONE" if code == 0 else "FAIL"), code


def result_path(program_dir: Path, name: str, st: dict) -> Path:
    """Where the child's resultado.txt lives.

    The normative wrapper runs with `--cwd <worktree>` and does `tee resultado.txt`,
    so the file is born AT THE WORKTREE ROOT — which the wave-state records in
    `worktree:`. Looking only in `<progdir>/slices/<S>/` made the poll never see
    any marker: every slice stayed `running` until blowing T_slice and falling
    into TIMEOUT, even though it had finished with MAESTRO-EXIT:0 (WEGO-parallel
    wave, 2026-08-24 — 5 slices done and the state saying running).
    The path under `slices/` remains valid as a fallback.
    """
    wt = st.get("worktree")
    if wt:
        cand = Path(wt) / "resultado.txt"
        if cand.is_file():
            return cand
    return program_dir / "slices" / name / "resultado.txt"


def poll(program_dir: Path, now: float, heartbeat_s: int):
    ws_path = program_dir / "wave-state.yaml"
    ws = yaml.safe_load(ws_path.read_text()) if ws_path.is_file() else {}
    slices = ws.get("slices") or {}
    default_timeout = int(ws.get("timeout_min_default", 45)) * 60

    transitions, alive, stalled = [], [], []
    for name, st in slices.items():
        if st.get("status") != "running":
            continue
        result_file = result_path(program_dir, name, st)
        term, detail = read_marker(result_file)
        if term:
            tr = {"slice": name, "to": term, "detail": detail}
            transitions.append(tr)
            continue
        # still running — heartbeat + timeout
        started = st.get("started_epoch")
        t_slice = int(st.get("timeout_min", default_timeout // 60)) * 60
        if started and (now - started) > t_slice:
            transitions.append({"slice": name, "to": "TIMEOUT",
                                "detail": f"sem MAESTRO-EXIT após {t_slice}s"})
            continue
        mtime = result_file.stat().st_mtime if result_file.is_file() else started
        if mtime and (now - mtime) > heartbeat_s:
            stalled.append({"slice": name,
                            "idle_s": round(now - mtime)})
        alive.append(name)

    # pending escalations in the gatekeeper queue
    escalations = []
    esc_dir = program_dir / "gatekeeper" / "escalations"
    if esc_dir.is_dir():
        for f in sorted(esc_dir.glob("*.yaml")):
            try:
                e = yaml.safe_load(f.read_text())
            except Exception:
                continue
            if isinstance(e, dict) and e.get("estado") == "pending":
                escalations.append(e)

    # gatekeeper health
    gk_pid = None
    pidf = program_dir / "gatekeeper" / "gatekeeper.pid"
    if pidf.is_file():
        try:
            gk_pid = int(pidf.read_text().strip())
        except ValueError:
            pass
    gk_alive = _pid_alive(gk_pid) if gk_pid else False

    return {
        "transitions": transitions,
        "escalations": escalations,
        "alive": alive,
        "stalled": stalled,
        "gatekeeper": {"pid": gk_pid, "alive": gk_alive},
        "wave_done": len(alive) == 0 and not any(
            s.get("status") == "running" for s in slices.values()),
    }


def _pid_alive(pid):
    import os
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return isinstance(pid, int)  # PermissionError → exists but under another owner
    except OSError:
        return False
    return True


def main():
    ap = argparse.ArgumentParser(prog="maestro-poll")
    ap.add_argument("program_dir")
    ap.add_argument("--now", type=float, default=None)
    ap.add_argument("--heartbeat-s", type=int, default=300)
    args = ap.parse_args()
    now = args.now if args.now is not None else time.time()
    out = poll(Path(args.program_dir), now, args.heartbeat_s)
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
