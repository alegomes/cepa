#!/usr/bin/env python3
"""maestro-wave-state — wave state store (design rev2.1, Comp. 2c).

Death of the maestro session is the most likely failure mode of a long session;
wave-state.yaml is written on EVERY transition so that /maestro:resume rebuilds
the wave (along the lines of /common:autonomous-resume). This script is the
only write door of the wave-state — /maestro:run and /maestro:resume call it.

Subcommands:
  init <program-dir> --plan PLAN --wave N
        creates the wave's wave-state.yaml (slices in pending, timeout_min per slice)
  set-slice <program-dir> <slice> <status> [--pane ID] [--worktree PATH]
        [--pid N] [--started-epoch E] [--detail TEXT]
  set-gk <program-dir> --pid N [--url URL]
  set-home <program-dir> --pane ID --tab ID --workspace ID
        records the pane/tab/Space the wave's forks must use (see
        /maestro:run, step captured BEFORE the intake gate — the focus at fork
        time is the wrong value, WEGO-parallel 2026-08-24)
  landed <program-dir> <slice>          # marks merge landed (slice → LANDED)
  get <program-dir> [--json]            # prints the state (resume reads this)
  check-terminal <program-dir> [--json] # exit 0 if every slice finished; 2 otherwise
  aguardando-merge <program-dir> [--json]
        # DONE slices that have not landed yet; exit 0 whenever it read

Terminal states per slice: DONE | LANDED | FAIL | TIMEOUT | ESCALATED (never
"hanging"). DONE means "the child finished"; LANDED, "the branch is in the
integration". Separating the two is what lets the disk say "wave waiting for
you" instead of "wave running": in wave 1 of WEGO-parallel (2026-08-24) the
maestro session died before the merge train, `landed:` stayed [] and five ready
branches waited hours until someone noticed.
"""
import argparse
import sys
import time
from pathlib import Path

try:
    import yaml
except ImportError:
    print("maestro-wave-state precisa de PyYAML", file=sys.stderr)
    sys.exit(2)

VALID = {"pending", "running", "DONE", "LANDED", "FAIL", "TIMEOUT", "ESCALATED"}

# States that END a slice. The complement (pending/running) is not an outcome —
# it is the absence of one. A wave that lands with a slice in there vanishes
# from the radar without anyone having decided anything about it.
TERMINAL = {"DONE", "LANDED", "FAIL", "TIMEOUT", "ESCALATED"}


def awaiting_merge(ws):
    """Slices that finished and nobody landed, in wave-state order.

    Also reads the old format, in which the merge only appeared in the loose
    `landed:` list at the top and the slice stayed DONE: a name in the list
    counts as landed. It is the only copy of this rule; maestro-programs imports it.
    """
    landed = set((ws or {}).get("landed") or [])
    slices = (ws or {}).get("slices") or {}
    if not isinstance(slices, dict):
        return []
    return [s for s, v in slices.items()
            if isinstance(v, dict) and v.get("status") == "DONE"
            and s not in landed]


def _path(d):
    return Path(d) / "wave-state.yaml"


def _load(d):
    p = _path(d)
    return yaml.safe_load(p.read_text()) if p.is_file() else {}


def _save(d, ws):
    Path(d).mkdir(parents=True, exist_ok=True)
    _path(d).write_text(yaml.safe_dump(ws, allow_unicode=True, sort_keys=False))


def cmd_init(a):
    plan = yaml.safe_load(Path(a.plan).read_text())
    # v1 = legacy (waves only); v2 = explicit `mode`. See common/plan-schema.yaml.
    if plan.get("schema_version") not in (1, 2):
        print("schema_version desconhecida (esperado 1 ou 2)", file=sys.stderr)
        return 2
    if (plan.get("mode") or "parallel-waves") != "parallel-waves":
        print("plano single-track não tem ondas — /maestro:run não o executa",
              file=sys.stderr)
        return 2
    wave = next((w for w in plan.get("waves", []) if w.get("id") == a.wave), None)
    if wave is None:
        print(f"onda {a.wave} não existe no plano", file=sys.stderr)
        return 2
    slices_def = plan.get("slices") or {}
    ws = {
        "program": plan.get("program"),
        "wave": a.wave,
        "created_epoch": int(time.time()),
        "timeout_min_default": 45,
        "gatekeeper": {"pid": None, "url": None},
        "home": None,
        "landed": [],
        "slices": {
            s: {"status": "pending",
                "timeout_min": int(slices_def.get(s, {}).get("timeout_min", 45)),
                "pane": None, "worktree": None, "pid": None,
                "started_epoch": None, "detail": None}
            for s in (wave.get("slices") or [])
        },
    }
    _save(a.program_dir, ws)
    print(f"wave-state inicializado: onda {a.wave}, "
          f"{len(ws['slices'])} slice(s)")
    return 0


def cmd_set_slice(a):
    if a.status not in VALID:
        print(f"status inválido: {a.status} (∈ {sorted(VALID)})", file=sys.stderr)
        return 2
    ws = _load(a.program_dir)
    sl = ws.setdefault("slices", {}).setdefault(a.slice, {})
    sl["status"] = a.status
    if a.pane is not None:
        sl["pane"] = a.pane
    if a.worktree is not None:
        sl["worktree"] = a.worktree
    if a.pid is not None:
        sl["pid"] = a.pid
    if a.started_epoch is not None:
        sl["started_epoch"] = a.started_epoch
    elif a.status == "running" and not sl.get("started_epoch"):
        sl["started_epoch"] = int(time.time())
    if a.detail is not None:
        sl["detail"] = a.detail
    _save(a.program_dir, ws)
    print(f"{a.slice} → {a.status}")
    return 0


def cmd_set_gk(a):
    ws = _load(a.program_dir)
    gk = ws.setdefault("gatekeeper", {})
    gk["pid"] = a.pid
    if a.url is not None:
        gk["url"] = a.url
    _save(a.program_dir, ws)
    print(f"gatekeeper pid={a.pid}")
    return 0


def cmd_set_home(a):
    """Records the pane/tab/Space captured at the start of the routine.

    It is the only source of "where the children are born". Without it, the
    step 6c spawn would fall back to the current focus at fork time — exactly
    the bug of the item (the WEGO-parallel wave, 2026-08-24, forked 5 panes in
    the tab that was in focus, not in the /maestro:run one).
    """
    ws = _load(a.program_dir)
    ws["home"] = {"pane": a.pane, "tab": a.tab, "workspace": a.workspace}
    _save(a.program_dir, ws)
    print(f"home: pane={a.pane} tab={a.tab} workspace={a.workspace}")
    return 0


def cmd_landed(a):
    ws = _load(a.program_dir)
    sl = (ws.get("slices") or {}).get(a.slice)
    st = (sl or {}).get("status")
    if st not in ("DONE", "LANDED"):
        # The merge train only lands DONE. Merging anything else and marking it
        # here would erase the FAIL/TIMEOUT/ESCALATED that sends the slice to re-fork.
        print(f"{a.slice} está {st or 'fora do wave-state'}, não DONE — só "
              f"slice DONE aterrissa (merge feito à mão? registre antes: "
              f"set-slice {a.program_dir} {a.slice} DONE)", file=sys.stderr)
        return 2
    sl["status"] = "LANDED"
    landed = ws.setdefault("landed", [])
    if a.slice not in landed:
        landed.append(a.slice)
    _save(a.program_dir, ws)
    print(f"landed: {a.slice}")
    return 0


def cmd_check_terminal(a):
    """Wave end boundary: nothing lands with a hanging slice.

    Called by /maestro:run before the merge train and before the report. It is
    mechanical on purpose — 'the wave is over' becomes a question with a
    verifiable answer, not an impression of whoever was driving.
    """
    ws = _load(a.program_dir)
    slices = ws.get("slices") or {}
    pend = {s: (v or {}).get("status") for s, v in slices.items()
            if (v or {}).get("status") not in TERMINAL}
    if a.json:
        import json
        print(json.dumps({"wave": ws.get("wave"), "total": len(slices),
                          "non_terminal": pend}, ensure_ascii=False, indent=2))
    elif pend:
        print(f"onda {ws.get('wave')}: {len(pend)} de {len(slices)} slice(s) "
              f"sem estado terminal", file=sys.stderr)
        for s, st in sorted(pend.items()):
            print(f"  {s}: {st or 'sem status'} "
                  f"(terminal ∈ {sorted(TERMINAL)})", file=sys.stderr)
    else:
        print(f"onda {ws.get('wave')}: {len(slices)} slice(s), todas terminais")
    return 2 if pend else 0


def cmd_awaiting_merge(a):
    ws = _load(a.program_dir)
    pend = awaiting_merge(ws)
    if a.json:
        import json
        print(json.dumps({"wave": ws.get("wave"), "aguardando_merge": pend},
                         ensure_ascii=False, indent=2))
    elif pend:
        print(f"onda {ws.get('wave')}: {len(pend)} slice(s) terminada(s) "
              f"esperando merge: {', '.join(pend)}")
    else:
        print(f"onda {ws.get('wave')}: nenhuma slice esperando merge")
    return 0


def cmd_get(a):
    ws = _load(a.program_dir)
    if a.json:
        import json
        print(json.dumps(ws, ensure_ascii=False, indent=2))
    else:
        print(yaml.safe_dump(ws, allow_unicode=True, sort_keys=False))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="maestro-wave-state")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init"); p.add_argument("program_dir")
    p.add_argument("--plan", required=True); p.add_argument("--wave", type=int, required=True)
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("set-slice"); p.add_argument("program_dir")
    p.add_argument("slice"); p.add_argument("status")
    p.add_argument("--pane"); p.add_argument("--worktree")
    p.add_argument("--pid", type=int); p.add_argument("--started-epoch", type=int)
    p.add_argument("--detail")
    p.set_defaults(fn=cmd_set_slice)

    p = sub.add_parser("set-gk"); p.add_argument("program_dir")
    p.add_argument("--pid", type=int, required=True); p.add_argument("--url")
    p.set_defaults(fn=cmd_set_gk)

    p = sub.add_parser("set-home"); p.add_argument("program_dir")
    p.add_argument("--pane", required=True); p.add_argument("--tab", required=True)
    p.add_argument("--workspace", required=True)
    p.set_defaults(fn=cmd_set_home)

    p = sub.add_parser("landed"); p.add_argument("program_dir"); p.add_argument("slice")
    p.set_defaults(fn=cmd_landed)

    p = sub.add_parser("get"); p.add_argument("program_dir")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_get)

    p = sub.add_parser("check-terminal"); p.add_argument("program_dir")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_check_terminal)

    p = sub.add_parser("aguardando-merge"); p.add_argument("program_dir")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_awaiting_merge)

    a = ap.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
