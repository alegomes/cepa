#!/usr/bin/env python3
"""maestro-fork-settings — generates the child's settings.json from a slice.

Layer 1 of Maestro's multi-layer enforcement (design rev2.1). Deny-by-default
with allow restricted to the declared surface and `ask` rules that ROUTE to the
gatekeeper everything layer 1 does not pre-approve.

SPIKE FINDING (mandatory, otherwise layer 3 is decorative): without `ask` rules,
the headless default mode pre-approves "safe" commands (touch, mkdir…) and the
gatekeeper is NEVER consulted. Hence we emit `ask` covering Bash/Write/Edit —
the most specific allow (surface, Bash base) wins for what is allowed, and the
catch-all `ask` sends the rest to the `--permission-prompt-tool`.

Claude Code precedence model: deny > allow > ask, by specificity.
  - deny  : enforcement zone (unconditional) — plugins/, hooks/, settings, cache
  - allow : Edit(<surface glob>), Bash(<base>:*) + bash_extra
  - ask   : Write, Edit, Bash (catch-all) → gatekeeper decides/escalates

WEGO-parallel WAVE FINDING (2026-08-24): a rule with a path is only valid as
`Edit(path)` — Claude Code REFUSES `Write(path)` with a warning ("only Edit(path)
rules are [matched by file permission checks]") and `Edit(path)` already covers
all the write tools. Emitting the Write+Edit pair was noise that neither opened
nor closed anything. Only the `ask` catch-all keeps the bare name `Write`.

FINDING FROM THE SAME WAVE (cost the entire wave): `mcpServers` in settings.json
is NOT read by Claude Code — the child came up without the gatekeeper's tool and
died at launch with `MCP tool mcp__gatekeeper__permission_prompt not found`
(exit 1). The gatekeeper's address has to go in a `.mcp.json` and the child be
launched with `--mcp-config .mcp.json --strict-mcp-config`. That is why this
generator emits TWO artifacts, not one.

Usage:
  maestro-fork-settings <plan.yaml> <slice> [--port P] [--host H]
                        [--enforcement-zone GLOB ...]
                        [--emit settings|mcp] [--out-dir WORKTREE]
Without --out-dir, emits to stdout the artifact requested by --emit (default
settings). With --out-dir, writes both into the slice worktree:
<dir>/.claude/settings.json and <dir>/.mcp.json (that is how /maestro:run calls it).
"""
import argparse
import json
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("maestro-fork-settings precisa de PyYAML", file=sys.stderr)
    sys.exit(2)

# Base set of Bash pre-approved in the settings (build/test/local git, reading).
# Deliberately conservative — whatever goes beyond this goes to the gatekeeper.
BASE_BASH = [
    "ls", "cat", "pwd", "echo", "grep", "rg", "find", "head", "tail", "wc",
    "git status", "git diff", "git log", "git add", "git commit", "git show",
    "git branch", "git rev-parse", "git stash",
    "python3", "pytest", "node", "npm test", "npm run",
    "mvn", "./mvnw", "gradle", "./gradlew", "make", "cargo", "go",
    "sed", "awk", "test", "true", "mkdir", "touch", "cp", "mv",
]

DEFAULT_ENFORCEMENT_ZONE = [
    ".claude/settings.json", ".claude/settings.local.json",
    ".claude-plugin/**", "**/.claude-plugin/**",
    "**/hooks/**", "**/plugins/**",
]


def build_settings(plan: dict, slice_name: str, gk_url: str,
                   enforcement_zone: list[str]) -> dict:
    slices = plan.get("slices") or {}
    if slice_name not in slices:
        raise KeyError(f"slice {slice_name!r} não existe no plano")
    sl = slices[slice_name]
    surface = sl.get("surface") or []
    bash_extra = sl.get("bash_extra") or []

    # Only Edit(path): Claude Code refuses Write(path) and Edit(path) already
    # covers every tool that edits a file (Write included).
    deny: list[str] = [f"Edit({z})" for z in enforcement_zone]

    allow: list[str] = [f"Edit({g})" for g in surface]
    for cmd in BASE_BASH + list(bash_extra):
        # Bash(cmd:*) matches the command and its arguments
        allow.append(f"Bash({cmd}:*)")

    # ask catch-all → routes to the gatekeeper everything allow did not cover.
    # (the most specific allow wins; without this the gatekeeper is decorative)
    ask = ["Bash", "Write", "Edit"]

    return {
        "permissions": {
            "deny": deny,
            "allow": allow,
            "ask": ask,
        },
        # Do NOT declare mcpServers here: settings.json is not read for MCP.
        # The gatekeeper goes in .mcp.json (build_mcp_config).
        "_maestro": {
            "slice": slice_name,
            "surface": surface,
            "gatekeeper_url": gk_url,
        },
    }


def build_mcp_config(gk_url: str) -> dict:
    """The child's .mcp.json — the ONLY way through which it sees the gatekeeper.

    The child points --permission-prompt-tool at THIS server; the slice
    identity goes in the URL (spike finding: the payload does not carry it).
    """
    return {"mcpServers": {"gatekeeper": {"type": "http", "url": gk_url}}}


def main() -> int:
    ap = argparse.ArgumentParser(prog="maestro-fork-settings")
    ap.add_argument("plan")
    ap.add_argument("slice")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--enforcement-zone", nargs="*",
                    default=DEFAULT_ENFORCEMENT_ZONE)
    ap.add_argument("--emit", choices=("settings", "mcp"), default="settings",
                    help="qual artefato vai ao stdout (ignorado com --out-dir)")
    ap.add_argument("--out-dir",
                    help="worktree do slice: grava .claude/settings.json E "
                         ".mcp.json (o par que a filha precisa)")
    args = ap.parse_args()

    plan = yaml.safe_load(Path(args.plan).read_text())
    # v1 = legacy (waves only); v2 = explicit `mode`. See common/plan-schema.yaml.
    if not isinstance(plan, dict) or plan.get("schema_version") not in (1, 2):
        print("schema_version ausente ou desconhecida (esperado 1 ou 2)",
              file=sys.stderr)
        return 2
    if (plan.get("mode") or "parallel-waves") != "parallel-waves":
        print("plano single-track não tem slices a forkar", file=sys.stderr)
        return 2

    # slice identity via query param — 1 gatekeeper shared by N children
    gk_url = f"http://{args.host}:{args.port}/mcp?slice={args.slice}"
    try:
        settings = build_settings(plan, args.slice, gk_url, args.enforcement_zone)
    except KeyError as e:
        print(str(e), file=sys.stderr)
        return 2
    mcp = build_mcp_config(gk_url)

    if args.out_dir:
        wt = Path(args.out_dir)
        if not wt.is_dir():
            print(f"--out-dir não é diretório: {wt}", file=sys.stderr)
            return 2
        (wt / ".claude").mkdir(exist_ok=True)
        (wt / ".claude" / "settings.json").write_text(
            json.dumps(settings, ensure_ascii=False, indent=2) + "\n")
        (wt / ".mcp.json").write_text(
            json.dumps(mcp, ensure_ascii=False, indent=2) + "\n")
        print(f"{wt}/.claude/settings.json e {wt}/.mcp.json gravados "
              f"(slice {args.slice})")
        return 0

    print(json.dumps(mcp if args.emit == "mcp" else settings,
                     ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
