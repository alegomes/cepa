#!/usr/bin/env python3
"""maestro-prune — removes the herdr Space + worktree of the slices that LANDED.

Why it exists (reflection 2026-08-24 + fact verified live on herdr 0.9.1,
2026-09-26): `/maestro:run` creates each slice with `herdr worktree create`, and
herdr treats a worktree **as** a Space — herdr's own removal is
`herdr worktree remove --workspace ID`, not a plain git command. Without prune,
each wave adds one Space per slice to the sidebar and they never go away by
themselves: on 2026-08-24 there were 11 Spaces (`w12`–`w1D`) left over from two
waves.

What this script does NOT remove, and why: DONE-not-landed (the child's evidence
has not become a merge yet — deleting the worktree would delete the evidence
before anyone decides), FAIL/TIMEOUT/ESCALATED (those slices re-fork in the next
wave from the worktree where they stopped) and any slice still pending or
running. Only LANDED — merge already in the integration, nothing more to
preserve there — is a prune candidate. `landed` in the old format (loose list at
the top of the wave-state, no `status: LANDED` on the slice) also counts, by the
same rule `maestro-wave-state aguardando-merge` already uses.

Facts verified live against herdr 0.9.1 (disposable repo in /tmp, 2026-09-26),
because the BACKLOG only had an unconfirmed sketch:
  - `herdr worktree remove --workspace ID --trust-repository` takes down the
    Space AND the git worktree AND the directory in one go; the BRANCH stays.
  - Dirty worktree (uncommitted/untracked file) without `--force`: exit 1,
    `dirty_worktree_requires_force` — nothing is removed. This script NEVER
    passes `--force`; the owner decides what to do with a still-dirty LANDED slice.
  - The positional form `herdr worktree remove <path>` does NOT exist in 0.9.1
    ("unknown option: <path>") — only `--workspace ID` identifies the target.
  - `herdr worktree list` without `--cwd` lists the repo of the Space in FOCUS,
    not of the current directory — hence the explicit `--cwd <repo>`.
  - `herdr worktree list --json` only returns `open_workspace_id` for a worktree
    with an open Space; if the owner closed the Space by hand, the key vanishes
    and this script falls back to a plain `git worktree remove` (without `--force`).

Same principle as step 6a of `/maestro:run` (check with git, not with an
external tool's word): after ordering the removal, this script re-reads
`git worktree list --porcelain` of the repo and only marks "removed" if the path
is no longer there. A path absent from the output already at the FIRST look
counts as "already removed" (the owner cleaned it by hand) — it is not a
failure and triggers no remove.

Usage:
  maestro-prune <program-dir> --repo <main-root> [--dry-run] [--json]

The environment variable `MAESTRO_HERDR` swaps the herdr binary (default:
`herdr`) — it is what the tests use to inject a fake.

Exit 0 = no failure (removed/kept/already-removed count as success).
Exit 1 = some LANDED slice failed to remove (dirty worktree, herdr/git errored,
or git still shows the path after the remove).
Exit 2 = incorrect usage or wave-state.yaml missing.
"""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("maestro-prune precisa de PyYAML", file=sys.stderr)
    sys.exit(2)


def herdr_bin():
    return os.environ.get("MAESTRO_HERDR", "herdr")


def _load_wave_state(program_dir):
    p = Path(program_dir) / "wave-state.yaml"
    if not p.is_file():
        return None
    return yaml.safe_load(p.read_text()) or {}


def landed_slices(ws):
    """Landed slices: `status: LANDED` OR listed in the legacy `landed:`
    (same compatibility rule that `maestro-wave-state
    aguardando-merge` uses for the old format)."""
    landed_names = set((ws or {}).get("landed") or [])
    slices = (ws or {}).get("slices") or {}
    out = {}
    for name, v in (slices.items() if isinstance(slices, dict) else []):
        v = v or {}
        status = v.get("status")
        if status == "LANDED" or name in landed_names:
            out[name] = v
        else:
            out.setdefault("__kept__", []).append((name, status or "sem status"))
    return out


def git_worktree_paths(repo):
    """Linked worktree paths registered by git, resolved (realpath),
    to compare with what the wave-state/herdr point to."""
    r = subprocess.run(["git", "-C", str(repo), "worktree", "list", "--porcelain"],
                       capture_output=True, text=True)
    paths = []
    for line in r.stdout.splitlines():
        if line.startswith("worktree "):
            paths.append(os.path.realpath(line[len("worktree "):]))
    return set(paths)


def herdr_worktree_map(repo):
    """resolved path -> open_workspace_id (absent = no open Space).

    `--cwd` is mandatory: without it herdr 0.9.1 lists the repo of the Space IN
    FOCUS and ignores the process's current directory (measured live on
    2026-09-26: run from inside the wave's repo, it returned the cepa clone,
    which was in focus; no slice matched, everything fell to the plain `git
    worktree remove` and the Spaces stayed in the sidebar — the whole defect)."""
    r = subprocess.run([herdr_bin(), "worktree", "list",
                        "--cwd", str(repo), "--json"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        # With no herdr answering, everything falls back to plain git.
        return {}
    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}
    out = {}
    for wt in (data.get("result") or {}).get("worktrees") or []:
        path = wt.get("path")
        if not path:
            continue
        wsid = wt.get("open_workspace_id")
        if wsid:
            out[os.path.realpath(path)] = wsid
    return out


def remove_via_herdr(workspace_id):
    r = subprocess.run([herdr_bin(), "worktree", "remove",
                        "--workspace", workspace_id, "--trust-repository"],
                       capture_output=True, text=True)
    return r


def remove_via_git(repo, path):
    r = subprocess.run(["git", "-C", str(repo), "worktree", "remove", path],
                       capture_output=True, text=True)
    return r


def prune(program_dir, repo, dry_run):
    ws = _load_wave_state(program_dir)
    if ws is None:
        return None, "wave-state.yaml não encontrado em " + str(program_dir)

    grouped = landed_slices(ws)
    kept = [{"slice": s, "status": st} for s, st in grouped.pop("__kept__", [])]

    result = {"removed": [], "kept": kept, "failed": [], "already_gone": []}

    if not grouped:
        return result, None

    git_paths_before = git_worktree_paths(repo)
    ws_map = herdr_worktree_map(repo)

    for slice_name, v in grouped.items():
        wt_path = v.get("worktree")
        if not wt_path:
            result["failed"].append({"slice": slice_name,
                                     "detail": "wave-state não tem `worktree` registrado para esta slice"})
            continue
        real_path = os.path.realpath(wt_path)

        if real_path not in git_paths_before:
            result["already_gone"].append(slice_name)
            continue

        if dry_run:
            wsid = ws_map.get(real_path)
            via = f"herdr worktree remove --workspace {wsid}" if wsid else \
                  f"git worktree remove {wt_path}"
            result["removed"].append({"slice": slice_name, "via": "dry-run: " + via})
            continue

        wsid = ws_map.get(real_path)
        if wsid:
            r = remove_via_herdr(wsid)
            via = f"herdr --workspace {wsid}"
        else:
            r = remove_via_git(repo, wt_path)
            via = "git worktree remove (sem Space aberto)"

        if r.returncode != 0:
            msg = (r.stderr or r.stdout or "").strip() or f"exit {r.returncode}"
            result["failed"].append({"slice": slice_name, "detail": f"{via}: {msg}"})
            continue

        # Confirmation by git, not by herdr's word — same principle as step 6a
        # of /maestro:run.
        git_paths_after = git_worktree_paths(repo)
        if real_path in git_paths_after:
            result["failed"].append({
                "slice": slice_name,
                "detail": f"{via} devolveu sucesso mas `git worktree list` ainda mostra {wt_path}",
            })
            continue

        result["removed"].append({"slice": slice_name, "via": via})

    return result, None


def render_human(result, dry_run):
    lines = []
    for r in result["removed"]:
        prefix = "removeria" if dry_run else "removida"
        lines.append(f"{r['slice']}: {prefix} ({r['via']})")
    for k in result["kept"]:
        lines.append(f"{k['slice']}: mantida — status {k['status']}")
    for a in result["already_gone"]:
        lines.append(f"{a}: já removida (não estava mais em `git worktree list`)")
    for f in result["failed"]:
        lines.append(f"{f['slice']}: falhou — {f['detail']}")
    return "\n".join(lines) if lines else "nenhuma slice aterrissada nesta onda"


def main():
    ap = argparse.ArgumentParser(prog="maestro-prune")
    ap.add_argument("program_dir")
    ap.add_argument("--repo", required=True,
                    help="raiz-principal onde `git worktree` e `herdr worktree list` rodam")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    result, err = prune(a.program_dir, a.repo, a.dry_run)
    if err:
        print(err, file=sys.stderr)
        return 2

    if a.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(render_human(result, a.dry_run))

    return 1 if result["failed"] else 0


if __name__ == "__main__":
    sys.exit(main())
