#!/usr/bin/env python3
"""maestro-gatekeeper — the Maestro permission gatekeeper (design rev2.1, Comp. 3).

Own process (the interactive maestro session does not serve MCP while it talks)
that decides the permissions of the headless child sessions via
`--permission-prompt-tool`, over MCP streamable HTTP on loopback, ONE server per
wave shared by the N children. Promoted from the spike
(maestro/spike-gatekeeper/, VIABLE 2026-07-15).

Contract settled by the spike:
  - transport: loopback HTTP, 1 server/wave (stdio would kill the single queue);
  - response: JSON in content[0].text — {"behavior":"allow|deny", ...};
  - child identity: does NOT come in the payload → the slice goes in the URL
    query param (?slice=S1) that the mcp-config generated per fork points to;
  - protocol 3a: the deny `message` carries MAESTRO-EXIT:ESCALATED:<id> and the
    child obeys — the whole contract lives here, nothing in the child's prompt.

Engine (D5): mechanical rules; the gray zone ALWAYS escalates (no LLM in v1).
Shadow mode (D3, 1st program): --shadow approves everything, logs what it WOULD
have done.

Usage:
  maestro-gatekeeper --state-dir DIR [--port 8765] [--host 127.0.0.1]
                     [--shadow] [--rules FILE]

State in DIR: gatekeeper.pid, decisions.jsonl (5-field log),
escalations/<id>.yaml (queue drained by the maestro session).
Healthcheck: GET /health → 200 (the event loop detects a dead gatekeeper).
"""
import argparse
import json
import os
import re
import shlex
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs

# --- command-line reading engine, borrowed from common ----------------------
# Classifying a command by a regex anchored on the first word is what made the
# WEGO-parallel shadow batch (2026-08-24) release 8 writes as "read-only" —
# `cat > File.java <<'EOF'` matches because of the `cat`, and one of the
# released lines ended in `git add -A && git commit`. `_shellscan` already knows
# how to read the whole line (quote mask, split into segments, write targets)
# and is the same source that the enforcement-guard and the maven-reactor-guard
# use.
_S = None
_SHELLSCAN_ERROR = ""


def _load_shellscan():
    """Imports common/hooks/_shellscan.py — repo layout AND plugin cache layout.

    Repo:  <repo>/maestro/bin/            → <repo>/common/hooks/
    Cache: <mkt>/maestro/<ver>/bin/       → <mkt>/common/<ver>/hooks/
    Failing here is FAIL-CLOSED: without the engine, no mechanical allow rule
    fires and everything escalates. A blind gatekeeper prefers to ask over
    releasing.
    """
    global _S, _SHELLSCAN_ERROR
    here = Path(__file__).resolve().parent
    candidates = [here.parent.parent / "common" / "hooks" / "_shellscan.py"]
    candidates += sorted(here.parent.parent.parent.glob("common/*/hooks/_shellscan.py"))
    for c in candidates:
        if c.is_file():
            import importlib.util
            spec = importlib.util.spec_from_file_location("_shellscan", c)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _S = mod
            return
    _SHELLSCAN_ERROR = ("_shellscan.py do common não encontrado em: "
                        + ", ".join(str(c) for c in candidates))

ARGS = None
# Per-slice state for the "watched post-deny" (design 3a): after a strategic
# deny, promote any later write outside the surface to an escalation.
DENIED_SLICES: set[str] = set()

# Explicit strategic patterns (design Comp. 3) → always escalate.
STRATEGIC = [
    ("edit-contract", r"openapi|\.proto\b|schema\.(yaml|json)|contract"),
    ("push-publish", r"\bgit\s+push\b|\bnpm\s+publish\b|\bgh\s+release\b|\bdocker\s+push\b"),
    ("delete-broad", r"\brm\s+-rf?\b|\bgit\s+clean\b"),
    ("enforcement", r"\.claude/settings|\.claude-plugin|/hooks/|/plugins/"),
]


# Commands whose worst case is reading. `sed`/`awk` are in because the form that
# WRITES (`sed -i`, `awk > file`) shows up as a write target and is caught
# there. `python3`, `perl` and `xargs` are deliberately OUT: the WEGO-parallel
# children edited Java with `python3 - <<'EOF'` and `perl -0pi -e`, and there is
# no way to know what an interpreter will write without running it. That case
# is the legitimate gray zone — it escalates.
READ_HEADS = {
    "ls", "cat", "pwd", "echo", "grep", "rg", "find", "head", "tail", "wc",
    "sed", "awk", "diff", "file", "stat", "basename", "dirname", "sort",
    "uniq", "cut", "tr", "test", "true", "which", "env", "date", "printf",
}
# Build and test: not reading (they compile, write to target/ and ~/.m2), but
# they are the work the slice exists to do and already come pre-approved in the
# generated settings. They were escalating only because `| tail -30` breaks the
# match of Claude Code's allow — 11 of the 42 escalations of the 1st batch were
# this.
BUILD_HEADS = {
    "mvn", "mvnw", "./mvnw", "gradle", "gradlew", "./gradlew", "make",
    "pytest", "go", "cargo",
}
GIT_READ = {"status", "diff", "log", "show", "rev-parse", "describe",
            "ls-files", "blame"}

# A heredoc body is not shell — it is content. The `trap 'rm -rf "${SANDBOX}"'
# EXIT` INSIDE a test script being written made the 1st batch classify
# `mkdir -p bin/tests && cat > bin/tests/x.sh <<'EOF'` as delete-broad. Same
# family as "quoted text is not shell" (WEGO-2087), one level up: there it was a
# commit message, here it is a whole file.
_HEREDOC_RE = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")


def strip_heredoc_bodies(cmd: str) -> str:
    """The line without the heredoc bodies — only what the shell really executes.

    The `<<TAG` operator goes out together with the body: it is not a write
    target, and leaving it behind would make the loop find the same heredoc
    forever. The redirection (`> file`) stays intact, which is what needs to
    show up in the target extraction.
    """
    while True:
        m = _HEREDOC_RE.search(cmd)
        if not m:
            return cmd
        end_match = re.search(r"^\s*" + re.escape(m.group(2)) + r"\s*$",
                              cmd[m.end():], re.M)
        rest = cmd[m.end():][end_match.end():] if end_match else ""
        cmd = cmd[:m.start()] + "\n" + rest


def scannable_text(tool_name: str, tool_input) -> str:
    """What the strategic patterns can scan without reading prose as a command."""
    cmd = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
    if tool_name != "Bash" or not cmd:
        return json.dumps(tool_input, ensure_ascii=False)
    clean = strip_heredoc_bodies(cmd)
    return _S._unquoted_view(clean) if _S else clean


def _command_heads(cmd: str) -> list:
    """The command heads of the line, one per segment.

    The redirections come out BEFORE the split into segments: `_split_segments`
    cuts on `&`, and `2>&1` has one — without taking the redirection out first,
    `./mvnw ... 2>&1 | tail -30` becomes the segments `./mvnw ... 2>` and
    `1 | tail`, the head of the second is "1" and the whole line is refused.
    That was what remained of the noise of the 11 `./mvnw` escalations in the
    1st batch.
    """
    clean = strip_heredoc_bodies(cmd)
    no_redir = _S._strip_redirections(clean, _S._quoted_mask(clean))
    return [_command_head(seg.strip()) for seg in _S._split_segments(no_redir)
            if seg.strip()]


def _command_head(segment: str) -> str:
    try:
        argv = shlex.split(segment, posix=True)
    except ValueError:
        argv = segment.split()
    if not argv:
        return ""
    c = argv[0]
    if os.path.basename(c) == "git":
        return "git " + (argv[1] if len(argv) > 1 else "")
    return c if c.startswith("./") else os.path.basename(c)


def writes_anything(cmd: str) -> bool:
    """True if ANY segment of the line creates, overwrites or versions a file.

    This function — and not the first word of the line — is what separates
    reading from writing. Without it, `cat > File.java <<'EOF'` and
    `... && git add -A && git commit` pass as reading.
    """
    if not _S:
        return True                      # fail-closed: no engine, assume write
    clean = strip_heredoc_bodies(cmd)
    if _extract_targets(clean):
        return True
    for head in _command_heads(cmd):
        if head.startswith("git ") and head.split(" ", 1)[1] not in GIT_READ:
            return True
        if head in ("mkdir", "touch", "rm", "rmdir", "ln", "chmod", "chown"):
            return True
    return False


def _extract_targets(cmd: str) -> list:
    """Write targets, by the same mechanics as the enforcement-guard."""
    targets = []
    for seg in _S._split_segments(cmd):
        seg = seg.strip()
        if not seg:
            continue
        mask = _S._quoted_mask(seg)
        targets += [_S._unquote(m.group(1)) for m in _S._REDIR_RE.finditer(seg)
                    if not mask[m.start()]]
        no_redir = _S._strip_redirections(seg, mask)
        try:
            argv = shlex.split(no_redir, posix=True)
        except ValueError:
            argv = no_redir.split()
        if not argv:
            continue
        cmd0 = os.path.basename(argv[0])
        nonflags = [t for t in argv[1:] if not _S._is_flag(t)]
        if cmd0 == "tee":
            targets += nonflags
        elif cmd0 == "sed" and any(t.startswith(("-i", "--in-place"))
                                   for t in argv[1:]):
            targets += nonflags[1:] if len(nonflags) >= 2 else nonflags
        elif cmd0 in ("cp", "mv", "install") and len(nonflags) >= 2:
            targets.append(nonflags[-1])
        elif cmd0 == "dd":
            targets += [t[3:] for t in argv[1:] if t.startswith("of=")]
    return [a for a in targets if a and a not in _S._PSEUDO
            and not a.startswith("&")]


def mechanical_allow(tool_name: str, tool_input):
    """(rule, True) when the whole line is safe; (None, False) if not.

    Single rule, applied to the WHOLE line and not to the first word: every
    command head belongs to the pre-approved set AND nothing is written.
    """
    if not _S or tool_name != "Bash":
        return None, False
    cmd = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
    if not cmd.strip():
        return None, False
    if writes_anything(cmd):
        return None, False
    heads = _command_heads(cmd)
    if not heads:
        return None, False
    only_reads = True
    for head in heads:
        if head.startswith("git "):
            if head.split(" ", 1)[1] not in GIT_READ:
                return None, False
        elif head in READ_HEADS:
            continue
        elif head in BUILD_HEADS or head.lstrip("./") in BUILD_HEADS:
            only_reads = False
        else:
            return None, False
    return ("read-only" if only_reads else "base-pipeline"), True


def load_rules(path):
    """EXTRA allow rules, optional. JSON format:
    {"allow": [{"rule":"name","tool":"Bash","pattern":"regex"}], ...}

    The base is no longer regex: it became `mechanical_allow`, which reads the
    whole line. A file here only ADDS — and a hand-written pattern goes back to
    having the first-word blind spot, so use it sparingly.
    """
    if path and Path(path).is_file():
        return json.loads(Path(path).read_text())
    return {"allow": []}


def decide(slice_name, tool_name, tool_input, rules):
    """Returns (decision, rule, esc_id|None). decision ∈ allow|deny|escalate."""
    hay = json.dumps(tool_input, ensure_ascii=False)
    cmd = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
    # The strategic patterns scan only what the shell executes — no heredoc
    # body, no quoted text. Scanning the raw payload made an `rm -rf` written
    # INSIDE a script become delete-broad.
    scan_text = scannable_text(tool_name, tool_input)

    for rule, pat in STRATEGIC:
        if re.search(pat, scan_text, re.I):
            return "escalate", rule, _escalate(slice_name, tool_name, hay, rule)

    if slice_name in DENIED_SLICES:
        return "escalate", "post-deny-watch", _escalate(
            slice_name, tool_name, hay, "post-deny-watch")

    mech_rule, ok = mechanical_allow(tool_name, tool_input)
    if ok:
        return "allow", mech_rule, None

    for r in rules.get("allow", []):
        if r.get("tool") in ("*", tool_name) and re.search(r["pattern"], cmd or hay):
            return "allow", r.get("rule", "allow"), None

    # gray zone → ALWAYS escalates (D5)
    return "escalate", "gray-zone", _escalate(slice_name, tool_name, hay, "gray-zone")


def _escalate(slice_name, tool_name, ctx, rule):
    esc_id = uuid.uuid4().hex[:8]
    d = Path(ARGS.state_dir) / "escalations"
    d.mkdir(parents=True, exist_ok=True)
    (d / f"{esc_id}.yaml").write_text(
        "id: {id}\nslice: {sl}\nacao: {tool}\nregra: {rule}\n"
        "contexto: {ctx}\nestado: pending\ncriado_em: {ts}\nttl: 3600\n".format(
            id=esc_id, sl=slice_name, tool=tool_name, rule=rule,
            ctx=json.dumps(ctx, ensure_ascii=False),
            ts=time.strftime("%Y-%m-%dT%H:%M:%S%z")))
    return esc_id


def handle_permission(slice_name, params, rules):
    t0 = time.monotonic()
    a = params.get("arguments", {})
    tool_name = a.get("tool_name", "?")
    tool_input = a.get("input", {})
    decision, rule, esc_id = decide(slice_name, tool_name, tool_input, rules)

    effective = "allow" if (ARGS.shadow or decision == "allow") else "deny"
    if decision != "allow" and not ARGS.shadow:
        if decision == "escalate" and rule in ("push-publish", "delete-broad",
                                               "edit-contract", "enforcement"):
            DENIED_SLICES.add(slice_name)  # arms the watched post-deny

    if effective == "allow":
        payload = {"behavior": "allow", "updatedInput": tool_input}
    elif decision == "escalate":
        payload = {"behavior": "deny",
                   "message": f"MAESTRO-ESCALATED:{esc_id} — decisão fora das "
                              "regras mecânicas; termine o turno IMEDIATAMENTE "
                              f"reportando a linha MAESTRO-EXIT:ESCALATED:{esc_id}"}
    else:
        payload = {"behavior": "deny", "message": f"negado pela regra {rule}"}

    # 5-field log (design): normalized command · layer/rule · decision ·
    # repo+slice · later human verdict (filled in afterwards, outside the gatekeeper)
    _log({
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "comando": (tool_input.get("command") if isinstance(tool_input, dict)
                    else None) or tool_name,
        "regra": f"gatekeeper/{rule}",
        "decisao": decision,
        "effective": effective,
        "shadow": bool(ARGS.shadow),
        "slice": slice_name,
        "escalation_id": esc_id,
        "veredito_humano": None,
        "tool_name": tool_name,
        "input": tool_input,
        "latency_ms": round((time.monotonic() - t0) * 1000, 2),
    })
    return {"content": [{"type": "text", "text": json.dumps(payload)}]}


def _log(obj):
    with open(Path(ARGS.state_dir) / "decisions.jsonl", "a") as f:
        f.write(json.dumps(obj, ensure_ascii=False) + "\n")


TOOL_DEF = {
    "name": "permission_prompt",
    "description": "Decide permissões das filhas do maestro.",
    "inputSchema": {"type": "object",
                    "properties": {"tool_name": {"type": "string"},
                                   "input": {"type": "object"}},
                    "additionalProperties": True},
}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    rules = None

    def log_message(self, *a):  # silences the access log
        pass

    def _reply(self, code, obj=None):
        body = json.dumps(obj).encode() if obj is not None else b""
        self.send_response(code)
        if body:
            self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _slice(self):
        q = parse_qs(urlparse(self.path).query)
        return (q.get("slice") or ["unknown"])[0]

    def do_GET(self):
        if urlparse(self.path).path == "/health":
            self._reply(200, {"ok": True, "pid": os.getpid()})
        else:
            self._reply(405)

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        try:
            msg = json.loads(self.rfile.read(n) or b"{}")
        except json.JSONDecodeError:
            self._reply(400)
            return
        method, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:  # notification
            self._reply(202)
            return
        if method == "initialize":
            result = {"protocolVersion": msg.get("params", {}).get(
                          "protocolVersion", "2025-06-18"),
                      "capabilities": {"tools": {}},
                      "serverInfo": {"name": "maestro-gatekeeper",
                                     "version": "0.1.0"}}
        elif method == "tools/list":
            result = {"tools": [TOOL_DEF]}
        elif method == "tools/call":
            params = msg.get("params", {})
            if params.get("name") == "permission_prompt":
                result = handle_permission(self._slice(), params, Handler.rules)
            else:
                self._reply(200, {"jsonrpc": "2.0", "id": msg_id,
                                  "error": {"code": -32602, "message": "unknown tool"}})
                return
        elif method == "ping":
            result = {}
        else:
            self._reply(200, {"jsonrpc": "2.0", "id": msg_id,
                              "error": {"code": -32601,
                                        "message": f"unknown method {method}"}})
            return
        self._reply(200, {"jsonrpc": "2.0", "id": msg_id, "result": result})


def main():
    global ARGS
    p = argparse.ArgumentParser(prog="maestro-gatekeeper")
    p.add_argument("--state-dir", required=True)
    p.add_argument("--port", type=int, default=8765)
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--shadow", action="store_true")
    p.add_argument("--rules", default=None)
    ARGS = p.parse_args()
    Path(ARGS.state_dir).mkdir(parents=True, exist_ok=True)
    (Path(ARGS.state_dir) / "gatekeeper.pid").write_text(str(os.getpid()))
    _load_shellscan()
    Handler.rules = load_rules(ARGS.rules)
    srv = ThreadingHTTPServer((ARGS.host, ARGS.port), Handler)
    engine = "shellscan" if _S else f"AUSENTE ({_SHELLSCAN_ERROR}) — tudo escala"
    print(f"maestro-gatekeeper {ARGS.host}:{ARGS.port} "
          f"shadow={ARGS.shadow} state={ARGS.state_dir} motor={engine}",
          flush=True)
    try:
        srv.serve_forever()
    finally:
        (Path(ARGS.state_dir) / "gatekeeper.pid").unlink(missing_ok=True)


if __name__ == "__main__":
    main()
